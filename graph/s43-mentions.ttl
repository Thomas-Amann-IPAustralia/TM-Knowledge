    tmk:spanEnd 213 ;
    tmk:spanStart 85 ;
    tmk:surfaceForm "It may result from a dictionary meaning or from a connection in the minds of the buying public with some person, place or thing." .

<https://data.ipaustralia.gov.au/tmk/assertion/GE-0039>
    a
        tmk:ManualInstruction ,
        tmk:Mention ;
    rdfs:comment "This is the single most important sentence in the pilot for precision: it is what makes PU-0008 a prohibited inference."@en ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:entityType "ManualInstruction" ;
    tmk:goldRecord "GE-0039" ;
    tmk:mentionOf <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3> ;
    tmk:resolvesTo <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:sourceContentHash "sha256:f77c8cbb077e1682c601fc3ba31e570dd8097297d2a240565a044a3135e70190" ;
    tmk:spanEnd 106 ;
    tmk:spanStart 0 ;
    tmk:surfaceForm "A connotation must arise from the trade mark itself, and not through a comparison with another trade mark." .

