<https://data.ipaustralia.gov.au/tmk/assertion/GE-0037>
    a
        tmk:ManualInstruction ,
        tmk:Mention ;
    rdfs:comment "Typed as an instruction is arguably wrong — it instructs nobody to do anything. If it is a statement rather than an instruction, that is a correction worth making, because the same shape recurs throughout."@en ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:entityType "ManualInstruction" ;
    tmk:goldRecord "GE-0037" ;
