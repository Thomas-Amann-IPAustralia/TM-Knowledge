<https://data.ipaustralia.gov.au/tmk/assertion/GE-0034>
    a
        tmk:LegalConcept ,
        tmk:Mention ;
    rdfs:comment "Typed LegalConcept rather than Role: this is a person referred to by the mark, not a participant in examination. The distinction matters and the word does not carry it."@en ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:entityType "LegalConcept" ;
