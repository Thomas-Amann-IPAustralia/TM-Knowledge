    tmk:spanEnd 71 ;
    tmk:spanStart 45 ;
    tmk:surfaceForm "at some indeterminate time" .

<https://data.ipaustralia.gov.au/tmk/assertion/GE-0057>
    a
        tmk:ManualInstruction ,
        tmk:Mention ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:entityType "ManualInstruction" ;
    tmk:goldRecord "GE-0057" ;
