    tmk:spanEnd 13 ;
    tmk:spanStart 0 ;
    tmk:surfaceForm "A connotation" .

<https://data.ipaustralia.gov.au/tmk/assertion/GE-0041>
    a
        tmk:LegalConcept ,
        tmk:Mention ;
    rdfs:comment "A retrieval system that indexes this chunk under \"comparison between trade marks\" will surface it for exactly the queries it should not."@en ;
    tmk:approvedBy "TC" ;
