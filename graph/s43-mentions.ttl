<https://data.ipaustralia.gov.au/tmk/assertion/GE-0048>
    a
        tmk:LegislativeProvision ,
        tmk:Mention ;
    rdfs:comment "Resolves to a unit beneath a provision rather than to a provision. The ref grammar cannot tell the two apart on its own (Q-18); the loader does it by trying both."@en ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:entityType "LegislativeProvision" ;
    tmk:goldRecord "GE-0048" ;
    tmk:mentionOf <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4> ;
