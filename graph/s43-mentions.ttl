<https://data.ipaustralia.gov.au/tmk/assertion/GE-0056>
    a tmk:Mention ;
    rdfs:comment "Compare GE-0061. Both are temporal expressions and only one of them matters to examination. A stock NER model tags both `DATE` and cannot tell them apart (Q-16) — which is precisely why the two taxonomies must not be mapped one to one."@en ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:entityType "Date" ;
    tmk:goldRecord "GE-0056" ;
    tmk:mentionOf <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2> ;
