    tmk:surfaceForm "section 33(3)" .

<https://data.ipaustralia.gov.au/tmk/assertion/GE-0050>
    a
        tmk:ManualInstruction ,
        tmk:Mention ;
    rdfs:comment "Read together with GE-0009 this is the pilot's whole treatment of uncertainty: no discretion once the section bites, and no raising the ground while there is doubt that it does."@en ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:entityType "ManualInstruction" ;
    tmk:goldRecord "GE-0050" ;
    tmk:mentionOf <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4> ;
    tmk:resolvesTo <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:sourceContentHash "sha256:5a52a4dd52ef95b0e001380666cfbc14b907dda998e67a97a99859e9c179e298" ;
    tmk:spanEnd 282 ;
    tmk:spanStart 186 ;
    tmk:surfaceForm "If there is doubt that a connotation exists, then the ground for rejection should not be raised." .

<https://data.ipaustralia.gov.au/tmk/assertion/GE-0051>
    a
        tmk:ManualInstruction ,
        tmk:Mention ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
