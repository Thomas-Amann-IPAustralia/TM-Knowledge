    tmk:spanEnd 83 ;
    tmk:spanStart 14 ;
    tmk:surfaceForm "may result from the whole trade mark or from a part of the trade mark" .

<https://data.ipaustralia.gov.au/tmk/assertion/GE-0038>
    a
        tmk:ManualInstruction ,
        tmk:Mention ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
