        <https://data.ipaustralia.gov.au/tmk/assertion/GA-0003> ;
    tmk:detectableBy "test" ;
    tmk:goldRecord "PU-0003" ;
    tmk:prohibits "Confidence that a section 43 ground applies: 82%."@en ;
    tmk:why "No probability in this system is calibrated against examination outcomes, and none could be without a decision corpus. A number invites reliance that the underlying evidence does not support."@en .

<https://data.ipaustralia.gov.au/tmk/assertion/PU-0004>
    a tmk:Bound ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-26"^^xsd:date ;
    tmk:boundKind "authority_conflation" ;
    tmk:boundsQuestion
        <https://data.ipaustralia.gov.au/tmk/assertion/CQ-0021> ,
