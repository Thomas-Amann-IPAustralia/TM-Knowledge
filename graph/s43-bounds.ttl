<https://data.ipaustralia.gov.au/tmk/assertion/PU-0001>
    a tmk:Bound ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-26"^^xsd:date ;
    tmk:boundKind "evaluative_conclusion" ;
    tmk:boundsQuestion
        <https://data.ipaustralia.gov.au/tmk/assertion/CQ-0012> ,
        <https://data.ipaustralia.gov.au/tmk/assertion/GA-0003> ;
    tmk:detectableBy "eval" ;
    tmk:goldRecord "PU-0001" ;
    tmk:prohibits "This trade mark should be rejected under section 43 because the connotation is likely to deceive or cause confusion."@en ;
    tmk:why "Whether a connotation exists and whether it is likely to deceive is the decision maker's evaluative judgement on the material before them. The Manual requires the decision maker to be clearly satisfied; a system that states the conclusion has substituted itself for that person."@en .

<https://data.ipaustralia.gov.au/tmk/assertion/PU-0002>
    a tmk:Bound ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-26"^^xsd:date ;
    tmk:boundKind "evaluative_conclusion" ;
    tmk:boundsQuestion <https://data.ipaustralia.gov.au/tmk/assertion/CQ-0012> ;
    tmk:detectableBy "eval" ;
    tmk:goldRecord "PU-0002" ;
    tmk:prohibits "No section 43 ground arises here, so the application can proceed to acceptance."@en ;
    tmk:why "An assurance that no ground arises is an examination decision. It also speaks to grounds the system was never asked about — acceptance turns on every ground, not on section 43 alone."@en .

<https://data.ipaustralia.gov.au/tmk/assertion/PU-0003>
    a tmk:Bound ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-26"^^xsd:date ;
    tmk:boundKind "evaluative_conclusion" ;
    tmk:boundsQuestion
