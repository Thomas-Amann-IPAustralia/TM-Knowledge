    tmk:ordinal 5 ;
    tmk:text "(2) If the Registrar is satisfied that the parties agree to a coolingoff period, the Registrar must allow a coolingoff period of 6 months." ;
    tmk:upstreamRef "TMR1995/r5.16(2)" .

