    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a34e3b8c2593744bab18844621cf3d9cbeaa686122245ae126eed8ed3326ed70" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the regulations under that Act that were in force immediately before its repeal." ;
    tmk:upstreamRef "TMA1995/s16(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16(1)(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:73467312b6d3592b5e9bb0839f1c7ad702171cb75add60aabddb7e15dcc78aae" ;
    tmk:ordinal 4 ;
    tmk:text "Note: For the repeal of the Trade Marks Act 1955 see section 232." ;
    tmk:upstreamRef "TMA1995/s16(1)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:809b004e2b8d111efdb6e6dda24c04cc13bc9014834ea7a70f034f13704ddc8b" ;
    tmk:ordinal 5 ;
    tmk:text "(2) In this Act, unless the contrary intention appears, a reference to a particular section of the repealed Act includes a reference to the regulations made for the purposes of that section and that were in force immediately before that Act was repealed." ;
    tmk:upstreamRef "TMA1995/s16(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s161(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s161> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e2871ba3922c0d737052642711a1fc250e4d3846df148d55d2b986c27e962627" ;
    tmk:ordinal 2 ;
    tmk:text "(a) defines a collective trade mark; and" ;
    tmk:upstreamRef "TMA1995/s161(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s161(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s161> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6139ae9b1c6628d3d1dd5a3921b302c41c4b86f227e0eeb9b170b42b192512f5" ;
    tmk:ordinal 3 ;
    tmk:text "(b) provides to what extent, and subject to what modifications or additions, the provisions of this Act relating to trade marks apply to collective trade marks." ;
    tmk:upstreamRef "TMA1995/s161(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s161~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s161> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:60affcdddc80b9cf16293af307b055f4fe14e526ff38cf0495fa444468d4f160" ;
    tmk:ordinal 1 ;
    tmk:text "This Part:" ;
    tmk:upstreamRef "TMA1995/s161~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s162~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s162> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b510cb9b2b8fc60688045c303c03e71bbe7cfecfc3b415a849cb28b80f2254eb" ;
    tmk:ordinal 1 ;
    tmk:text "A collective trade mark is a sign used, or intended to be used, in relation to goods or services dealt with or provided in the course of trade by members of an association to distinguish those goods or services from goods or services so dealt with or provided by persons who are not members of the association." ;
    tmk:upstreamRef "TMA1995/s162~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s164~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s164> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:926c69409484992b2cecef6b5b0bf3dfb2087d882ecd93ff160b3b6136183574" ;
    tmk:ordinal 1 ;
    tmk:text "An application for the registration of a collective trade mark must be made by the association to which the mark belongs." ;
    tmk:upstreamRef "TMA1995/s164~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s166~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s166> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9aa31337c0b600e1c0e325baef0e582aa0516b424e1e3b797d3b0b666b6f9a84" ;
    tmk:ordinal 1 ;
    tmk:text "A collective trade mark may not be assigned or transmitted." ;
    tmk:upstreamRef "TMA1995/s166~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168> ;
