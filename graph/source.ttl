    tmk:ordinal 2 ;
    tmk:text "(a) the applicant’s trade mark is substantially identical with, or deceptively similar to:" ;
    tmk:upstreamRef "TMA1995/s44(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(1)(a)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
