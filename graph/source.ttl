    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:83f849cbe8dfa6e9818268f9c418339a27b511ecaa0a9016d42373dc130edf81" ;
    tmk:ordinal 17 ;
    tmk:text "(b) any relevant obligation of Australia under an international agreement;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(3)(c)> a tmk:LegislativeUnit ;
