    tmk:ordinal 2 ;
    tmk:text "Note: For filing date see section 6." ;
    tmk:upstreamRef "TMA1995/s72(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72> ;
