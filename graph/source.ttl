    tmk:upstreamRef "TMA1995/s96(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s96(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s96> ;
