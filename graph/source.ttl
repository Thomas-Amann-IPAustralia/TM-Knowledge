    tmk:contentHash "sha256:71cfa553a5f63bead8ff7f878ce92687b7b59914bf4191f8ee9fb50a4fe3b1d1" ;
    tmk:ordinal 3 ;
    tmk:text "(b) specify the goods and/or services to which it relates; and" ;
    tmk:upstreamRef "TMA1995/s46(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46(1)(c)> a tmk:LegislativeUnit ;
