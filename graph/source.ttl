    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar may grant a request under subregulation 5.9(1) for an extension of time only if the Registrar is satisfied that the grounds set out in the request justify the extension." ;
    tmk:upstreamRef "TMR1995/r5.10(1)" .

