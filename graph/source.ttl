    tmk:ordinal 1 ;
    tmk:text "(1) A divisional application must:" ;
    tmk:upstreamRef "TMA1995/s46(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e842732f60f87771f3247c2816554be46d0075442fa8b73876bac242f9d299a1" ;
    tmk:ordinal 2 ;
    tmk:text "(a) be for the registration of the trade mark to which the parent application relates; and" ;
    tmk:upstreamRef "TMA1995/s46(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46> ;
