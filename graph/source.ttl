    tmk:contentHash "sha256:86a1379060c7b4891ce00226fe33029cbd25f768fb4227155e03ffc415486a21" ;
    tmk:ordinal 4 ;
    tmk:text "(2) The application may be amended to correct a clerical error or an obvious mistake in the application if the Registrar is of the opinion that it is fair and reasonable in all the circumstances of the case to make the amendment under this section." ;
    tmk:upstreamRef "TMA1995/s65A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
