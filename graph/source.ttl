    tmk:contentHash "sha256:dd7f93f90023d92e393d72575b6b2ca881e5c3554c98a1b7bf266e2f3dc23709" ;
    tmk:ordinal 9 ;
    tmk:text "(4) A person may, as prescribed, oppose the granting of the request for the amendment on the ground that, if the amendment is made, the trade mark will be substantially identical with, or deceptively similar to:" ;
    tmk:upstreamRef "TMA1995/s83A(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7eb01bf1d28e3874394b682ed4378f7a8158a50279dac189e67a8a637b3a19a0" ;
    tmk:ordinal 10 ;
    tmk:text "(a) a trade mark registered in the name of the person in respect of similar or closely related goods or similar or closely related services; or" ;
    tmk:upstreamRef "TMA1995/s83A(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(4)(b)> a tmk:LegislativeUnit ;
