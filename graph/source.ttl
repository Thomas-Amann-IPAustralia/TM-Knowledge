    tmk:ordinal 2 ;
    tmk:text "(a) the request is made within a period mentioned in subregulation 17A.20(1) or that period as extended under regulation 17A.20 or section 224 of the Act; and" ;
    tmk:upstreamRef "TMR1995/r17A.21(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.21(1)(b)> a tmk:LegislativeUnit ;
