    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/3/4/3/1/internal/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/3/4/3/1/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/3/4/3/1/prov/1>,
