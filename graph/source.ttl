    tmk:ordinal 1 ;
    tmk:text "(1) An aggrieved person applying to a prescribed court under this Division must give notice of the application to the Registrar." ;
    tmk:upstreamRef "TMA1995/s90(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90> ;
