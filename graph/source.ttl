    tmk:ordinal 9 ;
    tmk:text "International Register means the register maintained by the International Bureau for the purposes of the Protocol." ;
    tmk:upstreamRef "TMR1995/r17A.2/international-register" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/international-registration> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
