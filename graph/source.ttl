    tmk:ordinal 4 ;
    tmk:text "(c) the trade marks are registered trade marks for the purposes of this Act with the same registered owner." ;
    tmk:upstreamRef "TMA1995/s82A(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A(1)(c)~1> a tmk:LegislativeUnit ;
