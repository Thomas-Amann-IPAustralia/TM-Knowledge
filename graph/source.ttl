<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/5> a tmk:Page ;
    rdfs:label "Part 23.5 Specific evidence requirements for trade marks with no inherent adaptation to distinguish"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
