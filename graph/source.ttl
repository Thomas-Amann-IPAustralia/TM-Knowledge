    tmk:ordinal 11 ;
    tmk:text "Note 1: For goods that are similar, see subsection 14(1)." ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)(vi)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)(vi)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:70c2f63044225f099e8b5a39b8c179fe70a7c31d1117e951163410304e8da529" ;
    tmk:ordinal 12 ;
    tmk:text "Note 2: For subparagraph (c)(iv), an authorised user may, under paragraph 26(1)(f), subject to any agreement the authorised user has with the registered owner, permit another person to apply the trade mark to, or in relation to, goods in respect of which the trade mark is registered." ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)(vi)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:32dbf9a4deb56763464aad0734ea5a497f9e9d28daf52f0e15ab457ad7889557" ;
    tmk:ordinal 13 ;
    tmk:text "(2) A reference in paragraph (1)(c) to consent to the application of a trade mark to, or in relation to, goods includes, without limitation, a reference to:" ;
    tmk:upstreamRef "TMA1995/s122A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b9e7a9c020c4d7b54bdd836cf91887e1cd0c74948781525e63d045c187e939a2" ;
    tmk:ordinal 14 ;
    tmk:text "(a) consent subject to a condition (for example, a condition that the goods are to be sold only in a foreign country); and" ;
    tmk:upstreamRef "TMA1995/s122A(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
