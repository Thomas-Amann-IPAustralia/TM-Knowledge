    tmk:ordinal 6 ;
    tmk:text "(3A) Subsection (3) does not limit subsection 33(3A) of the Acts Interpretation Act 1901." ;
    tmk:upstreamRef "TMA1995/s52(3A)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52> ;
