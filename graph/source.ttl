    tmk:ordinal 43 ;
    tmk:text "(6) If:" ;
    tmk:upstreamRef "TMR1995/r17A.36(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36(6)(a)> a tmk:LegislativeUnit ;
