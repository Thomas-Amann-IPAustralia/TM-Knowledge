    tmk:contentHash "sha256:f512e2ef7601256d5fc82b3a76695178ddf3bfac007deae06298015f1041f576" ;
    tmk:ordinal 12 ;
    tmk:text "Note: A defendant bears an evidential burden in relation to the matter in subsection (2A), see subsection 13.3(3) of the Criminal Code." ;
    tmk:upstreamRef "TMA1995/s153(2A)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153> ;
