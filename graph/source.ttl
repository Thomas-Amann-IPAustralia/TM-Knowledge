    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b0e7e60718b61ab662101868d66e1124604fc33c6e8a3619de0a043fa6ffcbc9" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The Registrar must give a copy of the notice to the applicant." ;
    tmk:upstreamRef "TMR1995/r6.6(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.7(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.7> ;
    tmk:authorityKind "law" ;
