    tmk:ordinal 26 ;
    tmk:text "Note 2: For company, registered trade marks attorney, patent attorney and incorporated legal practice see section 6." ;
    tmk:upstreamRef "TMA1995/s156~6~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s156~7> a tmk:LegislativeUnit ;
