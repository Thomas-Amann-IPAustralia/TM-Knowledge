    tmk:ordinal 6 ;
    tmk:text "(6) The goods and/or services must, as far as practicable, be specified in terms appearing in any listing of goods and services that is:" ;
    tmk:upstreamRef "TMR1995/r4.4(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(6)(a)> a tmk:LegislativeUnit ;
