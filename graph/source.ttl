    tmk:contentHash "sha256:2de5dce5d67b4d9f8d857090eea71ad84da02edb581df7986143cfc1270a4f10" ;
    tmk:ordinal 7 ;
    tmk:text "Note: Section 37 of the Act and regulation 4.12 deal with the lapsing of an application before acceptance." ;
    tmk:upstreamRef "TMR1995/r4.8(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:de9ff66bcc363c67243a13a1fd52b02aaa71b42bc5226bf643dc4565325e23bf" ;
    tmk:ordinal 4 ;
    tmk:text "the Registrar must report that belief by notification to the applicant." ;
    tmk:upstreamRef "TMR1995/r4.8~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9> ;
