    tmk:ordinal 4 ;
    tmk:text "(i) paragraph (a) does not apply; and" ;
    tmk:upstreamRef "TMA1995/s74A(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74A(b)(ii)> a tmk:LegislativeUnit ;
