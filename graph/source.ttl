    tmk:ordinal 5 ;
    tmk:text "The Registrar must enter these particulars in the Register." ;
    tmk:upstreamRef "TMA1995/s69~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:86a28c43974a39d74a1d79dc67c1af7b84f14118f1c0d4eb207fa5278ccfc430" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If the Registrar or a prescribed court, having regard to the circumstances of a particular case, thinks fit, the Registrar or the court may decide that a person has used a trade mark if it is established that the person has used the trade mark with additions or alterations that do not substantially affect the identity of the trade mark." ;
    tmk:upstreamRef "TMA1995/s7(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7(1)~1> a tmk:LegislativeUnit ;
