<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/6/6/4~2> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
