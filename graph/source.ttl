    tmk:contentHash "sha256:fe36d6fba775fb325e4f2ad0865cdbb444401784f7506540aa3e0019a6cba96b" ;
    tmk:ordinal 12 ;
    tmk:text "in relation to the goods and/or services to which the nonuse application relates and that the registered owner:" ;
    tmk:upstreamRef "TMA1995/s92(4)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(4)~2> a tmk:LegislativeUnit ;
