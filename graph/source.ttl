    tmk:contentHash "sha256:37c63f1c9ddf9a3aedfe13529373db00cf3076953235d465b31317d4b0b2306c" ;
    tmk:ordinal 2 ;
    tmk:text "(a) relating to an application for the registration of a trade mark of a kind mentioned in subsection 241(2) of the Act (which deals with pending applications for registration of trade marks); or" ;
    tmk:upstreamRef "TMR1995/r22.2(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.2(1)(b)> a tmk:LegislativeUnit ;
