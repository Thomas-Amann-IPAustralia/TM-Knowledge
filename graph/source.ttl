    tmk:ordinal 1 ;
    tmk:text "(1) A person proposing to submit an application under Part 4 of the Act (a requester) may submit a request for filing assistance (an AFS request) under this Part." ;
    tmk:upstreamRef "TMR1995/r3A.3(1)" .

