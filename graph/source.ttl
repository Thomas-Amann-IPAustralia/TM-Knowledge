    tmk:contentHash "sha256:d4917d11e2e22e95b75b8cc0f0a5e6644cdebed09fb0bdc0b2a190f0c2a53e4b" ;
    tmk:ordinal 6 ;
    tmk:text "Note: For filing date see section 6." ;
    tmk:upstreamRef "TMA1995/s74A(b)(ii)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74A~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:033f591757b878d78e541fd8ef28009762273ad33b357a714272d1c2204e123d" ;
    tmk:ordinal 1 ;
    tmk:text "This Division applies to a registered trade mark if:" ;
    tmk:upstreamRef "TMA1995/s74A~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:28540c11397681be8844578d68f68d4433cd44673151dbee03c95f498d2e2b32" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Any person may, within the prescribed period before the registration of a trade mark expires, ask the Registrar to renew the registration." ;
    tmk:upstreamRef "TMA1995/s75(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6cf081cca9a3df0ee910a1fcf0940c35dcacbb1850b7970cc804f291fe727e74" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The request must:" ;
    tmk:upstreamRef "TMA1995/s75(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:58d123d84a6c348cac0c8d2dee2668a71cd5982f4d07446c2635ea84d71849b8" ;
    tmk:ordinal 3 ;
    tmk:text "(a) be in an approved form; and" ;
    tmk:upstreamRef "TMA1995/s75(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dd5163e130a77232a53515419d25f78cd6b491b6a93926496071dadc71f359ae" ;
    tmk:ordinal 4 ;
    tmk:text "(b) be filed in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s75(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s77(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s77> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:64c0e2c7d030b71e31ce2d873943592884a6812fe35d0173b070964f6fa2a8a9" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If a request for the renewal of the registration of a trade mark is made in accordance with section 75, the Registrar must renew the registration for a period of 10 years from the day on which the registration of the trade mark would expire if it were not renewed." ;
    tmk:upstreamRef "TMA1995/s77(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s77(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s77> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1251eba230a4d8fee11d87c0cbc0b74e1940fb3941e70e9ba0e717a0affe8027" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The Registrar must give notification of the renewal to the registered owner of the trade mark in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s77(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s77(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s77> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:51bc3d2cb875067e368c2072432c782621315c33806e2644e35cc3386a852148" ;
    tmk:ordinal 3 ;
    tmk:text "Note: For registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s77(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s78(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s78> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5792da9c859ca5a5abbcaf4da00eec25bd2237010b305c25473eae69635bba0a" ;
    tmk:ordinal 2 ;
    tmk:text "(a) subject to sections 79 and 80, the registration ceases to have effect when it expires; and" ;
    tmk:upstreamRef "TMA1995/s78(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s78(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s78> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6a16bfc27f190d8c744e37fe6db10bb86d5f7780570c7febb679408cec291b37" ;
    tmk:ordinal 3 ;
    tmk:text "(b) unless the registration is renewed under section 79, the Registrar must remove the trade mark from the Register 6 months after the day on which the registration expired." ;
    tmk:upstreamRef "TMA1995/s78(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s78(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s78> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:243b207aafb7f23ce561eeecbb0008f5345af54930d07401a5eca6e2c6607258" ;
    tmk:ordinal 4 ;
    tmk:text "Note: For month and Register see section 6." ;
    tmk:upstreamRef "TMA1995/s78(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s78~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s78> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:55b701c69fb471e549c637e37864945b5d86d97b4925d8d849a6f204c723dacf" ;
    tmk:ordinal 1 ;
    tmk:text "If the registration of a trade mark is not renewed under section 77, then:" ;
    tmk:upstreamRef "TMA1995/s78~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s79~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s79> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bca8338197e56589cf9c70706a61f0b4a22402d07e6ede8e0c6ad3b326db0815" ;
    tmk:ordinal 1 ;
    tmk:text "If, within 6 months after the registration of a trade mark has expired, a person asks the Registrar, in accordance with subsection 75(2), to renew the registration of the trade mark, the Registrar must renew the registration of the trade mark for 10 years from the day on which the registration expired." ;
    tmk:upstreamRef "TMA1995/s79~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s79~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s79> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c079d3291c395e1cec6ab58944e84750edf7c0969c8897809e5f99519633b6ab" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For month see section 6." ;
    tmk:upstreamRef "TMA1995/s79~1~1" .

