    tmk:contentHash "sha256:68de2bc7831959b1cb9f68b829541d774b41a23b6df9e9fc81f22a489138eb2d" ;
    tmk:ordinal 8 ;
    tmk:text "(3) Unless the acceptance of an IRDA is deferred under regulation 17A.21, a report under subregulation (2) about the IRDA must specify the date by which the Registrar must notify his or her final decision on examination to the International Bureau." ;
    tmk:upstreamRef "TMR1995/r17A.18(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.18(4)> a tmk:LegislativeUnit ;
