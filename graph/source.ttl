    tmk:ordinal 4 ;
    tmk:text "(2) If:" ;
    tmk:upstreamRef "TMR1995/r17A.4(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(2)(a)> a tmk:LegislativeUnit ;
