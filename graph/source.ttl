    tmk:ordinal 6 ;
    tmk:text "(a) first used the similar trade mark in respect of:" ;
    tmk:upstreamRef "TMA1995/s58A(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58A(2)(a)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58A> ;
