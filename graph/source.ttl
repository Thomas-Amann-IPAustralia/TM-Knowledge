    tmk:ordinal 7 ;
    tmk:text "Note: For this Act and registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s82A(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A> ;
