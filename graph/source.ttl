    tmk:ordinal 3 ;
    tmk:text "old Patents regulations means the Patents Regulations 1991 as in force immediately before the commencement day." ;
    tmk:upstreamRef "TMR1995/r22.14/old-patents-regulations" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.14/old-regulations> a tmk:LegislativeUnit ;
