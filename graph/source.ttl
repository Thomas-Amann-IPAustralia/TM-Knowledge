    tmk:ordinal 20 ;
    tmk:text "(ii) the protection of the trade mark be subject to a condition or limitation, or an additional or different condition or limitation." ;
    tmk:upstreamRef "TMR1995/r17A.42A(3)(c)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5087c738c076c0c85793c8ec7e4c33903613c9a5ab084b9c3d42bf44af60a378" ;
    tmk:ordinal 21 ;
    tmk:text "(4) For paragraph (2)(d), in deciding whether or not it is reasonable to exercise a power or powers, the matters to which the Registrar must have regard include the following:" ;
    tmk:upstreamRef "TMR1995/r17A.42A(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ea7a9880f9fe0d099c13690999b808494cb9cc699b57ad6406c9cdf4fae6f774" ;
    tmk:ordinal 22 ;
    tmk:text "(a) any use that has been made of the trade mark;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:991fb9a791ab9c28093fc836e0e2ac3ebd1333b8b7e64869e9b14aebb66e4b7b" ;
    tmk:ordinal 23 ;
    tmk:text "(b) any past, current or proposed legal proceedings relating to the trade mark as a protected international trade mark or seeking amendment or cessation of its protection;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(4)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:324f63ef1dd3b1d41ebc5104cc5049958a136ee46c3d0a3e6f4e040777d83dcb" ;
    tmk:ordinal 24 ;
    tmk:text "(c) any other action taken in relation to the trade mark as a protected international trade mark;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(4)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(4)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a979c73efc19aa396b2087b6c8849f77831a50a7cf4913c782844bb04f2113ba" ;
    tmk:ordinal 25 ;
    tmk:text "(d) any special circumstances making it appropriate for the Registrar to exercise or not to exercise a power or powers mentioned in subregulation (1)." ;
    tmk:upstreamRef "TMR1995/r17A.42A(4)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6545820afd2dcc658c0fa20368b9fb65d4359f6f6eac8bdb7fec2fbb3b3ff9cd" ;
    tmk:ordinal 26 ;
    tmk:text "(5) The Registrar does not have a duty to consider whether or not to exercise a power under this Subdivision, whether or not the Registrar has been requested to do so." ;
    tmk:upstreamRef "TMR1995/r17A.42A(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42F~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42F> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:86e7e223760cea161330e40899bdea00c9c8345c9deccabb8a2d344cdcebc704" ;
    tmk:ordinal 1 ;
    tmk:text "A person who made submissions to the Registrar, or was heard by the Registrar, during the course of proceedings mentioned in paragraph 17A.42C(1)(a), may appeal to the Federal Court or Federal Magistrates Court from a decision of the Registrar to exercise, or not exercise, a power mentioned in subregulation 17A.42A(1)." ;
    tmk:upstreamRef "TMR1995/r17A.42F~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f855f75382267b60f2cea371abc30e5a936864bf0c5ecd4809ffd0f73cc0bf68" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A person may make an application for cessation of protection." ;
    tmk:upstreamRef "TMR1995/r17A.48C(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:331a6dd737c330359fb04451c018e89bbdf646e6b826e8653700dfe96f22a77c" ;
    tmk:ordinal 2 ;
    tmk:text "(2) However, an application may not be made under subregulation (1) if an action concerning the protected international trade mark is pending in a prescribed court." ;
    tmk:upstreamRef "TMR1995/r17A.48C(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e7c195ebbbfc3922d1ea1f500a4ca5950207080127587171ee540c050a285bfe" ;
    tmk:ordinal 3 ;
    tmk:text "(3) If subregulation (2) applies, a person may apply to the court for an order directing the Registrar to cease protecting the protected international trade mark." ;
    tmk:upstreamRef "TMR1995/r17A.48C(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d45bac281350e3795efb31bb6d9870e7935d2b84b3171697e868ab23193b2d04" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Part 9 of the Act and Part 9 of these Regulations apply in relation to an application for cessation of protection." ;
    tmk:upstreamRef "TMR1995/r17A.48D(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)> a tmk:LegislativeUnit ;
