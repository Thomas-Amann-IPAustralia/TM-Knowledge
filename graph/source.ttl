    tmk:ordinal 2 ;
    tmk:text "(a) the IRDA is not in accordance with this Division; or" ;
    tmk:upstreamRef "TMR1995/r17A.16(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
