    tmk:contentHash "sha256:8ac39bab7db9b8d6a1592af606cd07117d4212efbb361e8f6bae588387c1b2a8" ;
    tmk:ordinal 5 ;
    tmk:text "(3) For subregulation (2), the following persons may be given declarations, including statutory declarations, in electronic form by electronic means:" ;
    tmk:upstreamRef "TMR1995/r21.6(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.6(3)(a)> a tmk:LegislativeUnit ;
