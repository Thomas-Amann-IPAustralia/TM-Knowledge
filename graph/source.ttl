    tmk:contentHash "sha256:cba5453b94b610054399e3950e7b197c1a6bc16fba6ceb709b20a5d0a6033df1" ;
    tmk:ordinal 1 ;
    tmk:text "(1) This section applies if:" ;
    tmk:upstreamRef "TMA1995/s65A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
    tmk:authorityKind "law" ;
