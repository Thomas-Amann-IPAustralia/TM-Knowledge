<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:45878059d3964862f16c8dae7b3d739b87e8da2fb1d8e50aa3bc9b659c826f83" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Subject to subsection (3) and to section 102, if:" ;
    tmk:upstreamRef "TMA1995/s101(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e73abbab6e21b75bc0de421b60e7f26dd6e61312293a632d59d84d7494109197" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the proceedings relating to an opposed application have not been discontinued or dismissed; and" ;
    tmk:upstreamRef "TMA1995/s101(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:38c1dac426b7441bfcb3e2e29e71cbebe00fffcedd702dbdf9681b08f2c07956" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the Registrar is satisfied that the grounds on which the application was made have been established;" ;
    tmk:upstreamRef "TMA1995/s101(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1e339be4603c5db7115bcc104ab66395f3eac19a8019b47a9f6a87d6fdab160d" ;
    tmk:ordinal 5 ;
    tmk:text "(2) Subject to subsection (3) and to section 102, if, at the end of the proceedings relating to an opposed application, the court is satisfied that the grounds on which the application was made have been established, the court may order the Registrar to remove the trade mark from the Register in respect of any or all of the goods and/or services to which the application relates." ;
    tmk:upstreamRef "TMA1995/s101(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1489bdd1776fd04d41b619b3d76b463eb5fc53aee46a0eeae532df4b3f9aa26f" ;
    tmk:ordinal 8 ;
    tmk:text "(a) similar goods or closely related services; or" ;
    tmk:upstreamRef "TMA1995/s101(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101> ;
