    tmk:ordinal 1 ;
    tmk:text "The Registrar may defer the acceptance of the application in the circumstances, and for the period, provided for in the regulations." ;
    tmk:upstreamRef "TMA1995/s36~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s37(2)> a tmk:LegislativeUnit ;
