    tmk:contentHash "sha256:ef51cb8fd3c1dd68d6d9cc1d589246f108554fcf6c4080a45eda542c80c2ed90" ;
    tmk:ordinal 3 ;
    tmk:text "(b) because of the reputation of that other trade mark, the use of the firstmentioned trade mark would be likely to deceive or cause confusion." ;
    tmk:upstreamRef "TMA1995/s60(b)" .

