    tmk:ordinal 9 ;
    tmk:text "(i) to use the trade mark in Australia; or" ;
    tmk:upstreamRef "TMA1995/s92(4)(a)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(4)(a)(ii)> a tmk:LegislativeUnit ;
