    tmk:upstreamRef "TMA1995/s156~7" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s15~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s15> ;
