    tmk:ordinal 8 ;
    tmk:text "(2) Subsection (1) applies to an act done before 1 January 1996 as it applies to an act done on or after that day, but it does not affect:" ;
    tmk:upstreamRef "TMA1995/s228(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
