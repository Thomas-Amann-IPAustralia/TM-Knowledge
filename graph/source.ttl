    tmk:contentHash "sha256:75d207b801e9080ee707bbb15f986145b6742a68d7a1f0b26ecaa5d2a5bd87e5" ;
    tmk:ordinal 6 ;
    tmk:text "the application of the trade mark or the other act is taken, for the purposes of this Act, to constitute use of the trade mark in relation to the export goods or export services." ;
    tmk:upstreamRef "TMA1995/s228~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
