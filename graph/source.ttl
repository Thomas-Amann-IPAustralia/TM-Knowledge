    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f37dac0e644707f421d956c24d61d1a2ac1cf48a56b02fd1f45a0176e5e6c00c" ;
    tmk:ordinal 4 ;
    tmk:text "(2) For the purposes of this Act, services are similar to other services:" ;
    tmk:upstreamRef "TMA1995/s14(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s19(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s19> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b2b215091f3eb5b39952a39cc013bd20424c53c68315108154b77d4cfc4c269b" ;
    tmk:ordinal 5 ;
    tmk:text "(2) The registration of a trade mark may be in respect of goods or services of more than one class." ;
    tmk:upstreamRef "TMA1995/s19(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s217A> a tmk:LegislativeProvision ;
    rdfs:label "Prescribed documents relating to trade marks to be made available for public inspection"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9fdb934239a03fa764fce632ce51f063c469e72e2aefd19a87c00b3ec4f25734" ;
    tmk:text "(1) The Registrar must make available for public inspection prescribed documents that relate to a trade mark while they are held in the Trade Marks Office at or after the time particulars of the application for registration of the trade mark are published under section 30. (2) A document may be prescribed for the purposes of subsection (1) wholly or partly by reference to the fact that it does not contain information covered by a requirement under section 226A. This does not limit the ways in which documents may be prescribed for those purposes." ;
    tmk:upstreamRef "TMA1995/s217A" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:59b43125b2b2470b521205ef7ef11d37fd64f7a12f054a8449905605584d95ca" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar must extend the time for doing a relevant act that is required by this Act to be done within a certain time if the act is not, or cannot be, done within that time because of an error or omission by:" ;
    tmk:upstreamRef "TMA1995/s224(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224(7)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4cccf2e6408d54b1fed376981f36e05c39b7145b87e4a9a8c1631fafd723a7b3" ;
    tmk:ordinal 18 ;
    tmk:text "(7) An application may be made to the Administrative Review Tribunal for the review of a decision of the Registrar not to extend the time for the doing of a relevant act." ;
    tmk:upstreamRef "TMA1995/s224(7)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238> a tmk:LegislativeProvision ;
    rdfs:label "Disclaimers"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a2ea38b96fc145d29f77ed946697d58780c8ef38ea8250d7f6c6ddf45491ff8e" ;
    tmk:text "If the particulars entered in the Register under paragraph 207(2)(a) in respect of an existing registered mark include particulars of a disclaimer made (under section 32 of the repealed Act) by the registered proprietor of the mark about the exclusive right to use a specified part of the mark, that disclaimer has effect as if it were a disclaimer made under section 74 of this Act. Note: For existing registered mark see section 6." ;
    tmk:upstreamRef "TMA1995/s238" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s3> a tmk:LegislativeProvision ;
    rdfs:label "Act binds the Crown"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b59d192ac1003234082fff6706df6c8f073df55600fa16e16905888f89953427" ;
    tmk:text "(1) This Act binds the Crown in right of the Commonwealth, of each of the States, of the Australian Capital Territory and of the Northern Territory. (2) Nothing in this Act makes the Crown liable to be prosecuted for an offence." ;
    tmk:upstreamRef "TMA1995/s3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> ;
