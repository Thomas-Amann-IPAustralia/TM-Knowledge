        "2.2.1",
        "Part 15 General Provision for Extensions of Time",
        "Part 15.2. When the general provision does not apply" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part15/2> ;
    tmk:ordinal 4 ;
    tmk:partId "Part15" ;
    tmk:text "The time allowed for meeting minimum filing requirements (reg 4.2) - this act is prescribed by paragraph 21.28(1)(a)." ;
    tmk:upstreamRef "TMM/Part15/2/2/2/1" .

