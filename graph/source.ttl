    tmk:contentHash "sha256:f2fcf2214e169073658e200c97b2b8360427ab9117c0d8da0e79b7d76cd7f320" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Subsection (2) applies if:" ;
    tmk:upstreamRef "TMA1995/s239A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7e6263b5bd82df1b2722113c9868071c71d8b1a4c540e775fa4de9753070839e" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the same trade mark was registered before 1 January 1996 in respect of goods or services of different classes; and" ;
    tmk:upstreamRef "TMA1995/s239A(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:52fc7a67da2087cc5e252d1d6b079cc687957bfbff5528b1ab8398c288a25485" ;
    tmk:ordinal 3 ;
    tmk:text "(b) all the applications for the trade marks were lodged (or were taken under the repealed Act to have been lodged) on the same day with the Trade Marks Office; and" ;
    tmk:upstreamRef "TMA1995/s239A(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8e46fd1266609bda7c90626457f02c0b4654c00560f653c59c70de6d89a43784" ;
    tmk:ordinal 4 ;
    tmk:text "(c) the trade marks are registered trade marks for the purposes of this Act with the same registered owner." ;
    tmk:upstreamRef "TMA1995/s239A(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A(1)(c)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:26325cc811a4826f280d8d6b070712e21a6564b224d17cc256a6d1663dcd955f" ;
    tmk:ordinal 5 ;
    tmk:text "Note: For registered owner and registered trade mark see section 6." ;
    tmk:upstreamRef "TMA1995/s239A(1)(c)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:81648aba443f33d0c7f306d4eb28f6c5c8d69d022c65f24be3bff90f9363cafc" ;
    tmk:ordinal 6 ;
    tmk:text "(2) The registered owner may apply to the Registrar, in writing, to have those trade marks, or so many of those trade marks as are identified in the application, dealt with under this Act as if they were one registered trade mark in relation to the goods or services in respect of which the trade marks, or the identified trade marks, were registered." ;
    tmk:upstreamRef "TMA1995/s239A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f724e71c878eadf8cfbe092d8be31235fecfff3b4d5733e1e232f82b9d5ce65e" ;
    tmk:ordinal 7 ;
    tmk:text "(3) If an application is made under subsection (2), the Registrar must deal with the trade marks, or the identified trade marks, as if they were a single trade mark." ;
    tmk:upstreamRef "TMA1995/s239A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fcafc21b2b36299d8c1b904dd234ac7cda86680922ce9ccbd73eb35593c9a560" ;
    tmk:ordinal 8 ;
    tmk:text "(4) The date of registration of the single trade mark is taken to be the day on which the applications mentioned in paragraph (1)(b) were lodged, or were taken to have been lodged (as the case may be), with the Trade Marks Office under the repealed Act." ;
    tmk:upstreamRef "TMA1995/s239A(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s23~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s23> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:262692c0cc15d256559207973a8c120b6e7c4d60b30349c1f55081b8bc03647e" ;
    tmk:ordinal 1 ;
    tmk:text "If trade marks that are substantially identical or deceptively similar have been registered by more than one person (whether in respect of the same or different goods or services), the registered owner of any one of those trade marks does not have the right to prevent the registered owner of any other of those trade marks from using that trade mark except to the extent that the firstmentioned owner is authorised to do so under the registration of his or her trade mark." ;
    tmk:upstreamRef "TMA1995/s23~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s23~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s23> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:537418b6b46fbb13715796df377b37f0c06f46be0c58f068a8dfcc1774f56b30" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For deceptively similar see section 10." ;
    tmk:upstreamRef "TMA1995/s23~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0919e848d6282beedf4b53e321cb25eb80085b664c2e8826c21bf36086d8b654" ;
    tmk:ordinal 1 ;
    tmk:text "(1) This section applies if a registered trade mark consists of, or contains, a sign that, after the date of registration of the trade mark, becomes generally accepted within the relevant trade as the sign that describes or is the name of an article, substance or service." ;
    tmk:upstreamRef "TMA1995/s24(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:541d0c5721fa4fbdaca9edd9fd3d1602c12a8675a379c344e5a4744af1829958" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For registered trade mark, sign and date of registration see section 6." ;
