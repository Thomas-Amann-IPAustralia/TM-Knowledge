    tmk:contentHash "sha256:905dc28d81c8786fa4d8be28afacf1be3383911fb4aff53a05578c6bd46fcc93" ;
    tmk:ordinal 4 ;
    tmk:text "Note: For limitations see section 6." ;
    tmk:upstreamRef "TMA1995/s70(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s71(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s71> ;
