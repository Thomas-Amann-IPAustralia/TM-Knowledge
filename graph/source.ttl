    tmk:ordinal 16 ;
    tmk:text "Note 2: For goods of a person and services of a person see section 6." ;
    tmk:upstreamRef "TMA1995/s41(4)(b)(iii)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)(iii)~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f10afca72a1c5f25f8ddb44d860c82451d75e786238a20e0b93820e61c5b841f" ;
    tmk:ordinal 17 ;
    tmk:text "Note 3: Use of a trade mark by a predecessor in title of an applicant and an authorised use of a trade mark by another person are each taken to be use of the trade mark by the applicant (see subsections (5) and 7(3) and section 8)." ;
    tmk:upstreamRef "TMA1995/s41(4)(b)(iii)~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(5)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
