        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5ccc1008191e7dcfe05f1ad23579866a617e86f4ecf18085cafd8cf3a93be13c" ;
    tmk:ordinal 6 ;
    tmk:text "(2) Each of the following is a prohibited act:" ;
    tmk:upstreamRef "TMA1995/s121(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fdfb3a190056813c9a43dd9c369beb74ea631e124040e8ec7676232da3762a71" ;
    tmk:ordinal 16 ;
    tmk:text "(2) In spite of section 120, if a disclaimer has been registered in respect of a part of a registered trade mark, a person does not infringe the trade mark by using that part of the trade mark." ;
    tmk:upstreamRef "TMA1995/s122(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s123> a tmk:LegislativeProvision ;
    rdfs:label "Services to which registered trade mark has been applied by or with consent of registered owner"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:eadfbef73e0f96fb1f53d477116b7d2f6c44ba818aac48112141be6af31bc096" ;
    tmk:text "In spite of section 120, a person who uses a registered trade mark in relation to services that are similar to services in respect of which the trade mark is registered does not infringe the trade mark if the trade mark has been applied in relation to the services by, or with the consent of, the registered owner of the trade mark. Note: For similar services see subsection 14(2)." ;
    tmk:upstreamRef "TMA1995/s123" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s14(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b783926b9d6968e89b9c566562094096543f315eed17a41c24b008ebb382ba9e" ;
    tmk:text "(1) For the purposes of this Act, goods are similar to other goods:" ;
    tmk:upstreamRef "TMA1995/s14(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s14(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f37dac0e644707f421d956c24d61d1a2ac1cf48a56b02fd1f45a0176e5e6c00c" ;
    tmk:text "(2) For the purposes of this Act, services are similar to other services:" ;
    tmk:upstreamRef "TMA1995/s14(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153(2A)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4757be51058d62c07d28bc5c3dcff9d54ea9a31537c99ec1ecc54cb052c2f566" ;
    tmk:ordinal 11 ;
    tmk:text "(2A) Subsections (1) and (2) do not apply if the person has a reasonable excuse." ;
    tmk:upstreamRef "TMA1995/s153(2A)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s176(1A)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s176> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ee17bb5caf1a39f40d50f6375e9657aa3674cb0dbbf860be12bf3dc9d6f702a9" ;
    tmk:ordinal 6 ;
    tmk:text "(1A) However, the Registrar must give the applicant an opportunity to be heard before rejecting the application solely because one or both of the conditions in paragraphs (1)(a) and (b) are not met." ;
    tmk:upstreamRef "TMA1995/s176(1A)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s180(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s180> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e22031788e5dbbba51729d520fbb8db83ea05adc8977b197fa81af8fc980b151" ;
    tmk:ordinal 4 ;
    tmk:text "(4) An application may be made to the Administrative Review Tribunal for the review of a decision of the Commission refusing to give its consent." ;
    tmk:upstreamRef "TMA1995/s180(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s19(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s19> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b2b215091f3eb5b39952a39cc013bd20424c53c68315108154b77d4cfc4c269b" ;
    tmk:ordinal 5 ;
    tmk:text "(2) The registration of a trade mark may be in respect of goods or services of more than one class." ;
    tmk:upstreamRef "TMA1995/s19(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f134f1d6da807fe6e57538b51de55c7514dfb7aaf572973a756a9f251417a343" ;
    tmk:ordinal 8 ;
    tmk:text "(2) The registered owner of a trade mark has also the right to obtain relief under this Act if the trade mark has been infringed." ;
    tmk:upstreamRef "TMA1995/s20(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:59b43125b2b2470b521205ef7ef11d37fd64f7a12f054a8449905605584d95ca" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar must extend the time for doing a relevant act that is required by this Act to be done within a certain time if the act is not, or cannot be, done within that time because of an error or omission by:" ;
    tmk:upstreamRef "TMA1995/s224(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s23> a tmk:LegislativeProvision ;
    rdfs:label "Limitation on rights if similar trade marks etc. registered by different persons"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c993b5414f0ee7b9b8a74d6c35a6b2f1e454bb79c34451599c42f9bb23620644" ;
    tmk:text "If trade marks that are substantially identical or deceptively similar have been registered by more than one person (whether in respect of the same or different goods or services), the registered owner of any one of those trade marks does not have the right to prevent the registered owner of any other of those trade marks from using that trade mark except to the extent that the firstmentioned owner is authorised to do so under the registration of his or her trade mark. Note: For deceptively similar see section 10." ;
    tmk:upstreamRef "TMA1995/s23" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238> a tmk:LegislativeProvision ;
    rdfs:label "Disclaimers"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a2ea38b96fc145d29f77ed946697d58780c8ef38ea8250d7f6c6ddf45491ff8e" ;
    tmk:text "If the particulars entered in the Register under paragraph 207(2)(a) in respect of an existing registered mark include particulars of a disclaimer made (under section 32 of the repealed Act) by the registered proprietor of the mark about the exclusive right to use a specified part of the mark, that disclaimer has effect as if it were a disclaimer made under section 74 of this Act. Note: For existing registered mark see section 6." ;
    tmk:upstreamRef "TMA1995/s238" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s25C> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMA1995/s25C" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9123fcbfbf6f63496b26e8e2a76d3bcf923caba81c89b0af1d3c52bf5577d9ec" ;
    tmk:ordinal 5 ;
    tmk:text "(2) The Registrar may accept the application subject to conditions or limitations." ;
    tmk:upstreamRef "TMA1995/s33(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s37(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s37> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bccbd3541a3dff5119d39d44830ebe2b78d7580a4217cfe85915ac054351b2df" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Subject to subsection (2), an application lapses if it is not accepted within the prescribed period or within that period as extended in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s37(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6b05cf40143ff4b0306fd5ee1e609990715cad25de8702e021829db541728763" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Before a trade mark is registered, the Registrar may revoke the acceptance of the application for registration of the trade mark if he or she is satisfied that:" ;
    tmk:upstreamRef "TMA1995/s38(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6d857a2f8dfd65dcf6a0ee1a35e43de2c299f0c3e8f27450eb77b2eeb2171578" ;
    tmk:ordinal 1 ;
    tmk:text "(1) An application for the registration of a trade mark must be rejected if the trade mark contains or consists of a sign that, under regulations made for the purposes of section 18, is not to be used as a trade mark." ;
    tmk:upstreamRef "TMA1995/s39(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:418b7341613245ac66f8b5ac50884c94a475967eb554204df14063fed3e8ca41" ;
    tmk:ordinal 3 ;
    tmk:text "(a) a sign that is prescribed for the purposes of this subsection; or" ;
    tmk:upstreamRef "TMA1995/s39(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39(2)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ea65dddea62ae3f68e0c17606517ccf2a6fba3346e723a87fbbf31a0e6cea955" ;
    tmk:ordinal 5 ;
    tmk:text "(i) a sign referred to in paragraph (a); or" ;
    tmk:upstreamRef "TMA1995/s39(2)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s4A> a tmk:LegislativeProvision ;
    rdfs:label "Application of the Criminal Code"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d63d453edbb4825959acadd81555a8ac02ea80bd0f46b9095a1013ad9ab27a3e" ;
    tmk:text "Chapter 2 of the Criminal Code applies to all offences created by this Act. Note: Chapter 2 of the Criminal Code sets out the general principles of criminal responsibility." ;
    tmk:upstreamRef "TMA1995/s4A" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s53A> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMA1995/s53A" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s53B> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMA1995/s53B" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s57> a tmk:LegislativeProvision ;
    rdfs:label "Registration may be opposed on same grounds as for rejection"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7d96040fe733aa71f150167fca312e0da763a447fea92573099c4cf4d2059b73" ;
    tmk:text "The registration of a trade mark may be opposed on any of the grounds on which an application for the registration of a trade mark may be rejected under this Act, except the ground that the trade mark cannot be represented graphically. Note: For this Act see section 6." ;
    tmk:upstreamRef "TMA1995/s57" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b3f780a1a08049ffb53cfbb89a945139bc3881265c54308848e0b464c09bc535" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The registration of a trade mark in respect of particular goods (relevant goods) may be opposed on the ground that the trade mark contains or consists of a sign that is a geographical indication for goods (designated goods) originating in:" ;
    tmk:upstreamRef "TMA1995/s61(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a4ce47e4490aa714242baa6ec96b707cd2b3d224f1e879cc086b6a5e0c7cd1ea" ;
    tmk:ordinal 5 ;
    tmk:text "(2) An opposition on a ground referred to in subsection (1) fails if the applicant establishes that:" ;
    tmk:upstreamRef "TMA1995/s61(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:381a10de4b87315e559f3f42fee2426a537bf1f2aa26d7a4f25fd295361cce3c" ;
    tmk:ordinal 17 ;
    tmk:text "(4) An opposition on a ground referred to in subsection (1) also fails if the applicant establishes that:" ;
    tmk:upstreamRef "TMA1995/s61(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s62(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ce73122c533b781c857bd1503760879998b45b9e8adb03d6868ec55dc3270b60" ;
    tmk:text "(a) that the application, or a document filed in support of the application, was amended contrary to this Act;" ;
    tmk:upstreamRef "TMA1995/s62(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s62(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3027a0b9af7fffb7d30595cad7516f31fc0ef46f2dd6ec94b6963bac8806a057" ;
    tmk:text "(b) that the Registrar accepted the application for registration on the basis of evidence or representations that were false in material particulars." ;
    tmk:upstreamRef "TMA1995/s62(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1fea24cce70104883746f85f981e4f762e2a9341dfdf20724ebf659f6c3583da" ;
    tmk:ordinal 3 ;
    tmk:text "(3) An amendment may be made to an application to which section 51 applies to remove one or more trade marks from the application." ;
    tmk:upstreamRef "TMA1995/s65(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:86a28c43974a39d74a1d79dc67c1af7b84f14118f1c0d4eb207fa5278ccfc430" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If the Registrar or a prescribed court, having regard to the circumstances of a particular case, thinks fit, the Registrar or the court may decide that a person has used a trade mark if it is established that the person has used the trade mark with additions or alterations that do not substantially affect the identity of the trade mark." ;
    tmk:upstreamRef "TMA1995/s7(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e6f695490bf91eb12cafd312bb60c419b6baf84f8378c8aa27c5c47239f7d1da" ;
    tmk:ordinal 3 ;
    tmk:text "(2) To avoid any doubt, it is stated that, if a trade mark consists of the following, or any combination of the following, namely, any letter, word, name or numeral, any aural representation of the trade mark is, for the purposes of this Act, a use of the trade mark." ;
    tmk:upstreamRef "TMA1995/s7(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:11a54d049634bbebdee3a3bcf37340cabcfffb3cc65616749ca6fee434e0ad9a" ;
    tmk:ordinal 4 ;
    tmk:text "(3) An authorised use of a trade mark by a person (see section 8) is taken, for the purposes of this Act, to be a use of the trade mark by the owner of the trade mark." ;
    tmk:upstreamRef "TMA1995/s7(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2793583dea31c16504e8e5958859642c3e2c134149d9fefb20f8e411eb368e01" ;
    tmk:ordinal 11 ;
    tmk:text "(3) Unless it is earlier cancelled, or the trade mark is earlier removed from the Register, the registration of the trade mark expires 10 years after the filing date in respect of the application for its registration." ;
    tmk:upstreamRef "TMA1995/s72(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(8)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:575e76c2862abdf0219b9902f14046838bf53edfdb052a727a3241d3fd9c539c" ;
    tmk:ordinal 25 ;
    tmk:text "(8) The registered owner who made the request for amendment, or a person who opposes the request under subsection (4), may appeal to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) from a decision of the Registrar under this section." ;
    tmk:upstreamRef "TMA1995/s83A(8)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c3235b6444c1c8ce1018267439e64384f0f8270ff2ba4efbbb572012d00aa271" ;
    tmk:ordinal 23 ;
    tmk:text "(5) If the right or interest on which a person relied to make a nonuse application becomes vested in another person, the other person may, on giving notice of the relevant facts to the Registrar or the court (as the case requires), be substituted for the firstmentioned person as the applicant." ;
    tmk:upstreamRef "TMA1995/s92(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s93(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s93> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f7fda6ae88c3d6d675d97bfaccd8fce254b590a2dd5223b36e1643eda654faa5" ;
    tmk:ordinal 3 ;
    tmk:text "(2) A nonuse application on the ground mentioned in paragraph 92(4)(b) may only be made after a period of 3 years beginning from the date the particulars of the trade mark were entered into the Register under section 69." ;
    tmk:upstreamRef "TMA1995/s93(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part10/x-introduction%231> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s31>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(3)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8> ;
    tmk:contentHash "sha256:52689ba4ba521ede128afc7e830693aca9f3b2fddc5c2815d98736bea000f161" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part10/x-introduction%231/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part10/x-introduction%231/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part10/x-introduction%231/prov/2>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part10/x-introduction%231/prov/3> ;
    tmk:headingPath "10. Introduction",
        "Part 10 Details of Formality Requirements" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part10/x-introduction> ;
    tmk:ordinal 1 ;
    tmk:partId "Part10" ;
    tmk:text "Federal Register of Legislation - Trade Marks Regulations 1995 Federal Register of Legislation - Trade Marks Act 1995 As part of the examination of an application for registration of a trade mark, carried out under section 31, the Registrar must report on whether or not the application has been made in accordance with the Act. If the Registrar reasonably believes that the application has not been made in accordance with the Act or Regulations, the Registrar must report that belief in writing to the applicant (reg 4.8). If any reported deficiencies are not corrected, the application must be rejected under sub-section 33(3). As soon as possible after an application for registration of a trade mark is received, a check is made to ensure that the application meets minimum filing requirements which allow it to be taken as filed (reg 4.2). However, the check for compliance with minimum filing requirements does not cover all formality requirements which are dealt with later as part of the examination process. Part 3 Filing Requirements for a Trade Mark Application - 6. The minimum filing requirements The following are the formality matters which must be considered by the person carrying out the examination." ;
    tmk:upstreamRef "TMM/Part10/x-introduction#1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1/1/4> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(2)(b)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.28>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.5> ;
    tmk:contentHash "sha256:755f78fffb8fe495136ac30d28eb8cb15ccb61b09c6ae0778ca3fae35697f2ba" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/4/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/4/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/4/prov/2>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/4/prov/3> ;
    tmk:headingPath "1. Applications in Australia (convention applications) where the applicant claims a right of priority on the basis of an application in a Convention country",
        "1.4 Timing of the application and claim for priority",
        "Part 11 Convention Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1> ;
    tmk:ordinal 5 ;
    tmk:partId "Part11" ;
    tmk:text "A convention application should be filed within six months after the day on which the application was made in the Convention country (subsection 29(1)). If applications for the trade mark have been filed in respect of particular goods and/or services in more than one Convention country, the application in Australia must be filed within six months after the day on which the earliest of the earlier applications was made (paragraph 29(2)(b)). When calculating the six months, the day the earlier application was made in the Convention country is not included in the calculation. That is, if the application was filed in a Convention country on 1 February 2007, the application in Australia must be filed by close of business on 1 August 2007. If the last day of the period is an official holiday, or a day when the Office is not open for the filing of applications the period is extended until the next working day (Paragraph C(3) of Article 4 of the Paris Convention). The claim for the right of priority must be made within two working days of the application being filed in Australia (subsection 29(1) and reg 4.5). This period and the 6 month period allowed from filing an application in a Convention country for filing in Australia, are both non-extendible periods of time (reg. 21.28 (1)(aa) and (b))." ;
    tmk:upstreamRef "TMM/Part11/1/1/4" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7> a tmk:Page ;
    rdfs:label "Part 11.7. Effect on registration of a claim for priority based on an earlier application"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a48b5c4c1e9407e8e5f0ad9ecf232e72850c415be047c141a2fec4935363935d" ;
    tmk:lastAmended "2025-01-13" ;
    tmk:partId "Part11" ;
    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/7.-effect-on-registration-of-a-claim-for-priority-based-on-an-earlier-application"^^xsd:anyURI ;
    tmk:upstreamRef "TMM/Part11/7" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/2%231> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s42>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:contentHash "sha256:1ccc40ab4041240f3a3d63e4f7f80b9d744ddccc90bfc04c08476f64a96584da" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/2%231/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/2%231/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/2%231/prov/2>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/2%231/prov/3> ;
    tmk:headingPath "2. Why file a divisional application?",
        "Part 12 Divisional Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/2> ;
    tmk:ordinal 1 ;
    tmk:partId "Part12" ;
    tmk:text "An applicant may choose to file a divisional application for several reasons including, but not limited to, the following: if the goods/services of the parent application conflict with another trade mark application or registration, the applicant may decide to exclude the conflicting goods/services from the parent application so that the parent application can proceed to acceptance; or similarly, if only some of the goods/services of the parent application have attracted a ground for rejection under sections 39, 41, 42 or 43, the applicant may decide to exclude the goods/services which have attracted the ground(s) for rejection from the parent application, so that the parent application can proceed to acceptance; or if an opposition is filed or threatened, the applicant may also decide to exclude the conflicting goods/services to allow the parent application to proceed to registration. In any of the above cases the applicant may decide to file a divisional application for goods/services which are to be excluded from the parent application. The parent application must be pending at the time the divisional application is filed and the goods/services of the divisional application must still be present in the parent application at the time of filing. If submissions are received requesting the deletion of certain goods/services from an application that also state that a divisional application is to be filed from that application, any deletion or amendment to the specification of goods/services should be delayed until the divisional application has been filed. Premature deletion or amendment of the goods/services of the parent may invalidate a subsequent divisional application. The goods/ services to remain in the parent must be nominated as part of the filing of the divisional application." ;
    tmk:upstreamRef "TMM/Part12/2#1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/2%231~2> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(3)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)(a)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)(b)> ;
    tmk:contentHash "sha256:ec6d0ba53bf6509673069081fdda71bf373a6af5818fe6a8e643bd63088c0c49" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/2%231~2/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/2%231~2/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/2%231~2/prov/2>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/2%231~2/prov/3> ;
    tmk:headingPath "13.2. Material Particulars",
        "Part 13 Application to Register a Series of Trade Marks" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/2> ;
    tmk:ordinal 2 ;
    tmk:partId "Part13" ;
    tmk:text "Typically, each trade mark in a series will consist of [shared identifying features, comprising the material particulars] + [allowable differences]. As a result, it is usually appropriate to focus on the shared elements when assessing the resemblance of material particulars. This approach may apply even where the identifying element is of low distinctiveness. For example: BETTA SHOES; BETTA BOOTS on Class 25: shoes, is a valid series. BETTA is the first word in each trade mark, followed by a purely descriptive word identifying the claimed goods (an allowable difference under paragraph 51(1)(a)). The word order follows a familiar [brand][product] format. Consumers are likely to rely heavily on the first word BETTA as an identifying element (rather than SHOES or BOOTS). Therefore, the trade marks resemble each other in material particulars. (For clarity, this assessment is separate to, and does not affect the application of, section 41. A section 41(3) ground for rejection would arise against each trade mark in this series.) However, the effect of any differences between trade marks must be considered in the context of the trade marks as a whole. Even if the differences are of a kind allowed under paragraphs 51(1)(a), (b) or (c), the differences may be such that the material particulars can no longer be considered the same. The following are examples of invalid series that do not resemble each other in material particulars, because the differences change the prominence or effect of a shared word. Example 1. SNEAKER and NINETY-NINE SNEAKER, on Class 25: shoes. The marks share SNEAKER, while NINETY-NINE is a statement as to number (an allowable difference under paragraph 51(1)(b)). SNEAKER is the identifying feature of the first mark. However, for the second mark, consumers are likely to rely on the first and less descriptive word NINETY-NINE to recognise or recall it, rather than the last word SNEAKER, which directly describes the goods. Therefore, the trade marks do not resemble each other in material particulars. Example 2. SUN and SUNBLOCK, on Class 28: toy building blocks. The marks share SUN, while BLOCK is a statement as to the goods (an allowable difference under paragraph 51(1)(a))." ;
    tmk:upstreamRef "TMM/Part13/2#1~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/8%231> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesPassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/1> ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(3)> ;
    tmk:contentHash "sha256:7b375955f5741919b319ff221a96f85ce9b78ba328ccbe8e954e0d7f9701495d" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/8%231/internal/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/8%231/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/8%231/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/8%231/prov/2> ;
    tmk:headingPath "13.8. Divisional Applications from Series",
        "Part 13 Application to Register a Series of Trade Marks" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/8> ;
    tmk:ordinal 1 ;
    tmk:partId "Part13" ;
    tmk:text "Trade Marks Act 1995 Trade Mark Regulations 1995 A divisional application may be made in respect of a series application, in accordance with the general divisional provisions. Part 12 Divisional Applications A divisional of a series application must be filed in respect of all of the same trade marks in the parent application, in order to meet the requirements of section 46(1) (i.e. divisional validity). That is, the trade marks in the parent and child, when the divisional application is filed, must be identical. If the parent or child contains an invalid series, the applicant may resolve this problem by removing trade marks from the parent and/or the child pursuant to section 65(3), in order to meet the requirements of section 51(1). An amendment to the trade marks in one application has no effect on options available in respect of the other. The compliance of the divisional with the requirements of section 51(1) will depend on the marks contained within the series and the goods/services that form part of the divisional (which will be some only of the goods/services of the parent). The divisional should be reassessed against the requirements of section 51(1) at examination, to ensure the series remains valid for the goods/services included in the divisional." ;
    tmk:upstreamRef "TMM/Part13/8#1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part14/3> a tmk:Page ;
    rdfs:label "3. Requirement for a clear specification and for correct classification"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f0358d1ea76cb617b1ddb565f20f1dce608d2efbdc0ed2dc1f35266c8af78b06" ;
    tmk:lastAmended "2024-04-05" ;
    tmk:partId "Part14" ;
    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/3.-requirement-for-a-clear-specification-and-for-correct-classification"^^xsd:anyURI ;
    tmk:upstreamRef "TMM/Part14/3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part14/6/6/4/1> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesPassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part27/3> ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:contentHash "sha256:23585289974e9cf2e37585163c1a57cfb49a30cfddc5a4615575a5178394161d" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part14/6/6/4/1/internal/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part14/6/6/4/1/internal/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part14/6/6/4/1/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part14/6/6/4/1/prov/1> ;
    tmk:headingPath "14.6. Wording of the specification",
        "6.4 Wording of exclusions and restrictions",
        "6.4.1",
        "Part 14 Classification of Goods and Services" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part14/6> ;
    tmk:ordinal 12 ;
    tmk:partId "Part14" ;
    tmk:text "Exclusions in a specification are intended to exclude items which would otherwise fall within the specification claimed. This is usually done in order to overcome grounds for rejection. For example if there are grounds for rejection under section 44 the applicant may seek to exclude items from the specification which are the same as, or similar to, the goods or services of the cited application. Goods or services may also be excluded to overcome an objection under section 41 by removing from the specification those items which the trade mark is not capable of distinguishing. Part 27 Overcoming Grounds for Rejection Under Section 44 - 2.2 Excluding goods or services from the application Part 23 Overcoming Grounds for Rejection under Section 41 – 2.2" ;
    tmk:upstreamRef "TMM/Part14/6/6/4/1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part14/6/6/5> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:contentHash "sha256:6ae3732c6b78e2cff9f4881917dfe2f3e807dbd9b55159512f42ed0d70a68e48" ;
    tmk:headingPath "14.6. Wording of the specification",
        "6.5 Claims for class headings",
        "Part 14 Classification of Goods and Services" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part14/6> ;
    tmk:ordinal 16 ;
    tmk:partId "Part14" ;
    tmk:text "Claims for the current class headings are acceptable in their entirety, as are claims for self-contained parts of the class headings. For example, based on the class heading for class 42 which includes industrial analysis, industrial research and industrial design services; a claim for industrial research services would be acceptable in class 42. A claim for research services would not be acceptable." ;
    tmk:upstreamRef "TMM/Part14/6/6/5" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part15/2/2/1/1> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34K>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48T>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.15>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.18> ;
    tmk:contentHash "sha256:939814f7ee1ed39f7dec3367e28d556cf14fcbdbcb58ac4ab5e2615e99fb2dae" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/2/2/1/1/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/2/2/1/1/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/2/2/1/1/prov/2>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/2/2/1/1/prov/3> ;
    tmk:headingPath "2.1 Times, for doing of prescribed acts and the filing of prescribed documents, which are extendible",
        "2.1.1",
        "Part 15 General Provision for Extensions of Time",
        "Part 15.2. When the general provision does not apply" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part15/2> ;
    tmk:ordinal 2 ;
    tmk:partId "Part15" ;
    tmk:text "Times for filing evidence (paragraph 21.28(1)(f)) in oppositions to registration/extension of protection and to removal/cessation of protection for non-use are extendible in the circumstances set out in regs 5.15, 9.18, 17A.34K and 17A.48T. Part 51 General Opposition Proceedings - 2. Extension of the period for filing evidence" ;
    tmk:upstreamRef "TMM/Part15/2/2/1/1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part15/6%231> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224(2)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224(5)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.20A>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.20G> ;
    tmk:contentHash "sha256:d249d96635c0ce884b442b0339d379ec0f9ab15dfb9fe385d83b63de23d217b6" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/6%231/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/6%231/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/6%231/prov/2>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/6%231/prov/3> ;
    tmk:headingPath "15.6. Extensions of time of more than three months",
        "Part 15 General Provision for Extensions of Time" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part15/6> ;
    tmk:ordinal 1 ;
    tmk:partId "Part15" ;
    tmk:text "Applications for extensions of time of more than three months under subsections 224(2) or (3) must be published for opposition (subsections 224(5) and (6) and regs 21.20A to 21.20G). The Registrar is required to publish the application whether or not he or she intends to allow the extension and no preliminary decision will be made prior to publication." ;
    tmk:upstreamRef "TMM/Part15/6#1" .

