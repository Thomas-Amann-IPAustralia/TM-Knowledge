    tmk:ordinal 5 ;
    tmk:text "(b) be accompanied by a declaration stating the facts and circumstances forming the basis for the grounds for making the application." ;
    tmk:upstreamRef "TMR1995/r5.13A(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13A(3)(b)~1> a tmk:LegislativeUnit ;
