    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8e741a9d0c0cd77d1b8c839213aaf6273029fbfabd2ce544fef8a78fb045002b" ;
    tmk:ordinal 15 ;
    tmk:text "Note: If the Registrar makes a decision to revoke the acceptance of the IRDA, the IRDA is taken never to have been accepted: see subregulation 17A.27(2)." ;
    tmk:upstreamRef "TMR1995/r17A.36(d)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36/appeal-period> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36> ;
