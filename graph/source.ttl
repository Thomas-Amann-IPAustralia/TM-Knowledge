    tmk:ordinal 3 ;
    tmk:text "(b) if the Registrar has a discretionary power in relation to the award of costs—as the Registrar considers appropriate." ;
    tmk:upstreamRef "TMR1995/r21.13(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.13(2)> a tmk:LegislativeUnit ;
