    tmk:ordinal 14 ;
    tmk:text "(a) the extent to which the amendment relates to the inconsistency; and" ;
    tmk:upstreamRef "TMA1995/s83A(5)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(5)(b)> a tmk:LegislativeUnit ;
