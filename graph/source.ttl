    tmk:contentHash "sha256:5f8ee212d9c278a80e5c8c418e99df489b8dd6c93ce4fe3a447b02125a36b092" ;
    tmk:ordinal 9 ;
    tmk:text "(b) circumstances beyond the control of the person, other than an error or omission by the person, the person’s agent, the Registrar or an employee." ;
    tmk:upstreamRef "TMR1995/r5.13A(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13B(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13B> ;
