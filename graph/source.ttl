    tmk:ordinal 3 ;
    tmk:text "Note 2: See section 34AB of the Acts Interpretation Act 1901 about the effect of this subsection." ;
    tmk:upstreamRef "TMA1995/s206(1)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dda76e14d00e5c7067241ea35a191c1354bb113daab6b439ccae21efd235b860" ;
    tmk:ordinal 4 ;
    tmk:text "(2) A delegate must, if so required by the instrument of delegation, exercise or perform a delegated power or function under the direction or supervision of:" ;
    tmk:upstreamRef "TMA1995/s206(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:34a2f862124be116566e51455c60206e63fa4a6f058a4364a26644a0f67245a3" ;
    tmk:ordinal 5 ;
    tmk:text "(a) the Registrar; or" ;
    tmk:upstreamRef "TMA1995/s206(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206> ;
