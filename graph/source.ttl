    tmk:ordinal 3 ;
    tmk:text "(b) the words ‘To counterfeit this is a forgery’, or words to the same effect;" ;
    tmk:upstreamRef "TMR1995/r4.15(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15(d)> a tmk:LegislativeUnit ;
