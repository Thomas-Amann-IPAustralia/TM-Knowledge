    tmk:contentHash "sha256:c26144ee2278a3325f72f8392876581075fc71a8a33497aa0ce7358be2b0a134" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part17/2/2/1/internal/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part17/2/2/1/prov/0>,
