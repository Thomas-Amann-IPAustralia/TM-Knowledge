    tmk:contentHash "sha256:ef052f8e77b44f08a73633367247d00c17a2335b8c5b07d235b63db33fb92dc4" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the application to assign or transmit the trade mark is withdrawn; or" ;
    tmk:upstreamRef "TMR1995/r10.5(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r10.5(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r10.5> ;
    tmk:authorityKind "law" ;
