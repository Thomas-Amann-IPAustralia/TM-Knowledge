    tmk:ordinal 4 ;
    tmk:text "(ii) a trade mark whose registration in respect of similar goods or closely related services is being sought by another person; and" ;
    tmk:upstreamRef "TMA1995/s44(1)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
