    tmk:ordinal 25 ;
    tmk:text "(b) if section 43 of the repealed Act applied to the application and the Registrar had made the proper direction—the day on which the application is to be taken to have been lodged with the Trade Marks Office under the repealed Act." ;
    tmk:upstreamRef "TMA1995/s241(5)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
