    tmk:ordinal 8 ;
    tmk:text "(d) if an application to register the trade mark was made in only one Convention country—from (and including) the day on which the application was made in that country; or" ;
    tmk:upstreamRef "TMA1995/s72(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4f22b679aeef1d2f847996ae0718f8f24842698a2645325d683bdf81780eb7f1" ;
    tmk:ordinal 9 ;
    tmk:text "(e) if applications to register the trade mark were made in more than one Convention country—from (and including) the day on which the earliest of those applications was made." ;
    tmk:upstreamRef "TMA1995/s72(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(e)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72> ;
