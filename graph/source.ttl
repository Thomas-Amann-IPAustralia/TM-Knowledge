    tmk:ordinal 3 ;
    tmk:text "(b) in a case where there has been an opposition:" ;
    tmk:upstreamRef "TMA1995/s68(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s68(1)(b)(i)> a tmk:LegislativeUnit ;
