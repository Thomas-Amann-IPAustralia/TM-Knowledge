    tmk:contentHash "sha256:5e8b0f64894287cbda51494eace64c248d8fb88a26f4077e2613ef92685721ed" ;
    tmk:ordinal 11 ;
    tmk:text "Note 2: For file, registered owner and this Act see section 6." ;
    tmk:upstreamRef "TMA1995/s88(2)(e)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88A~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8218caeb3095ef01ffe4fdf07b2af2b1465008f884ce01462038e78a14de4941" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar must not make an application under section 86, 87 or 88 unless he or she considers the application desirable in the public interest." ;
    tmk:upstreamRef "TMA1995/s88A~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8> ;
