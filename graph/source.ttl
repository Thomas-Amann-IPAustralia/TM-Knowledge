    tmk:upstreamRef "TMR1995/r5.9(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.2~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:be71fe055fd619442dddba7eee7b34427fc7efc13075d596012c8acd691e52e0" ;
    tmk:ordinal 1 ;
    tmk:text "For the purposes of paragraph 64(b) of the Act (which deals with amendments before publication), the period for requesting an amendment is 14 days after filing the application for the registration of the trade mark." ;
    tmk:upstreamRef "TMR1995/r6.2~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.6(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.6> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9b95c24b18d4f0787459271deb56332cbbcd26837c4465b162adc4c028434029" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For subsection 65A(4) of the Act, a person may oppose a request for amendment by filing a notice of opposition, in an approved form, within one month from the publication of the request for the amendment in a computer database maintained by the Trade Marks Office in accordance with regulation 6.3A." ;
    tmk:upstreamRef "TMR1995/r6.6(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.6(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.6> ;
