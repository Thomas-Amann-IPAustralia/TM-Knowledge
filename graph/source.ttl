    tmk:contentHash "sha256:3f5cace18faa7f95771f32e2b4ae3d9a140fc97ae0253bf3756ba64601ccf335" ;
    tmk:ordinal 6 ;
    tmk:text "(3) The report must include:" ;
    tmk:upstreamRef "TMR1995/r17A.16(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c0be3ab7b5411a885fca75976c8a0a56d5dc108bbaa4ce89f6d7b96c0311cd3c" ;
    tmk:ordinal 7 ;
    tmk:text "(a) notice of the date by which the Registrar must notify his or her final decision on examination to the International Bureau; and" ;
    tmk:upstreamRef "TMR1995/r17A.16(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2ac92ea3c6495e6e222f5e952abbef34e75b8a6aec61de9f17a2e9a21a03901a" ;
    tmk:ordinal 8 ;
    tmk:text "(b) notice that the Registrar is not required to consider any response by the holder to the report unless the holder has notified the Registrar, in writing, of the holder’s address for service in Australia or New Zealand." ;
    tmk:upstreamRef "TMR1995/r17A.16(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(3)(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:49ebfc8690dfc7e55132a78afe76129f664c51c1c5f98d3569005cf8119a0d22" ;
    tmk:ordinal 9 ;
    tmk:text "Note: Under the Protocol, protection must be extended in Australia to a trade mark that is the subject of an IRDA at the end of 18 months after the International Bureau notifies the Trade Marks Office of the IRDA unless, before then, the International Bureau receives:" ;
    tmk:upstreamRef "TMR1995/r17A.16(3)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(3)(b)~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5f57775ceb4caed60a6839134dbf8c93a904e1d330f7c9b93485682e503e9f6f" ;
    tmk:ordinal 10 ;
    tmk:text "(a) notification of a provisional or final refusal from the Trade Marks Office; or" ;
    tmk:upstreamRef "TMR1995/r17A.16(3)(b)~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(3)(b)~1~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:387a1b2d5f8e5cbc306da568ee9fde341bd37586bc845bbfc22f363f8877f4d0" ;
    tmk:ordinal 11 ;
    tmk:text "(b) notification of the possibility that oppositions may be filed after the 18month period." ;
    tmk:upstreamRef "TMR1995/r17A.16(3)(b)~1~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d67811d615085da07d4fef90c4b70b3f8e5468d88580fa1a1826fa455deaf916" ;
    tmk:ordinal 4 ;
    tmk:text "the Registrar must send a report in accordance with rule 17 of the Madrid Regulations to the holder through the intermediary of the International Bureau." ;
    tmk:upstreamRef "TMR1995/r17A.16~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:25276fdedb4297de72ce048349019882eddc6d57c94bb75b88e0b6cb813ffa12" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The holder of the IRDA may respond in writing to the Registrar’s report under regulation 17A.16." ;
    tmk:upstreamRef "TMR1995/r17A.17(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:478bf6e1246e1b07e041fcf08e385c73da57cdbff9af17f2901015bc7132ba2d" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The response may do any of the following:" ;
    tmk:upstreamRef "TMR1995/r17A.17(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d6b8832483de6892c70022d924195526f2882bced04a7c5c2b4d583f0626b69b" ;
    tmk:ordinal 3 ;
    tmk:text "(a) contest a belief of the Registrar that is expressed in the report;" ;
    tmk:upstreamRef "TMR1995/r17A.17(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17(2)(b)> a tmk:LegislativeUnit ;
