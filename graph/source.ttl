    tmk:contentHash "sha256:641c6701936c55f535574c0640143c38213374936660b53b957fec91026aa25b" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A nonuse application on the ground mentioned in paragraph 92(4)(a) may be made at any time after the filing date in respect of the application for the registration of the trade mark." ;
    tmk:upstreamRef "TMA1995/s93(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s93(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s93> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d4917d11e2e22e95b75b8cc0f0a5e6644cdebed09fb0bdc0b2a190f0c2a53e4b" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For filing date see section 6." ;
    tmk:upstreamRef "TMA1995/s93(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s93(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s93> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b8366d40e9269101057f12b9bf4324ca2a36aea7815af9eecabd76fbb263e447" ;
    tmk:ordinal 4 ;
    tmk:text "Note: The registration of a trade mark is taken to have effect earlier than the date the particulars of the trade mark are entered into the Register (see sections 72 and 239A)." ;
    tmk:upstreamRef "TMA1995/s93(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s94(a)> a tmk:LegislativeUnit ;
