    tmk:contentHash "sha256:3c715e1c7769fdfb5240ce9a1ebb856548b2bc5105fa6419d5ac1d8ec4325d61" ;
    tmk:ordinal 5 ;
    tmk:text "(3) Subject to subsection (5), the Registrar must publish the request for the amendment in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s65A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(4)> a tmk:LegislativeUnit ;
