    tmk:ordinal 16 ;
    tmk:text "Note: For limitations see section 6." ;
    tmk:upstreamRef "TMA1995/s102(d)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fb965860af7b9f0e6762d31f9a22c3c1fdcffc91371c76563352cdccd3d54842" ;
    tmk:ordinal 13 ;
    tmk:text "the Registrar may decide, or the court may order, that the challenged trade mark should not be removed from the Register but that the registration of the trade mark should be subject to the conditions or limitations that the Registrar or the court considers necessary to ensure that the registration does not extend to the use of the trade mark in relation to:" ;
    tmk:upstreamRef "TMA1995/s102~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s104~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s104> ;
