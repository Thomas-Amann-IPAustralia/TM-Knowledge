    tmk:ordinal 3 ;
    tmk:text "(3) Subregulation (4) applies if a person asks the Registrar, under section 79 of the Act, to renew the registration of a trade mark after it expires." ;
    tmk:upstreamRef "TMR1995/r21.21(3)" .

