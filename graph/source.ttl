    tmk:ordinal 2 ;
    tmk:text "(2) In particular (but without limiting subsection (1)), the regulations may deal with the following matters:" ;
    tmk:upstreamRef "TMA1995/s189A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s189A(2)(a)> a tmk:LegislativeUnit ;
