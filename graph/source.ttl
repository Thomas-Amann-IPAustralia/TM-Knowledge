    tmk:ordinal 15 ;
    tmk:text "(b) the time of production of goods or of the rendering of services." ;
    tmk:upstreamRef "TMA1995/s41(4)(b)(iii)~1~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)(iii)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
