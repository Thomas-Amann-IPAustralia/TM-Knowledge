    tmk:contentHash "sha256:61c78528728dfc13c93c66af5352a476e030a3a94f763e87d11854698419ca37" ;
    tmk:ordinal 9 ;
    tmk:text "would be extended for more than 6 months after the end of the relevant period prescribed in subregulation (1)." ;
    tmk:upstreamRef "TMR1995/r4.12~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.12~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.12> ;
