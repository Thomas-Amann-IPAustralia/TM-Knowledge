    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ef83d96affb59b94a31116795de22490ba403c6dded9a571393cac963c730b4c" ;
    tmk:ordinal 14 ;
    tmk:text "(7) If the Registrar makes a decision in any of the circumstances mentioned in subregulation (5), the Registrar must notify each party of the Registrar’s decision." ;
    tmk:upstreamRef "TMR1995/r21.15(7)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16> ;
