    tmk:ordinal 6 ;
    tmk:text "(b) amend the particulars entered in the Register in respect of the trade mark to remove or substitute any or all of the particulars." ;
    tmk:upstreamRef "TMA1995/s83A(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(3)> a tmk:LegislativeUnit ;
