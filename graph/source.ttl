    tmk:ordinal 2 ;
    tmk:text "(a) if there has been no opposition to the registration; or" ;
    tmk:upstreamRef "TMA1995/s68(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s68(1)(b)> a tmk:LegislativeUnit ;
