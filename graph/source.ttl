    tmk:ordinal 9 ;
    tmk:text "(a) notifies the Registrar that the person does not want to be heard; or" ;
    tmk:upstreamRef "TMR1995/r21.15(5)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(5)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15> ;
