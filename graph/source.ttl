    tmk:ordinal 4 ;
    tmk:text "(b) contest another matter that is mentioned in the report; and" ;
    tmk:upstreamRef "TMR1995/r4.9(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9(2)(c)> a tmk:LegislativeUnit ;
