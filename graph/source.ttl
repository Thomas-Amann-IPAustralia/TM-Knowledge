    tmk:ordinal 7 ;
    tmk:text "Otherwise, the application for the registration of the trade mark lapses." ;
    tmk:upstreamRef "TMA1995/s68~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s68~1~1> a tmk:LegislativeUnit ;
