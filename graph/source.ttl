    tmk:contentHash "sha256:5c8c9bb05fcd5bb6c170f3f686d202af9677d878031dfff2dea7ff810b98a26e" ;
    tmk:ordinal 13 ;
    tmk:text "(3) An offence under this section is an offence of strict liability." ;
    tmk:upstreamRef "TMA1995/s153(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153> ;
