    tmk:contentHash "sha256:e993dfd5ba0c11113766f4783b133c5428aa6516ffc7b9c60ecfe37d20cf8dad" ;
    tmk:ordinal 3 ;
    tmk:text "(b) amend any particulars entered in the Register relating to any goods or services in respect of which the trade mark is registered if the amendment does not have the effect of extending the rights that (apart from the amendment) the owner has under the registration; or" ;
    tmk:upstreamRef "TMA1995/s83(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f13c69491ad15be2eb00899896fda8e7f41fba7738753862116c530e45b15c14" ;
    tmk:ordinal 4 ;
    tmk:text "(c) amend, or enter in the Register, any other particular in respect of the trade mark if the amendment or entry does not have the effect of extending the rights that (apart from the amendment or entry) the owner has under the registration." ;
    tmk:upstreamRef "TMA1995/s83(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83(1)(c)~1> a tmk:LegislativeUnit ;
