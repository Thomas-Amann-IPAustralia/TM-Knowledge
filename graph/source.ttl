    tmk:ordinal 1 ;
    tmk:text "(1) If:" ;
    tmk:upstreamRef "TMR1995/r21.7(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.7(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.7> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c3231ea3de840ab0dc6a187dfc4130fe645c28d6e7571a4661101945d13c7846" ;
    tmk:ordinal 2 ;
    tmk:text "(a) a person is required by the Act or these regulations to file a declaration or serve a copy of the declaration; and" ;
    tmk:upstreamRef "TMR1995/r21.7(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.7(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.7> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:60ebf84c593a51b944c5a0e9bac85ac3cc8f5e8047a05333933bc732799cfac9" ;
    tmk:ordinal 3 ;
    tmk:text "(b) it is not practicable to include in, or attach to, the declaration or copy any material to which the declaration refers;" ;
    tmk:upstreamRef "TMR1995/r21.7(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.7(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.7> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c8a3a30fcfdd8ad29769910b7eaae4f9d8f1ec9636495df3e07bd0064341cfe3" ;
    tmk:ordinal 5 ;
    tmk:text "(2) A declaration is not taken to have been filed or served until any material to which the declaration refers, or any copy of the material, is filed or served." ;
    tmk:upstreamRef "TMR1995/r21.7(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.7~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.7> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fd327d237ea06d34c5cde72f1ce453a4ea55c87f9a410fd5491cb6527c9019ad" ;
    tmk:ordinal 4 ;
    tmk:text "the person must file or serve the material to which the declaration refers, or a copy of the material, at the same time as the declaration or as soon as practicable after that time." ;
    tmk:upstreamRef "TMR1995/r21.7~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9> ;
