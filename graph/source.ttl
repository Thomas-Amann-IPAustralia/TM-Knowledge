    tmk:contentHash "sha256:dd88c314614b3e8b9998a64eda21e4e38290e3f51320223f8a9be46742e067a0" ;
    tmk:ordinal 13 ;
    tmk:text "(a) the application had not lapsed (see subsection 48(1)), been withdrawn (see subsection 40A(1)) or refused (see subsection 44(1)); and" ;
    tmk:upstreamRef "TMA1995/s11(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11> ;
