    tmk:ordinal 5 ;
    tmk:text "Note 1: For applicant see section 6." ;
    tmk:upstreamRef "TMA1995/s177~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177~1~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
