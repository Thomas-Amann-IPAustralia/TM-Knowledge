    tmk:contentHash "sha256:e297ce16a4c64419005894e4c875ed15e60cc6134125c11ea3fa9a89b4df4aea" ;
    tmk:ordinal 22 ;
    tmk:text "Note 3: For when the registration of a trade mark is taken to have effect, see sections 72 and 239A." ;
    tmk:upstreamRef "TMA1995/s92(4)~3~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s93(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s93> ;
