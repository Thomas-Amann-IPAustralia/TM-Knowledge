    tmk:upstreamRef "TMR1995/r21.2(2)(b)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.2(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.2> ;
