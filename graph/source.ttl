    tmk:ordinal 1 ;
    tmk:text "(1) A person who applies, or has applied, for the registration of a trade mark:" ;
    tmk:upstreamRef "TMR1995/r4.18(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18> ;
