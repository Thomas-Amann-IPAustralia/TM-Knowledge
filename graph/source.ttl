<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s116> a tmk:LegislativeProvision ;
    rdfs:label "Record not proof etc. of existence of right etc."@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:65c00e596b20a413ec16b81bf0b6a403475064032d31b2aad7ee5fd870dd1cf3" ;
    tmk:text "The fact that a record has been made in the Register under this Part that a person claims an interest in, or a right in respect of, a registered trade mark is not proof or evidence that the person has that right or interest." ;
    tmk:upstreamRef "TMA1995/s116" .

