    tmk:ordinal 1 ;
    tmk:text "In this Subdivision:" ;
    tmk:upstreamRef "TMR1995/r17A.48~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.49(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.49> ;
