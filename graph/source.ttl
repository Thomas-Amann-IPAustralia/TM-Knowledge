    tmk:upstreamRef "TMR1995/r21.1(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.10~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.10> ;
