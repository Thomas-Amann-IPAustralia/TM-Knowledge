    tmk:ordinal 23 ;
    tmk:text "(5) The filing date in respect of the application is:" ;
    tmk:upstreamRef "TMA1995/s241(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s241(5)(a)> a tmk:LegislativeUnit ;
