    tmk:ordinal 13 ;
    tmk:text "(a) demonstrate the nature of the trade mark sufficiently; or" ;
    tmk:upstreamRef "TMR1995/r4.3(8)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(8)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
