    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0250dd68cfdf9d1dc030da5d16109c7e1d3e3e2fbfb1d7b63378381514e2168c" ;
    tmk:ordinal 1 ;
    tmk:text "An application for the registration of a trade mark must be rejected if:" ;
    tmk:upstreamRef "TMA1995/s42~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:37f2c27c42b22f4448b941d9e541f979dc443b8cf2c9aff6e711f28c2e82c73c" ;
    tmk:ordinal 1 ;
    tmk:text "An application for the registration of a trade mark in respect of particular goods or services must be rejected if, because of some connotation that the trade mark or a sign contained in the trade mark has, the use of the trade mark in relation to those goods or services would be likely to deceive or cause confusion." ;
    tmk:upstreamRef "TMA1995/s43~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
