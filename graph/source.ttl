    tmk:ordinal 2 ;
    tmk:text "(a) a foreign country that is a signatory to the Paris Convention for the Protection of Industrial Property of 20 March 1883, as in force from time to time;" ;
    tmk:upstreamRef "TMR1995/r21.29(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:73d63fe7cf1e24e6ca5b47361cb310c5cf17b487300e1293b009c5240b52ced8" ;
    tmk:ordinal 3 ;
    tmk:text "(b) a foreign country that is a full member of the World Trade Organization." ;
    tmk:upstreamRef "TMR1995/r21.29(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29(1)(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c7bbc176ff940a016cb80bd8ce292da0a46a401fa90336700f733f4381aad10b" ;
    tmk:ordinal 4 ;
    tmk:text "Note 1: For signatories to the Paris Convention for the Protection of Industrial Property, see www.wipo.int." ;
    tmk:upstreamRef "TMR1995/r21.29(1)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29(1)(b)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1c364f3e49ae2cecf0910f6ec2cfbf0f803b17f1bfcc6664b06ab243c45c646e" ;
    tmk:ordinal 5 ;
    tmk:text "Note 2: For full members of the World Trade Organization, see www.wto.org." ;
    tmk:upstreamRef "TMR1995/r21.29(1)(b)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:217a964dca1bf8537b9e07dffdba9bfa9e8c4b2917b8e5c9b713a8885ce4af3c" ;
    tmk:ordinal 6 ;
    tmk:text "(2) For the purposes of subsection 225(2) of the Act, an application for the registration of a trade mark, being an application that is made under the treaty done at Bangui in the Central African Republic on 2 March 1977 entitled the Agreement Relating to the Creation of an African Intellectual Property Organisation, Constituting a Revision of the Agreement Relating to the Creation of an African and Malagasy Office of Industrial Property (a treaty subsisting between 2 or more Convention countries), is, in accordance with the terms of that treaty, declared to be equivalent to an application made in each of those Convention countries." ;
    tmk:upstreamRef "TMR1995/r21.29(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:090fdcd9be5920382d0f23007ac2329d51e08aae8414cee2885b30d626fbd9ed" ;
    tmk:ordinal 7 ;
    tmk:text "(3) For the purposes of subsection 225(2) of the Act, an application for the registration of a trade mark, being an application that is made under the Benelux Convention Concerning Trademarks done at Brussels on 19 March 1962 (being a treaty subsisting between 2 or more Convention countries), is, in accordance with the terms of that treaty, declared to be equivalent to an application made in each Convention country that is a High Contracting party within the meaning of that treaty." ;
    tmk:upstreamRef "TMR1995/r21.29(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e1ef13c84100cdab6866620edce3aa8cde3a84f89ab5c9c8f08dad0671f87651" ;
    tmk:ordinal 8 ;
    tmk:text "(4) For subsection 225(2) of the Act, an application, under the terms of the Treaty Establishing the European Community done at Rome on 25 March 1957, for registration of a European Community trade mark is equivalent to an application made in each Convention country party to the treaty." ;
    tmk:upstreamRef "TMR1995/r21.29(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:72dc9c3939f1faf89fd677b54195868eda2064ce326a1d8d9b6e37c47a898e45" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A person who files an application, notice or request must include in the application, notice or request the business or residential address of:" ;
    tmk:upstreamRef "TMR1995/r21.3(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d733f352203acdae2a189c755389285b82de738d7397255bdd7d29dc58cef042" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the person making the application or request or giving the notice; or" ;
    tmk:upstreamRef "TMR1995/r21.3(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f8ae3220a2a67ba8c5d94fe4d826cb2561406383b3ff0cd0a29effd534057822" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the person on whose behalf the application, notice or request is made." ;
    tmk:upstreamRef "TMR1995/r21.3(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:cac05405c5052f6a2500dce685f757f3cd3bccb6ab803f887cfeeab255078854" ;
    tmk:ordinal 4 ;
    tmk:text "(2) If an address recorded in the Register or included in an application, notice or request that is filed changes, the person whose address changes, or a person acting on behalf of that person, must notify the Registrar of the new address." ;
    tmk:upstreamRef "TMR1995/r21.3(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7354cb5e57179760e5314df609e83c1c9b8656ddca1bc5762a02ad505b769b86" ;
    tmk:ordinal 5 ;
    tmk:text "(3) If the Registrar is notified of a new address, the Registrar must amend the Register, application, notice or request accordingly." ;
    tmk:upstreamRef "TMR1995/r21.3(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:99a47141f0df1f6ecbdab8a0c5f718eaca51f2e5aba0e8789e5311efdaa5afec" ;
    tmk:ordinal 6 ;
    tmk:text "Note: Section 212 of the Act also deals with the making and signing of applications, notices and requests." ;
    tmk:upstreamRef "TMR1995/r21.3(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.33(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.33> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
