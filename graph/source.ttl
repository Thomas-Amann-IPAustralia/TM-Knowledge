    tmk:contentHash "sha256:14ad1f55d1b363725d897ec11cc752d67bdef5974e90dbe8b3d73b98fe437962" ;
    tmk:ordinal 7 ;
    tmk:text "(4) The registration of a trade mark may be opposed on any of the grounds specified in this Act and on no other grounds." ;
    tmk:upstreamRef "TMA1995/s52(4)" .

