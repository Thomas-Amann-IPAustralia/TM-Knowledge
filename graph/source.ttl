    tmk:contentHash "sha256:726825c092ee41be59548dda53bfe32142b5af25d560b1036e34ae6aec519961" ;
    tmk:ordinal 8 ;
    tmk:text "Note: Regulations made for the purposes of subsection 231(3) may make provision in relation to amendment of documents filed in relation to an opposition." ;
    tmk:upstreamRef "TMA1995/s66(2)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66A~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66A> ;
