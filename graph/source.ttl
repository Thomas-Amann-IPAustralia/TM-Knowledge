<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.23> a tmk:LegislativeProvision ;
    rdfs:label "Expedited examination"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:83420c45af949c10202eb8252c9d320c30076eb900525af4bb8336f4f724f15d" ;
    tmk:text "Regulations 4.18 and 4.19 apply in relation to an IRDA as if a reference in those regulations to an application for registration of a trade mark were a reference to the IRDA." ;
    tmk:upstreamRef "TMR1995/r17A.23" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42F> a tmk:LegislativeProvision ;
    rdfs:label "Appeals to Federal Court or Federal Magistrates Court"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:86e7e223760cea161330e40899bdea00c9c8345c9deccabb8a2d344cdcebc704" ;
    tmk:text "A person who made submissions to the Registrar, or was heard by the Registrar, during the course of proceedings mentioned in paragraph 17A.42C(1)(a), may appeal to the Federal Court or Federal Magistrates Court from a decision of the Registrar to exercise, or not exercise, a power mentioned in subregulation 17A.42A(1)." ;
    tmk:upstreamRef "TMR1995/r17A.42F" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.10> a tmk:LegislativeProvision ;
    rdfs:label "Notification of withdrawal of application etc."@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2800e4d688c15d5e627436938b4fb7b532800507ec47d014d35feb466beb2d53" ;
    tmk:text "If an application, notice or request is withdrawn in accordance with regulation 21.9, the Registrar must publish the withdrawal in a computer database maintained by the Trade Marks Office." ;
    tmk:upstreamRef "TMR1995/r21.10" .

