    tmk:ordinal 2 ;
    tmk:text "Note: For prescribed court see section 190." ;
    tmk:upstreamRef "TMA1995/s182(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s182(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s182> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ca1ee641e01e17de4ba9ea392f6fccb44823a98a9290e25134aae75f10c756b7" ;
    tmk:ordinal 3 ;
    tmk:text "(2) Notice of an application to the prescribed court must be given to the Commission." ;
    tmk:upstreamRef "TMA1995/s182(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s182(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s182> ;
