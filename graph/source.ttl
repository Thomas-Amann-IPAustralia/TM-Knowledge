    tmk:ordinal 18 ;
    tmk:text "(6) Regulation 17A.31 does not apply to this regulation." ;
    tmk:upstreamRef "TMR1995/r17A.34C(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34D(3)> a tmk:LegislativeUnit ;
