    tmk:ordinal 8 ;
    tmk:text "(4) The Registrar must give a copy of the documents to the opponent." ;
    tmk:upstreamRef "TMR1995/r5.18(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.18(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
