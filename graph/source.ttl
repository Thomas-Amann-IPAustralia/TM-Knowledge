    tmk:ordinal 24 ;
    tmk:text "Note 4: In addition, the regulations may provide for the effect of a protected international trade mark: see Part 17A." ;
    tmk:upstreamRef "TMA1995/s120(3)(d)~4" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d8c8b1c676c18a5bac301c37060423e16b2deabfca9bd2c8596e8cc36454ede4" ;
    tmk:ordinal 25 ;
    tmk:text "(4) In deciding, for the purposes of paragraph (3)(a), whether a trade mark is well known in Australia, one must take account of the extent to which the trade mark is known within the relevant sector of the public, whether as a result of the promotion of the trade mark or for any other reason." ;
    tmk:upstreamRef "TMA1995/s120(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5bd7d813394519527d992744ac86a5722409529e0f01ab87baefe6ea08068fed" ;
    tmk:ordinal 10 ;
    tmk:text "However, the person is not taken to have infringed the trade mark if the person establishes that using the sign as the person did is not likely to deceive or cause confusion." ;
    tmk:upstreamRef "TMA1995/s120~1" .

