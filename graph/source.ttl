    tmk:text "“(a) on a natural person:" ;
    tmk:upstreamRef "TMA1995/s215(7)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e1a82adb3ca843ed4c7c7c728dfe05f5f8c43071f15bf7b5c909f57a102fd964" ;
    tmk:ordinal 24 ;
    tmk:text "(i) by delivering it to the person personally; or" ;
    tmk:upstreamRef "TMA1995/s215(7)~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)~4> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7cb3b745e2fdd3e3998ca2567756930b447f4d30c3ab7f3ee784949cf431bd43" ;
    tmk:ordinal 25 ;
    tmk:text "(ii) by leaving it at, or by sending it by prepaid post to, the address of the place of residence or business of the person last known to the person serving the document; or" ;
    tmk:upstreamRef "TMA1995/s215(7)~4" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)~5> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:96153a76d93e663a96de906c51c383e93b64bb854f682ab76347ab4a6e573c6e" ;
    tmk:ordinal 26 ;
    tmk:text "(b) on a body corporate—by leaving it at, or sending it by prepaid post to, the head office, a registered office or a principal office of the body corporate.”." ;
    tmk:upstreamRef "TMA1995/s215(7)~5" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(8)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0e103fa1b65e23c4d0e436d892544489be598b404a730874a4b19299c4a18298" ;
    tmk:ordinal 27 ;
    tmk:text "(8) After the time specified in the regulations, a reference in this section to an address includes a reference to an electronic address." ;
    tmk:upstreamRef "TMA1995/s215(8)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(9)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0103422eb06daadfe1671602f02c4d78d96eb951c82ee23daa8374c8dc9779e1" ;
    tmk:ordinal 28 ;
    tmk:text "(9) The time specified under subsection (8) must be later than the day on which the regulations are registered under the Legislation Act 2003." ;
    tmk:upstreamRef "TMA1995/s215(9)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3d3f8cb83d3fd5415dd12856b93e694e10e16df29fca8d4a790d568c7a1a94b2" ;
    tmk:ordinal 9 ;
    tmk:text "(c) if paragraph (d) does not apply—the address given, or last given, by the registered owner or the person to the Registrar under subsection (1); or" ;
    tmk:upstreamRef "TMA1995/s215(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:07f6303c5f210f9790fc482ad52a23a9c93eccb5d9ce9f520cb504ea271a8700" ;
    tmk:ordinal 10 ;
    tmk:text "(d) if, before the Registrar registers the trade mark or records the claim to the interest or right, the registered owner or person gives in writing to the Registrar another address as his or her address for service—that other address." ;
    tmk:upstreamRef "TMA1995/s215(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(d)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e39fe086fa4c20f2d67d92ec50802aa1028d7a51258d36683247e77cc1c66e62" ;
    tmk:ordinal 11 ;
    tmk:text "Note: For registered trade mark and registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s215(d)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2de8aedf6cb29bd8feb37b5c43cf5ee21d80565476a00d3220bf49f5811d0df0" ;
    tmk:ordinal 8 ;
    tmk:text "the Registrar must enter in the Register as the address for service of the registered owner or of the person:" ;
    tmk:upstreamRef "TMA1995/s215~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0d7673b9c6aa0568b8640cb4c339fab2dff589e1b666927e2f0b77685d43d597" ;
    tmk:ordinal 16 ;
    tmk:text "is the address set out from time to time in the Register as being the address for service of the registered owner or of the person." ;
    tmk:upstreamRef "TMA1995/s215~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
