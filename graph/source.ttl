    tmk:ordinal 8 ;
    tmk:text "Note: Applications may also lapse if an application for registration is opposed and a notice to defend the application is not filed: see section 54A." ;
    tmk:upstreamRef "TMA1995/s68~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s69(1)> a tmk:LegislativeUnit ;
