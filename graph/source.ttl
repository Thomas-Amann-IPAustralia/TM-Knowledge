    tmk:ordinal 2 ;
    tmk:text "(2) On receiving the request, the Registrar must require the applicant to file:" ;
    tmk:upstreamRef "TMR1995/r5.18(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.18(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.18> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
