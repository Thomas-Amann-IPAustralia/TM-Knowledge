    tmk:contentHash "sha256:3126f3a4121e3daa9f1bf149037eb9ab408cc4fcde1d2807c8e44e95f85d4695" ;
    tmk:ordinal 9 ;
    tmk:text "(7) If any of the goods and/or services cannot be specified using terms referred to in subregulation (6), the applicant must provide sufficient information to enable the Registrar to decide the classification of the goods and/or services." ;
    tmk:upstreamRef "TMR1995/r4.4(7)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.10(1)> a tmk:LegislativeUnit ;
