    tmk:ordinal 4 ;
    tmk:text "the Registrar must, if no appeal has been made at the end of any relevant appeal period, notify the International Bureau of that decision or order." ;
    tmk:upstreamRef "TMR1995/r17A.48X~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48Y~1> a tmk:LegislativeUnit ;
