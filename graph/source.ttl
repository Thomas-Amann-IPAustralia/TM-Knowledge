    tmk:ordinal 6 ;
    tmk:text "Note: Regulations 21.6 and 21.7 deal with making and filing declarations." ;
    tmk:upstreamRef "TMR1995/r5.13A(3)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13A(4)(a)> a tmk:LegislativeUnit ;
