    tmk:ordinal 6 ;
    tmk:text "(b) the holder claimed a right of priority under regulation 17A.15 for protection of the trade mark in respect of particular goods or services; and" ;
    tmk:upstreamRef "TMR1995/r17A.4(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(2)(c)> a tmk:LegislativeUnit ;
