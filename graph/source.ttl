    tmk:ordinal 5 ;
    tmk:text "before making the decision the Registrar must:" ;
    tmk:upstreamRef "TMR1995/r21.19~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.2(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.2> ;
