    tmk:ordinal 9 ;
    tmk:text "would be extended for more than 6 months after the end of the relevant period mentioned in subregulation (1)." ;
    tmk:upstreamRef "TMR1995/r17A.20~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20~1~1> a tmk:LegislativeUnit ;
