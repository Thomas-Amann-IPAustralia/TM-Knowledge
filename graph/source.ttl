    tmk:ordinal 10 ;
    tmk:text "Note: For Convention country see section 225." ;
    tmk:upstreamRef "TMA1995/s72(e)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72~1> a tmk:LegislativeUnit ;
