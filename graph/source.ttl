    tmk:ordinal 15 ;
    tmk:text "(5) When the holder files a copy of the rules in accordance with subregulation (4), the holder must notify the Registrar, in writing, of the holder’s address for service in Australia or New Zealand." ;
    tmk:upstreamRef "TMR1995/r17A.50(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.51(a)> a tmk:LegislativeUnit ;
