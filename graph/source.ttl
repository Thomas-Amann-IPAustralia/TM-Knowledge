    tmk:ordinal 16 ;
    tmk:text "priority date, for a trade mark that is the subject of an IRDA or a protected international trade mark, has the meaning given by regulation 17A.3." ;
    tmk:upstreamRef "TMR1995/r17A.2/priority-date" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/protected-international-trade-mark> a tmk:LegislativeUnit ;
