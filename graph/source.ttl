    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of this Act, goods are similar to other goods:" ;
    tmk:upstreamRef "TMA1995/s14(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s14(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
