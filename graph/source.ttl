    tmk:ordinal 6 ;
    tmk:text "(5) If:" ;
    tmk:upstreamRef "TMR1995/r22.2(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.2(5)(a)> a tmk:LegislativeUnit ;
