    tmk:contentHash "sha256:468dbf32104b956448d13ef2b9234256b9fbf98406430ade62ec45241b0757d1" ;
    tmk:ordinal 10 ;
    tmk:text "(a) the Sydney Organising Committee for the Olympic Games constituted by the Sydney Organising Committee for the Olympic Games Act 1993 of New South Wales; or" ;
    tmk:upstreamRef "TMR1995/r4.7(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7> ;
