    tmk:ordinal 3 ;
    tmk:text "(b) the Registrar has reason to believe that the information is not known to a party to the proceedings; and" ;
    tmk:upstreamRef "TMR1995/r21.19(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.19(1)(c)> a tmk:LegislativeUnit ;
