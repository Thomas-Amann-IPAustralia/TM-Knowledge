    tmk:ordinal 8 ;
    tmk:text "(c) in relation to a Panel of the Disciplinary Tribunal—the Panel Chair;" ;
    tmk:upstreamRef "TMR1995/r21.6(3)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.6(3)(d)> a tmk:LegislativeUnit ;
