    tmk:ordinal 2 ;
    tmk:text "(a) on behalf of all of them; or" ;
    tmk:upstreamRef "TMA1995/s28(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s28(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
