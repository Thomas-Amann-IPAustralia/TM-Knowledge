    tmk:ordinal 7 ;
    tmk:text "(ii) the decision is confirmed on appeal;" ;
    tmk:upstreamRef "TMA1995/s11(1)(c)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(1)(d)> a tmk:LegislativeUnit ;
