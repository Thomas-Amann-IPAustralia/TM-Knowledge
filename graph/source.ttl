    tmk:ordinal 6 ;
    tmk:text "(d) request a hearing from the Registrar." ;
    tmk:upstreamRef "TMR1995/r17A.17(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17(3)> a tmk:LegislativeUnit ;
