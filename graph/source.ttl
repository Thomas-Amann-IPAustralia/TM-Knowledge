<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:68277ebc16c4194cef9e2f05f81953c2fcfd3ed553a738e0b58a041633d836c6" ;
    tmk:ordinal 8 ;
    tmk:text "(2) In deciding whether or not the certification trade mark is capable of so distinguishing goods or services certified by the applicant or an approved certifier, the Registrar must take into account:" ;
    tmk:upstreamRef "TMA1995/s177(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1781c8fab0de7f99ca9fb485ee5dfc6e718471109ddfe529a3c5555526cd29bd" ;
    tmk:ordinal 9 ;
    tmk:text "(a) the extent to which the certification trade mark is inherently adapted so to distinguish those goods or services; or" ;
    tmk:upstreamRef "TMA1995/s177(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d1f4b2b26ede51ee80c93941c81a6522166fb709ffa44d95bb524ce429197109" ;
    tmk:ordinal 10 ;
    tmk:text "(b) the extent to which, because of its use or of any other circumstances, the certification trade mark has become adapted so to distinguish those goods or services." ;
    tmk:upstreamRef "TMA1995/s177(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s178(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
