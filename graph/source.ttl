    tmk:ordinal 1 ;
    tmk:text "(2) The Registrar may require a person who has made a declaration that is filed in any proceedings before the Registrar to attend before the Registrar to give evidence orally on oath or affirmation instead of, or in addition to, the evidence contained in the declaration." ;
    tmk:upstreamRef "TMR1995/r21.17(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.17(3)> a tmk:LegislativeUnit ;
