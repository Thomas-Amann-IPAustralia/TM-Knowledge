    tmk:ordinal 7 ;
    tmk:text "(4) Subsection (3) does not limit subsection 33(3A) of the Acts Interpretation Act 1901." ;
    tmk:upstreamRef "TMA1995/s96(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s96(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s96> ;
