    tmk:ordinal 12 ;
    tmk:text "(c) the other person notifies the Registrar in writing that the right or interest is vested in him or her;" ;
    tmk:upstreamRef "TMA1995/s52(5)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52(d)> a tmk:LegislativeUnit ;
