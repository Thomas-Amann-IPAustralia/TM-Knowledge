<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204> a tmk:LegislativeProvision ;
    rdfs:label "Registrar to act as soon as practicable"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6a199a4bed960cf182cb32aaf4b050afa6c60a7359545899a491b088271c0596" ;
    tmk:text "If: (a) the Registrar is required under this Act to do any act or thing; and (b) no time or period is provided within which the act or thing is to be done; the Registrar is to do the act or thing as soon as practicable." ;
    tmk:upstreamRef "TMA1995/s204" .

