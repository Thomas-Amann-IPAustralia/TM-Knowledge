    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dacc202625153c035f381b079b2f2d860ef990435e2acb54d728c0e99b28bef2" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of this Act:" ;
    tmk:upstreamRef "TMA1995/s9(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:28a724e8f5c1ce944e728eb1634bfe408f8aa703413c8a0c11ed84dc33a2a361" ;
    tmk:ordinal 2 ;
    tmk:text "(a) a trade mark is taken to be applied to any goods, material or thing if it is woven in, impressed on, worked into, or affixed or annexed to, the goods, material or thing; and" ;
    tmk:upstreamRef "TMA1995/s9(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a643436e347b86f14be0a64803aeac83ea39ec3c9d01060332f43a707e82a024" ;
    tmk:ordinal 3 ;
    tmk:text "(b) a trade mark is taken to be applied in relation to goods or services:" ;
    tmk:upstreamRef "TMA1995/s9(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9cad1f6700a39e55a8d11c44f7e02064e3b7ba54775acc52e26a746784914577" ;
    tmk:ordinal 4 ;
    tmk:text "(i) if it is applied to any covering, document, label, reel or thing in or with which the goods are, or are intended to be, dealt with or provided in the course of trade; or" ;
    tmk:upstreamRef "TMA1995/s9(1)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:eeaccc00fdbf28ffd318fb69f6f6e818ed99e051dad9e7145d141c44cbc65048" ;
    tmk:ordinal 5 ;
    tmk:text "(ii) if it is used in a manner likely to lead persons to believe that it refers to, describes or designates the goods or services; and" ;
    tmk:upstreamRef "TMA1995/s9(1)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
