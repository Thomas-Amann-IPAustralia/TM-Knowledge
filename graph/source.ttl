    tmk:contentHash "sha256:044354775103f7a1eba0de477e78c03ffb11eafe7258ed2cfdc18e8a1e27d535" ;
    tmk:ordinal 14 ;
    tmk:text "(7) Subject to these Regulations, the Registrar may give a direction that is reasonably necessary for the conduct of the hearing." ;
    tmk:upstreamRef "TMR1995/r21.16(7)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(8)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16> ;
