    tmk:ordinal 46 ;
    tmk:text "(c) the International Bureau does not receive notification under subregulation 17A.32(2) within 7 months after the opposition period begins;" ;
    tmk:upstreamRef "TMR1995/r17A.36(6)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36(c)> a tmk:LegislativeUnit ;
