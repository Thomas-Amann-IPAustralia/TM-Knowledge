    tmk:contentHash "sha256:1e4ec35180e65dfed8a60ff668436b5038627043e0213d49cc65f395a2851ce6" ;
    tmk:ordinal 7 ;
    tmk:text "Note 3: Division 2 of Part 4 sets out the main grounds for rejecting an application, but section 41 does not apply to certification trade marks (see section 170)." ;
    tmk:upstreamRef "TMA1995/s177~1~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s17~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s17> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:19fcd99043438dc1562a18409baf5f40f6f48a80bc727f16ffb4dead9e8eae28" ;
    tmk:ordinal 1 ;
    tmk:text "A trade mark is a sign used, or intended to be used, to distinguish goods or services dealt with or provided in the course of trade by a person from goods or services so dealt with or provided by any other person." ;
    tmk:upstreamRef "TMA1995/s17~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s17~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s17> ;
