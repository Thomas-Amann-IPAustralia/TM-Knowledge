    tmk:ordinal 9 ;
    tmk:text "(5) If:" ;
    tmk:upstreamRef "TMA1995/s52(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52(5)(a)> a tmk:LegislativeUnit ;
