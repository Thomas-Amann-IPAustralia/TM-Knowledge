    tmk:ordinal 3 ;
    tmk:text "(b) if the Registrar is of the opinion that it is fair and reasonable in all the circumstances of the case to do so." ;
    tmk:upstreamRef "TMA1995/s66(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(1)(b)~1> a tmk:LegislativeUnit ;
