    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:80f2c308387af92d029eaf5d801a41e7ab132881732d425404d624fbeb2cb3b6" ;
    tmk:ordinal 19 ;
    tmk:text "Note 3: For what amounts to an infringement of a trade mark see Part 12." ;
    tmk:upstreamRef "TMA1995/s26(1)(f)~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(f)~4> a tmk:LegislativeUnit ;
