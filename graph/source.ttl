    tmk:ordinal 5 ;
    tmk:text "Note 1: For registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s20~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20~1~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0ea38179d707eebec26cbbd7b77ac3a196ad280c258f81662f03474a331f18eb" ;
    tmk:ordinal 6 ;
    tmk:text "Note 2: For use see section 7." ;
    tmk:upstreamRef "TMA1995/s20~1~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20~1~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f904ac3de044959b37a9aa708db51719a2f3f9f7840fb984b8b364a2abe8beb8" ;
    tmk:ordinal 7 ;
    tmk:text "Note 3: In addition, the regulations may provide for the effect of a protected international trade mark: see Part 17A." ;
    tmk:upstreamRef "TMA1995/s20~1~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s21(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s21> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a63896fe609cf5a85eb9423bb1990d8b6f44eecf79351c1ad41067d735b35a9a" ;
    tmk:ordinal 2 ;
    tmk:text "(2) Equities in respect of a registered trade mark may be enforced in the same way as equities in respect of any other personal property." ;
    tmk:upstreamRef "TMA1995/s21(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s21(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s21> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:48edc9e7118618be3f615e1f7d65a2a703b12d564f06e64025fa38badc28c0f1" ;
    tmk:ordinal 3 ;
    tmk:text "Note: For registered trade mark see section 6." ;
    tmk:upstreamRef "TMA1995/s21(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:324df484859af56c3b343137076d1ec41449ca68b5b9db8c43f64f0f23e5169a" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The Register is prima facie evidence of any particular or other matter entered in it." ;
    tmk:upstreamRef "TMA1995/s210(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:437ea8f7bfac9b01834de27f012feb0a7752060bf045c93044023b2bc8f29d69" ;
    tmk:ordinal 2 ;
    tmk:text "Note: See section 116 about records of claims to interests and rights made under Part 11." ;
    tmk:upstreamRef "TMA1995/s210(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e9a9ace798123f67678965d9ec99ec02e1576ea6e5a9a545a23f098434a26d4e" ;
    tmk:ordinal 3 ;
    tmk:text "(2) A copy of, or an extract from, the Register that is certified by the Registrar to be a true record or extract is admissible in any proceedings as if it were the original." ;
    tmk:upstreamRef "TMA1995/s210(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7eb6a68785c66c6c175b176feb89b2883d119f911d54347d17e0602cddc72667" ;
    tmk:ordinal 4 ;
    tmk:text "(3) If the Register or a part of the Register is kept by using a computer, a document certified by the Registrar as reproducing in writing a computer record of all or any of the particulars comprised in the Register or in that part of the Register is admissible in any proceedings as prima facie evidence of those particulars." ;
    tmk:upstreamRef "TMA1995/s210(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2e9e6ba23d4393e6282e4e1a3aa00236ddb791696bfbf5b560b76bbfd00daf5b" ;
    tmk:ordinal 5 ;
    tmk:text "(4) This section does not apply in relation to any particular or other matter entered in the Register in relation to a PPSA security interest." ;
    tmk:upstreamRef "TMA1995/s210(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210(4)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d75a037e43324ce00f0701b75f9952687d5758731f579151b171d828ecdd387e" ;
    tmk:ordinal 6 ;
    tmk:text "Note 1: For PPSA security interest see section 6." ;
    tmk:upstreamRef "TMA1995/s210(4)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210(4)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c268bc161f36ff6ead0e9ff456bc02bd57bdf782e889c85be538e05901c17e1b" ;
    tmk:ordinal 7 ;
    tmk:text "Note 2: Certain particulars relating to registrations in respect of PPSA security interests under the Personal Property Securities Act 2009 are admissible in evidence: see section 174 of that Act." ;
    tmk:upstreamRef "TMA1995/s210(4)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s212~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s212> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:aa9556284f6a6200248ec9f4476ed9453d227e00bac13a24601fda8178f66888" ;
    tmk:ordinal 1 ;
    tmk:text "An application, notice or request required or permitted under this Act to be made or signed by a person may be made or signed, on behalf of that person, by any other person." ;
    tmk:upstreamRef "TMA1995/s212~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s213A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s213A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:15a346cb8a65d361eebd8b59f38de0177ca653a45c97f2ad6f3c84eb8ed412b2" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of section 213, the Registrar may, by writing, determine one or more means for filing a document with the Trade Marks Office." ;
    tmk:upstreamRef "TMA1995/s213A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s213A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s213A> ;
