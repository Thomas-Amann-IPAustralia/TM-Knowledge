    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d1b75b1e15cb5be8063daf9054dd22133b33ac2a63bfa74331b0efaabf0fdc2f" ;
    tmk:ordinal 10 ;
    tmk:text "Note: For Convention country see section 225 of the Act." ;
    tmk:upstreamRef "TMR1995/r17A.15(3)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15~1> a tmk:LegislativeUnit ;
