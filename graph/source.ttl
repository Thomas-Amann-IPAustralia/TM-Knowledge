    tmk:text "Note 4: The regulations may provide that an application must also be rejected if the trade mark is substantially identical with, or deceptively similar to, a protected international trade mark or a trade mark for which there is a request to extend international registration to Australia: see Part 17A." ;
    tmk:upstreamRef "TMA1995/s44(2)(b)~4" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:authorityKind "law" ;
