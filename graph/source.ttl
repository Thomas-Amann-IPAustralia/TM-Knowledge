    tmk:ordinal 1 ;
    tmk:text "(1) This section applies to a registered trade mark if:" ;
    tmk:upstreamRef "TMA1995/s83A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(1)(a)> a tmk:LegislativeUnit ;
