    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar may, at the written request of the holder, defer acceptance of an IRDA if:" ;
    tmk:upstreamRef "TMR1995/r17A.21(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.21(1)(a)> a tmk:LegislativeUnit ;
