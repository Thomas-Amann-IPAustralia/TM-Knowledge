    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:47c597b839030c01a22b9a008a643435b1b1021b033a9326709e91029cdb6c96" ;
    tmk:ordinal 7 ;
    tmk:text "(b) an opposition to an application under section 92." ;
    tmk:upstreamRef "TMA1995/s66(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(2)(b)~1> a tmk:LegislativeUnit ;
