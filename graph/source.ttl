    tmk:ordinal 3 ;
    tmk:text "(b) a trade mark is taken to be applied in relation to goods or services:" ;
    tmk:upstreamRef "TMA1995/s9(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
    tmk:authorityKind "law" ;
