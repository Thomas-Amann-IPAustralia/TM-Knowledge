    tmk:ordinal 20 ;
    tmk:text "Division 2 of Part 4 of the Act includes provisions relating to the grounds on which an application for the registration of a trade mark must be rejected." ;
    tmk:upstreamRef "TMR1995/r4.15A(2)(b)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(2)~1> a tmk:LegislativeUnit ;
