    tmk:text "(a) be in an approved form; and" ;
    tmk:upstreamRef "TMA1995/s109(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s109(2)(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s109> ;
