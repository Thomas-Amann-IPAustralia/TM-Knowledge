    tmk:ordinal 2 ;
    tmk:text "(1) Any person may oppose an application under subsection 92(1) by filing a notice of opposition with the Registrar." ;
    tmk:upstreamRef "TMA1995/s96(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s96(2)> a tmk:LegislativeUnit ;
