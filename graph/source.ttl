    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4637af09de20131c2a5fb5057f6693a310256cece07857fea2fc59883aaa1837" ;
    tmk:ordinal 6 ;
    tmk:text "(2) If the holder is the successor in title to the person who made the earlier application, the Registrar may notify the holder that the holder is required to file documentary evidence that is sufficient to establish the passing of title to the holder." ;
    tmk:upstreamRef "TMR1995/r17A.19(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.1> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e47e9049187a5203b05663f38dad2d5031772993931261d3cbc87bef63e68cf9" ;
    tmk:ordinal 1 ;
    tmk:text "This Part provides for matters that enable the performance of the obligations of Australia, or obtain for Australia an advantage or benefit, under the Madrid Protocol." ;
    tmk:upstreamRef "TMR1995/r17A.1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/change-of-ownership> a tmk:LegislativeUnit ;
