    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:cf12deba6574ea146619894ede2f1f660310e8fdd3c330bdc92750b07a2bf9a2" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of section 214 of the Act (which deals with withdrawal of applications, notices and requests):" ;
    tmk:upstreamRef "TMR1995/r21.9(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:cac18c6b9fdff50551d5adf94c76a65d44835c11377782af875c67f5eae51613" ;
    tmk:ordinal 2 ;
    tmk:text "(a) a person who has filed an application, notice or request; or" ;
    tmk:upstreamRef "TMR1995/r21.9(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c8fa6a90aa0a1fbf1c1255dc8ca1e060a3187653f495999510182ed497c8fefa" ;
    tmk:ordinal 3 ;
    tmk:text "(b) another person in whom the right or interest in reliance on which the application, notice or request was filed has become vested;" ;
    tmk:upstreamRef "TMR1995/r21.9(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9> ;
