    tmk:ordinal 6 ;
    tmk:text "the term must not be used in an IRDA to specify the goods or services in respect of which protection is sought, unless the Registrar is satisfied that the term is sufficiently clear in the circumstances." ;
    tmk:upstreamRef "TMR1995/r17A.14~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.14~2> a tmk:LegislativeUnit ;
