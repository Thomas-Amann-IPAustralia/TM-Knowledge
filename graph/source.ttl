    tmk:ordinal 5 ;
    tmk:text "(3) An applicant may, before the end of a period prescribed in subregulation (1), or that period as extended under section 224 of the Act or as a result of a previous application of subregulation (4), request the Registrar in writing to extend the period." ;
    tmk:upstreamRef "TMR1995/r4.12(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15> ;
