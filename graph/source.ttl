    tmk:contentHash "sha256:7a16f05ab4d92fde083f092c1d19ad3970239145e155b35f61305a67e5317261" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The repealed Act means:" ;
    tmk:upstreamRef "TMA1995/s16(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b853ef2d623e4b98919e32e270be65d3a734a578415ae47b1667e2d81b6e6f90" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the Trade Marks Act 1955 as in force immediately before its repeal; and" ;
    tmk:upstreamRef "TMA1995/s16(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16> ;
