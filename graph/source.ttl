    tmk:ordinal 7 ;
    tmk:text "the Registrar must report that belief by notification to the holder." ;
    tmk:upstreamRef "TMR1995/r17A.18~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.19(1)> a tmk:LegislativeUnit ;
