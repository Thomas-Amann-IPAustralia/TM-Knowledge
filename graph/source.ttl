    tmk:contentHash "sha256:905dc28d81c8786fa4d8be28afacf1be3383911fb4aff53a05578c6bd46fcc93" ;
    tmk:ordinal 23 ;
    tmk:text "Note: For limitations see section 6." ;
    tmk:upstreamRef "TMA1995/s44~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4bb71839074c5610f61407a19874c83c17cdd477fbce9204d0e1e9585d6cb609" ;
    tmk:ordinal 29 ;
    tmk:text "the Registrar may not reject the application because of the existence of the other trade mark." ;
    tmk:upstreamRef "TMA1995/s44~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44~2~1> a tmk:LegislativeUnit ;
