    tmk:contentHash "sha256:9197648a1a18d24f02c1882b10a94fa246b9d859eef8580c1e04ad3885643c0e" ;
    tmk:ordinal 3 ;
    tmk:text "(b) at the time when the particulars of registration of the trade mark were entered in the Register, the obligation did not exist." ;
    tmk:upstreamRef "TMA1995/s83A(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A> ;
