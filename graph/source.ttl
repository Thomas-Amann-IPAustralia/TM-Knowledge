    tmk:ordinal 2 ;
    tmk:text "(2) An application must be made:" ;
    tmk:upstreamRef "TMR1995/r21.12(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.12(2)~1> a tmk:LegislativeUnit ;
