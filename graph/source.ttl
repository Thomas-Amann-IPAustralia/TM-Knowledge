    tmk:ordinal 20 ;
    tmk:text "(a) whether it arose directly or indirectly; or" ;
    tmk:upstreamRef "TMA1995/s122A(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
