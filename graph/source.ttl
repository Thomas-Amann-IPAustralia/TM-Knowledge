    tmk:upstreamRef "TMA1995/s11~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12> ;
