    tmk:ordinal 3 ;
    tmk:text "(a) it lapses (see sections 37 and 54A), is withdrawn (see section 214) or is rejected (see section 33); or" ;
    tmk:upstreamRef "TMA1995/s11(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(1)(b)> a tmk:LegislativeUnit ;
