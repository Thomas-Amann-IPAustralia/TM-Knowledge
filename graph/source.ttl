    tmk:contentHash "sha256:2ab1584bc629c364f6844ce5aaee336d28b369d7547958ecb0aa557dbcb56606" ;
    tmk:ordinal 1 ;
    tmk:text "When the Registrar amends any particular entered in the Register in respect of a trade mark, the Registrar may also amend the certificate of registration if he or she thinks it appropriate to do so." ;
    tmk:upstreamRef "TMA1995/s91~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(1)> a tmk:LegislativeUnit ;
