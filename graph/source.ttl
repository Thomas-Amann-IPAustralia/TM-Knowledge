    tmk:ordinal 5 ;
    tmk:text "(ii) if the opposition has been withdrawn; or" ;
    tmk:upstreamRef "TMA1995/s68(1)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s68(1)(b)(iii)> a tmk:LegislativeUnit ;
