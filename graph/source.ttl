    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:22dd2f1edf74fa843db17ed395cb0dd3a7651cb2f4abb249eaae4651ebb0ee24" ;
    tmk:ordinal 25 ;
    tmk:text "(4) If the applicant’s trade mark has been used only in a particular area, the limitations may include that the use of the trade mark is to be restricted to that particular area." ;
    tmk:upstreamRef "TMR1995/r4.15A(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(5)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
