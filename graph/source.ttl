    tmk:ordinal 3 ;
    tmk:text "(2) A trade mark may be registered as a defensive trade mark in respect of particular goods or services even if the registered owner does not use or intend to use the trade mark in relation to those goods or services." ;
    tmk:upstreamRef "TMA1995/s185(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s185(3)> a tmk:LegislativeUnit ;
