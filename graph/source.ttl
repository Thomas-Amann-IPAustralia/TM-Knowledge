    tmk:upstreamRef "TMA1995/s71(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s71(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s71> ;
