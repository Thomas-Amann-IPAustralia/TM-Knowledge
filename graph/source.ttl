    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:73467312b6d3592b5e9bb0839f1c7ad702171cb75add60aabddb7e15dcc78aae" ;
    tmk:ordinal 4 ;
    tmk:text "Note: For the repeal of the Trade Marks Act 1955 see section 232." ;
    tmk:upstreamRef "TMA1995/s16(1)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:809b004e2b8d111efdb6e6dda24c04cc13bc9014834ea7a70f034f13704ddc8b" ;
    tmk:ordinal 5 ;
    tmk:text "(2) In this Act, unless the contrary intention appears, a reference to a particular section of the repealed Act includes a reference to the regulations made for the purposes of that section and that were in force immediately before that Act was repealed." ;
    tmk:upstreamRef "TMA1995/s16(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s164~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s164> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:926c69409484992b2cecef6b5b0bf3dfb2087d882ecd93ff160b3b6136183574" ;
    tmk:ordinal 1 ;
    tmk:text "An application for the registration of a collective trade mark must be made by the association to which the mark belongs." ;
    tmk:upstreamRef "TMA1995/s164~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s166~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s166> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9aa31337c0b600e1c0e325baef0e582aa0516b424e1e3b797d3b0b666b6f9a84" ;
    tmk:ordinal 1 ;
    tmk:text "A collective trade mark may not be assigned or transmitted." ;
    tmk:upstreamRef "TMA1995/s166~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6556ad78749c7366d00e1c0cd19f8adc1bfeef1902ace74a7119e148a66a6650" ;
    tmk:ordinal 2 ;
    tmk:text "(a) defines a certification trade mark; and" ;
    tmk:upstreamRef "TMA1995/s168(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c4f5478f5a32cd2bfea38b33f18b9202a7476db5f0222de72038c7755e32a0d0" ;
    tmk:ordinal 3 ;
    tmk:text "(b) provides to what extent, and subject to what modifications or additions, the provisions of this Act relating to trade marks apply to certification trade marks; and" ;
    tmk:upstreamRef "TMA1995/s168(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1089d331e15c84574f6f63fb399208650a44450d73bf021e6b77126ca2315649" ;
    tmk:ordinal 4 ;
    tmk:text "(c) outlines the role of the Commission in the regulation of certification trade marks." ;
    tmk:upstreamRef "TMA1995/s168(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:60affcdddc80b9cf16293af307b055f4fe14e526ff38cf0495fa444468d4f160" ;
    tmk:ordinal 1 ;
    tmk:text "This Part:" ;
    tmk:upstreamRef "TMA1995/s168~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f06cec14b94fe66665aeff542bd23e8053b156caa8b4f31f25d1917637013b53" ;
    tmk:ordinal 2 ;
    tmk:text "(a) dealt with or provided in the course of trade; and" ;
    tmk:upstreamRef "TMA1995/s169(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:58e96fedfbec76377ae4a1818aa7d70bf837c88d7e74fb25af840e7364deb3ca" ;
    tmk:ordinal 3 ;
    tmk:text "(b) certified by a person (owner of the certification trade mark), or by another person approved by that person, in relation to quality, accuracy or some other characteristic, including (in the case of goods) origin, material or mode of manufacture;" ;
    tmk:upstreamRef "TMA1995/s169(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5150051f74a26fe78fe622ee4fad422b1935dabc78e7283502c1f00ed249a794" ;
    tmk:ordinal 1 ;
    tmk:text "A certification trade mark is a sign used, or intended to be used, to distinguish goods or services:" ;
    tmk:upstreamRef "TMA1995/s169~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e295eb9197b9dc461fd1dfa9e958e92a2500c95e86583ba7a289dd18a37a0a3e" ;
    tmk:ordinal 4 ;
    tmk:text "from other goods or services dealt with or provided in the course of trade but not so certified." ;
    tmk:upstreamRef "TMA1995/s169~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169~2~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1e560e444ffef5c6f58c785a1e99d9f99e63779064d7ae2974bcaac2a315204d" ;
    tmk:ordinal 5 ;
    tmk:text "Note: The goods or services certified may be those of any person, including the owner of the certification trade mark or any person approved by the owner for the purpose of certifying goods or services." ;
    tmk:upstreamRef "TMA1995/s169~2~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s170~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s170> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7c11866151e51042630786461b8b5aeb23da704f63ad9cfef2d89d484ff8e7a5" ;
    tmk:ordinal 1 ;
    tmk:text "Subject to this Part, the provisions of this Act relating to trade marks (other than sections 8 and 26, paragraph 27(1)(b), sections 33, 34 and 41, sections 121 and 127, Part 9—Removal of trade mark from Register for nonuse and Part 17—Defensive Trade Marks) apply to certification trade marks and so apply as if a reference to a trade mark included a reference to a certification trade mark." ;
    tmk:upstreamRef "TMA1995/s170~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s171~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s171> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e41a5f727e46b8d4fb466e504d0769ac04b1a4fd14ab08743306010bfe890d0a" ;
    tmk:ordinal 1 ;
    tmk:text "Section 20 applies in relation to a certification trade mark as if subsection (1) were omitted and the following subsection were substituted:" ;
    tmk:upstreamRef "TMA1995/s171~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s171~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s171> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b3872ed436483fa45c6313a56efa1ddecd721df6eca6515e4e112ffe1d2c6c5e" ;
    tmk:ordinal 2 ;
    tmk:text "“(1) If a certification trade mark is registered, the registered owner has, subject to this Part, the exclusive rights to use, and to allow other persons to use, the certification trade mark, in relation to the goods and/or services in respect of which the certification trade mark is registered. The registered owner may, however, use the certification trade mark only in accordance with the rules governing the use of the certification trade mark." ;
    tmk:upstreamRef "TMA1995/s171~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s171~2~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s171> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3fb9c73e7e748424231fe48a16abc6f864cf3e021e4860f5ef60624684b24f8f" ;
    tmk:ordinal 3 ;
    tmk:text "Note: For the rules governing the use of the certification trade mark see section 173.”." ;
    tmk:upstreamRef "TMA1995/s171~2~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s174~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s174> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7a7c43d718b4ce6340e7e26f98828eaaf23ff28846492fa0dbef94d47a69e691" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar must send the prescribed documents relating to the application to the Commission in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s174~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4b047c580d5700d82328295c5723bfdc904034ba8a1865496e446151efe5a7f2" ;
    tmk:ordinal 1 ;
    tmk:text "(1) In addition to any other ground on which:" ;
    tmk:upstreamRef "TMA1995/s177(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f6fd174514db9552ef6ceed0695aafe756837c64e18b4cc01712a88afe266241" ;
    tmk:ordinal 2 ;
    tmk:text "(a) an application for the registration of a certification trade mark may be rejected; or" ;
    tmk:upstreamRef "TMA1995/s177(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:256fd9a9d0d143a63f7c0ebd2ce4fa5387b693455c84080a7e2f6093db291fed" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the registration of a certification trade mark may be opposed;" ;
    tmk:upstreamRef "TMA1995/s177(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:68277ebc16c4194cef9e2f05f81953c2fcfd3ed553a738e0b58a041633d836c6" ;
    tmk:ordinal 8 ;
    tmk:text "(2) In deciding whether or not the certification trade mark is capable of so distinguishing goods or services certified by the applicant or an approved certifier, the Registrar must take into account:" ;
    tmk:upstreamRef "TMA1995/s177(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1781c8fab0de7f99ca9fb485ee5dfc6e718471109ddfe529a3c5555526cd29bd" ;
    tmk:ordinal 9 ;
    tmk:text "(a) the extent to which the certification trade mark is inherently adapted so to distinguish those goods or services; or" ;
    tmk:upstreamRef "TMA1995/s177(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d1f4b2b26ede51ee80c93941c81a6522166fb709ffa44d95bb524ce429197109" ;
    tmk:ordinal 10 ;
    tmk:text "(b) the extent to which, because of its use or of any other circumstances, the certification trade mark has become adapted so to distinguish those goods or services." ;
    tmk:upstreamRef "TMA1995/s177(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0e99218d8588538df2fa4474028ec9bac4a0dc33da01bbd9fd9d846aa7641c29" ;
    tmk:ordinal 4 ;
    tmk:text "the application must be rejected or the registration may be opposed if the trade mark is not capable of distinguishing goods or services certified by the applicant or an approved certifier from goods or services not so certified." ;
    tmk:upstreamRef "TMA1995/s177~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2b0ed2e3bddc751391e7100be4dda43761ee43959e1ba43a4c037155863222d9" ;
    tmk:ordinal 5 ;
    tmk:text "Note 1: For applicant see section 6." ;
    tmk:upstreamRef "TMA1995/s177~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177~1~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5b71329dca2cc6d2f472baac87e112bdd4e3105ed36eaffba8f3358afe09e024" ;
