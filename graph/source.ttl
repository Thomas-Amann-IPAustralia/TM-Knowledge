    tmk:ordinal 3 ;
    tmk:text "(b) the registered owner of the trade mark is the holder of the protected international trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.54(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.54(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.54> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
