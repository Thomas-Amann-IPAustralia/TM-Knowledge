    tmk:ordinal 5 ;
    tmk:text "holder means:" ;
    tmk:upstreamRef "TMR1995/r17A.2/holder" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/holder(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fec4cf51eb7f17cdd44ab7e6d9810a47a3c46ba89727ca574dc430b513a48236" ;
    tmk:ordinal 6 ;
    tmk:text "(a) in relation to an IRDA or a protected international trade mark—the person or persons in whose name or names the international registration of the trade mark is recorded in the Record of International Registrations; and" ;
    tmk:upstreamRef "TMR1995/r17A.2/holder(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/holder(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
