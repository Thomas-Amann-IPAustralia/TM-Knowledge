    tmk:ordinal 4 ;
    tmk:text "is the fee that would have been payable if these regulations had applied to the proceedings." ;
    tmk:upstreamRef "TMR1995/r22.2~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.2~2> a tmk:LegislativeUnit ;
