    tmk:ordinal 14 ;
    tmk:text "Note 2: For Madrid Protocol, see regulation 2.1 of these Regulations." ;
    tmk:upstreamRef "TMR1995/r17A.2/madrid-regulations~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/office-of-origin> a tmk:LegislativeUnit ;
