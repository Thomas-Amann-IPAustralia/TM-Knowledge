    tmk:contentHash "sha256:02a62d17e0cbb65732eb5fe14327ffc50e6cf25c0c5c11e97e139745a7ceac19" ;
    tmk:ordinal 4 ;
    tmk:text "(i) at any time, with the consent of the registered owner; or" ;
    tmk:upstreamRef "TMA1995/s26(1)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f88fa835617e00cf01751539c1389bc03ea8fdf65a96f917b4c1ed64b460f675" ;
    tmk:ordinal 5 ;
    tmk:text "(ii) during the prescribed period, if the registered owner refuses to bring such an action on a particular occasion during the prescribed period; or" ;
    tmk:upstreamRef "TMA1995/s26(1)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(b)(iii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9a9a2b478a0e2506c6009cc2436c47c70246d5b4873f3a5ef5fa29bfb9453711" ;
    tmk:ordinal 6 ;
    tmk:text "(iii) after the end of the prescribed period, if the registered owner has failed to bring such an action during the prescribed period;" ;
    tmk:upstreamRef "TMA1995/s26(1)(b)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3b64040119cd70dae11d54546d44c0e6e941b45830841f246ac75dfc194cb288" ;
    tmk:ordinal 7 ;
    tmk:text "(c) the authorised user may cause to be displayed on goods in respect of which the trade mark is registered, or on their package, or on the container in which they are offered to the public, a notice prohibiting any act that is under subsection 121(2) a prohibited act in relation to the goods;" ;
    tmk:upstreamRef "TMA1995/s26(1)(c)" .

