        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.3>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4> ;
