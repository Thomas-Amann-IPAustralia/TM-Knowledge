    tmk:upstreamRef "TMR1995/r21.21A(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.21A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.21A> ;
