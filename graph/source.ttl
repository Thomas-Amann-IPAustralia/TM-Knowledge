    tmk:contentHash "sha256:8f03334e5f28297cbddb786f0c78faa1212bf0a8fa89ca8badef40c444f030f0" ;
    tmk:ordinal 21 ;
    tmk:text "(b) whether it arose by way of proprietary interest, contract, arrangement, understanding, a combination of those things, or otherwise." ;
    tmk:upstreamRef "TMA1995/s122A(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s123~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s123> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5ec43184d4bc580eea66215f76b5a4a0c8702c70e7a7d83f983f32e10c513ce8" ;
    tmk:ordinal 1 ;
    tmk:text "In spite of section 120, a person who uses a registered trade mark in relation to services that are similar to services in respect of which the trade mark is registered does not infringe the trade mark if the trade mark has been applied in relation to the services by, or with the consent of, the registered owner of the trade mark." ;
    tmk:upstreamRef "TMA1995/s123~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s123~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s123> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8513d6ddf7132e90447939409de1ebae0c81cebd1d3c2e4366a250641272cff6" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For similar services see subsection 14(2)." ;
    tmk:upstreamRef "TMA1995/s123~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:33df758983bcb5fc674773d4d3f1988c79344d21ff3487a34767a23917327ae1" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A person does not infringe a registered trade mark by using an unregistered trade mark that is substantially identical with, or deceptively similar to, the registered trade mark in relation to:" ;
    tmk:upstreamRef "TMA1995/s124(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c4cd0c5f8c9d1e5265b1261318314cc4e8b66be3f7156bd95bc7eee41433fa54" ;
    tmk:ordinal 2 ;
    tmk:text "(a) goods similar to goods (registered goods) in respect of which the trade mark is registered; or" ;
    tmk:upstreamRef "TMA1995/s124(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0b3d585df0697c63e2a2ff59aeeaef2df18562948ab426b78d09d7d88c27ec7c" ;
    tmk:ordinal 3 ;
    tmk:text "(b) services closely related to registered goods; or" ;
    tmk:upstreamRef "TMA1995/s124(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:27c56301f3dcd91720ad9b6ee442cfbd681cd7c2cda1abaaad1e5aeddc28d298" ;
    tmk:ordinal 4 ;
    tmk:text "(c) services similar to services (registered services) in respect of which the trade mark is registered; or" ;
    tmk:upstreamRef "TMA1995/s124(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124(1)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:28b98917516ed03833bf1d8424e1311343c9cf81319329050cf368ca2f8ec4fd" ;
    tmk:ordinal 5 ;
    tmk:text "(d) goods closely related to registered services;" ;
    tmk:upstreamRef "TMA1995/s124(1)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:22c622d8b42e2c40a07f61f3b65036f0c5dcfe63ed381d3f317547b8e6897afc" ;
    tmk:ordinal 12 ;
    tmk:text "(2) If the unregistered trade mark has continuously been used only in a particular area of Australia, subsection (1) applies only to the use of the trade mark by the person in that area." ;
    tmk:upstreamRef "TMA1995/s124(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bc6a2f469cff197cabc1ee3d404b8ea5ce98599f88a0f9a051d372242cb9da19" ;
    tmk:ordinal 7 ;
    tmk:text "(e) the date of registration of the registered trade mark; or" ;
    tmk:upstreamRef "TMA1995/s124(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124(f)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fc411d132077db7a6f9baf73ac63c6f589eb29fcd205cb7a9f1863447dca0d2d" ;
    tmk:ordinal 8 ;
    tmk:text "(f) the registered owner of the registered trade mark, or a predecessor in title, or a person who was a registered user of the trade mark under the repealed Act, first used the trade mark;" ;
    tmk:upstreamRef "TMA1995/s124(f)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c32273b26ce46ad2aec5eb9ee507a085273114917d08869098fd766dfdd665be" ;
    tmk:ordinal 6 ;
    tmk:text "if the person, or the person and the person’s predecessor in title, have continuously used in the course of trade the unregistered trade mark in relation to those goods or services from a time before:" ;
    tmk:upstreamRef "TMA1995/s124~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8f780d9e53dd0fb25b018cd29c5063089e3f22c29642c6b77828f5de41020df5" ;
    tmk:ordinal 9 ;
    tmk:text "whichever is earlier." ;
    tmk:upstreamRef "TMA1995/s124~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124~2~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:47acd93b7e0126fd7e3b0e0e0d09567747dab371e05b737950f7897e0c75dd85" ;
    tmk:ordinal 10 ;
    tmk:text "Note 1: For deceptively similar see section 10." ;
    tmk:upstreamRef "TMA1995/s124~2~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124~2~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s124> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c806c39da8f6fccb1502daf9d5165d35f0c676076b220527d14327ccec0fe0ee" ;
    tmk:ordinal 11 ;
    tmk:text "Note 2: For predecessor in title and date of registration see section 6." ;
    tmk:upstreamRef "TMA1995/s124~2~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a55055c15dc9db3ee685910ef9e7882cebac8a653a3d93bda1c80ab8ea415282" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The relief that a court may grant in an action for an infringement of a registered trade mark includes:" ;
    tmk:upstreamRef "TMA1995/s126(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4979c15056b34761f4223b79a643279afa6baf0aac5c5fcece6fe343e499809e" ;
    tmk:ordinal 2 ;
    tmk:text "(a) an injunction, which may be granted subject to any condition that the court thinks fit; and" ;
    tmk:upstreamRef "TMA1995/s126(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c454f2d4e01f3427aeef7706e5ff1a1adc49022c70281de5642a3ad1107499d3" ;
    tmk:ordinal 3 ;
    tmk:text "(b) at the option of the plaintiff but subject to section 127, damages or an account of profits." ;
    tmk:upstreamRef "TMA1995/s126(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5ec7fbf2ff918f65a52e3c185cc187e4e2ff4f63d6ef6bab7b5fce59be566c02" ;
    tmk:ordinal 4 ;
    tmk:text "(2) A court may include an additional amount in an assessment of damages for an infringement of a registered trade mark, if the court considers it appropriate to do so having regard to:" ;
    tmk:upstreamRef "TMA1995/s126(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ac3a159dac72d8f89ed8d1cfa8011261fd0dc28e638f5ca3b4eacfcc902ae0e6" ;
    tmk:ordinal 5 ;
    tmk:text "(a) the flagrancy of the infringement; and" ;
    tmk:upstreamRef "TMA1995/s126(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:09b5a929bcb000b874962b5980bc32cd4aab13f289097bb5f14d5856469a7d7d" ;
    tmk:ordinal 6 ;
    tmk:text "(b) the need to deter similar infringements of registered trade marks; and" ;
    tmk:upstreamRef "TMA1995/s126(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f9408b9637639726693d7cd463364719cb61db9935918676c0ebd61f945b056e" ;
    tmk:ordinal 7 ;
    tmk:text "(c) the conduct of the party that infringed the registered trade mark that occurred:" ;
    tmk:upstreamRef "TMA1995/s126(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(2)(c)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:56725d0226725c1bc55ffe61abab9861f317ddc5a14cf1b0871f37ce47e35588" ;
    tmk:ordinal 8 ;
    tmk:text "(i) after the act constituting the infringement; or" ;
    tmk:upstreamRef "TMA1995/s126(2)(c)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(2)(c)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8c10557fdefaea59f5cf06c94ce0be28df88fc20315e63d837a3e8bd96b74027" ;
    tmk:ordinal 9 ;
    tmk:text "(ii) after that party was informed that it had allegedly infringed the registered trade mark; and" ;
    tmk:upstreamRef "TMA1995/s126(2)(c)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(2)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:05656a1e611cf36a05dc2b034b1a3eadec5448763fc457211d19dc271171ba52" ;
    tmk:ordinal 10 ;
    tmk:text "(d) any benefit shown to have accrued to that party because of the infringement; and" ;
    tmk:upstreamRef "TMA1995/s126(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126(2)(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s126> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5739c15e72e739b13169e036274649d590a2e64e0d9d4ee1b13de2c8cdc89953" ;
    tmk:ordinal 11 ;
    tmk:text "(e) all other relevant matters." ;
    tmk:upstreamRef "TMA1995/s126(2)(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d3757ee6255bc6b9b6ca4412992904000b2aee504287432ac478af07587ffbfd" ;
    tmk:ordinal 1 ;
    tmk:text "The priority date for the registration of a trade mark in respect of particular goods or services is:" ;
    tmk:upstreamRef "TMA1995/s12~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s15(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3d48d517be4df6db40bea7da9d449db0dc8ba18e51080bd98307758012e5d1cd" ;
    tmk:ordinal 2 ;
    tmk:text "(a) a wine is taken to have originated in a foreign country or Australia only if the wine is made from grapes grown within the territory of that country or of Australia, as the case may be; and" ;
    tmk:upstreamRef "TMA1995/s15(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s15(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:eedeba641b6c8dbcf246b6f60652d83a8b885719576ded91aa950bd4aa511eb2" ;
    tmk:ordinal 3 ;
    tmk:text "(b) a wine is taken to have originated in a particular region or locality of a foreign country or of Australia only if the wine is made from grapes grown in that region or locality." ;
    tmk:upstreamRef "TMA1995/s15(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1ae7dc76e9e306a5c1c0d3493fabd42fe2c4d7ce5bfbebfdc8807919c6f8ca96" ;
    tmk:ordinal 2 ;
    tmk:text "(a) who has been summonsed to appear as a witness before the Registrar; and" ;
    tmk:upstreamRef "TMA1995/s153(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153> ;
