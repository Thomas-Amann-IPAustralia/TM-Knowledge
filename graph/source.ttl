    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dbf2800e9f69f7b8129f886c8e588d59dd435ee01cee0e841819859c246477a3" ;
    tmk:ordinal 6 ;
    tmk:text "the other person is taken, for the purposes of subsection (1), to use the trade mark in relation to the goods or services under the control of the owner." ;
    tmk:upstreamRef "TMA1995/s8~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dbf2800e9f69f7b8129f886c8e588d59dd435ee01cee0e841819859c246477a3" ;
    tmk:ordinal 10 ;
    tmk:text "the other person is taken, for the purposes of subsection (1), to use the trade mark in relation to the goods or services under the control of the owner." ;
    tmk:upstreamRef "TMA1995/s8~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
