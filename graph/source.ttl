    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:531c64be480adda505408642dcb55a4183a4993d6acb94f2fd65c5a9186c1e23" ;
    tmk:ordinal 9 ;
    tmk:text "Note: Regulations 4.11, 5.18 and 17A.19 have specific rules about applications filed in trade marks offices (however described) of Convention countries." ;
    tmk:upstreamRef "TMR1995/r21.2(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.20(a)> a tmk:LegislativeUnit ;
