    tmk:contentHash "sha256:20c8409bc208b28ffac8de86e6b5bae4e76672607309a0670fbd453b78fa9d11" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of paragraph 27(3)(b) of the Act, the following subregulations set out the manner of specifying, in an application for the registration of a trade mark, the goods and/or services in respect of which registration is sought." ;
    tmk:upstreamRef "TMR1995/r4.4(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8829489dd9a17d33d4fa8d4b9e7b4cc70c81111d975a1b85bc156e86e66650cf" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The expression ‘all goods’, ‘all services’, ‘all other goods’, or ‘all other services’ must not be used in an application for registration of a trade mark to specify the goods and/or services in respect of which registration is sought." ;
    tmk:upstreamRef "TMR1995/r4.4(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7ffad8b0a25ab3a8144a4bc5e873cda3a8673f5bea6c1eeb8f7be93caa18f289" ;
    tmk:ordinal 3 ;
    tmk:text "(3) The goods and/or services must be grouped according to the appropriate classes described in Schedule 1." ;
    tmk:upstreamRef "TMR1995/r4.4(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1f2138d22e7f1206f076756d400404f7ba8e11b2ffd9160a86b358040b4c31f1" ;
    tmk:ordinal 4 ;
    tmk:text "(4) The applicant must nominate the class number that is appropriate to the goods or services in each group." ;
    tmk:upstreamRef "TMR1995/r4.4(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:631ddc092c853ff8fab4f437b057235d712c941607f3bad26022371ec1f85a3e" ;
    tmk:ordinal 5 ;
    tmk:text "(5) The groups must be listed in the order of their class numbers." ;
    tmk:upstreamRef "TMR1995/r4.4(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(6)> a tmk:LegislativeUnit ;
