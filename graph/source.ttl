    tmk:ordinal 8 ;
    tmk:text "(ii) similar services or closely related goods;" ;
    tmk:upstreamRef "TMA1995/s58A(2)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58A(2)(b)> a tmk:LegislativeUnit ;
