    tmk:ordinal 3 ;
    tmk:text "(b) if the holder requests a hearing, give the holder an opportunity to be heard." ;
    tmk:upstreamRef "TMR1995/r17A.18(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.18(2)> a tmk:LegislativeUnit ;
