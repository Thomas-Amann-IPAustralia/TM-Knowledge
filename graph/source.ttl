    tmk:contentHash "sha256:87bbc7df074978a24820242371798cbf03344f4e5ba68f1780cc5c5c0f86b94f" ;
    tmk:ordinal 5 ;
    tmk:text "(2) An application may be made on any of the following grounds, and on no other grounds:" ;
    tmk:upstreamRef "TMA1995/s88(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ecba1c3f45a99e064161f257b237bd02df2407e3ecd8d9ff8d3df28d149e9f43" ;
    tmk:ordinal 6 ;
    tmk:text "(a) any of the grounds on which the registration of the trade mark could have been opposed under this Act;" ;
    tmk:upstreamRef "TMA1995/s88(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5d017b3eaa4979bce86afa6896ac64a166a84fb737aa02cc0f7cad6707595f5d" ;
    tmk:ordinal 7 ;
    tmk:text "(b) an amendment of the application for the registration of the trade mark was obtained as a result of fraud, false suggestion or misrepresentation;" ;
    tmk:upstreamRef "TMA1995/s88(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(2)(b)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:312cbf6ff1f6b4cf115dc18161dadd724338e7a1aba259a54084715f7e179abd" ;
    tmk:ordinal 8 ;
    tmk:text "(c) because of the circumstances applying at the time when the application for rectification is filed, the use of the trade mark is likely to deceive or cause confusion;" ;
    tmk:upstreamRef "TMA1995/s88(2)(b)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(2)(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0c1e23d38679dd998109986a93373c30f82a93173dbda592593bc8ffa0246c97" ;
    tmk:ordinal 9 ;
    tmk:text "(e) if the application is in respect of an entry in the Register—the entry was made, or has been previously amended, as a result of fraud, false suggestion or misrepresentation." ;
    tmk:upstreamRef "TMA1995/s88(2)(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(2)(e)~1> a tmk:LegislativeUnit ;
