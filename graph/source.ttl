    tmk:ordinal 25 ;
    tmk:text "(a) beginning before the priority date for the registration of the other trade mark in respect of:" ;
    tmk:upstreamRef "TMA1995/s44(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(4)(a)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
