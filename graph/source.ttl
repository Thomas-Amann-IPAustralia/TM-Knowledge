    tmk:ordinal 6 ;
    tmk:text "(i) the kind, quality, quantity, intended purpose, value, geographical origin, or some other characteristic, of goods or services; or" ;
    tmk:upstreamRef "TMA1995/s122(1)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122(1)(b)(ii)> a tmk:LegislativeUnit ;
