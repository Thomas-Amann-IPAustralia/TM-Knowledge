    tmk:ordinal 12 ;
    tmk:text "Note: For file see section 6." ;
    tmk:upstreamRef "TMA1995/s27(2)(c)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(2A)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2b1f75bba4f572e9cab6fe78e2003a360bba066b2e3ca8bd9101c2aaeed17a8e" ;
    tmk:ordinal 13 ;
    tmk:text "(2A) Despite paragraph (2)(c), an application for registration of a collective trade mark need not be made by a person or persons having legal personality." ;
    tmk:upstreamRef "TMA1995/s27(2A)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(2A)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
