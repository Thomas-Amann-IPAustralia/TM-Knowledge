    tmk:ordinal 2 ;
    tmk:text "(2) The means may be an electronic means or any other means." ;
    tmk:upstreamRef "TMA1995/s213A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s213A(3)> a tmk:LegislativeUnit ;
