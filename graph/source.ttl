    tmk:ordinal 6 ;
    tmk:text "(a) a trade mark is registered; or" ;
    tmk:upstreamRef "TMA1995/s215(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
