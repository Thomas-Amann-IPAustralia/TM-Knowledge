    tmk:ordinal 2 ;
    tmk:text "(a) the particulars of the application have been published under section 30; and" ;
    tmk:upstreamRef "TMA1995/s65A(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a430e708004c26fc0c6d14f1185bfd6345ba7af6db44f4d5681a5adb329b730a" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the amendment requested is not an amendment which could be made under section 65." ;
    tmk:upstreamRef "TMA1995/s65A(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
