    tmk:contentHash "sha256:8acfd092c8ec4ed74adaea81b58251f0104c723460548f652b4d78e32b5f5a27" ;
    tmk:ordinal 8 ;
    tmk:text "(3) Subregulation (2) does not apply in relation to an application mentioned in paragraph 4.11(1)(a), 5.18(2)(a) or 17A.19(1)(a)." ;
    tmk:upstreamRef "TMR1995/r21.2(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.2(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.2> ;
