    tmk:contentHash "sha256:75568a1bb0dedb81536099e73138f1146ea1de85e64806074728c3a4752c0ca6" ;
    tmk:ordinal 9 ;
    tmk:text "(4) Regulation 17A.17 and this regulation apply to a report under subregulation (2) as if it were a report under regulation 17A.16." ;
    tmk:upstreamRef "TMR1995/r17A.18(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.18~1> a tmk:LegislativeUnit ;
