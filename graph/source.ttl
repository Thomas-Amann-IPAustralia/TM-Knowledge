    tmk:ordinal 3 ;
    tmk:text "(b) the applicant’s name;" ;
    tmk:upstreamRef "TMR1995/r4.7(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(1)(c)> a tmk:LegislativeUnit ;
