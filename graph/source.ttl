    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:505521a107ba46c3cb9078e40c6174a049d157236b2bc665c14233c29e927126" ;
    tmk:ordinal 8 ;
    tmk:text "(b) to whom a reasonable sum has been tendered in payment for expenses;" ;
    tmk:upstreamRef "TMA1995/s153(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153(2A)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153> ;
