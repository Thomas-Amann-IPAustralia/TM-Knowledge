    tmk:ordinal 17 ;
    tmk:text "(b) specify, in accordance with the regulations, the goods and/or services in respect of which it is sought to register the trade mark." ;
    tmk:upstreamRef "TMA1995/s27(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(4)> a tmk:LegislativeUnit ;
