    tmk:ordinal 14 ;
    tmk:text "(b) show each feature of the trade mark sufficiently;" ;
    tmk:upstreamRef "TMR1995/r4.3(8)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(9)> a tmk:LegislativeUnit ;
