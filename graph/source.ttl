    tmk:ordinal 11 ;
    tmk:text "(b) a person participates by telephone or other means of telecommunications that the Registrar reasonably allows." ;
    tmk:upstreamRef "TMR1995/r21.16(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(5)> a tmk:LegislativeUnit ;
