    tmk:contentHash "sha256:e1553cbea9ba9472d248e0686f1096db2b82581196ac39a1398af5bd134b4573" ;
    tmk:ordinal 21 ;
    tmk:text "(3) If, in a case mentioned in subregulation (1) or (2), the Registrar is satisfied:" ;
    tmk:upstreamRef "TMR1995/r4.15A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b089b66cd312e5b1522eec36139f697a6471449820d2fcd81117545eed489768" ;
    tmk:ordinal 2 ;
    tmk:text "(a) may request in writing expedited examination of the application; and" ;
    tmk:upstreamRef "TMR1995/r4.18(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c9f334a39881c840dff1f719b9905f796e9c90b64902492a5cf3e5ba0662f68d" ;
    tmk:ordinal 3 ;
    tmk:text "(b) must include with the request a declaration stating the reasons for the request." ;
    tmk:upstreamRef "TMR1995/r4.18(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0a19836baf1514e3e027ac5702a5d601999e23f5c3325b2ee2a90864e9f28a32" ;
    tmk:ordinal 6 ;
    tmk:text "(2) In the absence of a request for expedited examination of an application for registration of a trade mark, the Registrar may expedite examination of the application if he or she reasonably believes that expedited examination is warranted." ;
    tmk:upstreamRef "TMR1995/r4.19(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:62f9d706f5c1a87ac46ca7b48be22efb63580b94659cee355c32b5c619eb4d88" ;
    tmk:ordinal 7 ;
    tmk:text "(3) The relationship of an application mentioned in subregulation (2) to another application for registration of a trade mark is a relevant circumstance for the purposes of that subregulation." ;
    tmk:upstreamRef "TMR1995/r4.19(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8829489dd9a17d33d4fa8d4b9e7b4cc70c81111d975a1b85bc156e86e66650cf" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The expression ‘all goods’, ‘all services’, ‘all other goods’, or ‘all other services’ must not be used in an application for registration of a trade mark to specify the goods and/or services in respect of which registration is sought." ;
    tmk:upstreamRef "TMR1995/r4.4(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2239ef5a2860a543b8417bf515ce16c57b0e333659612d7873805dd7e501224a" ;
    tmk:text "(3) If the Registrar reasonably suspects that the provisions of paragraph 27(1)(b) of the Act do not apply in relation to all of the goods and/or services specified in an application for registration of a trade mark, the Registrar may require the applicant to make a declaration to the Registrar that those provisions apply to all of those goods and/or services." ;
    tmk:upstreamRef "TMR1995/r4.8(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.10(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.10> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f804f34b52948d52c085379a0f891ba7337efe9b3bab01e3a86f0043b5c65d3d" ;
    tmk:ordinal 3 ;
    tmk:text "(3) The Registrar must decide the length of the extended period having regard to what is reasonable in the circumstances." ;
    tmk:upstreamRef "TMR1995/r5.10(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.14(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.14> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:16f0829ab2305cddd61710ecc0311333ae686a87f57ae90961b6252f7c5d099a" ;
    tmk:ordinal 10 ;
    tmk:text "(4) If the opponent files evidence in support of the opposition, the applicant must file any evidence in answer to the evidence in support within 3 months from the day the Registrar:" ;
    tmk:upstreamRef "TMR1995/r5.14(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.14(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.14> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:492c1687167ef94716b264a86c1d8926500252a91b4be9d57a61c1147f571132" ;
    tmk:ordinal 15 ;
    tmk:text "(5) If the opponent does not file any evidence in support of the opposition, the applicant must file any evidence in answer to the statement of grounds and particulars within 3 months from the day the Registrar notifies the applicant that no evidence in support was filed." ;
    tmk:upstreamRef "TMR1995/r5.14(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.14(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.14> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4a6481cbaff0930984d5065a5c0b86740d7030d9f0b7dd78fe75a72b3c32eeaa" ;
    tmk:ordinal 17 ;
    tmk:text "(6) If the applicant files evidence in answer under subregulation (4) or (5), the opponent must file any evidence in reply to the evidence in answer within 2 months from the day the Registrar:" ;
    tmk:upstreamRef "TMR1995/r5.14(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.4(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.4> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:baa45a68e4841c11dac3b0e314cc1833321d8e40d49a3c6608c6edd225b58640" ;
    tmk:ordinal 7 ;
    tmk:text "(3) If the Registrar proposes to grant the request, the Registrar must give the parties an opportunity to make representations:" ;
    tmk:upstreamRef "TMR1995/r5.4(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.6(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0336a5a2f59949155204b107b3955b57786ab5e0ca2ab45a48264906fbfc29f7" ;
    tmk:text "(1) For subsection 52(2) of the Act, the period for filing a notice of intention to oppose is 2 months from the day the acceptance of the trade mark application is published in a computer database maintained by the Trade Marks Office in accordance with regulation 4.11A." ;
    tmk:upstreamRef "TMR1995/r5.6(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.8(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.8> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:71d7c98954ab592646ae22a3e4e72d605a2ad7c6a3fc5d53ac15b3482ba7d643" ;
    tmk:ordinal 3 ;
    tmk:text "(3) If the Registrar decides that the statement is inadequate:" ;
    tmk:upstreamRef "TMR1995/r5.8(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.8(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.8> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:743a09961584671eeff3e3a31917f0ccb540ae048a73e03e60a558592b4fd6a2" ;
    tmk:ordinal 4 ;
    tmk:text "(a) the Registrar may direct the opponent to rectify the inadequacy by filing more information on the basis for one or more of the grounds; or" ;
    tmk:upstreamRef "TMR1995/r5.8(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.8(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.8> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:21f54898a9e9b1c544733b5f355f23fb52efb619a30e42935e0d4e5e1029d26d" ;
    tmk:ordinal 5 ;
    tmk:text "(b) if all the grounds are inadequately particularised, the Registrar may dismiss the opposition; or" ;
    tmk:upstreamRef "TMR1995/r5.8(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.8(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.8> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:32a781aaf7c6c6450b70755d85a02a3f88db9ac1e1fcb12fcb582e67c5386900" ;
    tmk:ordinal 16 ;
    tmk:text "(5) If the Registrar decides that the information filed under paragraph (3)(a) rectifies the inadequacy of the statement, the Registrar must give a copy of the statement and the information filed in relation to paragraph (3)(a) to the applicant." ;
    tmk:upstreamRef "TMR1995/r5.8(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.9(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.9> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:38903ca2c75b5f493c3d17ec91bba0081930b1c77d8a38e013a64324ab84ae23" ;
    tmk:ordinal 15 ;
    tmk:text "(a) an error or omission by the person, the person’s agent, the Registrar or an employee;" ;
    tmk:upstreamRef "TMR1995/r5.9(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.9(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.9> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5f8ee212d9c278a80e5c8c418e99df489b8dd6c93ce4fe3a447b02125a36b092" ;
    tmk:ordinal 16 ;
    tmk:text "(b) circumstances beyond the control of the person, other than an error or omission by the person, the person’s agent, the Registrar or an employee." ;
    tmk:upstreamRef "TMR1995/r5.9(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r8.1(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f61833fc2029ec999a642cf60bd00b3483ad51d7ee3e8a2d1752c07ed121a9a7" ;
    tmk:text "(2) If the Registrar must notify a person under that subsection, the notification must state that unless:" ;
    tmk:upstreamRef "TMR1995/r8.1(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.16(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.16> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:91fe40c57a67b7997e07a058ab36826ffb4c76684f4642f21f60bd82d99ba433" ;
    tmk:ordinal 10 ;
    tmk:text "(4) If the opponent files evidence in support of the opposition, the applicant must file any evidence in answer to the opponent’s evidence within 3 months from the day the Registrar:" ;
    tmk:upstreamRef "TMR1995/r9.16(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.16(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.16> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0103c1d5e08be49256a20da0ed169337e8cb5a98687686d0b1429ef3d5d246c5" ;
    tmk:ordinal 17 ;
    tmk:text "(6) If the applicant files evidence in answer under subregulation (4), the opponent must file any evidence in reply to the evidence in answer within 2 months from the day the Registrar:" ;
    tmk:upstreamRef "TMR1995/r9.16(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.17(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5b2eec76973aecae07892cc84e2ed126a339c21fbbb64b41399038333de2c9e0" ;
    tmk:text "(2) The opposition is taken to have ended, but not to have been discontinued or dismissed, if the opponent does not:" ;
    tmk:upstreamRef "TMR1995/r9.17(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s111> a tmk:LegislativeProvision ;
    rdfs:label "Notification of application to be given to person recorded as claiming interest in trade mark etc."@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d01646e32f685196b7d3497bb5f947d9eb39ee23e14c38450f86fd7a86056019" ;
    tmk:text "If an application made under section 107 or 109 in relation to the assignment or transmission of a trade mark complies with this Act, the Registrar must notify in accordance with the regulations any person recorded under Part 11 as claiming an interest in, or a right in respect of, the trade mark." ;
    tmk:upstreamRef "TMA1995/s111" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s115> a tmk:LegislativeProvision ;
    rdfs:label "Amendment and cancellation"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:60ed2763be6092d4e12cca58bde8741aa4b2b40becadddb8cc1a3deb6ab04bad" ;
    tmk:text "The regulations may provide for the amendment and cancellation of particulars entered in the Register under this Division." ;
    tmk:upstreamRef "TMA1995/s115" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s164> a tmk:LegislativeProvision ;
    rdfs:label "Application for registration"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:926c69409484992b2cecef6b5b0bf3dfb2087d882ecd93ff160b3b6136183574" ;
    tmk:text "An application for the registration of a collective trade mark must be made by the association to which the mark belongs." ;
    tmk:upstreamRef "TMA1995/s164" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s166> a tmk:LegislativeProvision ;
    rdfs:label "Assignment etc. of collective trade mark"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9aa31337c0b600e1c0e325baef0e582aa0516b424e1e3b797d3b0b666b6f9a84" ;
    tmk:text "A collective trade mark may not be assigned or transmitted." ;
    tmk:upstreamRef "TMA1995/s166" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s170> a tmk:LegislativeProvision ;
    rdfs:label "Application of Act"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7c11866151e51042630786461b8b5aeb23da704f63ad9cfef2d89d484ff8e7a5" ;
    tmk:text "Subject to this Part, the provisions of this Act relating to trade marks (other than sections 8 and 26, paragraph 27(1)(b), sections 33, 34 and 41, sections 121 and 127, Part 9—Removal of trade mark from Register for nonuse and Part 17—Defensive Trade Marks) apply to certification trade marks and so apply as if a reference to a trade mark included a reference to a certification trade mark." ;
    tmk:upstreamRef "TMA1995/s170" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s186> a tmk:LegislativeProvision ;
    rdfs:label "Application of Act"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2763c17d0e607eaf7779c6ec2c456d83f3f6b7f99df142a82534db1f8b410d22" ;
    tmk:text "Subject to this Part, the provisions of this Act (other than subsection 20(1), paragraph 27(1)(b), sections 41 and 59, sections 121 and 127, Part 9—Removal of trade mark from Register for nonuse and Part 16—Certification Trade Marks) apply to defensive trade marks and so apply as if a reference to a trade mark included a reference to a defensive trade mark." ;
    tmk:upstreamRef "TMA1995/s186" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s196> a tmk:LegislativeProvision ;
    rdfs:label "Registrar may appear in appeals"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:61512a82195504313c5fba837efb02f71c0d65665f4087933a8db3870e2cdeb0" ;
    tmk:text "The Registrar may appear and be heard at the hearing of an appeal to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) against a decision or direction of the Registrar." ;
    tmk:upstreamRef "TMA1995/s196" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s5> a tmk:LegislativeProvision ;
    rdfs:label "Repeal of Trade Marks Act 1994"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2f626969184bc0e8434520db87e9a9c78ee06aa8b5f00c90a22df3c193c70d3a" ;
    tmk:text "The Trade Marks Act 1994 is repealed." ;
    tmk:upstreamRef "TMA1995/s5" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s62A> a tmk:LegislativeProvision ;
    rdfs:label "Application made in bad faith"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a2ce1aa66f443f745a769fb72df4f8198754a51f71c00cfd28a92d188e9bef38" ;
    tmk:text "The registration of a trade mark may be opposed on the ground that the application was made in bad faith." ;
    tmk:upstreamRef "TMA1995/s62A" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88A> a tmk:LegislativeProvision ;
    rdfs:label "Applications by Registrar"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8218caeb3095ef01ffe4fdf07b2af2b1465008f884ce01462038e78a14de4941" ;
    tmk:text "The Registrar must not make an application under section 86, 87 or 88 unless he or she considers the application desirable in the public interest." ;
    tmk:upstreamRef "TMA1995/s88A" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1/1/2> a tmk:Chunk ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29(1)> ;
    tmk:contentHash "sha256:1a253922355f22a634da8bad7e6c2fc1104ed3c6c8c185f4a7c7e34d27051e4b" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/2/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/2/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/2/prov/2> ;
    tmk:headingPath "1. Applications in Australia (convention applications) where the applicant claims a right of priority on the basis of an application in a Convention country",
        "1.2 Convention countries",
        "Part 11 Convention Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1> ;
    tmk:ordinal 3 ;
    tmk:partId "Part11" ;
    tmk:text "A Convention country is a foreign country or region of a kind prescribed by the regulations (section 6). The regulations define a convention country as: a foreign country that is a signatory to the Paris Convention for the Protection of Industrial Property of 20 March 1883, as in force from time to time; a foreign country that is a full member of the World Trade Organization (Reg 21.29(1)). For a list of signatories to the Paris Convention see – www.wipo.int For a list of full members of the World Trade Organization see – www.wto.org Regulation 21.29 also refers to the following international treaty organisations: the European Community, Benelux and the African Intellectual Property Office (OAPI)." ;
    tmk:upstreamRef "TMM/Part11/1/1/2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/2> a tmk:Page ;
