    tmk:ordinal 1 ;
    tmk:text "(1) This section applies to a trade mark (section 44 trade mark) the application for registration of which has been accepted because of:" ;
    tmk:upstreamRef "TMA1995/s58A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58A(1)(a)> a tmk:LegislativeUnit ;
