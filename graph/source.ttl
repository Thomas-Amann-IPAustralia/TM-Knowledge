    tmk:upstreamRef "TMA1995/s4(f)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s4(f)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s4> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:48b3f896d8764b792b9875bba156a389c118719c5c00b468abaeecd2b40a462e" ;
    tmk:ordinal 8 ;
    tmk:text "Note: For Australia and Australian continental shelf see section 6." ;
    tmk:upstreamRef "TMA1995/s4(f)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s40~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s40> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a10e0176ed82d06f5a120abc004b601d9f3f00106577d971cc9b5f5ff01c7354" ;
    tmk:ordinal 1 ;
    tmk:text "An application for the registration of a trade mark must be rejected if the trade mark cannot be represented graphically." ;
    tmk:upstreamRef "TMA1995/s40~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:42edf378286a04aacd5a7217202c4fb2c177bfc1d5bd612770ee17c4880ac34a" ;
    tmk:ordinal 1 ;
    tmk:text "(1) An application for the registration of a trade mark must be rejected if the trade mark is not capable of distinguishing the applicant’s goods or services in respect of which the trade mark is sought to be registered (the designated goods or services) from the goods or services of other persons." ;
    tmk:upstreamRef "TMA1995/s41(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f4ed97b0946a049130af49b167bf58b72bef6f5f219154723f0fcf4e6eaf954d" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For goods of a person and services of a person see section 6." ;
    tmk:upstreamRef "TMA1995/s41(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:73b419ef5ac321ac86a6a7ddeb7cab3efbe54952013cbe479a0de9756c25c1de" ;
    tmk:ordinal 3 ;
    tmk:text "(2) A trade mark is taken not to be capable of distinguishing the designated goods or services from the goods or services of other persons only if either subsection (3) or (4) applies to the trade mark." ;
    tmk:upstreamRef "TMA1995/s41(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:76241011c8a8aea35c61bdeda3214d427c829977a9b8826f3448f26ead4ec629" ;
    tmk:ordinal 5 ;
    tmk:text "(a) the trade mark is not to any extent inherently adapted to distinguish the designated goods or services from the goods or services of other persons; and" ;
    tmk:upstreamRef "TMA1995/s41(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a12916424e0f0382bf0700dbbd63a39f5fe5ceaf8f36592dff6fa1e4acddfa8e" ;
    tmk:ordinal 6 ;
    tmk:text "(b) the applicant has not used the trade mark before the filing date in respect of the application to such an extent that the trade mark does in fact distinguish the designated goods or services as being those of the applicant." ;
    tmk:upstreamRef "TMA1995/s41(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d57518cca8fd35a5b8d3980d85df43948532fc28b0af0fbd5f75007b0836ebde" ;
    tmk:ordinal 8 ;
    tmk:text "(a) the trade mark is, to some extent, but not sufficiently, inherently adapted to distinguish the designated goods or services from the goods or services of other persons; and" ;
    tmk:upstreamRef "TMA1995/s41(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:555681a7276c9e1199f72d2b1f5fe2dcfa01b4b90a78b326fd3e1e356870bb09" ;
    tmk:ordinal 9 ;
    tmk:text "(b) the trade mark does not and will not distinguish the designated goods or services as being those of the applicant having regard to the combined effect of the following:" ;
    tmk:upstreamRef "TMA1995/s41(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:78fddb0ab3979454b0517be5e428fd9658fa7330cf598a9d6abdfe13b7fb5091" ;
    tmk:ordinal 10 ;
    tmk:text "(i) the extent to which the trade mark is inherently adapted to distinguish the goods or services from the goods or services of other persons;" ;
    tmk:upstreamRef "TMA1995/s41(4)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:561732b2a05f06c88a901f3b83b19d734a301aadb5029cc69f1a8ea74a692624" ;
    tmk:ordinal 11 ;
    tmk:text "(ii) the use, or intended use, of the trade mark by the applicant;" ;
    tmk:upstreamRef "TMA1995/s41(4)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)(iii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:57f8b0e8c8487d59125934371d108f05ec8ca1ce3ebab40598eed7178a277f23" ;
    tmk:ordinal 12 ;
    tmk:text "(iii) any other circumstances." ;
    tmk:upstreamRef "TMA1995/s41(4)(b)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)(iii)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3cc9e3129f93107ce0ae91cc9ca8275c2a150ae5872731689308d1465fe3e2be" ;
    tmk:ordinal 13 ;
    tmk:text "Note 1: Trade marks that are not inherently adapted to distinguish goods or services are mostly trade marks that consist wholly of a sign that is ordinarily used to indicate:" ;
    tmk:upstreamRef "TMA1995/s41(4)(b)(iii)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)(iii)~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f4ab32f02abfb88e708d404b43cb8249ef5822832989a3b568a97dd98fb33339" ;
    tmk:ordinal 14 ;
    tmk:text "(a) the kind, quality, quantity, intended purpose, value, geographical origin, or some other characteristic, of goods or services; or" ;
    tmk:upstreamRef "TMA1995/s41(4)(b)(iii)~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)(iii)~1~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
