    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar may, at the request of the applicant in writing, defer acceptance of an application for registration of a trade mark, if:" ;
    tmk:upstreamRef "TMR1995/r4.13(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.13(1)(a)> a tmk:LegislativeUnit ;
