    tmk:ordinal 1 ;
    tmk:text "For the purposes of this Act:" ;
    tmk:upstreamRef "TMA1995/s15~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16> ;
