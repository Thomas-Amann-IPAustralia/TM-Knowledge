<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part40/1> a tmk:Page ;
    rdfs:label "Part 40.1. What is renewal?"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ad044ead44afaa42905b477e01e9aaad488c4022b4f100184f6f3201c6d28eb1" ;
    tmk:lastAmended "2025-02-10" ;
    tmk:partId "Part40" ;
