    tmk:ordinal 6 ;
    tmk:text "(b) there are grounds under Subdivision 2 for rejecting it in whole or in part;" ;
    tmk:upstreamRef "TMR1995/r17A.18(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.18(3)> a tmk:LegislativeUnit ;
