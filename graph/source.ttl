    tmk:contentHash "sha256:645e5b179e62d4868525c62b411d0565efe4a06da511fd3b5d37947172776d43" ;
    tmk:ordinal 11 ;
    tmk:text "Note 1: For registered trade mark see section 6." ;
    tmk:upstreamRef "TMA1995/s120~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120~1~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
