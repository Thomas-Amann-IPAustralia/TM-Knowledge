    tmk:ordinal 9 ;
    tmk:text "(v) a person with significant influence over the use of the trade mark by the registered owner or an authorised user; or" ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)(v)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)(vi)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:03fc4b08169bd6b67b4c0035e56f837247f360594f39c9f013d1bd4beb936bb8" ;
    tmk:ordinal 10 ;
    tmk:text "(vi) an associated entity (within the meaning of the Corporations Act 2001) of a relevant person mentioned in subparagraph (i), (ii), (iii), (iv) or (v)." ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)(vi)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)(vi)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
