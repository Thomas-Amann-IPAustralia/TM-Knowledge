    tmk:ordinal 14 ;
    tmk:text "(d) the other person is taken to have been granted an extension of time in which to file the notice of opposition; and" ;
    tmk:upstreamRef "TMA1995/s52(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52(e)> a tmk:LegislativeUnit ;
