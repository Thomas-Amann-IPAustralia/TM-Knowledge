    tmk:ordinal 5 ;
    tmk:text "(d) a representation of the Arms or emblem of a city or town in Australia or of a public authority or public institution in Australia;" ;
    tmk:upstreamRef "TMR1995/r4.15(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15(f)> a tmk:LegislativeUnit ;
