    tmk:ordinal 14 ;
    tmk:text "(ii) the court is of the opinion that the person would obtain registration of the substantially identical or deceptively similar trade mark in his or her name if the person were to apply for it; or" ;
    tmk:upstreamRef "TMA1995/s122(1)(fa)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
