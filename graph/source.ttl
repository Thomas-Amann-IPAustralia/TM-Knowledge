    tmk:ordinal 7 ;
    tmk:text "(5) In this Act:" ;
    tmk:upstreamRef "TMA1995/s7(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7/use-of-a-trade-mark-in-relation-to-goods> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6eea78c87a54219ec1f4d926465a88fa065ec397d4328f89c845725e3896a252" ;
    tmk:ordinal 6 ;
    tmk:text "use of a trade mark in relation to goods means use of the trade mark upon, or in physical or other relation to, the goods (including secondhand goods)." ;
    tmk:upstreamRef "TMA1995/s7/use-of-a-trade-mark-in-relation-to-goods" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7/use-of-a-trade-mark-in-relation-to-services> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8ed5e2e6bb84a11f1f5e27165a7e4a0211383d2fbbe630c762f5ed2d030274ff" ;
    tmk:ordinal 8 ;
    tmk:text "use of a trade mark in relation to services means use of the trade mark in physical or other relation to the services." ;
    tmk:upstreamRef "TMA1995/s7/use-of-a-trade-mark-in-relation-to-services" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s70(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s70> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:49f9a85b90da8c89eb051beec5a7b3e6fa5757863b4b6dcc13c8b460053b47ce" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A trade mark may be registered with limitations as to colour." ;
    tmk:upstreamRef "TMA1995/s70(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s70(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s70> ;
