    tmk:ordinal 6 ;
    tmk:text "(3) The Registrar must extend the coolingoff period for 6 months if, before the end of the period, the Registrar is satisfied that the parties agree to the extension." ;
    tmk:upstreamRef "TMR1995/r5.16(3)" .

