    tmk:ordinal 19 ;
    tmk:text "(a) must be attached to the application for registration of the trade mark or trade marks; and" ;
    tmk:upstreamRef "TMR1995/r4.3(9)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(9)(b)> a tmk:LegislativeUnit ;
