    tmk:ordinal 3 ;
    tmk:text "(b) give to the registered owner of the trade mark a certificate of registration in an approved form." ;
    tmk:upstreamRef "TMA1995/s71(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s71(b)~1> a tmk:LegislativeUnit ;
