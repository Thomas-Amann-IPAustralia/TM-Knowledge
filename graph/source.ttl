    tmk:contentHash "sha256:de3afe58c7cf4fed2cc4f5da2986c251c4258beb2cdbb7810ed4db930966bf93" ;
    tmk:ordinal 14 ;
    tmk:text "(b) the Registrar had not refused (under section 50) to register the trade mark or if he or she had refused to register the trade mark:" ;
    tmk:upstreamRef "TMA1995/s11(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(2)(b)(i)> a tmk:LegislativeUnit ;
