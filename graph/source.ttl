    tmk:ordinal 3 ;
    tmk:text "(b) the Registrar is of the opinion that the matter should be decided by a prescribed court;" ;
    tmk:upstreamRef "TMA1995/s94(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s94~1> a tmk:LegislativeUnit ;
