    tmk:ordinal 14 ;
    tmk:text "Note: For registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s24(3)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c0c6e4082b388122c96aa31304ab344627ba747b0d781be114f4eac268ddac84" ;
    tmk:ordinal 15 ;
    tmk:text "(4) For the purposes of subsections (2) and (3), a prescribed court may determine the day on which a sign first became generally accepted within the relevant trade as the sign that describes or is the name of the article, substance or service." ;
    tmk:upstreamRef "TMA1995/s24(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24(4)~1> a tmk:LegislativeUnit ;
