    tmk:ordinal 4 ;
    tmk:text "(2) If the Registrar revokes the acceptance:" ;
    tmk:upstreamRef "TMA1995/s38(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38(2)(a)> a tmk:LegislativeUnit ;
