    tmk:ordinal 7 ;
    tmk:text "as the case requires." ;
    tmk:upstreamRef "TMR1995/r21.12(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.12(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.12> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4e0bf414b32650a0545d8436b222784bdfdecfcd20d6a709be804b23e0a61fd5" ;
    tmk:ordinal 9 ;
    tmk:text "(4) If a bill of costs is filed in relation to the proceedings, the bill of costs must be filed within 3 months from the day on which the costs are awarded." ;
    tmk:upstreamRef "TMR1995/r21.12(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.13(1)(a)> a tmk:LegislativeUnit ;
