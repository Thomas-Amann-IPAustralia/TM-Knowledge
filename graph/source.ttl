    tmk:ordinal 15 ;
    tmk:text "(3) Without limiting the particulars that may be included in an application, the application must:" ;
    tmk:upstreamRef "TMA1995/s27(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:724cdf3e6a7a1812722a609193a356bdd3390af3abb8ab5b0e04be6f3690382b" ;
    tmk:ordinal 18 ;
    tmk:text "(4) Regulations made for the purposes of paragraph (3)(b) may apply, adopt or incorporate any matter contained in any listing of goods and/or services published by the Registrar from time to time and made available for inspection by the public at the Trade Marks Office and its suboffices (if any)." ;
    tmk:upstreamRef "TMA1995/s27(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s28~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s28> ;
