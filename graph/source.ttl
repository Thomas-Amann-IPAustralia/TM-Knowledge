    tmk:ordinal 9 ;
    tmk:text "(2) On registering the trade mark, the Registrar must give it a number by which it may be identified." ;
    tmk:upstreamRef "TMA1995/s68(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s68~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s68> ;
