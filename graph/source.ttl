    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:45ec38168a395af6d358e383e78ea804a737145462a99ee407e6021af873c0d2" ;
    tmk:ordinal 8 ;
    tmk:text "(2) The particulars must be published in a computer database maintained by the Trade Marks Office." ;
    tmk:upstreamRef "TMR1995/r4.7(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(3)> a tmk:LegislativeUnit ;
