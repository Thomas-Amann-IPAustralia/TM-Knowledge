    tmk:ordinal 6 ;
    tmk:text "(4) Subject to subsection (5), a person may, as prescribed, oppose the granting of the request for the amendment." ;
    tmk:upstreamRef "TMA1995/s65A(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(5)> a tmk:LegislativeUnit ;
