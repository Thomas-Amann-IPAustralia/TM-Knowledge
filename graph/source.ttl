    tmk:ordinal 13 ;
    tmk:text "(c) the trade mark that is the subject of the IRDA does not become a protected international trade mark at the end of the relevant period or that period as extended; and" ;
    tmk:upstreamRef "TMR1995/r17A.36(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36> ;
