    tmk:ordinal 7 ;
    tmk:text "(5) If the Registrar is satisfied that a request for an amendment would not be granted even in the absence of opposition under subsection (4):" ;
    tmk:upstreamRef "TMA1995/s65A(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(5)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1acb53d742d640344ed4d6e2903ea955a78025d90a20f4a22c58e0c6670aa53c" ;
    tmk:ordinal 8 ;
    tmk:text "(a) the Registrar need not publish the request in accordance with subsection (3); and" ;
    tmk:upstreamRef "TMA1995/s65A(5)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(5)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:24c60ffe1ce5f7fbf086419e5faa516ed59d61eae2b89a8aa00c415043eb4c55" ;
    tmk:ordinal 9 ;
    tmk:text "(b) the request cannot be opposed, despite subsection (4); and" ;
    tmk:upstreamRef "TMA1995/s65A(5)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A(5)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f9a50eb24d4c610a67d3ddfd2937c8145be889a468b48c9628e689ffb884a301" ;
    tmk:ordinal 10 ;
    tmk:text "(c) the Registrar must refuse to grant the request." ;
    tmk:upstreamRef "TMA1995/s65A(5)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66> ;
    tmk:authorityKind "law" ;
