    tmk:contentHash "sha256:360570911394fb4aa0d94d15bcbb2fd0de6907c4f7cc7d41a4e9ba0236beaef9" ;
    tmk:ordinal 6 ;
    tmk:text "(e) particulars of any claim for a right of priority for the application;" ;
    tmk:upstreamRef "TMR1995/r4.7(1)(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(1)(f)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7> ;
