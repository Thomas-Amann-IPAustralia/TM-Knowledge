    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of subsection 68(1) of the Act (which deals with registration), the period for the registration of a trade mark that has been accepted for registration is:" ;
    tmk:upstreamRef "TMR1995/r7.1(1)" .

