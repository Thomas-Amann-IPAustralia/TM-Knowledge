    tmk:ordinal 1 ;
    tmk:text "(1) The regulations may provide for such matters as are necessary to enable the performance of the obligations of Australia, or to obtain for Australia any advantage or benefit, under the Madrid Protocol." ;
    tmk:upstreamRef "TMA1995/s189A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s189A(2)> a tmk:LegislativeUnit ;
