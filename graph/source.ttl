    tmk:contentHash "sha256:91c6b094d4df665bb1a5db8a7283d4da5c5564e49aacd8ec6e49d84af61ff666" ;
    tmk:ordinal 5 ;
    tmk:text "(a) amend the representation of the trade mark as entered in the Register to remove or substitute part (but not the whole) of the representation;" ;
    tmk:upstreamRef "TMA1995/s83A(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:50ae5165f49020128f8232c6333f67ff9d6bbe8a2d596eb4588298381cec1b84" ;
    tmk:ordinal 6 ;
    tmk:text "(b) amend the particulars entered in the Register in respect of the trade mark to remove or substitute any or all of the particulars." ;
    tmk:upstreamRef "TMA1995/s83A(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A> ;
