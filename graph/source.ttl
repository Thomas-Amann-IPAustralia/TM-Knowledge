    tmk:ordinal 2 ;
    tmk:text "(a) to perform the act; or" ;
    tmk:upstreamRef "TMR1995/r21.33(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.33(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.33> ;
