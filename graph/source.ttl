    tmk:contentHash "sha256:7c1cae61928ac6fdb059e13abe8e07169e5f32cb6e4a985f7352c0690a994962" ;
    tmk:lastAmended "2025-01-22" ;
    tmk:partId "Part10" ;
    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/introduction"^^xsd:anyURI ;
    tmk:upstreamRef "TMM/Part10/x-introduction" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/2/2/2> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.5> ;
    tmk:contentHash "sha256:04e9f1edcd30cd5362243e403ba8b92c76e51b0eae46c05fb6c8d351b9e38855" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/2/2/2/prov/0> ;
    tmk:headingPath "11.2. Making a claim for priority",
        "2.2",
        "Part 11 Convention Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/2> ;
    tmk:ordinal 3 ;
    tmk:partId "Part11" ;
    tmk:text "A priority claim may be made at the time of filing of the application to register a trade mark in Australia, or up to two working days later. (reg 4.5)." ;
    tmk:upstreamRef "TMM/Part11/2/2/2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/3> a tmk:Page ;
    rdfs:label "Part 11.3. Examination of applications claiming convention priority"@en-AU ;
