    tmk:ordinal 8 ;
    tmk:text "(i) an article or substance that was formerly exploited under a patent; or" ;
    tmk:upstreamRef "TMA1995/s87(2)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s87(2)(b)(ii)> a tmk:LegislativeUnit ;
