    tmk:ordinal 1 ;
    tmk:text "(1) Subsection (2) applies if:" ;
    tmk:upstreamRef "TMA1995/s82A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:02e29626852175849e05493fe6a0d733f3c72f6f573a1bbb94df33693d3d137b" ;
    tmk:ordinal 2 ;
    tmk:text "(a) before the commencement of this section, 2 or more applications were made each seeking the registration of the same 2 or more trade marks in respect of goods or services of different classes; and" ;
    tmk:upstreamRef "TMA1995/s82A(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
