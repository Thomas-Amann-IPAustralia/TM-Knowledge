    tmk:ordinal 4 ;
    tmk:text "(b) if the Registrar refuses (under section 55) to register the trade mark and there is no appeal against the decision—the end of the period allowed for the appeal; or" ;
    tmk:upstreamRef "TMA1995/s11(1)(b)" .

