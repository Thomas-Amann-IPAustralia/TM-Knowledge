    tmk:ordinal 15 ;
    tmk:text "Office of origin has the meaning given by Article 2(2) of the Protocol." ;
    tmk:upstreamRef "TMR1995/r17A.2/office-of-origin" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/priority-date> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
