    tmk:contentHash "sha256:68fa334f92ec64fe837e9cee4b7019aaba07d4a8ad8bd6edda59468d557e7644" ;
    tmk:ordinal 15 ;
    tmk:text "to permit proper examination of the trade mark, the Registrar may, by notification to the applicant, require the applicant to give to the Registrar:" ;
    tmk:upstreamRef "TMR1995/r4.3~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:20c8409bc208b28ffac8de86e6b5bae4e76672607309a0670fbd453b78fa9d11" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of paragraph 27(3)(b) of the Act, the following subregulations set out the manner of specifying, in an application for the registration of a trade mark, the goods and/or services in respect of which registration is sought." ;
    tmk:upstreamRef "TMR1995/r4.4(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(6)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
