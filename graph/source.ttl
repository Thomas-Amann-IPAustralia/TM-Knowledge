    tmk:contentHash "sha256:0a1fefd4b38154c6d99c4541fd04416d35e2daf474d3e496809e5ef1cd588c46" ;
    tmk:ordinal 15 ;
    tmk:text "(b) consent that can be reasonably inferred from the conduct of a relevant person." ;
    tmk:upstreamRef "TMA1995/s122A(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:44eb57176bc08f7e04c8e421e2d12937f1fd177a67b209f0680128172a47228d" ;
    tmk:ordinal 16 ;
    tmk:text "(3) In determining whether a relevant person mentioned in subparagraph (1)(c)(iii) or (iv) was permitted to use the trade mark, disregard how that permission arose, for example:" ;
    tmk:upstreamRef "TMA1995/s122A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:29010bcc874bc7f47c2f8a5f9fe5c6d19fff056687e5303b16b33ec25818d1ae" ;
    tmk:ordinal 17 ;
    tmk:text "(a) whether it arose directly or indirectly; or" ;
    tmk:upstreamRef "TMA1995/s122A(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
