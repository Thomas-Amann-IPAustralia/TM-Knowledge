    tmk:ordinal 1 ;
    tmk:text "(1) A person may apply to the Registrar to extend the period for filing, under subsection 52A(1) of the Act, a notice of intention to defend." ;
    tmk:upstreamRef "TMR1995/r5.13A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13A(2)> a tmk:LegislativeUnit ;
