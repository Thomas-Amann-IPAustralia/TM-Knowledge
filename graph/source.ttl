    tmk:ordinal 5 ;
    tmk:text "(ii) that is a protected international trade mark; or" ;
    tmk:upstreamRef "TMR1995/r17A.21(1)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.21(1)(b)(iii)> a tmk:LegislativeUnit ;
