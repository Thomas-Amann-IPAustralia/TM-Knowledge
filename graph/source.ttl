    tmk:contentHash "sha256:5bc6849712bfb0ec41743f787c529878a1586cfac7c6be43a80ce94c569bf76d" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part33/1/1/1/prov/0> ;
    tmk:headingPath "1.1",
        "33.1. What is a collective trademark?",
        "Part 33 Collective Trade Marks" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part33/1> ;
    tmk:ordinal 2 ;
    tmk:partId "Part33" ;
    tmk:text "Section 164 states: An application for the registration of a collective trade mark must be made by the association to which the mark belongs." ;
    tmk:upstreamRef "TMM/Part33/1/1/1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part38/1/1/3> a tmk:Chunk ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesPassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/15> ;
    tmk:contentHash "sha256:6cc3b98270dba439a22e7b6765ea12f73936349b4cf5106d94a015d334fc84f6" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part38/1/1/3/internal/0> ;
    tmk:headingPath "1.3",
        "38.1. What is revocation of acceptance?",
        "Part 38 Revocation of Acceptance" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part38/1> ;
    tmk:ordinal 4 ;
    tmk:partId "Part38" ;
    tmk:text "The Examination team leader or Deputy Registrar must notify the applicant in writing of the proposed revocation setting out any conditions under which the application can remain accepted. The applicant is also given the opportunity to be heard in the matter. The applicant has one month to respond to the notice of proposed revocation (holders/owners of International Registrations are given two months to respond). Part 60 The Madrid Protocol - 4.15 Revocation of Acceptance" ;
    tmk:upstreamRef "TMM/Part38/1/1/3" .

