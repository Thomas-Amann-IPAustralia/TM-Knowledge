    tmk:ordinal 8 ;
    tmk:text "the notice of withdrawal must be signed by, or on behalf of, each of those persons." ;
    tmk:upstreamRef "TMR1995/r21.9~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.14/commencement-day> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.14> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fcb9db23a0a40cc30834ea925ba247976b97f86ba596be1790f7108697973994" ;
    tmk:ordinal 2 ;
    tmk:text "commencement day means the day on which Schedule 4 to the Intellectual Property Laws Amendment Act 2015 commences." ;
    tmk:upstreamRef "TMR1995/r22.14/commencement-day" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.14/old-patents-regulations> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.14> ;
