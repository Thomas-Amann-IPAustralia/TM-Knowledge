    tmk:contentHash "sha256:a80a8aa2f84844d11d0af2bbdc8b4ac2aa52bc5e6502e1df9d85964ced920b3a" ;
    tmk:ordinal 3 ;
    tmk:text "(b) if the person subsequently notifies in writing another address to the Registrar—that other address." ;
    tmk:upstreamRef "TMA1995/s215(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s22(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d91d0f4d81fd3d4f62edff6ec5363436c1378c321d5d2cba9f16d5b1274ad3f5" ;
    tmk:text "(1) The registered owner of a trade mark may, subject only to any rights appearing in the Register to be vested in another person, deal with the trade mark as its absolute owner and give in good faith discharges for any consideration for that dealing." ;
    tmk:upstreamRef "TMA1995/s22(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s22(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:524878ecfb29e3a0d748f697dd7badf9d9ae817b98b74b96aedbc2147503494b" ;
    tmk:text "(2) This section does not protect a person who deals with the registered owner otherwise than:" ;
    tmk:upstreamRef "TMA1995/s22(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s22(2A)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fa69de87931b96e268de5c2408a39c0a2e0d1d375fe5d5625646eab8f9d3b3d4" ;
    tmk:text "(2A) Despite subsection (1), the recording in the Register of a right that is a PPSA security interest does not affect a dealing with a trade mark." ;
    tmk:upstreamRef "TMA1995/s22(2A)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s22(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d579a0f57797dceb7ac65f96c8438bcef0d59b31f74c9878be0222b85bc07e6c" ;
    tmk:text "(3) Equities in relation to a registered trade mark may be enforced against the registered owner, except to the prejudice of a purchaser in good faith for value." ;
    tmk:upstreamRef "TMA1995/s22(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s22(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:85abb7c76b6ec7e80b51de6850d50cc86b6ff6c11fd3852b3a47d283455d5b2a" ;
    tmk:text "(4) Subsection (3) does not apply in relation to an equity that is a PPSA security interest." ;
    tmk:upstreamRef "TMA1995/s22(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s221(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:da1bc3316afeea316ec4553de683224e01b5645bc874091ed9b45e9ad2d91ba6" ;
    tmk:text "(3) If a party is ordered to pay the costs of another party, the costs may be recovered in a court of competent jurisdiction as a debt due by the first party to the other party." ;
    tmk:upstreamRef "TMA1995/s221(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
