    tmk:ordinal 22 ;
    tmk:text "(a) that there has been honest concurrent use of the 2 trade marks; or" ;
    tmk:upstreamRef "TMR1995/r4.15A(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(3)(b)> a tmk:LegislativeUnit ;
