    tmk:contentHash "sha256:0e103fa1b65e23c4d0e436d892544489be598b404a730874a4b19299c4a18298" ;
    tmk:ordinal 27 ;
    tmk:text "(8) After the time specified in the regulations, a reference in this section to an address includes a reference to an electronic address." ;
    tmk:upstreamRef "TMA1995/s215(8)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(9)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0103422eb06daadfe1671602f02c4d78d96eb951c82ee23daa8374c8dc9779e1" ;
    tmk:ordinal 28 ;
    tmk:text "(9) The time specified under subsection (8) must be later than the day on which the regulations are registered under the Legislation Act 2003." ;
    tmk:upstreamRef "TMA1995/s215(9)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
