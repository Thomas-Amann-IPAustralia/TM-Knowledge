    tmk:ordinal 2 ;
    tmk:text "(a) consider the holder’s response; and" ;
    tmk:upstreamRef "TMR1995/r17A.18(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.18(1)(b)> a tmk:LegislativeUnit ;
