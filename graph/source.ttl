    tmk:ordinal 2 ;
    tmk:text "Note: For registered trade mark and registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s185(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s185(2)> a tmk:LegislativeUnit ;
