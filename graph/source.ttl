    tmk:ordinal 6 ;
    tmk:text "Note: For limitations see section 6." ;
    tmk:upstreamRef "TMA1995/s33(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:649e269d5e80491d4821d08b0f84e7de75c3ebb82a4ae78e4a315784e27357f8" ;
    tmk:ordinal 8 ;
    tmk:text "(a) the application has not been made in accordance with this Act; or" ;
    tmk:upstreamRef "TMA1995/s33(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> ;
