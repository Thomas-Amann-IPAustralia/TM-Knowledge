    tmk:ordinal 9 ;
    tmk:text "(a) a transliteration of the characters into roman letters, using the recognised system of romanisation of the characters (if any); and" ;
    tmk:upstreamRef "TMR1995/r4.3(6)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(6)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
