    tmk:contentHash "sha256:4b55f732a397c8e99627cc59bc668dc7b4abe6b2c2fbd6edcfdfc52d63695069" ;
    tmk:ordinal 11 ;
    tmk:text "(a) the reference in paragraph 127(b) of the Act to a defendant having applied under subsection 92(3) for an order directing the Registrar to remove a trade mark from the Register is taken to be a reference to the defendant having applied under subregulation 17A.48C(3) for an order directing the Registrar to cease protection; and" ;
    tmk:upstreamRef "TMR1995/r17A.39(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8d299af515f7f424ec6cbb98498330a1e08ff3407e2d923aa0984bc5d9ef8b44" ;
    tmk:ordinal 12 ;
    tmk:text "(b) the reference in paragraph 129(1)(b) of the Act to a trade mark alleged to be registered is taken to be a reference to a trade mark alleged to be a protected international trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.39(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(3)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
