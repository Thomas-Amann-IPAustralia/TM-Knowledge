    tmk:ordinal 1 ;
    tmk:text "change of ownership includes assignment or transmission." ;
    tmk:upstreamRef "TMR1995/r17A.2/change-of-ownership" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/contracting-party-of-the-holder> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
