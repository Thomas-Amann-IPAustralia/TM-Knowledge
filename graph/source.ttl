    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b600d7091d50331b7ed82472a556a9ac41a2f12dfdf3549807ab0bb64438a4c5" ;
    tmk:ordinal 10 ;
    tmk:text "(b) the determination of an appeal from such a decision." ;
    tmk:upstreamRef "TMA1995/s228(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:75d207b801e9080ee707bbb15f986145b6742a68d7a1f0b26ecaa5d2a5bd87e5" ;
    tmk:ordinal 6 ;
    tmk:text "the application of the trade mark or the other act is taken, for the purposes of this Act, to constitute use of the trade mark in relation to the export goods or export services." ;
    tmk:upstreamRef "TMA1995/s228~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:36af5abadbc25b095d87682288444f42ee78fd3f55f70343e894987bcfa964d7" ;
    tmk:ordinal 7 ;
    tmk:text "Note: For applied to or in relation to goods and applied in relation to services see section 9." ;
    tmk:upstreamRef "TMA1995/s228~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:65acd1629f2e15299f5e557ffec02c3e4e38cd3f0c9a8d64d5fc3899813ac3c7" ;
    tmk:ordinal 1 ;
    tmk:text "If the particulars entered in the Register under paragraph 207(2)(a) in respect of an existing registered mark include particulars of a disclaimer made (under section 32 of the repealed Act) by the registered proprietor of the mark about the exclusive right to use a specified part of the mark, that disclaimer has effect as if it were a disclaimer made under section 74 of this Act." ;
    tmk:upstreamRef "TMA1995/s238~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4101ae20ff15a88819162b840ff47f43c6d70f3cf9d3f639a4f89b709ae37195" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For existing registered mark see section 6." ;
    tmk:upstreamRef "TMA1995/s238~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s239A> ;
