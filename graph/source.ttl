    tmk:ordinal 9 ;
    tmk:text "(b) at a hearing; or" ;
    tmk:upstreamRef "TMR1995/r17A.48B(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48B(3)(c)> a tmk:LegislativeUnit ;
