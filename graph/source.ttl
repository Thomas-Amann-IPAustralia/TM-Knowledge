    tmk:ordinal 2 ;
    tmk:text "(a) a trade mark is applied in Australia:" ;
    tmk:upstreamRef "TMA1995/s228(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228(1)(a)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
    tmk:authorityKind "law" ;
