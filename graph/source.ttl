    tmk:ordinal 27 ;
    tmk:text "(ii) the similar services or closely related goods; and" ;
    tmk:upstreamRef "TMA1995/s44(4)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
