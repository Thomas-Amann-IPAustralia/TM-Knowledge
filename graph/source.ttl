    tmk:ordinal 16 ;
    tmk:text "(b) the priority date for the registration of the applicant’s trade mark in respect of the applicant’s services is not earlier than the priority date for the other trade mark in respect of the similar services or closely related goods." ;
    tmk:upstreamRef "TMR1995/r4.15A(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(2)(b)~1> a tmk:LegislativeUnit ;
