    tmk:ordinal 3 ;
    tmk:text "(i) a trade mark registered by another person in respect of similar goods or closely related services; or" ;
    tmk:upstreamRef "TMA1995/s44(1)(a)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(1)(a)(ii)> a tmk:LegislativeUnit ;
