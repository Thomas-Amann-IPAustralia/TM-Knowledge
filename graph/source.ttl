    tmk:ordinal 1 ;
    tmk:text "(1) If, under a provision of this Act, an application may be made to the Administrative Review Tribunal for the review of a decision of a person:" ;
    tmk:upstreamRef "TMA1995/s227(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7a9c73f99a392c566ec297770c19e3214c515c2c879f372c781fa82f337fb520" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the person must give a written notice of the decision to any person affected by it; and" ;
    tmk:upstreamRef "TMA1995/s227(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:da66074d5a86fa7665925580bf19768eec7ef26eed7f4543985d3be7ba5da7ab" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the notice must include a statement to the effect that, subject to the Administrative Review Tribunal Act 2024, application may be made to the Administrative Review Tribunal for the review of the decision to which the notice relates by or on behalf of the person or persons whose interests are affected by the decision." ;
    tmk:upstreamRef "TMA1995/s227(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f619e767a728ea149791f6536beb8594c14016d460b7d9593107939b3268eba7" ;
    tmk:ordinal 4 ;
    tmk:text "(2) Failure to comply with subsection (1) in relation to a decision does not affect the validity of the decision." ;
    tmk:upstreamRef "TMA1995/s227(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227> ;
