    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a34e3b8c2593744bab18844621cf3d9cbeaa686122245ae126eed8ed3326ed70" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the regulations under that Act that were in force immediately before its repeal." ;
    tmk:upstreamRef "TMA1995/s16(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16(1)(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s16> ;
