    tmk:contentHash "sha256:919d9c6e6d562ea06898945b64a7e62921105df58c61cc26cbef5185a81b29a5" ;
    tmk:ordinal 8 ;
    tmk:text "(iv) a person permitted to use the trade mark by an authorised user who has power to give such permission under paragraph 26(1)(f); or" ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)(iv)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)(v)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
