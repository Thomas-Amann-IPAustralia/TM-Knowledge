    tmk:ordinal 4 ;
    tmk:text "(c) some or all of the goods or services covered by the registered trade mark are covered by the protected international trade mark." ;
    tmk:upstreamRef "TMR1995/r17A.54(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.54(2)> a tmk:LegislativeUnit ;
