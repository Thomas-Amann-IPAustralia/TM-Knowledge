    tmk:ordinal 10 ;
    tmk:text "(e) if applications to register the trade mark were made in more than 1 Convention country—from (and including) the day on which the earliest of those applications was made." ;
    tmk:upstreamRef "TMR1995/r17A.4(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.41~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:88ce744da0203389ad12c0e0dbacef82ac17948bb796c204c2429fcb729f2ef7" ;
    tmk:ordinal 1 ;
    tmk:text "If the International Bureau cancels, in whole or in part, the international registration of a trade mark that is a protected international trade mark, the trade mark ceases to be a protected international trade mark, to the extent of the cancellation, when the international registration is cancelled." ;
    tmk:upstreamRef "TMR1995/r17A.41~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7a9878b0f561145e7ce7944ace1be1d5bcc9b5b9f50ec5fdfde8ace356474145" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If the international registration of a trade mark that is a protected international trade mark is not renewed, the trade mark ceases to be a protected international trade mark when the international registration expires." ;
    tmk:upstreamRef "TMR1995/r17A.42(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42(2)> a tmk:LegislativeUnit ;
