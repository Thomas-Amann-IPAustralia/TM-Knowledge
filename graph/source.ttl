    tmk:ordinal 2 ;
    tmk:text "(a) in accordance with Schedule 8; or" ;
    tmk:upstreamRef "TMR1995/r21.13(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.13(1)(b)> a tmk:LegislativeUnit ;
