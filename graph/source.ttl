    tmk:ordinal 11 ;
    tmk:text "Application for registration under repealed Act" ;
    tmk:upstreamRef "TMA1995/s11~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d5ee1be85f8d7b7cca80622d2bf6ef2d144027adf84d783afcd80a5d9a8112ec" ;
    tmk:ordinal 2 ;
    tmk:text "(a) if the trade mark is registered—the date of registration of the trade mark in respect of those goods or services; or" ;
    tmk:upstreamRef "TMA1995/s12(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fe74107817d8c0471d5fe5271bafea40d13c7740d42cb0a37a1d609a09867c52" ;
    tmk:ordinal 3 ;
    tmk:text "(b) if the registration of the trade mark is being sought—the day that would be the date of registration of the trade mark in respect of those goods or services if the trade mark were registered." ;
    tmk:upstreamRef "TMA1995/s12(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5330fa04caf56f950025e213a65516a72c046d0306afb263059971822f9bbf28" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A person infringes a registered trade mark if the person uses as a trade mark a sign that is substantially identical with, or deceptively similar to, the trade mark in relation to goods or services in respect of which the trade mark is registered." ;
    tmk:upstreamRef "TMA1995/s120(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:645e5b179e62d4868525c62b411d0565efe4a06da511fd3b5d37947172776d43" ;
    tmk:ordinal 2 ;
    tmk:text "Note 1: For registered trade mark see section 6." ;
    tmk:upstreamRef "TMA1995/s120(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(1)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7922eee9d23edc7e9cbeb9abcd12bdfbb09bb9d92b77a683a4b05ded6cbc5be2" ;
    tmk:ordinal 3 ;
    tmk:text "Note 2: For deceptively similar see section 10." ;
    tmk:upstreamRef "TMA1995/s120(1)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(1)~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f904ac3de044959b37a9aa708db51719a2f3f9f7840fb984b8b364a2abe8beb8" ;
    tmk:ordinal 4 ;
    tmk:text "Note 3: In addition, the regulations may provide for the effect of a protected international trade mark: see Part 17A." ;
    tmk:upstreamRef "TMA1995/s120(1)~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9ef2be88525f8804eb9975dbc7694951965bcb92dc230b93576fb123ae43861f" ;
    tmk:ordinal 6 ;
    tmk:text "(a) goods of the same description as that of goods (registered goods) in respect of which the trade mark is registered; or" ;
    tmk:upstreamRef "TMA1995/s120(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1426bd1fd4e45e985919b1875323e6f0c6514fed276efa029bac82605439e0b9" ;
    tmk:ordinal 7 ;
    tmk:text "(b) services that are closely related to registered goods; or" ;
    tmk:upstreamRef "TMA1995/s120(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3f685b3d0d6b84b099b37ee107b7631ccdce2bd000d607aecb0ce6a23b71fc30" ;
    tmk:ordinal 8 ;
    tmk:text "(c) services of the same description as that of services (registered services) in respect of which the trade mark is registered; or" ;
    tmk:upstreamRef "TMA1995/s120(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(2)(d)> a tmk:LegislativeUnit ;
