    tmk:ordinal 7 ;
    tmk:text "(c) the trade mark is a protected international trade mark;" ;
    tmk:upstreamRef "TMR1995/r17A.4(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(3)> a tmk:LegislativeUnit ;
