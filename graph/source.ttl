    tmk:ordinal 1 ;
    tmk:text "The hours of business of the Trade Marks Office and each suboffice (if any) of the Trade Marks Office are from 9 am to 5 pm on each day other than:" ;
    tmk:upstreamRef "TMR1995/r19.1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.1(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.1> ;
