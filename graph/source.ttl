    tmk:ordinal 1 ;
    tmk:text "(1) In spite of section 120, a person who uses a registered trade mark in relation to goods does not infringe the trade mark if:" ;
    tmk:upstreamRef "TMA1995/s122A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:99a71aef204d15425f70ff455ce84f2624c9621a4215cfe809e811886c498684" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the goods are similar to goods in respect of which the trade mark is registered; and" ;
    tmk:upstreamRef "TMA1995/s122A(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bbd8e88cafc985e377f954621df9e76b4293525f333587b09129064b2fd50b28" ;
    tmk:ordinal 3 ;
    tmk:text "(b) before the time of use, the person had made reasonable inquiries in relation to the trade mark; and" ;
    tmk:upstreamRef "TMA1995/s122A(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:617f7688d48d159a062d65c269a9fc2558da2b9a3537a2bbd86e8960e7186a2d" ;
    tmk:ordinal 4 ;
    tmk:text "(c) at the time of use, a reasonable person, after making those inquiries, would have concluded that the trade mark had been applied to, or in relation to, the goods by, or with the consent of, a person (a relevant person) who was, at the time of the application or consent (as the case may be):" ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ddbf6570b0be12f0917c215e52a91d417dad91fd9c205ce419ac54aca272b1c7" ;
    tmk:ordinal 5 ;
    tmk:text "(i) the registered owner of the trade mark; or" ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
