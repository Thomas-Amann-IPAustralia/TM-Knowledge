<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5eb71be3696ab71d9d7066384423061c4d8bc2710f32e8c3b7abf1f175cd6c45" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A registered trade mark, or a trade mark whose registration is being sought, may be assigned or transmitted in accordance with this section." ;
    tmk:upstreamRef "TMA1995/s106(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:942df1557c351f5067bdb1c030463e162bf5b41cfede4e3f8482d3fce327bc9f" ;
    tmk:ordinal 3 ;
    tmk:text "(3) The assignment or transmission may be with or without the goodwill of the business concerned in the relevant goods and/or services." ;
    tmk:upstreamRef "TMA1995/s106(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s12(2)> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMA1995/s12(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
