    tmk:text "(a) in writing; or" ;
    tmk:upstreamRef "TMR1995/r17A.48B(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48B(3)(b)> a tmk:LegislativeUnit ;
