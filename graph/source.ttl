    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:28613b079173903cc13aa2420903dcf3d01dca1e0ff9bfc90984e9699ef248ba" ;
    tmk:ordinal 14 ;
    tmk:text "Note: For collective trade mark see section 162." ;
    tmk:upstreamRef "TMA1995/s27(2A)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
