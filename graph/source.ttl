    tmk:ordinal 2 ;
    tmk:text "(a) except as provided by paragraph (b)—15 months from the date of that report (whether or not a further report is made under regulation 4.10); or" ;
    tmk:upstreamRef "TMR1995/r4.12(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.12(2)> a tmk:LegislativeUnit ;
