        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.18> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3feefd166abbd2247ecda8aa7396c81f55610f847b356342f04650966d13a117" ;
    tmk:ordinal 1 ;
    tmk:text "(1) In opposition proceedings relating to an application in respect of which the applicant claims a right of priority, an opponent may request the Registrar for a copy of an earlier application to be made available." ;
    tmk:upstreamRef "TMR1995/r5.18(1)" .

