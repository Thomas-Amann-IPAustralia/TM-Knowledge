    tmk:contentHash "sha256:8602294959d1cafeb02ee549e93913347ec77834aa7afae5b85ff3f0724cb1bb" ;
    tmk:ordinal 7 ;
    tmk:text "(c) other prescribed matters." ;
    tmk:upstreamRef "TMA1995/s207(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1a57771da14b7965ae52273c705e4377e584c23b7ebe3836ce552052618a7731" ;
    tmk:ordinal 8 ;
    tmk:text "(3) If 2 or more trade marks were entered as associated trade marks in the old register, no equivalent entry designating them as associated trade marks is to be made in the Register." ;
    tmk:upstreamRef "TMA1995/s207(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:34491267f06a075ab1f2441535f1d7ebdd116bdb0f5ae13e35bda7437cd5c9f3" ;
    tmk:ordinal 9 ;
    tmk:text "Note: For old register see section 6." ;
    tmk:upstreamRef "TMA1995/s207(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
