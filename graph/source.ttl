    tmk:ordinal 2 ;
    tmk:text "Contracting Party of the holder has the meaning given by Rule 1(xxvibis) of the Madrid Regulations." ;
    tmk:upstreamRef "TMR1995/r17A.2/contracting-party-of-the-holder" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/date-of-international-registration> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fba2b21759d87ef0daa04daa4ef4641d1054ad8fda14c4c0d11aaf84c89ae4c2" ;
    tmk:ordinal 3 ;
    tmk:text "date of international registration means the date recorded in the International Register as the international registration date for a trade mark in respect of which a request was made under Article 3ter (1) of the Protocol for extension of protection to Australia." ;
    tmk:upstreamRef "TMR1995/r17A.2/date-of-international-registration" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/date-of-recording> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
