    tmk:ordinal 5 ;
    tmk:text "(3) The Registrar must publish in accordance with the regulations:" ;
    tmk:upstreamRef "TMA1995/s110(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
