    tmk:ordinal 10 ;
    tmk:text "(4) All particulars entered in the Register under paragraph (2)(a) are taken to have been so entered on 1 January 1996." ;
    tmk:upstreamRef "TMA1995/s207(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
