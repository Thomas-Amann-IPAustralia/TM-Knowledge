    tmk:ordinal 20 ;
    tmk:text "(b) must be taken to be part of the application." ;
    tmk:upstreamRef "TMR1995/r4.3(9)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(c)> a tmk:LegislativeUnit ;
