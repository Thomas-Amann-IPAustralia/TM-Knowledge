    tmk:ordinal 3 ;
    tmk:text "(i) to, or in relation to goods that are to be exported from Australia (export goods); or" ;
    tmk:upstreamRef "TMA1995/s228(1)(a)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228(1)(a)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
