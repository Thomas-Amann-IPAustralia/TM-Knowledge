    tmk:contentHash "sha256:c2770b848f030be5cb8d734653ccc72f3bac4b4fe9a4e9cf690b547faf1d19d7" ;
    tmk:ordinal 2 ;
    tmk:text "(2) Subject to any direction by the Registrar, a Deputy Registrar has all the powers and functions of the Registrar, except the powers of delegation under section 206." ;
    tmk:upstreamRef "TMA1995/s205(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0aae7684d154eb32b109eecec0dfff1755547a1fd468e6c239a417a516965584" ;
    tmk:ordinal 3 ;
    tmk:text "(3) A power or function of the Registrar, when exercised by a Deputy Registrar, is taken to have been exercised by the Registrar." ;
    tmk:upstreamRef "TMA1995/s205(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205> ;
