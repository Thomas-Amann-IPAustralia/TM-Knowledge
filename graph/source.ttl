    tmk:lastAmended "2025-04-02" ;
    tmk:partId "Part55" ;
    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/5.-full-costs-where-certificate-of-use-of-a-trade-mark-provided-to-removal-applicant"^^xsd:anyURI ;
    tmk:upstreamRef "TMM/Part55/5" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part55/5%231> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesPassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part48/15> ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s105(2)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92> ;
    tmk:contentHash "sha256:3cb100e6a7d266ef3a5ef98b7a4128bbd5344f09545a516e49a05229309dffb1" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part55/5%231/internal/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part55/5%231/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part55/5%231/prov/1> ;
    tmk:headingPath "Part 55 Costs",
        "Part 55.5. Full costs where certificate of use of a trade mark provided to removal applicant" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part55/5> ;
    tmk:ordinal 1 ;
    tmk:partId "Part55" ;
    tmk:text "Trade Marks Act 1995 Trade Marks Regulations 1995 Subreg 21.13(1) provides an exception to the determination of costs against the scale in Schedule 8. A successful opponent to an application under Section 92 may be entitled to have its full costs paid by the removal applicant where the current proceedings have been determined in favour of the opponent and a certificate attesting to use during the alleged period of non-use (provided by the Registrar or a court in earlier proceedings) was notified to the removal applicant either before or on filing the notice of opposition in the current proceedings (subsection 105(2)). Part 48 Removal of a Trade Mark from the Register for Non-Use - 15. Certificate - Use of a trade mark" ;
    tmk:upstreamRef "TMM/Part55/5#1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part55/x-annex-a1---taxing-of-costs-in--multiple--oppositions-relying-on-same-evidence> a tmk:Page ;
