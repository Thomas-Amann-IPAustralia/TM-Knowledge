<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:af7bb753a645d7712c526f090ec38a5a60a550cfa992288f373d6285589edb3e" ;
    tmk:ordinal 11 ;
    tmk:text "(2) For the purposes of paragraph 1(b), the opponent is taken to have rebutted the allegation that the trade mark has not, at any time before the period referred to in that paragraph, been used, or been used in good faith, by its registered owner in relation to the relevant goods and/or services if:" ;
    tmk:upstreamRef "TMA1995/s100(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:197e3a8a4b068cb6462f927c69926c455e5bcbd90d461217ca218cd81f902006" ;
    tmk:ordinal 6 ;
    tmk:text "(3) If satisfied that it is reasonable to do so, the Registrar or the court may decide that the trade mark should not be removed from the Register even if the grounds on which the application was made have been established." ;
    tmk:upstreamRef "TMA1995/s101(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4018de6c45bacd23b2d8e27bab08e32ec5cf6ed436bfafbb364bda07422a4dea" ;
    tmk:ordinal 7 ;
    tmk:text "(4) Without limiting the matters the Registrar may take into account in deciding under subsection (3) not to remove a trade mark from the Register, the Registrar may take into account whether the trade mark has been used by its registered owner in respect of:" ;
    tmk:upstreamRef "TMA1995/s101(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s105(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
