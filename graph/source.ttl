    tmk:contentHash "sha256:086ed73d3435fced03b437815a0d66b9bfedbdf4e43790926ca89017a06a894d" ;
    tmk:lastAmended "2025-01-13" ;
    tmk:partId "Part11" ;
    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/3.-examination-of-applications-claiming-convention-priority"^^xsd:anyURI ;
    tmk:upstreamRef "TMM/Part11/3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7/7/1> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(2)> ;
    tmk:contentHash "sha256:5196ad87eccf21a5fc48cf20aa8b8c1ea7d7d67a600603ed753ae24dccd1a2e6" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/7/7/1/prov/0> ;
    tmk:headingPath "11.7. Effect on registration of a claim for priority based on an earlier application",
        "7.1",
        "Part 11 Convention Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7> ;
    tmk:ordinal 2 ;
    tmk:partId "Part11" ;
    tmk:text "Under subsection 72(2) the registration of a trade mark will have effect, where a convention claim applies in respect of particular goods and/or services, from (and including) the day on which application in the Convention country was made in respect of those particular goods and/or services. Where an application was made in respect of the same goods and/or services in more than one Convention country, registration of the trade mark will have effect from (and including) the day on which the earliest of those applications was made." ;
    tmk:upstreamRef "TMM/Part11/7/7/1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7/7/3> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(3)> ;
    tmk:contentHash "sha256:fcba72b8e9e3ba02d700f48c1f28bdfbd113f7953c86b1cbbd2a109276e3000f" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/7/7/3/prov/0> ;
    tmk:headingPath "11.7. Effect on registration of a claim for priority based on an earlier application",
        "7.3",
        "Part 11 Convention Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7> ;
    tmk:ordinal 4 ;
    tmk:partId "Part11" ;
    tmk:text "For the purposes of renewal, however, the registration will expire 10 years from the date of filing in Australia (subsection 72(3)). Where an application is accepted or a trade mark registered where a claim to a right of priority was wrongly made the applicant may leave their acceptance and/or registration open to dispute. The onus now lies with the applicant to make sure the correct claim/s have been made in respect of claims to a right of priority." ;
    tmk:upstreamRef "TMM/Part11/7/7/3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/2> a tmk:Page ;
    rdfs:label "2. Why file a divisional application?"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
