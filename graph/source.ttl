    tmk:ordinal 10 ;
    tmk:text "(b) be filed, together with any prescribed document, in accordance with the regulations; and" ;
    tmk:upstreamRef "TMA1995/s27(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(2)(c)~1> a tmk:LegislativeUnit ;
