    tmk:ordinal 2 ;
    tmk:text "(a) particulars of registration were entered in the Register under section 69 before the end of the period of 10 years after the filing date of the application for registration; or" ;
    tmk:upstreamRef "TMA1995/s74A(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74A(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74A> ;
