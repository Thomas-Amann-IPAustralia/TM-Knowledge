    tmk:contentHash "sha256:0e95580a69cb865ad4dd9ac1e77a1c26611a2343b8e90fe14dfdf486eec1007e" ;
    tmk:ordinal 12 ;
    tmk:text "(2) An application for the registration of a trade mark under the repealed Act was pending immediately before 1 January 1996 if before that day:" ;
    tmk:upstreamRef "TMA1995/s11(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11> ;
