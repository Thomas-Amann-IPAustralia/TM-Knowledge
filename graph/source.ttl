    tmk:text "(a) asking the person for written submissions; or" ;
    tmk:upstreamRef "TMR1995/r21.15(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(2)(b)> a tmk:LegislativeUnit ;
