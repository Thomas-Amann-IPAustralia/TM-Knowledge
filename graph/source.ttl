    tmk:ordinal 3 ;
    tmk:text "(a) must be in accordance with the regulations; and" ;
    tmk:upstreamRef "TMA1995/s92(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(2)(b)> a tmk:LegislativeUnit ;
