    tmk:ordinal 6 ;
    tmk:text "(c) a trade mark is taken also to be applied in relation to goods or services if it is used:" ;
    tmk:upstreamRef "TMA1995/s9(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)(c)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d993fc419ab09a32e10f772cc8646c19662b195d4a9bfde9584af089e44f9291" ;
    tmk:ordinal 7 ;
    tmk:text "(i) on a signboard or in an advertisement (including a televised advertisement); or" ;
    tmk:upstreamRef "TMA1995/s9(1)(c)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)(c)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
