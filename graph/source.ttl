    tmk:contentHash "sha256:8fad24879553034a5c34f2983b5ed34166270c51b22305059013b1a036e3e06c" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the authorised user may (subject to subsection (2)) bring an action for infringement of the trade mark:" ;
    tmk:upstreamRef "TMA1995/s26(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
