    tmk:ordinal 3 ;
    tmk:text "(b) in relation to goods and/or services with which all of them are connected in the course of trade;" ;
    tmk:upstreamRef "TMA1995/s28(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c9865ae8fec08d5b59dfd08c114e729ee28e0cd1d204a206cdeb50b55266db52" ;
    tmk:ordinal 3 ;
    tmk:text "(b) within 6 months after the day on which that application, or the first of those applications, was made, that person or another person (successor in title) of whom that person is a predecessor in title applies to the Registrar for the registration of the trade mark in respect of some or all of the goods and/or services in respect of which registration was sought in that country or those countries;" ;
    tmk:upstreamRef "TMA1995/s29(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1c9572fa8264f82728da33c25478df23029dde4c78e90e3d3861efbd7ccc3c90" ;
    tmk:ordinal 8 ;
    tmk:text "(b) if applications to register the trade mark were made in more than one Convention country—from (and including) the day on which the earliest of those applications was made." ;
    tmk:upstreamRef "TMA1995/s29(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(b)> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMA1995/s29(b)" .

