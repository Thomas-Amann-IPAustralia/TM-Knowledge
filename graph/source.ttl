<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/19> a tmk:Page ;
    rdfs:label "4.19 Cessation or Limitation of Protection"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
