    tmk:contentHash "sha256:595d53b825407be60421e9c1351be4f12003418867b58b77544234bb57da9dc2" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The response may:" ;
    tmk:upstreamRef "TMR1995/r4.9(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9> ;
    tmk:authorityKind "law" ;
