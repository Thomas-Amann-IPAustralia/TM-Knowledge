    tmk:ordinal 7 ;
    tmk:text "(b) the registration of the beneficiary as the owner of the trade mark." ;
    tmk:upstreamRef "TMA1995/s110(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s111~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s111> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d01646e32f685196b7d3497bb5f947d9eb39ee23e14c38450f86fd7a86056019" ;
    tmk:ordinal 1 ;
    tmk:text "If an application made under section 107 or 109 in relation to the assignment or transmission of a trade mark complies with this Act, the Registrar must notify in accordance with the regulations any person recorded under Part 11 as claiming an interest in, or a right in respect of, the trade mark." ;
    tmk:upstreamRef "TMA1995/s111~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s112(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s112> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:61296c8a5cdd947fccf32f413fd23c74d4649ac726362c7e74e26c3cbbba9cad" ;
    tmk:ordinal 2 ;
    tmk:text "(a) for recording in the Register claims to interests in, and rights in respect of, registered trade marks that may not be so recorded under another Part; and" ;
    tmk:upstreamRef "TMA1995/s112(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s112(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s112> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6ef146a9fe0960e8c1b063c4443fc63c846c6889101508cf589eba7473ad46c3" ;
    tmk:ordinal 3 ;
    tmk:text "(b) for the Registrar to keep a record of claims to interests in, and rights in respect of, trade marks for which registration is sought." ;
    tmk:upstreamRef "TMA1995/s112(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s112(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s112> ;
