    tmk:ordinal 6 ;
    tmk:text "(2) If the applicant is the successor in title to the person who made the earlier application, the Registrar may notify the applicant that the applicant is required to file documentary evidence that is sufficient to establish the passing of title to the applicant." ;
    tmk:upstreamRef "TMR1995/r4.11(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.12(1)(a)> a tmk:LegislativeUnit ;
