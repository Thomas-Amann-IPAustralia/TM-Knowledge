    tmk:ordinal 4 ;
    tmk:text "Note: For registered owner and approved form see section 6." ;
    tmk:upstreamRef "TMA1995/s71(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s71~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s71> ;
