    tmk:ordinal 3 ;
    tmk:text "(b) if the earlier application is not in English:" ;
    tmk:upstreamRef "TMR1995/r17A.19(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.19(1)(b)(i)> a tmk:LegislativeUnit ;
