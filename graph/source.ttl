    tmk:ordinal 16 ;
    tmk:text "Note 1: If the registered owner of the trade mark has authorised another person to use it, any authorised use of the trade mark by that person is taken to be a use of the trade mark by the registered owner (see subsection 7(3))." ;
    tmk:upstreamRef "TMA1995/s100(2)(b)(ii)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)(b)(ii)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7d15db38aed7df06bec461be96bceeae8bb0ee01511b01f7a4c9bafb7b800487" ;
    tmk:ordinal 17 ;
    tmk:text "Note 2: For registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s100(2)(b)(ii)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:aff7e7cd72030f640e97e8e0b205fd0020dc0016385cfc37c51960877f11aa46" ;
    tmk:ordinal 18 ;
    tmk:text "(3) For the purposes of paragraph 1(c), the opponent is taken to have rebutted the allegation that the trade mark has not, at any time during the period referred to in that paragraph, been used, or been used in good faith, by its registered owner in relation to the relevant goods and/or services if:" ;
    tmk:upstreamRef "TMA1995/s100(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
