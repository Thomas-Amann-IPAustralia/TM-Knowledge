    tmk:ordinal 1 ;
    tmk:text "(1) If there is a change in the name of a person who has filed an application, notice or request, the person must notify the Registrar in writing of the change." ;
    tmk:upstreamRef "TMA1995/s216(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:29aeb916097adb6e983a880c23ac7e14bfa52946d977727cd218ca87c6eeec42" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For file see section 6." ;
    tmk:upstreamRef "TMA1995/s216(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b54a49ab3b5de586013f8b1d542f3efb89777af130a1c83e014d5a5da06d45a2" ;
    tmk:ordinal 3 ;
    tmk:text "(2) If there is a change in the name of:" ;
    tmk:upstreamRef "TMA1995/s216(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e9b08cd6903a2df129eda45983a061b42309c31daeae73146e243fbd7c147ef6" ;
    tmk:ordinal 4 ;
    tmk:text "(a) the registered owner of a registered trade mark; or" ;
    tmk:upstreamRef "TMA1995/s216(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f494ac598cd04b6904d12d4a449f983a0e8aa07349990c7b71b2d97f70aa7ab9" ;
    tmk:ordinal 5 ;
    tmk:text "(b) a person whose claim to an interest in, or to a right in respect of, a trade mark is recorded in the Register;" ;
    tmk:upstreamRef "TMA1995/s216(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s216> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fa6eb53c0a53f6bc821e6c8a6267a8e906c3261c0ee74bcdcb389d1046f9a05c" ;
    tmk:ordinal 6 ;
    tmk:text "the registered owner or the person must notify the Registrar in writing of the change and the Registrar must amend the Register accordingly." ;
    tmk:upstreamRef "TMA1995/s216~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s217A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s217A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:640cc1a0fa68435ffaa17fb1af7eb456efdfbf5f24ba0bdb1595b676ff15a1c2" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar must make available for public inspection prescribed documents that relate to a trade mark while they are held in the Trade Marks Office at or after the time particulars of the application for registration of the trade mark are published under section 30." ;
    tmk:upstreamRef "TMA1995/s217A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s217A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s217A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:24bc43f1e77bac2afb848a9d103c70c30399a6d8dee75d5722ed5ba98880a45d" ;
    tmk:ordinal 2 ;
    tmk:text "(2) A document may be prescribed for the purposes of subsection (1) wholly or partly by reference to the fact that it does not contain information covered by a requirement under section 226A. This does not limit the ways in which documents may be prescribed for those purposes." ;
    tmk:upstreamRef "TMA1995/s217A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s222(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s222> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:907436e0e9d7e225728136fc1452065d64b692a45e72b005758d498345182788" ;
    tmk:ordinal 2 ;
    tmk:text "(a) gives notice of opposition under section 52 or subsection 65A(4), 83A(4) or 224(6); or" ;
    tmk:upstreamRef "TMA1995/s222(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s222(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s222> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f884ea0657d8f24431e02d46e0f251e67ff5bb27b71962b7ca7ce980a0576765" ;
    tmk:ordinal 3 ;
    tmk:text "(b) applies to the Registrar under Part 9 for a trade mark to be removed from the Register;" ;
    tmk:upstreamRef "TMA1995/s222(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s222~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s222> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:08b63f24f67fb38918f0661a7aaa42162b3cef25be956c280ea88459fd35146d" ;
    tmk:ordinal 1 ;
    tmk:text "If a person who neither resides nor carries on business in Australia:" ;
    tmk:upstreamRef "TMA1995/s222~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s222~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s222> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:19aa52982ed2f0ed42161a1c25d46db9fb0ca72ed894144a7b64fbbf04e3ed1c" ;
    tmk:ordinal 4 ;
    tmk:text "the Registrar may require the person to give security for the costs of the proceeding and may, if security is not given, dismiss the proceeding." ;
    tmk:upstreamRef "TMA1995/s222~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fe0b86a19a54426fe57a3169bf6ad1ca223a0ed8357196db0e4a41899c5de4cc" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The regulations may prescribe the fees to be paid for the purposes of this Act and may prescribe different fees in respect of the doing of an act according to the time when the act is done." ;
    tmk:upstreamRef "TMA1995/s223(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3d3b35a696811f2131dbb09401d00b3820d726f22ba42673ced6c6081be76b03" ;
    tmk:ordinal 2 ;
    tmk:text "(2) Prescribed fees are payable in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s223(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(2A)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c841a8c38d3e303a674b98edff90ca9cde7c310a5482c3ca0c989ce67f9d4c5b" ;
    tmk:ordinal 3 ;
    tmk:text "(2A) Without limiting subsection (1), different fees may be prescribed for filing a document with the Trade Marks Office according to the means by which the document is filed." ;
    tmk:upstreamRef "TMA1995/s223(2A)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(2B)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2a3cf394cf6f7ec8913a8931f38fdabdad9cfd59f9791b1513d76462730dd11a" ;
    tmk:ordinal 4 ;
    tmk:text "(2B) Without limiting subsection (1), different amounts of a fee may be prescribed according to the means by which the fee is paid." ;
    tmk:upstreamRef "TMA1995/s223(2B)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(2C)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ec85c3a74ba517f73983d4e92818a54b0d313daeb3343f2dd342bfc278bb071e" ;
    tmk:ordinal 6 ;
    tmk:text "(2C) A fee that must be paid to the Registrar must be paid by a means determined in an instrument under subsection 223AA(1)." ;
    tmk:upstreamRef "TMA1995/s223(2C)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c148428ae1a1905559213b2c321cf714fae0655fbdfa7cda6acfde71920ce436" ;
    tmk:ordinal 8 ;
    tmk:text "(3) The regulations may provide for the consequences (for the purposes of this Act) of failing to pay a fee in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s223(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6c2bc142d8b1b016ce6d596455bfe8f8e7604d99445833a46665d479abe92d7b" ;
    tmk:ordinal 9 ;
    tmk:text "(4) In particular, the regulations may provide that, for the purposes of this Act:" ;
    tmk:upstreamRef "TMA1995/s223(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dd64cd71b9349819d6007d2a02ea2f4a49b82ba18ebdf178858cc2c74aca67d0" ;
    tmk:ordinal 10 ;
    tmk:text "(a) an act is not to be done, or is taken not to have been done, if the fee for doing the act is not paid in accordance with the regulations; or" ;
    tmk:upstreamRef "TMA1995/s223(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(4)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:429e612616d618688908e666110cccab15c4a435194e3fd23fb2b90347241c41" ;
    tmk:ordinal 12 ;
    tmk:text "(c) an application for registration of a trade mark lapses, or is taken to have lapsed, if the fee for filing the application is not paid in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s223(4)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0279702a14e77be4e1495aef0934b8edaffc83ca35129fd0e1db9ad4a1bcb519" ;
    tmk:ordinal 13 ;
    tmk:text "(5) Subsection (4) does not limit subsection (3)." ;
    tmk:upstreamRef "TMA1995/s223(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:58a3011295fd83881ba3aa2b5a892e1962a79cbf825afcee84b392e840236f14" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If the last day of a period provided by this Act (except this section) for doing an act is a day when the Trade Marks Office, or a suboffice of the Trade Marks Office (if any), is not open for business, the act may be done in prescribed circumstances on the next day when the office or suboffice is open for business." ;
    tmk:upstreamRef "TMA1995/s223A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s223A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:01091dff3eadf377bbdfbce9993ee23e37a818c59f21bef2dd343a68892f5bfa" ;
    tmk:ordinal 2 ;
    tmk:text "(2) For the purposes of this section, the Trade Marks Office, or a suboffice of the Trade Marks Office, is taken not to be open for business on a day:" ;
    tmk:upstreamRef "TMA1995/s223A(2)" .

