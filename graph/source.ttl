        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part38/1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part9/1> ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s203>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224>,
