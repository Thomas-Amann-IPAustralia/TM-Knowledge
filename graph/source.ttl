    tmk:contentHash "sha256:73632f288662996bc1cf5cb54a040292aa8f3602a7ec01e44c849be431ab4dce" ;
    tmk:ordinal 12 ;
    tmk:text "Note: In certain circumstances a person cannot oppose the granting of a request under this subsection (see subsection (7))." ;
    tmk:upstreamRef "TMA1995/s83A(4)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(5)> a tmk:LegislativeUnit ;
