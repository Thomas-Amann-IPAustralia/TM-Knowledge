    tmk:contentHash "sha256:02107a300a22cd6724f2d3d7035c636d3b23c9582caa38a980d532f888fd5641" ;
    tmk:ordinal 19 ;
    tmk:text "Note 1: For applicant and predecessor in title see section 6." ;
    tmk:upstreamRef "TMA1995/s41(5)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(5)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:86e890ec424931e7d09365ac26789ff4478bf842908c7a61a39a999697ec38c1" ;
    tmk:ordinal 20 ;
    tmk:text "Note 2: If a predecessor in title had authorised another person to use the trade mark, any authorised use of the trade mark by the other person is taken to be a use of the trade mark by the predecessor in title (see subsection 7(3) and section 8)." ;
    tmk:upstreamRef "TMA1995/s41(5)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s42~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s42> ;
