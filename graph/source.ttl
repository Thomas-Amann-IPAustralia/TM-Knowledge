    tmk:ordinal 6 ;
    tmk:text "decision has the same meaning as in the Administrative Review Tribunal Act 2024." ;
    tmk:upstreamRef "TMA1995/s227/decision" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
