    tmk:ordinal 75 ;
    tmk:text "predecessor in title, in relation to a person who claims to be the owner of a trade mark, means:" ;
    tmk:upstreamRef "TMA1995/s6/predecessor-in-title" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/predecessor-in-title(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8ea266f4e588703e50883fad9660745092ddf3333dab2b87baa39984743ba48d" ;
    tmk:ordinal 76 ;
    tmk:text "(a) if the trade mark was assigned or transmitted to one or more than one other person before it was assigned or transmitted to the firstmentioned person—that other person or any one of those other persons; or" ;
    tmk:upstreamRef "TMA1995/s6/predecessor-in-title(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/predecessor-in-title(b)> a tmk:LegislativeUnit ;
