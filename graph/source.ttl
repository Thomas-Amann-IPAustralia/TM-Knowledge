    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d10f8e243a942fdcb13132c3b814191877be850429c853e9a134c2b8ae54ffe7" ;
    tmk:lastAmended "2025-01-13" ;
    tmk:partId "Part29" ;
