    tmk:upstreamRef "TMR1995/r17A.48R(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48R(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48R> ;
    tmk:authorityKind "law" ;
