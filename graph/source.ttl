    tmk:upstreamRef "TMR1995/r17A.48R(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48S(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
