    tmk:upstreamRef "TMR1995/r4.15(f)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
