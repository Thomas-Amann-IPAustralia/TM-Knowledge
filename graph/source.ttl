    tmk:ordinal 17 ;
    tmk:text "protected international trade mark means a trade mark to which protection resulting from international registration of the mark is extended in Australia in accordance with these Regulations." ;
    tmk:upstreamRef "TMR1995/r17A.2/protected-international-trade-mark" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/protocol> a tmk:LegislativeUnit ;
