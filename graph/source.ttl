    tmk:contentHash "sha256:16e79b37c652e003ab9f0fb7814e783037a999cf7baf9c8d060b1b7b0f2874eb" ;
    tmk:ordinal 5 ;
    tmk:text "Note: For filing date, registered owner and registered trade mark see section 6." ;
    tmk:upstreamRef "TMA1995/s82A(1)(c)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A> ;
