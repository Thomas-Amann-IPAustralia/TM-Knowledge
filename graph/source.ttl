    tmk:ordinal 7 ;
    tmk:text "Note: For use see section 7." ;
    tmk:upstreamRef "TMA1995/s27(1)(b)(iii)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
