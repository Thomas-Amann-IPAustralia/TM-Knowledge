    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:482fdc6a9674180b5fdd113f566b6c12c06e264ddc35c3247a682a6396fbe3d8" ;
    tmk:ordinal 5 ;
    tmk:text "(3) The holder of an IRDA may, before the end of a period mentioned in subregulation (1), or that period as extended under section 224 of the Act or as a result of a previous application of subregulation (4), request the Registrar in writing to extend the period." ;
    tmk:upstreamRef "TMR1995/r17A.20(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20(4)> a tmk:LegislativeUnit ;
