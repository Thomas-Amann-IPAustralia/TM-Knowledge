    tmk:contentHash "sha256:33b2d526f3b891c3f100428733984537197012d370ccd9075b332d546efccfa1" ;
    tmk:ordinal 3 ;
    tmk:text "(3) The Registrar must publish the determination in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s213A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s213A(4)> a tmk:LegislativeUnit ;
