<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part54/3> a tmk:Page ;
    rdfs:label "3. Production of documents"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
