    tmk:ordinal 2 ;
    tmk:text "(a) subsection 44(4); or" ;
    tmk:upstreamRef "TMA1995/s58A(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58A(1)(b)> a tmk:LegislativeUnit ;
