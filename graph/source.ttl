<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224> a tmk:LegislativeProvision ;
    rdfs:label "Extension of time"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
