<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58> a tmk:LegislativeProvision ;
    rdfs:label "Applicant not owner of trade mark"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:783b140e2bc30c3c631731f022e85da62956144beaf975970e48585397f9eb74" ;
    tmk:text "The registration of a trade mark may be opposed on the ground that the applicant is not the owner of the trade mark. Note: For applicant see section 6." ;
    tmk:upstreamRef "TMA1995/s58" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s60> a tmk:LegislativeProvision ;
    rdfs:label "Trade mark similar to trade mark that has acquired a reputation in Australia"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b981c43df6fedd1f8604c1244acb825de3192f420355bbc001f0032c2e83485c" ;
    tmk:text "The registration of a trade mark in respect of particular goods or services may be opposed on the ground that: (a) another trade mark had, before the priority date for the registration of the firstmentioned trade mark in respect of those goods or services, acquired a reputation in Australia; and (b) because of the reputation of that other trade mark, the use of the firstmentioned trade mark would be likely to deceive or cause confusion. Note: For priority date see section 12." ;
    tmk:upstreamRef "TMA1995/s60" .

