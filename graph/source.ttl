    tmk:ordinal 1 ;
    tmk:text "(1) If the Registrar has accepted an application for the registration of a trade mark, a person may oppose the registration by filing a notice of opposition." ;
    tmk:upstreamRef "TMA1995/s52(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52> ;
