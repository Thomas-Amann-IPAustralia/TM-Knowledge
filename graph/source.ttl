    tmk:contentHash "sha256:cdd71e347a31495cbc4546408915b1a3d81cba4672a53db42cf87a1ecf46dc58" ;
    tmk:ordinal 26 ;
    tmk:text "then, subject to subregulation (4), the trade mark becomes a protected international trade mark, to the extent permitted by the decision on the opposition, at the end of the appeal period." ;
    tmk:upstreamRef "TMR1995/r17A.36~4" .

