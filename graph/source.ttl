    tmk:contentHash "sha256:743a09961584671eeff3e3a31917f0ccb540ae048a73e03e60a558592b4fd6a2" ;
    tmk:ordinal 4 ;
    tmk:text "(a) the Registrar may direct the opponent to rectify the inadequacy by filing more information on the basis for one or more of the grounds; or" ;
    tmk:upstreamRef "TMR1995/r17A.34B(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a3fd6a20bac7f961a71fcd26b977c389ab7840f96a04a6b2432f21285de963ff" ;
    tmk:ordinal 5 ;
    tmk:text "(b) if all the grounds are inadequately particularised, the Registrar may dismiss the opposition: or" ;
    tmk:upstreamRef "TMR1995/r17A.34B(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B> ;
