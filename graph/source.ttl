    tmk:ordinal 4 ;
    tmk:text "(c) specify the goods and/or services in relation to which the application is made; and" ;
    tmk:upstreamRef "TMR1995/r4.2(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.25A> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMR1995/r4.25A" .

