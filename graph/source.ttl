    tmk:ordinal 4 ;
    tmk:text "(b) there are grounds under Division 2 of Part 4 of the Act for rejecting it;" ;
    tmk:upstreamRef "TMR1995/r4.10(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.10(3)> a tmk:LegislativeUnit ;
