    tmk:contentHash "sha256:e9a9ace798123f67678965d9ec99ec02e1576ea6e5a9a545a23f098434a26d4e" ;
    tmk:ordinal 3 ;
    tmk:text "(2) A copy of, or an extract from, the Register that is certified by the Registrar to be a true record or extract is admissible in any proceedings as if it were the original." ;
    tmk:upstreamRef "TMA1995/s210(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s210> ;
