    tmk:ordinal 8 ;
    tmk:text "(2) For the purposes of paragraph (1)(e), the representations may be made in writing or at a hearing or by such other means as the Registrar reasonably allows." ;
    tmk:upstreamRef "TMR1995/r21.19(2)" .

