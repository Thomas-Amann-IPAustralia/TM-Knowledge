    tmk:ordinal 31 ;
    tmk:text "Note 2: For predecessor in title see section 6." ;
    tmk:upstreamRef "TMA1995/s44~2~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44~2~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:authorityKind "law" ;
