    tmk:ordinal 1 ;
    tmk:text "(1) If the holder has complied with subregulation 17A.17(3), the Registrar must:" ;
    tmk:upstreamRef "TMR1995/r17A.18(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.18(1)(a)> a tmk:LegislativeUnit ;
