    tmk:ordinal 21 ;
    tmk:text "(b) that, because of other circumstances, it is proper to do so;" ;
    tmk:upstreamRef "TMA1995/s44(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
