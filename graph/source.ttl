    tmk:upstreamRef "TMR1995/r17A.32(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.33(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
