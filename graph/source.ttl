<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part51/1%231~2> a tmk:Chunk ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesPassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part51/2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part51/2/2/4> ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34K>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48T>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.15>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.18> ;
    tmk:contentHash "sha256:88ba00217807c0bf75cf201606e016ca684cb607c16bd6cecb46a3ec7b64a97a" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part51/1%231~2/internal/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part51/1%231~2/internal/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part51/1%231~2/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part51/1%231~2/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part51/1%231~2/prov/2>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part51/1%231~2/prov/3> ;
    tmk:headingPath "Part 51 General Opposition Proceedings",
        "Part 51.1. Evidence" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part51/1> ;
    tmk:ordinal 2 ;
    tmk:partId "Part51" ;
    tmk:text "Evidence should be filed with IP Australia within the period allowed for the filing of that evidence. If the evidence is filed late the party who filed the evidence should apply for that period to be extended (regs 5.15, 9.18, 17A.34K, 17A.48T). If the party does not apply for an extension, the evidence may not be taken into account when the opposition is decided. See Part 51.2.2.6." ;
    tmk:upstreamRef "TMM/Part51/1#1~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part51/10%231~1> a tmk:Chunk ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
