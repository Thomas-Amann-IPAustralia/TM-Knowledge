    tmk:contentHash "sha256:f99383a6b57cabef08f5ad62a2cdd2ea97a508aa1ee29be5a959882727477f29" ;
    tmk:ordinal 20 ;
    tmk:text "Note 4: For apply to and apply in relation to see section 9." ;
    tmk:upstreamRef "TMA1995/s26(1)(f)~4" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
