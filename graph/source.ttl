    tmk:ordinal 1 ;
    tmk:text "Chapter 2 of the Criminal Code applies to all offences created by this Act." ;
    tmk:upstreamRef "TMA1995/s4A~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s4A~1~1> a tmk:LegislativeUnit ;
