    tmk:ordinal 25 ;
    tmk:text "Note 2: For registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s100(3)(c)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s104~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s104> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0e5615d1f17950d5e8d41496be947c1162a7baffb66993299921b72612e0fed3" ;
    tmk:ordinal 1 ;
    tmk:text "An appeal lies to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) from a decision of the Registrar under section 101 or 102." ;
    tmk:upstreamRef "TMA1995/s104~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:09c401d797d5359ff675038c4062887ffa0850aa9bba0f1b803817fc8ad455de" ;
    tmk:ordinal 4 ;
    tmk:text "Note: For assignment and transmission see section 6." ;
    tmk:upstreamRef "TMA1995/s106(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s108(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s108> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:15ae7374efd6555f4805f67be1ffaac2e18e6e24ccbc51ab4df5bfc212b78800" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If the application complies with this Act, the Registrar must:" ;
    tmk:upstreamRef "TMA1995/s108(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s108(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s108> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8b3af52765943a1c31271573c25411692cecc095d058327557e9d68bb638e337" ;
    tmk:ordinal 2 ;
    tmk:text "(a) at, or within, the time provided for in the regulations, record in the manner that the Registrar thinks fit (but not in the Register) the particulars of the assignment or transmission; and" ;
    tmk:upstreamRef "TMA1995/s108(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s108(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s108> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:69fb03e32685314bc892c1dc9811d9881e2cff10818a8cc72d1498f8d8a5cf67" ;
    tmk:ordinal 3 ;
    tmk:text "(b) publish the particulars of the assignment or transmission in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s108(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s108(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s108> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:15f6e6cfb800533644e113aa41b6cfc305e1f2896cc968ff4a673acd0b57665c" ;
    tmk:ordinal 4 ;
    tmk:text "(2) On and after the day on which the Registrar records the particulars of the assignment or transmission, the person to whom the trade mark has been assigned or transmitted is taken, for the purposes of this Act, to be the applicant for the registration of the trade mark." ;
    tmk:upstreamRef "TMA1995/s108(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s10~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s10> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:267b10f0b047e6ab3212296943282612992e1bf8ca8de41a26b0891eefaa166e" ;
    tmk:ordinal 1 ;
    tmk:text "For the purposes of this Act, a trade mark is taken to be deceptively similar to another trade mark if it so nearly resembles that other trade mark that it is likely to deceive or cause confusion." ;
    tmk:upstreamRef "TMA1995/s10~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3f1c389b1fc7d2e081e0d7ea96ae113b19ef1164fc4deca5ad1f2721361727ac" ;
    tmk:ordinal 2 ;
    tmk:text "(1) An application for the registration of a trade mark under this Act is pending from the time it is filed until:" ;
    tmk:upstreamRef "TMA1995/s11(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(1)(a)> a tmk:LegislativeUnit ;
