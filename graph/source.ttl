    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/1.-formality-requirements---name"^^xsd:anyURI ;
    tmk:upstreamRef "TMM/Part10/1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part15/2/2/1/2> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.29>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34C>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34H>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48>,
