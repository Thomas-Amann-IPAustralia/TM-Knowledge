    tmk:ordinal 8 ;
    tmk:text "(c) because of the circumstances applying at the time when the application for rectification is filed, the use of the trade mark is likely to deceive or cause confusion;" ;
    tmk:upstreamRef "TMA1995/s88(2)(b)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(2)(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
