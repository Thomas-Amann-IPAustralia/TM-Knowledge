    tmk:contentHash "sha256:bb666eda17e414110015af87c2dd0c3d78b74fabc581c73458998cde3af0565b" ;
    tmk:ordinal 5 ;
    tmk:text "(2) If:" ;
    tmk:upstreamRef "TMR1995/r21.9(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4d74a380deeb38ff83865f4f4f1775213d5ac3bde8dd9182609c20a27eda9e39" ;
    tmk:ordinal 6 ;
    tmk:text "(a) the application, notice or request was filed by, or on behalf of, more than 1 person; or" ;
    tmk:upstreamRef "TMR1995/r21.9(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e3174b8333a35f711e6af4f5d8995d854b302ed1a05b4ad084c1c54b331152f9" ;
    tmk:ordinal 7 ;
    tmk:text "(b) the right or interest mentioned in paragraph (1)(b) has become vested in more than 1 person;" ;
    tmk:upstreamRef "TMR1995/r21.9(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a2c3350ab359648fbdc4e886d90909328e7309fb34ad9675b15dbb36a8a46256" ;
    tmk:ordinal 9 ;
    tmk:text "(3) If a person mentioned in paragraph (1)(b) withdraws an application, notice or request, the Registrar may notify the person that the person is required to file documentary evidence that is sufficient to establish that the right or interest mentioned in that paragraph is vested in the person." ;
    tmk:upstreamRef "TMR1995/r21.9(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.9~1> a tmk:LegislativeUnit ;
