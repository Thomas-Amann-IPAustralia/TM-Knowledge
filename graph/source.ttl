    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:926c69409484992b2cecef6b5b0bf3dfb2087d882ecd93ff160b3b6136183574" ;
    tmk:text "An application for the registration of a collective trade mark must be made by the association to which the mark belongs." ;
    tmk:upstreamRef "TMA1995/s164" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s170> a tmk:LegislativeProvision ;
    rdfs:label "Application of Act"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7c11866151e51042630786461b8b5aeb23da704f63ad9cfef2d89d484ff8e7a5" ;
    tmk:text "Subject to this Part, the provisions of this Act relating to trade marks (other than sections 8 and 26, paragraph 27(1)(b), sections 33, 34 and 41, sections 121 and 127, Part 9—Removal of trade mark from Register for nonuse and Part 17—Defensive Trade Marks) apply to certification trade marks and so apply as if a reference to a trade mark included a reference to a certification trade mark." ;
    tmk:upstreamRef "TMA1995/s170" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s196> a tmk:LegislativeProvision ;
    rdfs:label "Registrar may appear in appeals"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:61512a82195504313c5fba837efb02f71c0d65665f4087933a8db3870e2cdeb0" ;
    tmk:text "The Registrar may appear and be heard at the hearing of an appeal to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) against a decision or direction of the Registrar." ;
    tmk:upstreamRef "TMA1995/s196" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s212> a tmk:LegislativeProvision ;
    rdfs:label "Making and signing applications etc."@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:aa9556284f6a6200248ec9f4476ed9453d227e00bac13a24601fda8178f66888" ;
    tmk:text "An application, notice or request required or permitted under this Act to be made or signed by a person may be made or signed, on behalf of that person, by any other person." ;
    tmk:upstreamRef "TMA1995/s212" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s213> a tmk:LegislativeProvision ;
    rdfs:label "Filing of documents"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:656410393782896c39c4aaf73f440ac2f12935ac5626a2ec2ce51057544a13fc" ;
    tmk:text "For the purposes of this Act, a document may be filed with the Trade Marks Office by a means determined in an instrument under subsection 213A(1)." ;
    tmk:upstreamRef "TMA1995/s213" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88A> a tmk:LegislativeProvision ;
    rdfs:label "Applications by Registrar"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8218caeb3095ef01ffe4fdf07b2af2b1465008f884ce01462038e78a14de4941" ;
    tmk:text "The Registrar must not make an application under section 86, 87 or 88 unless he or she considers the application desirable in the public interest." ;
    tmk:upstreamRef "TMA1995/s88A" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s91> a tmk:LegislativeProvision ;
    rdfs:label "Amendment of certificate of registration"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2ab1584bc629c364f6844ce5aaee336d28b369d7547958ecb0aa557dbcb56606" ;
    tmk:text "When the Registrar amends any particular entered in the Register in respect of a trade mark, the Registrar may also amend the certificate of registration if he or she thinks it appropriate to do so." ;
    tmk:upstreamRef "TMA1995/s91" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1/1/2> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29(1)> ;
    tmk:contentHash "sha256:1a253922355f22a634da8bad7e6c2fc1104ed3c6c8c185f4a7c7e34d27051e4b" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/2/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/2/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part11/1/1/2/prov/2> ;
    tmk:headingPath "1. Applications in Australia (convention applications) where the applicant claims a right of priority on the basis of an application in a Convention country",
        "1.2 Convention countries",
        "Part 11 Convention Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1> ;
    tmk:ordinal 3 ;
    tmk:partId "Part11" ;
    tmk:text "A Convention country is a foreign country or region of a kind prescribed by the regulations (section 6). The regulations define a convention country as: a foreign country that is a signatory to the Paris Convention for the Protection of Industrial Property of 20 March 1883, as in force from time to time; a foreign country that is a full member of the World Trade Organization (Reg 21.29(1)). For a list of signatories to the Paris Convention see – www.wipo.int For a list of full members of the World Trade Organization see – www.wto.org Regulation 21.29 also refers to the following international treaty organisations: the European Community, Benelux and the African Intellectual Property Office (OAPI)." ;
    tmk:upstreamRef "TMM/Part11/1/1/2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/3%231> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesPassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/x-annex-a1-divisional-checklist-for-divisional-applications-filed-on-or-after-27-march-2007> ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46> ;
    tmk:contentHash "sha256:3c6c84b1d3a1ac1a4ae3b5a177285a9e3d91bc5745acdcd51f4a7110b09a38c0" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/3%231/internal/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/3%231/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/3%231/prov/1> ;
    tmk:headingPath "3. Conditions for a valid divisional application",
        "Part 12 Divisional Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/3> ;
    tmk:ordinal 1 ;
    tmk:partId "Part12" ;
    tmk:text "Sections 45 and 46 set out the conditions that must be met to file a valid divisional. These are: the trade marks must be the same; and the trade mark applicants must be the same; and the parent must be a single application; and the parent application must be pending when the divisional application is filed; and the divisional application must specify the goods or services to which it relates; and the divisional application must be for some only of the goods or services of the parent application; and the divisional application must specify the goods or services that are to remain in the parent application. If the divisional application meets all of the above requirements it is a valid divisional. Annex A1 of this Part contains a divisional checklist as an aid to determine if a divisional application is valid. If the divisional application does not meet all of the above requirements it is an invalid divisional. This means that the filing date will be the day on which the divisional application was filed, not the parent. In this situation, the goods or services of the parent application should not be amended unless specifically requested by the applicant." ;
    tmk:upstreamRef "TMM/Part12/3#1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/x-annex-a1-divisional-checklist-for-divisional-applications-filed-on-or-after-27-march-2007%231> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "annex" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46> ;
    tmk:contentHash "sha256:04d63794bce8d45f6cd504a384baad6e20bde360a1145c5aca65e34911090c1a" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/x-annex-a1-divisional-checklist-for-divisional-applications-filed-on-or-after-27-march-2007%231/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/x-annex-a1-divisional-checklist-for-divisional-applications-filed-on-or-after-27-march-2007%231/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/x-annex-a1-divisional-checklist-for-divisional-applications-filed-on-or-after-27-march-2007%231/prov/2> ;
    tmk:headingPath "Annex A1 Divisional Checklist (for divisional applications filed on or after 27 March 2007)",
        "Part 12 Divisional Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/x-annex-a1-divisional-checklist-for-divisional-applications-filed-on-or-after-27-march-2007> ;
    tmk:ordinal 1 ;
    tmk:partId "Part12" ;
    tmk:text "Answer YES or NO to each of the questions in the following checklist. If the answer to any of the questions 1-5 is NO, it is not a valid divisional application. Yes/No Section 1. Is the applicant of the divisional application the same as the current applicant of the parent application? s45 2. Was the divisional filed while the parent was still pending? Pending includes status “accepted” and status “opposed”. s45 3. Is the trade mark the same as the trade mark of the parent? s46 4. Are the goods/services of the divisional some only of the goods/services of the parent? s45 5. Has the applicant specified the goods/services that are to remain in the parent application? s46 If the answer to ALL of the questions above (1-5) was YES AND the parent application has not lapsed proceed to question 6. 6. Are any of the goods/services of the divisional duplicated in or encompassed by the goods/services specified to remain in the parent? If the answer to question 6 is yes, the applicant must generally either: a. if possible, agree to the goods or services of the parent and/or child being restricted so as to eliminate any duplication (i.e. goods/services that are in substance the same) between the goods and/or services of the parent and child; OR b. delete reference to the divisional priority date. If the answer to question 6 is no, and the divisional application is valid and complete, the examiner must (as soon as practicable) process the amendment to the specification of the parent application to exclude the claimed goods and/or services of the divisional application. The parent application should then be reassessed in light of the amended goods and/or services." ;
    tmk:upstreamRef "TMM/Part12/x-annex-a1-divisional-checklist-for-divisional-applications-filed-on-or-after-27-march-2007#1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/2> a tmk:Page ;
    rdfs:label "2. Material Particulars"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f6136f88155402c2959795b1bac9ecad2dc6808054c91ca595361836f5021e90" ;
    tmk:lastAmended "2026-06-03" ;
    tmk:partId "Part13" ;
    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/2.-material-particulars"^^xsd:anyURI ;
    tmk:upstreamRef "TMM/Part13/2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/4%231~1> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)(a)> ;
    tmk:contentHash "sha256:9ac5acfd3aa75773918789261da297b3505d9e44b3600f1471d0f4d80ee346e6" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/4%231~1/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/4%231~1/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part13/4%231~1/prov/2> ;
    tmk:headingPath "13.4. Applying Requirements for Material Particulars and Provisions of Paragraphs 51(1)(a), (b) and (c)",
        "Part 13 Application to Register a Series of Trade Marks" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/4> ;
    tmk:ordinal 1 ;
    tmk:partId "Part13" ;
    tmk:text "Trade Marks Act 1995 Trade Mark Regulations 1995 Section 51 requires that both requirements discussed above be met for a series application to be valid. In applying these requirements, there are three possible outcomes. The material particulars resemble each other, and the trade marks differ only in the ways specified in paragraphs 51(1)(a),(b),(c) - this is a valid series. The material particulars do not resemble each other, and the trade marks differ only in the ways specified in paragraphs 51(1)(a),(b),(c) - this is an invalid series. The material particulars resemble each other, but the trade marks do not differ only in the ways specified in paragraphs 51(1)(a),(b),(c). There are two variations of this possible outcome: a. The trade marks differ in none of the ways specified in paragraphs 51(1)(a),(b), and (c) - this is an invalid series. OR b. The trade marks differ in one or more of the ways specified in paragraphs 51(1)(a),(b),(c), but also incorporate a further change. That is, they do not differ only in the allowable ways - this is an invalid series. By way of example, trade marks can resemble each other in material particulars in combinations such as: IDAK may resemble each other in material particulars, but would not qualify as a series because the ways in which they differ are not specified in any of paragraphs 51(1)(a), (b) or (c). Applications for a series of trade marks that consist of non-traditional signs must be assessed on their merits, and should not be treated differently to traditional signs. However, signs such as sound, shape or colour per se, may often not qualify under section 51(1). For example: if the trade marks consist only of colours, then differences in colour may mean the trade marks do not resemble each other in material particulars, since colour is an identifying feature of each mark in the series. a series of non-traditional signs without words will often differ in ways not allowed by paragraphs 51(1)(a), (b) or (c). For example, a series of sound trade marks for variations on a piano melody would differ in ways not specified in paragraph 51(1). However, the following are examples of non-traditional signs that only differ in ways specified in paragraphs 51(1)(a), (b) or (c)paragraphs 51(1)(a), (b) and (c):" ;
    tmk:upstreamRef "TMM/Part13/4#1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/8> a tmk:Page ;
    rdfs:label "8. Divisional Applications from Series"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
