    tmk:ordinal 7 ;
    tmk:text "(3) The Registrar must publish the request for the amendment in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s83A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(3)~1> a tmk:LegislativeUnit ;
