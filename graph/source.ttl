    tmk:upstreamRef "TMR1995/r17A.50(3)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.50(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.50> ;
