    tmk:contentHash "sha256:fb6e083f15db80a701dd086348c554c1fb80cd6d3f089b715fd47d8b78f005fd" ;
    tmk:ordinal 3 ;
    tmk:text "(b) a similar provision of the regulations made for the purposes of Part 17A." ;
    tmk:upstreamRef "TMA1995/s58A(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58A(1)(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d92cee66f8ed829d84d9b7e3f5ef61c3a305dbb127547d49080ce1dd1b851789" ;
    tmk:ordinal 4 ;
    tmk:text "Note: Subsection 44(4) prevents rejection of an application for registration of a trade mark that is substantially identical with, or deceptively similar to, a registered trade mark or a trade mark whose registration is being sought where the firstmentioned trade mark has been continuously used since before the priority date of the other trade mark." ;
    tmk:upstreamRef "TMA1995/s58A(1)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s58A(2)> a tmk:LegislativeUnit ;
