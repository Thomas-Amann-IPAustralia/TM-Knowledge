    tmk:ordinal 4 ;
    tmk:text "(c) the date of filing the application;" ;
    tmk:upstreamRef "TMR1995/r4.7(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(1)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1722c646d58e7bedd5ffd3f5465b0ec644a011bee77caaedab59e73b850659b4" ;
    tmk:ordinal 5 ;
    tmk:text "(d) if the application is a divisional application—particulars of the parent application;" ;
    tmk:upstreamRef "TMR1995/r4.7(1)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(1)(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7> ;
