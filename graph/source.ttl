    tmk:ordinal 1 ;
    tmk:text "(1) Subject to subregulation (2), a fee payable in relation to proceedings:" ;
    tmk:upstreamRef "TMR1995/r22.2(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.2(1)(a)> a tmk:LegislativeUnit ;
