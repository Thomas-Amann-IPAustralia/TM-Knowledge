    tmk:ordinal 2 ;
    tmk:text "(a) if the request for extension of protection to Australia was made under Article 3ter (1) of the Protocol—the date of international registration of the trade mark; or" ;
    tmk:upstreamRef "TMR1995/r17A.4(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4> ;
