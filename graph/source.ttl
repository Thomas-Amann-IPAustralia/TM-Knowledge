    tmk:ordinal 7 ;
    tmk:text "(a) under the repealed Act the registration of a trade mark expires in 1995; and" ;
    tmk:upstreamRef "TMR1995/r22.2(5)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.2(5)(b)> a tmk:LegislativeUnit ;
