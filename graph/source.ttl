    tmk:ordinal 7 ;
    tmk:text "(f) the class number or numbers for the goods and/or services in respect of which registration of the trade mark is sought." ;
    tmk:upstreamRef "TMR1995/r4.7(1)(f)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(2)> a tmk:LegislativeUnit ;
