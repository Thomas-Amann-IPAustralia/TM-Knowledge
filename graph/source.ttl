    tmk:ordinal 6 ;
    tmk:text "(c) the trade mark is registered under this Act;" ;
    tmk:upstreamRef "TMA1995/s72(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72> ;
    tmk:authorityKind "law" ;
