    tmk:contentHash "sha256:cb5574c09c3d63787c9e49e7cf1b5fb04edc3f71b39348df1d748751e7397668" ;
    tmk:ordinal 8 ;
    tmk:text "Note: In certain circumstances the Registrar need not publish a request under this subsection (see subsection (7))." ;
    tmk:upstreamRef "TMA1995/s83A(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(4)> a tmk:LegislativeUnit ;
