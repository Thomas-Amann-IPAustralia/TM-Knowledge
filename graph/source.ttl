    tmk:contentHash "sha256:7eef3995b0837b2e09e6755c8b30043a269d1170d565952d868aecfb8397ac38" ;
    tmk:ordinal 7 ;
    tmk:text "(b) in relation to another international registration of a trade mark—the person or persons in whose name or names the international registration of the trade mark is recorded in the International Register." ;
    tmk:upstreamRef "TMR1995/r17A.2/holder(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/international-bureau> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3ea95c2297a482f46c309226f212723ad4cb3dec86f77641aa94eab8a4bedd26" ;
    tmk:ordinal 8 ;
    tmk:text "International Bureau means the International Bureau of the World Intellectual Property Organisation." ;
    tmk:upstreamRef "TMR1995/r17A.2/international-bureau" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/international-register> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
