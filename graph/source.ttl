    tmk:ordinal 3 ;
    tmk:text "(b) the person to whom the trade mark has been assigned or transmitted;" ;
    tmk:upstreamRef "TMA1995/s109(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s109(2)(a)> a tmk:LegislativeUnit ;
