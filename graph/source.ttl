    tmk:contentHash "sha256:0fb354185e2399ba68949a587a3f1dda478e3529fd845483dc9f64b791a4dab9" ;
    tmk:ordinal 5 ;
    tmk:text "(2) Subsection (1) does not apply to a notice of opposition filed by an opponent in relation to:" ;
    tmk:upstreamRef "TMA1995/s66(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66> ;
