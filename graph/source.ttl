    tmk:ordinal 3 ;
    tmk:text "Note 2: For deceptively similar see section 10." ;
    tmk:upstreamRef "TMA1995/s120(1)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(1)~3> a tmk:LegislativeUnit ;
