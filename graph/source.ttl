    tmk:ordinal 9 ;
    tmk:text "(4) The Registrar may hold an oral hearing in which:" ;
    tmk:upstreamRef "TMR1995/r21.16(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(4)(a)> a tmk:LegislativeUnit ;
