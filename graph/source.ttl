    tmk:contentHash "sha256:e787ffcb2b84e3738c903758baedcbf464402f2be458239ca275418064655220" ;
    tmk:ordinal 4 ;
    tmk:text "(b) within the prescribed period, or within that period as extended in accordance with the regulations or in accordance with subsection (5)." ;
    tmk:upstreamRef "TMA1995/s52(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52> ;
