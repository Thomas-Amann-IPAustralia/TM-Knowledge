    tmk:ordinal 8 ;
    tmk:text "(b) that period as extended under section 224 of the Act or as a result of a previous application of this subregulation;" ;
    tmk:upstreamRef "TMR1995/r17A.20(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20~1> a tmk:LegislativeUnit ;
