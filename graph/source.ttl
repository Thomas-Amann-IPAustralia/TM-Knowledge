    tmk:ordinal 5 ;
    tmk:text "(ii) a certificate of verification relating to the translation." ;
    tmk:upstreamRef "TMR1995/r17A.19(1)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.19(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.19> ;
