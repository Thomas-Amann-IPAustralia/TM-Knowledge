    tmk:ordinal 6 ;
    tmk:text "(iii) if the opposition has been dismissed under section 222 or the regulations (if any) made for the purposes of subsection 54(2)." ;
    tmk:upstreamRef "TMA1995/s68(1)(b)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s68(2)> a tmk:LegislativeUnit ;
