    tmk:ordinal 12 ;
    tmk:text "Madrid Regulations means the Regulations under the Madrid Protocol, as the Regulations are in force for Australia on 1 November 2024." ;
    tmk:upstreamRef "TMR1995/r17A.2/madrid-regulations" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/madrid-regulations~1> a tmk:LegislativeUnit ;
