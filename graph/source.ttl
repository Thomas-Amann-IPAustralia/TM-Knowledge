    tmk:ordinal 23 ;
    tmk:text "(b) that, because of other circumstances, it is proper to do so;" ;
    tmk:upstreamRef "TMR1995/r4.15A(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
