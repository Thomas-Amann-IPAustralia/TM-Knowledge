    tmk:ordinal 21 ;
    tmk:text "Note 1: For registered trade mark see section 6." ;
    tmk:upstreamRef "TMA1995/s120(3)(d)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(d)~2> a tmk:LegislativeUnit ;
