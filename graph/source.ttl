    tmk:ordinal 5 ;
    tmk:text "(4) The Registrar must comply with any order made by the court under this Division." ;
    tmk:upstreamRef "TMA1995/s90(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s91~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s91> ;
