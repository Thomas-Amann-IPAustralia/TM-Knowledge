    tmk:ordinal 1 ;
    tmk:text "When a trade mark has been registered, the Registrar must:" ;
    tmk:upstreamRef "TMA1995/s71~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:28540c11397681be8844578d68f68d4433cd44673151dbee03c95f498d2e2b32" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Any person may, within the prescribed period before the registration of a trade mark expires, ask the Registrar to renew the registration." ;
    tmk:upstreamRef "TMA1995/s75(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75> ;
