    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part46/4/4/3/case/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part46/4/4/3/internal/0>,
