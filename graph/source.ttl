<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s10~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s10> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:267b10f0b047e6ab3212296943282612992e1bf8ca8de41a26b0891eefaa166e" ;
    tmk:ordinal 1 ;
    tmk:text "For the purposes of this Act, a trade mark is taken to be deceptively similar to another trade mark if it so nearly resembles that other trade mark that it is likely to deceive or cause confusion." ;
    tmk:upstreamRef "TMA1995/s10~1" .

