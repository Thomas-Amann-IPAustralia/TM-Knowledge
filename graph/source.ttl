    tmk:ordinal 4 ;
    tmk:text "(2) In particular, the Registrar must:" ;
    tmk:upstreamRef "TMR1995/r17A.8(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.8(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.8> ;
