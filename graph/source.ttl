    tmk:ordinal 12 ;
    tmk:text "(ii) the service or other services of the same description; and" ;
    tmk:upstreamRef "TMA1995/s24(3)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6b8de165efc8ae8b848df0ee465ffb10e3c456013dcd1f64b2c891a3c1f91dbf" ;
    tmk:ordinal 13 ;
    tmk:text "(b) is taken to have ceased to have those exclusive rights from the day determined by the court under subsection (4)." ;
    tmk:upstreamRef "TMA1995/s24(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24(3)(b)~1> a tmk:LegislativeUnit ;
