    tmk:contentHash "sha256:8218caeb3095ef01ffe4fdf07b2af2b1465008f884ce01462038e78a14de4941" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar must not make an application under section 86, 87 or 88 unless he or she considers the application desirable in the public interest." ;
    tmk:upstreamRef "TMA1995/s88A~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8~1> a tmk:LegislativeUnit ;
