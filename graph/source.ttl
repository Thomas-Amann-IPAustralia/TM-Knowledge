    tmk:contentHash "sha256:41633c546adb2476144a44750a50ce2c63f2bbcda437fdb4ea182a1d7ea69b7f" ;
    tmk:ordinal 15 ;
    tmk:text "held by another person in respect of similar services or closely related goods; and" ;
    tmk:upstreamRef "TMR1995/r4.15A(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
