    tmk:text "(3) A request for a hearing must be in an approved form." ;
    tmk:upstreamRef "TMR1995/r21.15(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15> ;
    tmk:authorityKind "law" ;
