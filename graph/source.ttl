    tmk:ordinal 117 ;
    tmk:text "(2) For the purposes of this Act, a reference to a country includes a reference to a member of the World Trade Organization." ;
    tmk:upstreamRef "TMA1995/s6(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6(3)> a tmk:LegislativeUnit ;
