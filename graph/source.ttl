    tmk:ordinal 16 ;
    tmk:text "(c) a description, or further description, of the trade mark; and" ;
    tmk:upstreamRef "TMR1995/r4.3(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(d)> a tmk:LegislativeUnit ;
