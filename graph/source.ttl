    tmk:ordinal 3 ;
    tmk:text "(b) one of the following applies:" ;
    tmk:upstreamRef "TMA1995/s27(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(1)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
