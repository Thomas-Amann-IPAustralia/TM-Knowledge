    tmk:upstreamRef "TMA1995/s120(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3f685b3d0d6b84b099b37ee107b7631ccdce2bd000d607aecb0ce6a23b71fc30" ;
    tmk:ordinal 8 ;
    tmk:text "(c) services of the same description as that of services (registered services) in respect of which the trade mark is registered; or" ;
    tmk:upstreamRef "TMA1995/s120(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(2)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c82905a7766e1e7cbc97f6cfb6920060555a7d69ff8f67b24752ab45d679944c" ;
    tmk:ordinal 9 ;
    tmk:text "(d) goods that are closely related to registered services." ;
    tmk:upstreamRef "TMA1995/s120(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fa979c717eb4d35e7c4e441dff68f9c761ab93dc503746163aa1b4989a65f034" ;
    tmk:ordinal 15 ;
    tmk:text "(a) the trade mark is well known in Australia; and" ;
    tmk:upstreamRef "TMA1995/s120(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3a68b4abf2637c07ed8af1d069ffd25d69f93d4d0cc46ea8850b17d2eea0a5e9" ;
    tmk:ordinal 16 ;
    tmk:text "(b) the person uses as a trade mark a sign that is substantially identical with, or deceptively similar to, the trade mark in relation to:" ;
    tmk:upstreamRef "TMA1995/s120(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d1515202e5337a2cbfd2ee93f00e10ec7372d78689c85a6898c75d405300fe83" ;
    tmk:ordinal 17 ;
    tmk:text "(i) goods (unrelated goods) that are not of the same description as that of the goods in respect of which the trade mark is registered (registered goods) or are not closely related to services in respect of which the trade mark is registered (registered services); or" ;
    tmk:upstreamRef "TMA1995/s120(3)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4589cc381145b127d5a7f04cd7d615ec86ad95069283ed93d3a919b4b79fa446" ;
    tmk:ordinal 18 ;
    tmk:text "(ii) services (unrelated services) that are not of the same description as that of the registered services or are not closely related to registered goods; and" ;
    tmk:upstreamRef "TMA1995/s120(3)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:81b1325060756e11419b99227b8d919ee76b3369c1a6f46195b49aefefb86735" ;
    tmk:ordinal 19 ;
    tmk:text "(c) because the trade mark is well known, the sign would be likely to be taken as indicating a connection between the unrelated goods or services and the registered owner of the trade mark; and" ;
    tmk:upstreamRef "TMA1995/s120(3)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:194d11ca427dbe07e700f43444f4c58499ab2d46754d1861fe9e921ae3845345" ;
    tmk:ordinal 20 ;
    tmk:text "(d) for that reason, the interests of the registered owner are likely to be adversely affected." ;
    tmk:upstreamRef "TMA1995/s120(3)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(d)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
