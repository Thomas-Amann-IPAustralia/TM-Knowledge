    tmk:ordinal 18 ;
    tmk:text "Note 2: For authorised user see section 8." ;
    tmk:upstreamRef "TMA1995/s26(1)(f)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(f)~3> a tmk:LegislativeUnit ;
