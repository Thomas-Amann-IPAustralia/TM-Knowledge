    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2c25b2c43ff6353b7b7e264dfeafdc32c3fd4b55e004dd44c9e5db23ae635915" ;
    tmk:ordinal 29 ;
    tmk:text "(ii) the similar services or closely related goods; and" ;
    tmk:upstreamRef "TMR1995/r4.15A(5)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(5)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:22208bd3b0819e40b43ea2dfb4e9db5974e9c4b78202fef4d17aa6d15ebe137a" ;
    tmk:ordinal 30 ;
    tmk:text "(b) ending on the priority date for the registration of the applicant’s trade mark;" ;
    tmk:upstreamRef "TMR1995/r4.15A(5)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e056a93d107ef24ad3364172905594bf4d8e34dd9ea16b470c085ccd77eeb0e8" ;
    tmk:ordinal 24 ;
    tmk:text "the Registrar may accept the application for the registration of the applicant’s trade mark subject to any conditions or limitations that the Registrar thinks fit to impose." ;
    tmk:upstreamRef "TMR1995/r4.15A~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4899199f2d6bf6841404a1cdfc716d62aa6911430c93e594b82cc92d94154165" ;
    tmk:ordinal 31 ;
    tmk:text "the Registrar must not reject the application because of the existence of the other trade mark." ;
    tmk:upstreamRef "TMR1995/r4.15A~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A~2~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5c157b08d083fde230843faf4b2d3e65daf28bba8426d6d9ce40694041829659" ;
    tmk:ordinal 32 ;
    tmk:text "Note: Section 44 of the Act provides for rejection of an application on the grounds that the trade mark is substantially identical with, or deceptively similar to, a registered trade mark or a trade mark for which registration is being sought." ;
    tmk:upstreamRef "TMR1995/r4.15A~2~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6e67d6054285482dd21d9c7898c8f5eca6051d051a238d77f4a028c3568af873" ;
    tmk:ordinal 1 ;
    tmk:text "For the purposes of paragraph 39(2)(a) of the Act (which deals with signs), the following signs are prescribed:" ;
    tmk:upstreamRef "TMR1995/r4.15~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:934624de875998442326dc4ff4325cc08967e0d8257a2e2c00d72f060dd1636d" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A person who applies, or has applied, for the registration of a trade mark:" ;
    tmk:upstreamRef "TMR1995/r4.18(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:88662743e545e2c915acac61d6fc04fe3c04cb56a9c752d6acd4eab5a211c2b8" ;
    tmk:ordinal 4 ;
    tmk:text "(2) As soon as practicable after making a decision in relation to a request, the Registrar must give notification of the decision to the person who made the request." ;
    tmk:upstreamRef "TMR1995/r4.18(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9dcd4b53c008a0f7a3b6f61ba14e5b9fdac9f8ff87e46565b1ca4062e4653d8b" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar must, to the extent that is practicable, examine applications for the registration of trade marks in relation to which requests under regulation 4.18 are granted:" ;
    tmk:upstreamRef "TMR1995/r4.19(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dff8ede0b8737dda3cee4b0348b4c9dd2a49cfc718cecc92765d93a33e1f880e" ;
    tmk:ordinal 2 ;
    tmk:text "(a) in the order in which the requests are filed; and" ;
    tmk:upstreamRef "TMR1995/r4.19(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8f5d2b6f5050b98d125936277ade5d01d0540f11d8ccdc5f94cc16d756f3e05b" ;
    tmk:ordinal 3 ;
    tmk:text "(b) before examination of an application for registration of a trade mark in relation to which:" ;
    tmk:upstreamRef "TMR1995/r4.19(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19(1)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:cc10bbf2f52338107e3fd0d07c49cead63521168809e59b7a9ded5497a5329bf" ;
    tmk:ordinal 4 ;
    tmk:text "(i) a request under regulation 4.18 is not made; or" ;
    tmk:upstreamRef "TMR1995/r4.19(1)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19(1)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4e11fc87e4160d69d65785d3f4fe4d60f229b9205f9b7011bbef9eb68c71667f" ;
    tmk:ordinal 5 ;
    tmk:text "(ii) a request made under that regulation is not granted." ;
    tmk:upstreamRef "TMR1995/r4.19(1)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bb9834cf7844e293d80fad2e529a4bd3519b65d968f62338fc393f7d864b72c3" ;
    tmk:ordinal 1 ;
    tmk:text "(1) To be taken to be filed, an application for registration of a trade mark that is in an approved form must:" ;
    tmk:upstreamRef "TMR1995/r4.2(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f750ad2002c2670ed6a5082fe1517bd6235a609de35aedd58194fdbf2de4f9b1" ;
    tmk:ordinal 2 ;
    tmk:text "(a) state that the application is for registration of the trade mark, or contain a clear indication to that effect; and" ;
    tmk:upstreamRef "TMR1995/r4.2(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9efc6fed609ba33fa5192cfc8516a51b3ad1206c86257fe7b59673217695978b" ;
    tmk:ordinal 3 ;
    tmk:text "(b) include a representation of the trade mark that is sufficient to identify the trade mark; and" ;
    tmk:upstreamRef "TMR1995/r4.2(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2(1)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:151693669c18b9794a28b57021768fb879003ff425099b51f7881ddf40ae7267" ;
    tmk:ordinal 5 ;
    tmk:text "(d) include sufficient information to enable the Registrar to establish the identity of the applicant; and" ;
    tmk:upstreamRef "TMR1995/r4.2(1)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2(1)(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3a4cd71bc29fdbc554d3d33f5c42583c28935f60e82687c1edb8bc61ca76c0b1" ;
    tmk:ordinal 6 ;
    tmk:text "(e) contain sufficient information to enable the Registrar to contact the applicant." ;
    tmk:upstreamRef "TMR1995/r4.2(1)(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:73cae2dc32bb89da5caeb2dfca815dc1a870905bbb60277308f2e5d264e133df" ;
    tmk:ordinal 7 ;
    tmk:text "(2) If an application does not meet a requirement set out in paragraph (1)(a), (b), (c) or (d), the Registrar must notify the applicant of the requirement." ;
    tmk:upstreamRef "TMR1995/r4.2(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6a5f0cd6fca7c3e186744fdedefb50082e7e3a327b003519a7be4b89ce70c8a6" ;
    tmk:ordinal 8 ;
    tmk:text "(3) If the applicant meets the requirement within a period of 2 months from the date of the notification, the application is taken to be filed on the day on which the requirement is met." ;
    tmk:upstreamRef "TMR1995/r4.2(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7a7f385b2b8dd1d761a820424f98b8e503d9b46a8cf59175b2685d7ccaa376b7" ;
    tmk:ordinal 9 ;
    tmk:text "(4) If the applicant does not meet the requirement within that period, the application is taken not to have been filed." ;
    tmk:upstreamRef "TMR1995/r4.2(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a1914affa50f4b8b91e8ac5b25247c6abf2af2455f5eeff66aa914f7de59aa23" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If practicable, the representation of a trade mark included in an application for registration of the trade mark must not exceed 8 centimetres by 8 centimetres." ;
    tmk:upstreamRef "TMR1995/r4.3(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(10)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fa1e3b58b4b19395c740ccfa333ba1330c105320182c504171c2d71a12fb86a2" ;
    tmk:ordinal 21 ;
    tmk:text "(10) The representation of a trade mark in an application for registration of the trade mark must be of a kind and quality that:" ;
    tmk:upstreamRef "TMR1995/r4.3(10)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(10)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6e5e9e398ea18c1f016bf2d2ed363efb93bd6156c044ab3642fb94aefbbc9f0b" ;
    tmk:ordinal 22 ;
    tmk:text "(a) ensures that the features of the trade mark will be preserved in the course of time; and" ;
    tmk:upstreamRef "TMR1995/r4.3(10)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(10)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c97931fe34fbe9d4b9bae4a897adcf4fdf76829f2f5952467e9846a64655f27d" ;
    tmk:ordinal 23 ;
    tmk:text "(b) is suitable for reproduction." ;
    tmk:upstreamRef "TMR1995/r4.3(10)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0805bb10fb2c1fe9101c4c0099a7e2696376fe1808be82f12ae88f8db67a97c7" ;
    tmk:ordinal 2 ;
    tmk:text "(2) In an application for the registration of 2 or more trade marks as a series, the representation of each trade mark in the series must, if practicable, not exceed 8 centimetres by 8 centimetres." ;
    tmk:upstreamRef "TMR1995/r4.3(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:afb0b7e3ce794ec9118f65a912657223dc2bfde2c0566f80cfcbb20bd72b6338" ;
    tmk:ordinal 3 ;
    tmk:text "(3) In an application for the registration of a trade mark that contains, or consists of, a 3 dimensional shape:" ;
    tmk:upstreamRef "TMR1995/r4.3(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3e21cdeea9324f354421cfa3dfe64a4540a7fe56ba15f9685617d7c7deb75be7" ;
    tmk:ordinal 4 ;
    tmk:text "(a) if practicable, the representation of the trade mark in the application must be illustrated in a perspective that shows each feature of the trade mark; and" ;
    tmk:upstreamRef "TMR1995/r4.3(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1becadc754d165bdd433619cd417468663c0d876855ce589442fa646eadb6ff9" ;
    tmk:ordinal 5 ;
    tmk:text "(b) otherwise, the representation of the trade mark in the application must include views of the trade mark that are necessary to show each feature of the trade mark." ;
    tmk:upstreamRef "TMR1995/r4.3(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:780dafdea5167ff15e3cb662f28e3f82f72d727e7ed98add8d85127fe3e69b07" ;
    tmk:ordinal 6 ;
    tmk:text "(4) If the Registrar reasonably believes that the views of a trade mark to which paragraph (3)(a) or (b) applies are not sufficient to allow all features of the trade mark to be properly examined, the Registrar may, by notification to the applicant, require the applicant to give to the Registrar up to 6 additional views of the trade mark that show the features sufficiently to permit proper examination of the trade mark." ;
    tmk:upstreamRef "TMR1995/r4.3(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a12fd83baa72f84c451f43b3477ff0c3721efcdb07f4c6212575f2edb0d74ba2" ;
    tmk:ordinal 7 ;
    tmk:text "(5) If the representation of a trade mark in an application for registration of the trade mark includes words of a language other than English, the applicant must file in support of the application a translation of the words into English, if required to do so by the Registrar at the time of application or later." ;
    tmk:upstreamRef "TMR1995/r4.3(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
