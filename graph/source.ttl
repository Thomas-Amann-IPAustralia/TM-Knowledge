    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f2e99f792bf20e64c18373d268fd29243e124e31476138812d0b072713cbd62c" ;
    tmk:ordinal 10 ;
    tmk:text "(b) does not file written submissions if requested under subregulation 21.16(1); or" ;
    tmk:upstreamRef "TMR1995/r21.15(5)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(5)(c)> a tmk:LegislativeUnit ;
