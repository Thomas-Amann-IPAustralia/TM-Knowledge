    tmk:ordinal 11 ;
    tmk:text "(e) an authorised user may give permission to any person:" ;
    tmk:upstreamRef "TMA1995/s26(1)(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(e)(i)> a tmk:LegislativeUnit ;
