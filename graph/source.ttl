    tmk:ordinal 2 ;
    tmk:text "Note: For prescribed court see section 190." ;
    tmk:upstreamRef "TMA1995/s90(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a572985f5081545b5e9dfa45c638ba52b02a0aadda6e4a70ffa37b5405f94997" ;
    tmk:ordinal 3 ;
    tmk:text "(2) In relation to an application made by an aggrieved person, the Registrar may appear before the court and be heard at his or her discretion unless the court directs the Registrar to appear before the court." ;
    tmk:upstreamRef "TMA1995/s90(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8a5b87fe2f5e1a865ce36e167ad7dbddc854b3aa3a6e468671921736f050aa14" ;
    tmk:ordinal 4 ;
    tmk:text "(3) If the application is made by an aggrieved person, the applicant must give to the Registrar a copy of any order made by the court under this Division." ;
    tmk:upstreamRef "TMA1995/s90(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90> ;
