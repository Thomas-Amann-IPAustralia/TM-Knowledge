    tmk:ordinal 5 ;
    tmk:text "Note: For divisional application and parent application see section 45." ;
    tmk:upstreamRef "TMA1995/s46(1)(c)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:782700619fab954c89482389a4e5e35518f2001c6c61353bb8e35e6dc9c16142" ;
    tmk:ordinal 7 ;
    tmk:text "Note: Section 204 requires the Registrar, where no time or period is specified for doing a thing, to do the thing as soon as practicable. However, it is possible that a parent application will lapse before it is practicable for the Registrar to amend it under subsection (2) of this section." ;
    tmk:upstreamRef "TMA1995/s46(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s4A~1> a tmk:LegislativeUnit ;
