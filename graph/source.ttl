    tmk:ordinal 4 ;
    tmk:text "the Registrar may refer the matter to such a court and the court may hear and determine the matter as if an application had been made to it under subsection 92(3)." ;
    tmk:upstreamRef "TMA1995/s94~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s96(1)> a tmk:LegislativeUnit ;
