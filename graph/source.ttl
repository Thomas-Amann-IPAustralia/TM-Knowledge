    tmk:contentHash "sha256:06892d6747fffe90e5ad95708497bdbf8f83bc29cf07737f20bdf070602b3ce8" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If, in the course of an examination of an IRDA, the Registrar reasonably believes that:" ;
    tmk:upstreamRef "TMR1995/r17A.16(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
