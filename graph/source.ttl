    tmk:ordinal 37 ;
    tmk:text "(d) the decision on the appeal is that the trade mark that is the subject of the IRDA should be protected in Australia;" ;
    tmk:upstreamRef "TMR1995/r17A.36(4)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36(5)> a tmk:LegislativeUnit ;
