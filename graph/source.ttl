    tmk:ordinal 44 ;
    tmk:text "(a) within 18 months after the Registrar was notified of an IRDA, the International Bureau receives notification of the possibility that oppositions may be filed after the 18month period; and" ;
    tmk:upstreamRef "TMR1995/r17A.36(6)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36(6)(b)> a tmk:LegislativeUnit ;
