    tmk:ordinal 10 ;
    tmk:text "(5) If a party files a notice, in an approved form, requesting the Registrar to discontinue the coolingoff period, the Registrar must do so." ;
    tmk:upstreamRef "TMR1995/r5.16(5)" .

