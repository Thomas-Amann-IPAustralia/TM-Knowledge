    tmk:contentHash "sha256:984cc1d886b7b2cf9f7530eb28c67fea5fb53710db513318263af8864d0b3728" ;
    tmk:ordinal 8 ;
    tmk:text "(3) If an application is made under subsection (2), the Registrar must deal with the trade marks, or the identified trade marks, as if they were one registration." ;
    tmk:upstreamRef "TMA1995/s82A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83> ;
