    tmk:ordinal 3 ;
    tmk:text "(b) an application for the registration of a trade mark is made, or has already been made, by a person other than the person who was registered as the owner of the unrenewed trade mark;" ;
    tmk:upstreamRef "TMA1995/s80(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s80~1> a tmk:LegislativeUnit ;
