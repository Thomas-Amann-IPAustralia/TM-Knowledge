    tmk:ordinal 32 ;
    tmk:text "Note 3: For priority date see section 12." ;
    tmk:upstreamRef "TMA1995/s44~2~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f21aa1940ba0ae24b1e2da4481ab2469743b2448de02e55bcf74266fc64b69c5" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If a single application for the registration of a trade mark in respect of certain goods and/or services is pending (parent application), the applicant may make another application (divisional application) for the registration of the trade mark in respect of some only of the goods and/or services in respect of which registration is sought under the parent application." ;
    tmk:upstreamRef "TMA1995/s45(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:67c2fd736ac427503084800ce3fbf33e937d9f2f7fe714f22d69c76e34c51fa6" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For applicant and pending see section 6." ;
    tmk:upstreamRef "TMA1995/s45(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:14bddec96ce683ba5636cff9067cb8556da843e57c33f07b63edc02e54284ddc" ;
    tmk:ordinal 3 ;
    tmk:text "(2) To avoid doubt, the parent application may itself be a divisional application." ;
    tmk:upstreamRef "TMA1995/s45(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:de5cad81aedc0f6ea001eba0ff1cd8d45dc6d57c2315fd3929007962250b90ba" ;
    tmk:ordinal 4 ;
    tmk:text "Note: A divisional application may be made by a person who has become the applicant in relation to the parent application because of subsection 108(2) (which deals with assignment and transmission)." ;
    tmk:upstreamRef "TMA1995/s45(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46> ;
