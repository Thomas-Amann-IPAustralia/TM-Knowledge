<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s186~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s186> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2763c17d0e607eaf7779c6ec2c456d83f3f6b7f99df142a82534db1f8b410d22" ;
    tmk:ordinal 1 ;
    tmk:text "Subject to this Part, the provisions of this Act (other than subsection 20(1), paragraph 27(1)(b), sections 41 and 59, sections 121 and 127, Part 9—Removal of trade mark from Register for nonuse and Part 16—Certification Trade Marks) apply to defensive trade marks and so apply as if a reference to a trade mark included a reference to a defensive trade mark." ;
    tmk:upstreamRef "TMA1995/s186~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187> ;
