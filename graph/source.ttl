    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar must, to the extent that is practicable, examine applications for the registration of trade marks in relation to which requests under regulation 4.18 are granted:" ;
    tmk:upstreamRef "TMR1995/r4.19(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19(1)(a)> a tmk:LegislativeUnit ;
