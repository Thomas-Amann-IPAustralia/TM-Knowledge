<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f2402b1b30c6e8992a00a6e5599536c35f845f3b152c9340f142efe56614e85e" ;
    tmk:ordinal 1 ;
    tmk:text "(1) In any proceedings relating to an opposed application, it is for the opponent to rebut:" ;
    tmk:upstreamRef "TMA1995/s100(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1a47309db012149201ed2a34bd6f63205046fa4301056e7d9384313ec97e5f4b" ;
    tmk:ordinal 2 ;
    tmk:text "(a) any allegation made under paragraph 92(4)(a) that, on the day on which the application for the registration of the trade mark was filed, the applicant for registration had no intention in good faith:" ;
    tmk:upstreamRef "TMA1995/s100(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)(a)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:313f364b2aea250cefe050819abdabbb935c8e066a9142e9b810130a8db4443e" ;
    tmk:ordinal 3 ;
    tmk:text "(i) to use the trade mark in Australia; or" ;
    tmk:upstreamRef "TMA1995/s100(1)(a)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)(a)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:34a70264b011079a12530031301b50b001c96abd075608bc9c2108d64d65024f" ;
    tmk:ordinal 4 ;
    tmk:text "(ii) to authorise the use of the trade mark in Australia; or" ;
    tmk:upstreamRef "TMA1995/s100(1)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)(a)(iii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9d5d8db1c94dd17cc4875e8aef281c2d5f9a3c2ade8c2ea1b9205c83fd197a07" ;
    tmk:ordinal 5 ;
    tmk:text "(iii) to assign the trade mark to a body corporate for use by the body corporate in Australia;" ;
    tmk:upstreamRef "TMA1995/s100(1)(a)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:91a4214e585ec7e0cce48057b60f1a7a980a3b95d516688c5d2b122883bb6f00" ;
    tmk:ordinal 7 ;
    tmk:text "(b) any allegation made under paragraph 92(4)(a) that the trade mark has not, at any time before the period of one month ending on the day on which the opposed application was filed, been used, or been used in good faith, by its registered owner in relation to the relevant goods and/or services; or" ;
    tmk:upstreamRef "TMA1995/s100(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:037c90ba8216e547a07542984fb9c17dd70bf334cde59cb6e0ac72636ff7cd53" ;
    tmk:ordinal 8 ;
    tmk:text "(c) any allegation made under paragraph 92(4)(b) that the trade mark has not, at any time during the period of 3 years ending one month before the day on which the opposed application was filed, been used, or been used in good faith, by its registered owner in relation to the relevant goods and/or services." ;
    tmk:upstreamRef "TMA1995/s100(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)(c)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:218ed517b3eba61446f17551058083d34c3a769b5530faccba5d9c5fde7feae8" ;
    tmk:ordinal 9 ;
    tmk:text "Note 1: If the registered owner of the trade mark has authorised another person to use it, any authorised use of the trade mark by that person is taken to be a use of the trade mark by the registered owner (see subsection 7(3))." ;
    tmk:upstreamRef "TMA1995/s100(1)(c)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)(c)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3054b46c240c78988dc0d89d07beec5f81daa37fea9c7d2929725d1e5d3507b3" ;
    tmk:ordinal 10 ;
    tmk:text "Note 2: For file, month and registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s100(1)(c)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5ab4e258c8476a3ca5639fde28664aa862cfbfccf1dd85cc22d6f42c5ba9e4ab" ;
    tmk:ordinal 6 ;
    tmk:text "in relation to the goods and/or services to which the opposed application relates (relevant goods and/or services); or" ;
    tmk:upstreamRef "TMA1995/s100(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:af7bb753a645d7712c526f090ec38a5a60a550cfa992288f373d6285589edb3e" ;
    tmk:ordinal 11 ;
    tmk:text "(2) For the purposes of paragraph 1(b), the opponent is taken to have rebutted the allegation that the trade mark has not, at any time before the period referred to in that paragraph, been used, or been used in good faith, by its registered owner in relation to the relevant goods and/or services if:" ;
    tmk:upstreamRef "TMA1995/s100(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dcfa64cae34c964a96ead652c1e3c108f23b7b3e8493e8285738ad471bbbbe5b" ;
    tmk:ordinal 12 ;
    tmk:text "(a) the opponent has established that the trade mark or the trade mark with additions or alterations not substantially affecting its identity, was used in good faith by its registered owner in relation to those goods or services before that period; or" ;
    tmk:upstreamRef "TMA1995/s100(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5addf8a1e2d1acec57a65e21a06fd355e98d28bad85d409a7f55ff4b8e1750f8" ;
    tmk:ordinal 13 ;
    tmk:text "(b) in a case where the trade mark has been assigned but a record of the assignment has not been entered in the Register:" ;
    tmk:upstreamRef "TMA1995/s100(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ae6b4c3204340923fbe2a7c75d98c9b623c7b60bcf451e752bc9520fff8370e3" ;
    tmk:ordinal 14 ;
    tmk:text "(i) the opponent has established that the trade mark, or the trade mark with additions or alterations not substantially affecting its identity, was used in good faith by the assignee in relation to those goods or services before that period and that that use was in accordance with the terms of the assignment; and" ;
    tmk:upstreamRef "TMA1995/s100(2)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4f2adf49f2dc3421047ff97594dde24e5764d537a95eb8cc0eeb13a7f8bdbd1c" ;
    tmk:ordinal 15 ;
    tmk:text "(ii) the Registrar or the court is of the opinion that it is reasonable, having regard to all the circumstances of the case, to treat the use of the trade mark by the assignee before that period as having been a use of the trade mark in relation to those goods or services by the registered owner." ;
    tmk:upstreamRef "TMA1995/s100(2)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)(b)(ii)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:218ed517b3eba61446f17551058083d34c3a769b5530faccba5d9c5fde7feae8" ;
    tmk:ordinal 16 ;
    tmk:text "Note 1: If the registered owner of the trade mark has authorised another person to use it, any authorised use of the trade mark by that person is taken to be a use of the trade mark by the registered owner (see subsection 7(3))." ;
    tmk:upstreamRef "TMA1995/s100(2)(b)(ii)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(2)(b)(ii)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7d15db38aed7df06bec461be96bceeae8bb0ee01511b01f7a4c9bafb7b800487" ;
    tmk:ordinal 17 ;
    tmk:text "Note 2: For registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s100(2)(b)(ii)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:aff7e7cd72030f640e97e8e0b205fd0020dc0016385cfc37c51960877f11aa46" ;
    tmk:ordinal 18 ;
    tmk:text "(3) For the purposes of paragraph 1(c), the opponent is taken to have rebutted the allegation that the trade mark has not, at any time during the period referred to in that paragraph, been used, or been used in good faith, by its registered owner in relation to the relevant goods and/or services if:" ;
    tmk:upstreamRef "TMA1995/s100(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a79bd85a5ac625b016cfd3c7e19893455db9581254c3a90e40f705c0bfd52d25" ;
    tmk:ordinal 19 ;
    tmk:text "(a) the opponent has established that the trade mark, or the trade mark with additions or alterations not substantially affecting its identity, was used in good faith by its registered owner in relation to those goods or services during that period; or" ;
    tmk:upstreamRef "TMA1995/s100(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5addf8a1e2d1acec57a65e21a06fd355e98d28bad85d409a7f55ff4b8e1750f8" ;
    tmk:ordinal 20 ;
    tmk:text "(b) in a case where the trade mark has been assigned but a record of the assignment has not been entered in the Register:" ;
    tmk:upstreamRef "TMA1995/s100(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(3)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
