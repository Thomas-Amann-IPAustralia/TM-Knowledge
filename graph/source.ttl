    tmk:ordinal 17 ;
    tmk:text "(d) a specimen of the trade mark." ;
    tmk:upstreamRef "TMR1995/r4.3(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3~1> a tmk:LegislativeUnit ;
