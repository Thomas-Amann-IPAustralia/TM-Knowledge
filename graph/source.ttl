    tmk:contentHash "sha256:14cecccd94695936e9596d4392ab6aaea196948107f8350e8578853bbdabfa83" ;
    tmk:ordinal 2 ;
    tmk:text "appeal period, in relation to an opposition decision, means the period within which an appeal from the decision can be made under regulation 17A.34P, not including any extension of the period that the court may allow in a particular case." ;
    tmk:upstreamRef "TMR1995/r17A.36/appeal-period" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36~1> a tmk:LegislativeUnit ;
