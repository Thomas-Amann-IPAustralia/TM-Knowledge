    tmk:ordinal 8 ;
    tmk:text "(a) a person deals with or provides, in the course of trade, goods or services in relation to which a trade mark is used; and" ;
    tmk:upstreamRef "TMA1995/s8(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5c689331db9b144e73566c209785661556ee361a4a90366464f5edf7127d7a29" ;
    tmk:ordinal 9 ;
    tmk:text "(b) the owner of the trade mark exercises financial control over the other person’s relevant trading activities;" ;
    tmk:upstreamRef "TMA1995/s8(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8> ;
