    tmk:contentHash "sha256:5cad2f0b48548b90a5fa240553e1fbd541ecb431224a405454ba23a10dadf0d0" ;
    tmk:ordinal 7 ;
    tmk:text "(a) who has been required by the Registrar to produce a document or any other thing; and" ;
    tmk:upstreamRef "TMA1995/s153(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153> ;
