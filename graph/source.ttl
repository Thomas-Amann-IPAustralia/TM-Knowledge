    tmk:ordinal 1 ;
    tmk:text "If the result of an action under this Subdivision is that the Registrar decides, or is directed by a court:" ;
    tmk:upstreamRef "TMR1995/r17A.48X~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48X~2> a tmk:LegislativeUnit ;
