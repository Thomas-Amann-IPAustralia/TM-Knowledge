    tmk:upstreamRef "TMA1995/s87~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s87~3~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s87> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7888c51ad4019509e0c79e6f595de97f68bbf245fd76ef9f153b3bd6719bb940" ;
    tmk:ordinal 14 ;
    tmk:text "Note 1: Sections 24 and 25 provide that the registered owner of a trade mark does not have exclusive rights to use, or to authorise the use of, the trade mark if it consists of, or contains, a sign that:" ;
    tmk:upstreamRef "TMA1995/s87~3~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s87~3~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s87> ;
