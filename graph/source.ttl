    tmk:ordinal 9 ;
    tmk:text "(3) If, before 1 January 2001, an application by:" ;
    tmk:upstreamRef "TMR1995/r4.7(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7> ;
