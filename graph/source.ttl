    tmk:contentHash "sha256:742bff4b87458e1451467f8ea462e332972e7c866bbde6de672a9f2645d3bf47" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar may, for the purposes of this Act:" ;
    tmk:upstreamRef "TMA1995/s202~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s203~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s203> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:72f10fa763072143a7ded2d5068fced30b967c3d486f8f76606db7f31257e88a" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar may not exercise a power under this Act in any way that adversely affects a person applying for the exercise of that power without first giving that person a reasonable opportunity of being heard." ;
    tmk:upstreamRef "TMA1995/s203~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204> ;
