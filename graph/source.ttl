    tmk:ordinal 11 ;
    tmk:text "covering includes packaging, frame, wrapper, container, stopper, lid or cap." ;
    tmk:upstreamRef "TMA1995/s9/covering" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9/label> a tmk:LegislativeUnit ;
