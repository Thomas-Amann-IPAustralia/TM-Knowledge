    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d8c10b37b85ba40cac1ed442cd280474ebd847446a8f72eec025ce4ff22394f1" ;
    tmk:ordinal 10 ;
    tmk:text "international registration of a trade mark means registration of the mark in the International Register." ;
    tmk:upstreamRef "TMR1995/r17A.2/international-registration" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/international-registration-designating-australia> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:59ef831d74af9e00fcd92ad22bd5f9e687f6279b5c50763aca92ebb217752ec7" ;
    tmk:ordinal 11 ;
    tmk:text "international registration designating Australia, or IRDA, means a request, made under Article 3ter (1) or (2) of the Protocol, for extension to Australia of the protection resulting from the international registration of a trade mark." ;
    tmk:upstreamRef "TMR1995/r17A.2/international-registration-designating-australia" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/madrid-regulations> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
