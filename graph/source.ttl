    tmk:ordinal 4 ;
    tmk:text "Note: For file see section 6." ;
    tmk:upstreamRef "TMA1995/s66(1)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(2)> a tmk:LegislativeUnit ;
