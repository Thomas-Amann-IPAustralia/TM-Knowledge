    tmk:ordinal 2 ;
    tmk:text "Note: For sign see section 6." ;
    tmk:upstreamRef "TMA1995/s17~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s18(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s18> ;
