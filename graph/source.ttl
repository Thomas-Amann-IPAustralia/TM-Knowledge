    tmk:ordinal 10 ;
    tmk:text "(4) If the opponent files evidence in support of the opposition, the IRDA holder must file any evidence in answer to the evidence in support within 3 months from the day the Registrar:" ;
    tmk:upstreamRef "TMR1995/r17A.34J(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34J(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34J> ;
