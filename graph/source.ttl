    tmk:ordinal 4 ;
    tmk:text "(a) the application was in respect of a trade mark whose registration had also been sought in one or more than one Convention country; and" ;
    tmk:upstreamRef "TMA1995/s72(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:387797a3df848a537a84ddb6b615ea93b5bebbc329d08e07107a8d24541aa04c" ;
    tmk:ordinal 5 ;
    tmk:text "(b) the applicant claimed a right of priority under section 29 for the registration of the trade mark in respect of particular goods or services; and" ;
    tmk:upstreamRef "TMA1995/s72(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72> ;
