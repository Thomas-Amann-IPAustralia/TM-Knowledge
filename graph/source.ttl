    tmk:contentHash "sha256:2a7f04278d2a8557009e96267ac783b5caf4ed7a50b0257d7577092aa61213d5" ;
    tmk:ordinal 6 ;
    tmk:text "(a) an opposition to the registration of a trade mark under section 52; or" ;
    tmk:upstreamRef "TMA1995/s66(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66> ;
