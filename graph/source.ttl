<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part35/12> a tmk:Page ;
    rdfs:label "12. Rectification of the Register and variation of rules by order of the court"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
