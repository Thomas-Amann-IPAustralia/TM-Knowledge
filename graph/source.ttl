    tmk:ordinal 1 ;
    tmk:text "(1) Subject to subregulation (2), the date of effect of the protection of a protected international trade mark is:" ;
    tmk:upstreamRef "TMR1995/r17A.4(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4> ;
