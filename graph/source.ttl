    tmk:ordinal 5 ;
    tmk:text "(ii) registration has already been renewed under Division 3 for a period that includes the day on which particulars of registration were entered in the Register under section 69." ;
    tmk:upstreamRef "TMA1995/s74A(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74A(b)(ii)~1> a tmk:LegislativeUnit ;
