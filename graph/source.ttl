    tmk:ordinal 7 ;
    tmk:text "Note: For applied to or in relation to goods and applied in relation to services see section 9." ;
    tmk:upstreamRef "TMA1995/s228~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:65acd1629f2e15299f5e557ffec02c3e4e38cd3f0c9a8d64d5fc3899813ac3c7" ;
    tmk:ordinal 1 ;
    tmk:text "If the particulars entered in the Register under paragraph 207(2)(a) in respect of an existing registered mark include particulars of a disclaimer made (under section 32 of the repealed Act) by the registered proprietor of the mark about the exclusive right to use a specified part of the mark, that disclaimer has effect as if it were a disclaimer made under section 74 of this Act." ;
    tmk:upstreamRef "TMA1995/s238~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4101ae20ff15a88819162b840ff47f43c6d70f3cf9d3f639a4f89b709ae37195" ;
    tmk:ordinal 2 ;
    tmk:text "Note: For existing registered mark see section 6." ;
    tmk:upstreamRef "TMA1995/s238~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s24> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0919e848d6282beedf4b53e321cb25eb80085b664c2e8826c21bf36086d8b654" ;
    tmk:ordinal 1 ;
    tmk:text "(1) This section applies if a registered trade mark consists of, or contains, a sign that, after the date of registration of the trade mark, becomes generally accepted within the relevant trade as the sign that describes or is the name of an article, substance or service." ;
    tmk:upstreamRef "TMA1995/s24(1)" .

