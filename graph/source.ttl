<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r10.1> a tmk:LegislativeProvision ;
    rdfs:label "Applications for assignment etc to be recorded or entered"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:086b742c23deea1f6553aa8d3aa5d9cd81c2c4eb459e9ae31aa349acf612442d" ;
    tmk:text "For the purposes of paragraphs 107(2)(b) and 109(2)(b) of the Act (which deal with assignment and transmission), the following documents are prescribed: (a) a document that establishes the title to a trade mark of the assignee, or of the person to whom the trade mark has been transmitted; (b) evidence in writing of consent of the Commission to the assignment of a certification trade mark." ;
    tmk:upstreamRef "TMR1995/r10.1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r16.10A> a tmk:LegislativeProvision ;
