    tmk:ordinal 5 ;
    tmk:text "(c) notify the person of the Registrar’s decision in relation to the matter." ;
    tmk:upstreamRef "TMR1995/r21.16(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d20d4471b4878e5b896e835d2a24d0a9053a44ae4bedf3675fec0530db296a43" ;
    tmk:ordinal 7 ;
    tmk:text "(2) If the Registrar decides that a person may be heard by way of an oral hearing, the Registrar must give notification of the date, time and place of the hearing to the person at least 10 business days before the day the hearing is to begin." ;
    tmk:upstreamRef "TMR1995/r21.16(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:51b4d919709316123c3194e5b411188a597ce99ae46bdb83fb954d2ec963d07a" ;
    tmk:ordinal 8 ;
    tmk:text "(3) The Registrar may adjourn an oral hearing from time to time or from place to place by notifying the person." ;
    tmk:upstreamRef "TMR1995/r21.16(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(4)> a tmk:LegislativeUnit ;
