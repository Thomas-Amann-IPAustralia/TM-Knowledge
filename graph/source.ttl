    tmk:contentHash "sha256:59b6baab554222dc9afdf50d2a7863c54a7d7e591da8522386dd4a2a87876b4d" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If a trade mark becomes a protected international trade mark, the Registrar must:" ;
    tmk:upstreamRef "TMR1995/r17A.37(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:09f5fb8d1bf6858ab613c97e3659fc5ba81e9c55885ff3a7a12a6ca76414df19" ;
    tmk:ordinal 2 ;
    tmk:text "(a) publish that fact in a computer database maintained by the Trade Marks Office; and" ;
    tmk:upstreamRef "TMR1995/r17A.37(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f0c32fa72b52c530f6f4e521edad14e2e52f4bfebfcb7f3c449cf470d3ed99a8" ;
    tmk:ordinal 3 ;
    tmk:text "(b) record that fact in the Record of International Registrations." ;
    tmk:upstreamRef "TMR1995/r17A.37(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:441d3d67b831bc3d036983f9af66eb4238b94dc56270b65d6202603f9ca3f9dd" ;
    tmk:ordinal 4 ;
    tmk:text "(2) The notice and record must include particulars of the conditions (if any) and the limitations (if any) to which the protection is subject." ;
    tmk:upstreamRef "TMR1995/r17A.37(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2a5576ed25b18fd06b3c3ec3bc36e2c291d7db18a187e981b714aed3b2d176e9" ;
    tmk:ordinal 5 ;
    tmk:text "(3) As soon as practicable after receiving notice that a trade mark is a protected international trade mark, the holder must notify the Registrar, in writing, of the holder’s address for service in Australia or New Zealand." ;
    tmk:upstreamRef "TMR1995/r17A.37(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ecf203d1574e9799992290e761ff07f34016d7950b2eacad906db1b480770af9" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Subject to this Part, sections 20 to 26 of the Act and Parts 12, 13 and 14 of the Act (except section 128 of the Act) and regulations 3.2, 13.1, 13.2 and 13.3 apply in relation to a protected international trade mark." ;
    tmk:upstreamRef "TMR1995/r17A.39(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7e154b33aadb910e30e8e55b39e7de8631a4e05027181b534610d966a3cbd8ef" ;
    tmk:ordinal 2 ;
    tmk:text "(2) For that application, a reference in those sections, Parts or regulations:" ;
    tmk:upstreamRef "TMR1995/r17A.39(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c26abb90b8f1494a676d79198c34d9e218ac77b290ce3ff260cee0149ed04ef3" ;
    tmk:ordinal 3 ;
    tmk:text "(a) to a registered trade mark or a trade mark that is registered is taken to be a reference to the protected international trade mark or a trade mark that is a protected international trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.39(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f124221af208010349bf5bcf47b5a14f1e731028d4ce8f0aea584ca0b5c50403" ;
    tmk:ordinal 4 ;
    tmk:text "(b) to a registered owner of a trade mark is taken to be a reference to the holder of the protected international trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.39(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8d81f30edef9115784c7f395a6a3567e2f95e2656e862917c7c1d2db5a798d9c" ;
    tmk:ordinal 5 ;
    tmk:text "(c) to goods or services in respect of which a trade mark is registered is taken to be a reference to goods or services covered by the protected international trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.39(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(2)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d61e2e28f6a7bb9503e8ae3e07c9accbfa97b6ab7cb96999b2a5827a2ec32275" ;
    tmk:ordinal 6 ;
    tmk:text "(d) to the date of registration of a trade mark is taken to be a reference to the date of effect of the protection of the trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.39(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(2)(e)> a tmk:LegislativeUnit ;
