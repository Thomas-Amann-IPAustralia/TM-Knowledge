    tmk:ordinal 3 ;
    tmk:text "(a) contest a belief of the Registrar that is expressed in the report; and" ;
    tmk:upstreamRef "TMR1995/r4.9(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9(2)(b)> a tmk:LegislativeUnit ;
