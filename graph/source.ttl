    tmk:ordinal 1 ;
    tmk:text "(1) For an IRDA in respect of which a report is made under regulation 17A.16, the Registrar must notify his or her decision under regulation 17A.24 (the final decision on examination) to the International Bureau:" ;
    tmk:upstreamRef "TMR1995/r17A.20(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:de36c80869bd1cfb77b034159e425ce08d5b559ad0de657a3b8a0bb6e2151301" ;
    tmk:ordinal 2 ;
    tmk:text "(a) if paragraph (b) does not apply—within 15 months from the date of that report (whether or not a further report is made under regulation 17A.18); or" ;
    tmk:upstreamRef "TMR1995/r17A.20(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:11ac6b77b6154e5bbfae8eb4201a0f1e7d9140a952235866ccabaa49e7acd887" ;
    tmk:ordinal 3 ;
    tmk:text "(b) if a further report raises grounds under Subdivision 2 for rejecting the IRDA that were not raised in the report made under regulation 17A.16—within 15 months from the date of the further report." ;
    tmk:upstreamRef "TMR1995/r17A.20(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8c4e57fd236bc4fff335380d833695419fb0bbb1cd76de2d320e5ca099c3c8b2" ;
    tmk:ordinal 4 ;
    tmk:text "(2) In determining the period of 15 months for the purposes of paragraph (1)(a) or (b) in relation to an IRDA, no account is to be taken of any period during which acceptance of the IRDA is deferred under regulation 17A.21." ;
    tmk:upstreamRef "TMR1995/r17A.20(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20> ;
