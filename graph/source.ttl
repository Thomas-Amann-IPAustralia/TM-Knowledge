    tmk:ordinal 11 ;
    tmk:text "then the term must not be used in the IRDA to specify the goods or services in respect of which protection is sought." ;
    tmk:upstreamRef "TMR1995/r17A.14~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2016d0c74cdc8bfb58951144ada28ba147cd9659396b57d30a4becbd26994b23" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If:" ;
    tmk:upstreamRef "TMR1995/r17A.15(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5ab94cbe2084ba4c84d6f94c670df8c0e26bcf3e33caee83565f11d45f04eaf3" ;
    tmk:ordinal 2 ;
    tmk:text "(a) a person has made an application for the registration of a trade mark in 1 or more Convention countries; and" ;
    tmk:upstreamRef "TMR1995/r17A.15(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:cfb3d445c53ca88407d750b1400d51eeb44ff883703ae348ef36fe04d855f4c1" ;
    tmk:ordinal 3 ;
    tmk:text "(b) within 6 months after the day on which that application, or the first of those applications, was made, that person or another person (successor in title) of whom that person is a predecessor in title makes an IRDA in respect of some or all of the goods, services or goods and services in respect of which registration was sought in that country or those countries;" ;
    tmk:upstreamRef "TMR1995/r17A.15(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1b909b2072b2e0a5bcd6d391334601846babd6c6400acfcb1c4057aba7f06142" ;
    tmk:ordinal 5 ;
    tmk:text "(2) The right of priority must be claimed in the IRDA that is notified to the Registrar in accordance with this Division." ;
    tmk:upstreamRef "TMR1995/r17A.15(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:34a09348980c1c3d81784efa981fb95d3f9ae8993c3e7c2ecaf047ff45979afb" ;
    tmk:ordinal 6 ;
    tmk:text "Note: Rule 9(4)(iv) of the Madrid Regulations contains requirements relating to claims for priority." ;
    tmk:upstreamRef "TMR1995/r17A.15(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3ef30e045554abb06bae5f5a72b5a8409c152bbb71cd4f49d0389774865732b0" ;
    tmk:ordinal 7 ;
    tmk:text "(3) The priority claimed is for the protection of the trade mark in respect of the goods, services or goods and services:" ;
    tmk:upstreamRef "TMR1995/r17A.15(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7a1663e9bfa7b9fc1867ff09a098903b065031248570281c4d95386bb7a8795b" ;
    tmk:ordinal 8 ;
    tmk:text "(a) if an application to register the trade mark was made in only 1 Convention country—from (and including) the day on which the application was made in that country; or" ;
    tmk:upstreamRef "TMR1995/r17A.15(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1d713fb3e453e324812e157156edd4b235a63868bd5f2876842d578d3c9afde6" ;
    tmk:ordinal 9 ;
    tmk:text "(b) if applications to register the trade mark were made in more than 1 Convention country—from (and including) the day on which the earliest of those applications was made." ;
    tmk:upstreamRef "TMR1995/r17A.15(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15(3)(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.15> ;
