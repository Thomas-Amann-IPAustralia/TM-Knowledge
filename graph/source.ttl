    tmk:upstreamRef "TMR1995/r17A.34C(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34C(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
