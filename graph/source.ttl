    tmk:ordinal 4 ;
    tmk:text "the application must be rejected or the registration may be opposed:" ;
    tmk:upstreamRef "TMA1995/s187~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s189A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s189A> ;
