    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ab2f1c985434247162ba4c0e5e3882ef06317d2f06a1554b68e10944f8183541" ;
    tmk:ordinal 3 ;
    tmk:text "(b) there are grounds under Subdivision 2 for rejecting it in whole or in part;" ;
    tmk:upstreamRef "TMR1995/r17A.16(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4abe6ded6235b4cb66099f964f88f92606e3f69b77b0d30af0ff83fa0a8dc8e8" ;
    tmk:ordinal 5 ;
    tmk:text "(2) Such a report is a provisional refusal for the purposes of the Protocol." ;
    tmk:upstreamRef "TMR1995/r17A.16(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
