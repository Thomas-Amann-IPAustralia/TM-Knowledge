    tmk:upstreamRef "TMA1995/s177~1~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177~1~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s177> ;
