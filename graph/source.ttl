    tmk:ordinal 12 ;
    tmk:text "Note 1: This is so even for a trade mark whose registration in respect of particular goods or services has effect from (and including) the day on which an application was made in a Convention country." ;
    tmk:upstreamRef "TMA1995/s72(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(3)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72> ;
