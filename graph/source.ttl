    tmk:contentHash "sha256:b8132cd593073efacd7ae073d842ffe3e66d531d22e10cbfb491520882c52cd8" ;
    tmk:ordinal 32 ;
    tmk:text "Note 3: For priority date see section 12." ;
    tmk:upstreamRef "TMA1995/s44~2~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52> ;
