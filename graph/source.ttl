    tmk:contentHash "sha256:12980e01e8a80040cd9e26e5d736d2ffe41c0ee535fd14bbe76252c6d232ce16" ;
    tmk:ordinal 1 ;
    tmk:text "(1) An applicant may respond in writing to the Registrar’s report under regulation 4.8." ;
    tmk:upstreamRef "TMR1995/r4.9(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9(2)> a tmk:LegislativeUnit ;
