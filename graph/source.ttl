<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s50> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMA1995/s50" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9ac2fb40c863256d91bdd616a40612edf17eadf7fb95ea1b36e347320a5807a1" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A person may make a single application under subsection 27(1) for the registration of 2 or more trade marks in respect of goods and/or services if the trade marks resemble each other in material particulars and differ only in respect of one or more of the following matters:" ;
    tmk:upstreamRef "TMA1995/s51(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)(a)(b)> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMA1995/s51(1)(a)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:912cd93df77e439f0f1186e15bd569ee8aada009ee92dd44a51e294032afdce8" ;
    tmk:ordinal 3 ;
    tmk:text "(b) statements or representations as to number, price, quality or names of places;" ;
    tmk:upstreamRef "TMA1995/s51(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f64405903b566d08f2ae1273408ee857a6ef074d8f049a09896e22907698fd1a" ;
    tmk:ordinal 4 ;
    tmk:text "(c) the colour of any part of the trade mark." ;
    tmk:upstreamRef "TMA1995/s51(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s62(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ce73122c533b781c857bd1503760879998b45b9e8adb03d6868ec55dc3270b60" ;
    tmk:text "(a) that the application, or a document filed in support of the application, was amended contrary to this Act;" ;
    tmk:upstreamRef "TMA1995/s62(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s62(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3027a0b9af7fffb7d30595cad7516f31fc0ef46f2dd6ec94b6963bac8806a057" ;
    tmk:text "(b) that the Registrar accepted the application for registration on the basis of evidence or representations that were false in material particulars." ;
    tmk:upstreamRef "TMA1995/s62(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e6f695490bf91eb12cafd312bb60c419b6baf84f8378c8aa27c5c47239f7d1da" ;
    tmk:ordinal 3 ;
    tmk:text "(2) To avoid any doubt, it is stated that, if a trade mark consists of the following, or any combination of the following, namely, any letter, word, name or numeral, any aural representation of the trade mark is, for the purposes of this Act, a use of the trade mark." ;
    tmk:upstreamRef "TMA1995/s7(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:11a54d049634bbebdee3a3bcf37340cabcfffb3cc65616749ca6fee434e0ad9a" ;
    tmk:ordinal 4 ;
    tmk:text "(3) An authorised use of a trade mark by a person (see section 8) is taken, for the purposes of this Act, to be a use of the trade mark by the owner of the trade mark." ;
    tmk:upstreamRef "TMA1995/s7(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a8694c14550c965880b1b3a8f15c9bd05b1c98f80578d70fe7439e3ac31b5ceb" ;
    tmk:text "(1) An applicant for the registration of a trade mark, or the registered owner of a registered trade mark, may, by notice in writing given to the Registrar, disclaim any exclusive right to use, or authorise the use of, a specified part of the trade mark." ;
    tmk:upstreamRef "TMA1995/s74(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:48dc154ae4e480dc846352472551a2d2bd08700a7d692bd4f17a100f8259e7ac" ;
    tmk:text "(4) A disclaimer properly made may not be revoked." ;
    tmk:upstreamRef "TMA1995/s74(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5ab774a69addefebfbb76df09ffb19b16415f442fd7e458fe86af94511d4dfce" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The use of a trade mark by an authorised user of the trade mark is an authorised use of the trade mark to the extent only that the user uses the trade mark under the control of the owner of the trade mark." ;
    tmk:upstreamRef "TMA1995/s8(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83> ;
