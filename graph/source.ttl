<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s37(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s37> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bccbd3541a3dff5119d39d44830ebe2b78d7580a4217cfe85915ac054351b2df" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Subject to subsection (2), an application lapses if it is not accepted within the prescribed period or within that period as extended in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s37(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6b05cf40143ff4b0306fd5ee1e609990715cad25de8702e021829db541728763" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Before a trade mark is registered, the Registrar may revoke the acceptance of the application for registration of the trade mark if he or she is satisfied that:" ;
    tmk:upstreamRef "TMA1995/s38(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:76d84a1a3c5e3301770c421fb47cba683c66956601ae71d5fc5c1bcc18afa2cd" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the application should not have been accepted, taking account of all the circumstances that existed when the application was accepted (whether or not the Registrar knew then of their existence); and" ;
    tmk:upstreamRef "TMA1995/s38(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s38> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3d92e0f84a3b1ea8f2bba8f09982a04136f709a3b42f1fb9dcc941b492c5204a" ;
    tmk:ordinal 3 ;
    tmk:text "(b) it is reasonable to revoke the acceptance, taking account of all the circumstances." ;
    tmk:upstreamRef "TMA1995/s38(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
