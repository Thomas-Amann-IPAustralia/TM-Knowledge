    tmk:ordinal 7 ;
    tmk:text "the registration of the trade mark in respect of those goods or services is taken to have had effect:" ;
    tmk:upstreamRef "TMA1995/s72~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74A(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s74A> ;
