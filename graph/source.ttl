    tmk:ordinal 19 ;
    tmk:text "(a) if the person has an address for service—the document may be served on, or given or sent to, the person by a prescribed means to that address; or" ;
    tmk:upstreamRef "TMA1995/s215(6)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(6)(b)> a tmk:LegislativeUnit ;
