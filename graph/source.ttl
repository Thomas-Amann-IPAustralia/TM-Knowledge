    tmk:contentHash "sha256:aac586357a73fe4b6a67a13c29436788d9461d874e3c40b6dfc4fa4563ba40d3" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For section 189A of the Act, and subject to subregulations (3) and (5), an application for the registration of a trade mark (applicant’s trade mark) in respect of goods (applicant’s goods) must be rejected if:" ;
    tmk:upstreamRef "TMR1995/r4.15A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:65f246447d72c557297809027553c4fb1f4b0c0fa3fb55e176593cd37b1c3c15" ;
    tmk:ordinal 11 ;
    tmk:text "(2) For section 189A of the Act, and subject to subregulations (3) and (5), an application for the registration of a trade mark (applicant’s trade mark) in respect of services (applicant’s services) must be rejected if:" ;
    tmk:upstreamRef "TMR1995/r4.15A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
