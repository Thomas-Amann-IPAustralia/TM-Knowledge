    tmk:ordinal 2 ;
    tmk:text "(a) a Saturday or a Sunday; or" ;
    tmk:upstreamRef "TMR1995/r19.1(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r19.1(b)> a tmk:LegislativeUnit ;
