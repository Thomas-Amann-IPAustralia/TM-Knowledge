    tmk:ordinal 2 ;
    tmk:text "(2) Subject to subregulation (3), if:" ;
    tmk:upstreamRef "TMR1995/r21.21A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.21A(2)(a)> a tmk:LegislativeUnit ;
