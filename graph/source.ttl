    tmk:contentHash "sha256:6ebf0cb57173a05fa42c6f630b9fd10efcec3395d5516be71122b5457338942a" ;
    tmk:ordinal 8 ;
    tmk:text "(6) If the representation of a trade mark in an application for registration of the trade mark includes characters constituting words, being characters that are not roman letters, the applicant must file in support of the application:" ;
    tmk:upstreamRef "TMR1995/r4.3(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(6)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
