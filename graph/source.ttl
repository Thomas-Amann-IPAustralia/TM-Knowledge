    tmk:contentHash "sha256:b8ef38e9d78c9b78e374dfdf0bbe6537f13ab089bcd416b6a9a81798ec9672d8" ;
    tmk:ordinal 4 ;
    tmk:text "that person or that person’s successor in title may claim a right of priority for the protection of the trade mark in respect of any or all of those goods, services or goods and services." ;
    tmk:upstreamRef "TMR1995/r17A.15~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.16> ;
