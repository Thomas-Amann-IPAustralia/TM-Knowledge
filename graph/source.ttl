    tmk:upstreamRef "TMA1995/s9/label" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s90> ;
