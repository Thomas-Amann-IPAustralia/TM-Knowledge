    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:282cd5dc450280cadab8b2c008c9aae292092934761220563279792e9c3d6381" ;
    tmk:ordinal 2 ;
    tmk:text "Note: Declaration forms in the approved form are available on the IP Australia website at www.ipaustralia.gov.au." ;
    tmk:upstreamRef "TMR1995/r21.6(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.6(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.6> ;
