        <https://data.ipaustralia.gov.au/tmk/ref/CASE/2008/FCA/934>,
        <https://data.ipaustralia.gov.au/tmk/ref/CASE/2013/FCA/559>,
        <https://data.ipaustralia.gov.au/tmk/ref/CASE/2020/FCA/1078>,
