    tmk:contentHash "sha256:5f5fba29a2806624b81c4b54bf01cc12bffa472154fbf531a3d01ae2112b1c26" ;
    tmk:ordinal 12 ;
    tmk:text "Note 1: For applied to see section 9." ;
    tmk:upstreamRef "TMA1995/s121(2)(e)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(2)(e)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:13ae90494e1dea74bfed8e1e124bd9ac141f1397160bab9a1d80e146c02e722c" ;
    tmk:ordinal 13 ;
    tmk:text "Note 2: For authorised user see section 8." ;
    tmk:upstreamRef "TMA1995/s121(2)(e)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:56eefa860be4e4d7bc74c5e7f1572dad58df4d60d98d0e5026dd1606adf43760" ;
    tmk:ordinal 14 ;
    tmk:text "(3) Subject to subsection (4), a person infringes a trade mark to which this section applies if the person:" ;
    tmk:upstreamRef "TMA1995/s121(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8c8c9b503264edc1ca06ab4cf75c649fe4129eec28974406999e9f7c11b69694" ;
    tmk:ordinal 15 ;
    tmk:text "(a) is the owner of registered goods; and" ;
    tmk:upstreamRef "TMA1995/s121(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:19d2e49a7aa5fa1a6c52115d95ffed0e553d61d0f7148e2861d5c3bbe735c460" ;
    tmk:ordinal 16 ;
    tmk:text "(b) in the course of trade, or with a view to a dealing with the goods in the course of trade:" ;
    tmk:upstreamRef "TMA1995/s121(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(3)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
