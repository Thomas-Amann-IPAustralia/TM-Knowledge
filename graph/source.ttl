    tmk:ordinal 2 ;
    tmk:text "(2) For that application, a reference in those Parts:" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(a)> a tmk:LegislativeUnit ;
