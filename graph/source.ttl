    tmk:upstreamRef "TMR1995/r21.16~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.17(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.17> ;
