<https://data.ipaustralia.gov.au/tmk/ref/CASE/2019/ATMO/41> a tmk:AdministrativeDecision,
        tmk:Decision ;
    tmk:authorityKind "decision" ;
    tmk:authorityStatus tmk:NotHeld ;
