    tmk:contentHash "sha256:3ecd22d07e58d71cb7230c1d7a3a532f2284df5cd9aff5ac5da366143ef40df5" ;
    tmk:ordinal 3 ;
    tmk:text "(b) a prescribed court determines otherwise; or" ;
    tmk:upstreamRef "TMR1995/r10.5(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r10.5(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r10.5> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4bb536049badfc649c513ca86d4e073bdf973d4949f2bd8a66a6b160f066f566" ;
    tmk:ordinal 4 ;
    tmk:text "(c) each person to whom the Registrar must notify under this subregulation has already notified the Registrar in writing that the person consents to the assignment or transmission." ;
    tmk:upstreamRef "TMR1995/r10.5(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r10.5(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r10.5> ;
