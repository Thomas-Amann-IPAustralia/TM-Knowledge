    tmk:upstreamRef "TMR1995/r17A.2/record-of-international-registrations" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20> ;
