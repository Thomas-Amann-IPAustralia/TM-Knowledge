    tmk:ordinal 15 ;
    tmk:text "(a) an error or omission by the person, the person’s agent, the Registrar or an employee;" ;
    tmk:upstreamRef "TMR1995/r17A.34C(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34C(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34C> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5f8ee212d9c278a80e5c8c418e99df489b8dd6c93ce4fe3a447b02125a36b092" ;
    tmk:ordinal 16 ;
    tmk:text "(b) circumstances beyond the control of the person, other than an error or omission by the person, the person’s agent, the Registrar or an employee." ;
    tmk:upstreamRef "TMR1995/r17A.34C(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34C(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34C> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c9572204b7b89d185d6cfab2aaf76ecc8f5aa9791b30b411a7225dcb59d53cff" ;
    tmk:ordinal 18 ;
    tmk:text "(6) Regulation 17A.31 does not apply to this regulation." ;
    tmk:upstreamRef "TMR1995/r17A.34C(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34D(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34D> ;
