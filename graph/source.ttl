    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f8737d64fc0c9260db786fc3ff6e6a825c645bf7a2b2786fae8757baca0a1ba2" ;
    tmk:ordinal 18 ;
    tmk:text "(c) any special circumstances making it appropriate, in the opinion of the Registrar, that:" ;
    tmk:upstreamRef "TMR1995/r17A.42A(3)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(3)(c)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:47b5ca905f77bbc742673ea8a038765f39928d94f15b5375b35ee85cb5988752" ;
    tmk:ordinal 19 ;
    tmk:text "(i) the trade mark not be protected for some or all of the goods or services in respect of which it is protected; or" ;
    tmk:upstreamRef "TMR1995/r17A.42A(3)(c)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(3)(c)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
