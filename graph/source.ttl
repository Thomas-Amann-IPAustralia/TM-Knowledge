    tmk:contentHash "sha256:62da2009f058acd85b339386a881d27680a4781b330ac9a02eebda4f466895c6" ;
    tmk:ordinal 5 ;
    tmk:text "(3) In this section:" ;
    tmk:upstreamRef "TMA1995/s227(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227/decision> a tmk:LegislativeUnit ;
