    tmk:ordinal 4 ;
    tmk:text "(b) the procedure for dealing with requests to extend to Australia the protection resulting from international registration of trade marks;" ;
    tmk:upstreamRef "TMA1995/s189A(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s189A(2)(c)> a tmk:LegislativeUnit ;
