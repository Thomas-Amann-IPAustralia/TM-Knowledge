    tmk:ordinal 13 ;
    tmk:text "(i) the person uses a trade mark that is substantially identical with, or deceptively similar to, the firstmentioned trade mark; and" ;
    tmk:upstreamRef "TMA1995/s122(1)(fa)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122(1)(fa)(ii)> a tmk:LegislativeUnit ;
