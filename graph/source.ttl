    tmk:ordinal 2 ;
    tmk:text "(a) an application has been made to the Registrar under subsection 92(1); and" ;
    tmk:upstreamRef "TMA1995/s94(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s94(b)> a tmk:LegislativeUnit ;
