<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part39/1> a tmk:Page ;
    rdfs:label "1. Overview of registration"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:033b7b52e6200c628b218c40c7b67383f45b4130c9f4069380a6ff771beb9d93" ;
    tmk:lastAmended "2025-06-04" ;
    tmk:partId "Part39" ;
