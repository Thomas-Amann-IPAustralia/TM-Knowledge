    tmk:contentHash "sha256:159949e19792ae93d696171cc1b9e86e6430358a897346a46d5ae4f3809a2cf2" ;
    tmk:ordinal 6 ;
    tmk:text "(a) the regulations declare that, under the law of a Convention country, an application for the registration of a trade mark made in another country is equivalent to an application made in the Convention country; and" ;
    tmk:upstreamRef "TMA1995/s225(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s225(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s225> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9331d77e8cdc6ea81ad1c5cf935037566f0ab3abafad6a92673a28a8a2d43567" ;
    tmk:ordinal 7 ;
    tmk:text "(b) an application for the registration of a trade mark is made in that other country;" ;
    tmk:upstreamRef "TMA1995/s225(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s225~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s225> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c59cf12283af97cfba0e032f53783b4f24ee228ba5a74e3d9e09dbec0a6723c5" ;
    tmk:ordinal 4 ;
    tmk:text "then, for the purposes of this Act, an application for the registration of the trade mark is taken to have also been made in the other Convention country or in each of the other Convention countries (as the case may be)." ;
    tmk:upstreamRef "TMA1995/s225~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s225~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s225> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:95d480b64ce5d790d8e55ebf0e4cfbc9e395cc9942a89b32860514f894dff79a" ;
    tmk:ordinal 8 ;
    tmk:text "then, for the purposes of this Act, an application for the registration of the trade mark is taken to have also been made in the Convention country." ;
    tmk:upstreamRef "TMA1995/s225~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s227> ;
