    tmk:ordinal 4 ;
    tmk:text "(b) may be made in respect of any or all of the goods and/or services in respect of which the trade mark may be, or is, registered." ;
    tmk:upstreamRef "TMA1995/s92(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92> ;
