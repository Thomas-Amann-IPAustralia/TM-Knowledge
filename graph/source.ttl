    tmk:contentHash "sha256:32621c109d1c1fc30b345f759eced15cb2feb2e6935d3255c08cf02e89f0d32d" ;
    tmk:ordinal 12 ;
    tmk:text "is accompanied by a written request by the applicant to postpone publication of the particulars of the application, the Registrar must publish the particulars of the application as soon as practicable after the expiration of 3 months after the date on which the application was filed." ;
    tmk:upstreamRef "TMR1995/r4.7~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b49812f8edb85b34c7d9821d8d3e43d097a44bcee47a642c85dbc88a8983e22d" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of section 31 of the Act (which deals with examination and reporting), if in the course of an examination of an application the Registrar reasonably believes that:" ;
    tmk:upstreamRef "TMR1995/r4.8(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:38384a0aebb4a02092f0bc93bad1846641c5e3e1b9e5d6173ea06f81bfdd76c4" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the application has not been made in accordance with the Act or these regulations; or" ;
    tmk:upstreamRef "TMR1995/r4.8(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a86954ee71fec3fb1da638ec81de3360bc8e19ae7c3d4732323fdd734fc1f14b" ;
    tmk:ordinal 3 ;
    tmk:text "(b) there are grounds under Division 2 of Part 4 of the Act for rejecting it;" ;
    tmk:upstreamRef "TMR1995/r4.8(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8> ;
