    tmk:contentHash "sha256:e441f399005dcfa3ce3a4838f8bd2f89cffc84f481f8b50ab93f7e15ae6d94c8" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/2/4/2/4/1/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/2/4/2/4/1/prov/1> ;
    tmk:headingPath "2.4.1 Relevant Legislation",
        "60.2.4 Certifying Process",
        "Part 60 The Madrid Protocol" ;
