    tmk:contentHash "sha256:d03b8209f6617de1598d9f49728d78f5364909b3b5359e09d491d7841ab1f437" ;
    tmk:ordinal 7 ;
    tmk:text "Note: Section 65 of the Act relates to the amendment of an application after particulars of the application have been published." ;
    tmk:upstreamRef "TMR1995/r4.9(2)(d)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.10(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.10> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fb6bbcdcb01a4f8034512736d38d44242765cbee95c1fa68e2d8555ea264f450" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar may grant a request under subregulation 5.9(1) for an extension of time only if the Registrar is satisfied that the grounds set out in the request justify the extension." ;
    tmk:upstreamRef "TMR1995/r5.10(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13> ;
