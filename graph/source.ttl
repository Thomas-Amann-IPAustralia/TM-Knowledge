    tmk:contentHash "sha256:fb19a21a84413c20afbb235226476c1e579dc62714b4c8807a32eec510877e24" ;
    tmk:ordinal 2 ;
    tmk:text "(2) If the Registrar decides that the statement is adequate, the Registrar must give a copy of the statement to the holder of the IRDA." ;
    tmk:upstreamRef "TMR1995/r17A.34B(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
