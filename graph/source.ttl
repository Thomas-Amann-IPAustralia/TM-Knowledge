    tmk:ordinal 11 ;
    tmk:text "(4) The Registrar must notify the parties of the Registrar’s decision." ;
    tmk:upstreamRef "TMR1995/r17A.48B(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f855f75382267b60f2cea371abc30e5a936864bf0c5ecd4809ffd0f73cc0bf68" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A person may make an application for cessation of protection." ;
    tmk:upstreamRef "TMR1995/r17A.48C(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:331a6dd737c330359fb04451c018e89bbdf646e6b826e8653700dfe96f22a77c" ;
    tmk:ordinal 2 ;
    tmk:text "(2) However, an application may not be made under subregulation (1) if an action concerning the protected international trade mark is pending in a prescribed court." ;
    tmk:upstreamRef "TMR1995/r17A.48C(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48C> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e7c195ebbbfc3922d1ea1f500a4ca5950207080127587171ee540c050a285bfe" ;
    tmk:ordinal 3 ;
    tmk:text "(3) If subregulation (2) applies, a person may apply to the court for an order directing the Registrar to cease protecting the protected international trade mark." ;
    tmk:upstreamRef "TMR1995/r17A.48C(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d45bac281350e3795efb31bb6d9870e7935d2b84b3171697e868ab23193b2d04" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Part 9 of the Act and Part 9 of these Regulations apply in relation to an application for cessation of protection." ;
    tmk:upstreamRef "TMR1995/r17A.48D(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d8162d6b079f82a7472d04bf99f8f053c51a47766f7542db00967e6ed4b01806" ;
    tmk:ordinal 2 ;
    tmk:text "(2) For that application, a reference in those Parts:" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:eae990ea39864cc6f9132b94412aca940ede89656b4f6bde8e4d27662c0f52bf" ;
    tmk:ordinal 3 ;
    tmk:text "(a) to a registered trade mark or a trade mark that is registered, or entered on the Register, is taken to be a reference to a trade mark that is, or may become, a protected international trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:978e062fe43216fecf5d10d8d461f9e7d6c73553e06320e7341fda85cdc824aa" ;
    tmk:ordinal 4 ;
    tmk:text "(b) to removing a trade mark from the Register is taken to be a reference to the cessation of protection of the trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4d9caa0bc811c97b8c30ee768b99d455c8bb9c75032680209b70edc46ff37308" ;
    tmk:ordinal 5 ;
    tmk:text "(c) to an application for registration of a trade mark is taken to be a reference to an international registration designating Australia; and" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:16c4744508063eec7d41fa3696d3d194d220feca8bc46d965f4b0f645d0f1093" ;
    tmk:ordinal 6 ;
    tmk:text "(d) to an applicant for registration of a trade mark is taken to be a reference to the holder of an international registration designating Australia; and" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e5ad0e458698ca6814113adf99d84f4e9e2815d2e5ed2caf276fd14afb24403d" ;
    tmk:ordinal 7 ;
    tmk:text "(e) to a registered owner of a trade mark is taken to be a reference to the holder of a protected international trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(f)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1544f96f78dd62adf9e9c6b0f7398df2d03ef44781639ef05d6efe19c12a0d7a" ;
    tmk:ordinal 8 ;
    tmk:text "(f) to an application under section 92 is taken to be a reference to an application for cessation of protection; and" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(f)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(g)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fafbdd9d0d67d5765899070fbd736e1c318dd5cac0015dd114c823792ff956fe" ;
    tmk:ordinal 9 ;
    tmk:text "(g) to the date the application for registration of the trade mark was filed, or the filing date in respect of the application for the registration of the trade mark, is taken to be a reference to:" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(g)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(g)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c6f7c911a625f6262fe99e616effc3ef67c4bfc318e697f0b5926c64d3c45efa" ;
    tmk:ordinal 10 ;
    tmk:text "(i) if the request for extension of protection to Australia was made under Article 3ter (1) of the Protocol—the date of international registration of the trade mark; or" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(g)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(g)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7e9730e4ab50ab9622f9ff8516657b9447f125680068948c50d65473d3054ede" ;
    tmk:ordinal 11 ;
    tmk:text "(ii) if the request for extension of protection to Australia was made under Article 3ter (2) of the Protocol—the date of recording of the request; and" ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(g)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(h)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c391ec2ece79eb5aecce0ffe1741e9dfcfbd4aad03f8ed70f42b4832454bebe7" ;
    tmk:ordinal 12 ;
    tmk:text "(h) to the date the particulars of the trade mark were entered into the Register under section 69 is taken to be a reference to the date the trade mark became a protected international trade mark under regulation 17A.36." ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(h)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(2)(h)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0445dae4308a0c840215cea1c8942e30db6e55004a84a2d3662182449de39024" ;
    tmk:ordinal 13 ;
    tmk:text "Note: The expressions date of international registration and date of recording are defined in regulation 17A.2." ;
    tmk:upstreamRef "TMR1995/r17A.48D(2)(h)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48D> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bc07a8f2494daf5a27994badffecb8c2fe244f9a8151ce328697cdd40a66ba03" ;
    tmk:ordinal 14 ;
    tmk:text "(3) Sections 96 to 101 of the Act apply in relation to the cessation of protection for nonuse." ;
    tmk:upstreamRef "TMR1995/r17A.48D(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48E(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48E> ;
