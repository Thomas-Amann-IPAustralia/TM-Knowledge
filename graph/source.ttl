    tmk:ordinal 38 ;
    tmk:text "the trade mark becomes a protected international trade mark, to the extent permitted by the decision on the appeal, when that decision is made." ;
    tmk:upstreamRef "TMR1995/r17A.36~6" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36~7> a tmk:LegislativeUnit ;
