    tmk:ordinal 1 ;
    tmk:text "If:" ;
    tmk:upstreamRef "TMA1995/s204~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204~2> a tmk:LegislativeUnit ;
