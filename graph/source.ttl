    tmk:ordinal 2 ;
    tmk:text "(a) the registration of a trade mark (unrenewed trade mark) has not been renewed under section 77 or 79; and" ;
    tmk:upstreamRef "TMA1995/s80(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s80(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s80> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
