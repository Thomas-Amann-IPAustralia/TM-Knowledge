    tmk:contentHash "sha256:101cddfcb7f5d46d4beb324ed59805fa634fd24b4b3305e016ed10e1e5567ce2" ;
    tmk:ordinal 1 ;
    tmk:text "In addition to any other ground on which:" ;
    tmk:upstreamRef "TMA1995/s187~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187~2> a tmk:LegislativeUnit ;
