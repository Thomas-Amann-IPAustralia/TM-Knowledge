    tmk:ordinal 6 ;
    tmk:text "(a) an instrument that purports to have been issued by the International Bureau is taken to have been issued by the International Bureau unless the contrary is proved; and" ;
    tmk:upstreamRef "TMR1995/r17A.69(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.69(2)(b)> a tmk:LegislativeUnit ;
