    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:99a945920e621ceef72764a46999345a2c97e9812d535ea2e5697dbc11885e2f" ;
    tmk:ordinal 8 ;
    tmk:text "(ii) in an invoice, wine list, catalogue, business letter, business paper, price list or other commercial document;" ;
    tmk:upstreamRef "TMA1995/s9(1)(c)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s9> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5cb2dfe46af0b3e6a288fa8eb8ab1dc954499291413f1b4b789504393f7e8df5" ;
    tmk:ordinal 9 ;
    tmk:text "and goods are delivered, or services provided (as the case may be) to a person following a request or order made by referring to the trade mark as so used." ;
    tmk:upstreamRef "TMA1995/s9(1)~1" .

