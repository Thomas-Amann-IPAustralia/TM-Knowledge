    tmk:ordinal 3 ;
    tmk:text "(b) of a kind mentioned to which section 251 of the Act (which deals with action for removal of trade marks from the Register for nonuse) applies;" ;
    tmk:upstreamRef "TMR1995/r22.2(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.2(2)> a tmk:LegislativeUnit ;
