    tmk:contentHash "sha256:224a176e4c6b56520d4d33b44d00481cdb1247ec3cab142201cf85e6048bc7db" ;
    tmk:ordinal 1 ;
    tmk:text "(1) This regulation applies if the Act or these Regulations provide for a person to be heard by the Registrar." ;
    tmk:upstreamRef "TMR1995/r21.15(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(2)> a tmk:LegislativeUnit ;
