    tmk:ordinal 3 ;
    tmk:text "(a) the procedure for dealing with applications for international registration of trade marks that are to be filed with the International Bureau through the intermediary of the Trade Marks Office;" ;
    tmk:upstreamRef "TMA1995/s189A(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s189A(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s189A> ;
