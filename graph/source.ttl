    tmk:ordinal 2 ;
    tmk:text "(a) a person has made an application for the registration of a trade mark in one or more than one Convention country; and" ;
    tmk:upstreamRef "TMA1995/s29(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(2)> a tmk:LegislativeUnit ;
