    tmk:contentHash "sha256:5d099d5faa66187d597e503c7293b1a6415544b4c2a0ddfbb5b2dc08c80ca9ac" ;
    tmk:text "Note: See regulation 21.21." ;
    tmk:upstreamRef "TMR1995/sch9" .

