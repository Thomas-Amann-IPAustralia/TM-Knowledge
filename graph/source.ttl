    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5e33fafee18e9c65560b35a4979051a2f22496646fc8c2856007f82ea2d95a68" ;
    tmk:ordinal 12 ;
    tmk:text "(d) does not attend an oral hearing if notified under subregulation 21.16(2)." ;
    tmk:upstreamRef "TMR1995/r21.15(5)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(6)> a tmk:LegislativeUnit ;
