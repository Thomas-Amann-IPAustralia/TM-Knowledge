    tmk:ordinal 2 ;
    tmk:text "(1) If the Registrar decides that a person may be heard by way of written submissions, the Registrar must:" ;
    tmk:upstreamRef "TMR1995/r21.16(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(1)(a)> a tmk:LegislativeUnit ;
