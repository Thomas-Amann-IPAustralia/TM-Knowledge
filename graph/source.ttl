    tmk:contentHash "sha256:63d792a2356c3e4e8e2f3ae9a6fe3db981c79a39a8ca49f3d7c4c0451aea76d0" ;
    tmk:text "(1) If in any proceedings relating to an opposed application the Registrar or the court has found that:" ;
    tmk:upstreamRef "TMA1995/s105(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s105(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bfb223e5531f75a199636e3acf2112e2212238a172b90a2010efd3753614a8a8" ;
    tmk:text "(2) In any subsequent proceedings in which nonuse of the trade mark is alleged:" ;
    tmk:upstreamRef "TMA1995/s105(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106> ;
    tmk:authorityKind "law" ;
