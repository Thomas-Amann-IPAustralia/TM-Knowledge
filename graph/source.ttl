    tmk:ordinal 6 ;
    tmk:text "(ii) an authorised user of the trade mark; or" ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)(iii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c0297fcc1a12b8265ab9c61b72b84586cfdecb8e59515ef7a6b9e09c7832cd25" ;
    tmk:ordinal 7 ;
    tmk:text "(iii) a person permitted to use the trade mark by the registered owner; or" ;
    tmk:upstreamRef "TMA1995/s122A(1)(c)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(1)(c)(iv)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
