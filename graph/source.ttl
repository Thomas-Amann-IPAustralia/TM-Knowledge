    tmk:contentHash "sha256:0975b2ef8cf849eff033b7a962d57dfd4783135edfca17effda6e40b62066dbc" ;
    tmk:ordinal 18 ;
    tmk:text "Note 3: For prescribed court see section 190." ;
    tmk:upstreamRef "TMA1995/s87~3~5" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:86fca052f84e0fc33b24de9cfc26eafa50ec04aaea943f55fcdc256a045c68dd" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Subject to subsection (2) and section 89, a prescribed court may, on the application of an aggrieved person or the Registrar, order that the Register be rectified by:" ;
    tmk:upstreamRef "TMA1995/s88(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c2b41a14553950e7a645bd30fad4bb32b72739aa9b123ce563308a6543246737" ;
    tmk:ordinal 2 ;
    tmk:text "(a) cancelling the registration of a trade mark; or" ;
    tmk:upstreamRef "TMA1995/s88(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d1f090b08aec24133598d167ecece4500054447f9fe5af5b89994c37d74c6930" ;
    tmk:ordinal 3 ;
    tmk:text "(b) removing or amending an entry wrongly made or remaining on the Register; or" ;
    tmk:upstreamRef "TMA1995/s88(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:517e8150f71e3c1045da567483262073e7daf2b3f163cfaaedc68545f243b6d8" ;
    tmk:ordinal 4 ;
    tmk:text "(c) entering any condition or limitation affecting the registration of a trade mark that ought to be entered." ;
    tmk:upstreamRef "TMA1995/s88(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88> ;
