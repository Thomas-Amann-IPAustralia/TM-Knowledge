    tmk:ordinal 2 ;
    tmk:text "(2) However, if:" ;
    tmk:upstreamRef "TMR1995/r17A.42(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e05ccc3fc6f1d499225e5527ff6c67892780621f48737bf869c00467229a6f19" ;
    tmk:ordinal 3 ;
    tmk:text "(a) the international registration of a trade mark that is a protected international trade mark (unrenewed protected international trade mark) is not renewed; and" ;
    tmk:upstreamRef "TMR1995/r17A.42(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:273eeeb09ae505d8fc0d3301f9aacda7ce8f9458ee9ea3e1ccc724acb052a956" ;
    tmk:ordinal 4 ;
    tmk:text "(b) an application for the registration of the trade mark, or an IRDA, is made, or has already been made, by a person other than the holder of the unrenewed protected international trade mark;" ;
    tmk:upstreamRef "TMR1995/r17A.42(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7b76f9284dcf1611aa3b0f46533bbcb5c025f4e9570785b280f0fc7ad57328bb" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If all the conditions in subregulation (2) are met, the Registrar may do any of the following:" ;
    tmk:upstreamRef "TMR1995/r17A.42A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9c362c382870bb83faaaa1ddb57f3fd3cce80d6ec4df5bd9c328589f8b5fff27" ;
    tmk:ordinal 2 ;
    tmk:text "(a) declare that the protection extended to a protected international trade mark is ceased;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:662cde927d00ad97cd944745052a6958689d819c6b6d50ebc46323d800765423" ;
    tmk:ordinal 3 ;
    tmk:text "(b) impose a condition or limitation on the protection extended to a protected international trade mark;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a0a9cf2042b1f1bb2ff49604741a84f6c580077261418183817ff1ff6ecc4e8e" ;
    tmk:ordinal 4 ;
    tmk:text "(c) if a protected international trade mark is already subject to a condition or limitation—impose or substitute an additional or different condition or limitation on the protection extended to the protected international trade mark;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(1)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8f087be5642a440491175213c543a0659fdfb9e73e554487dfb9f9dcd93a3725" ;
    tmk:ordinal 5 ;
    tmk:text "(d) remove or amend an entry in the Record of International Registrations relating to a protected international trade mark." ;
    tmk:upstreamRef "TMR1995/r17A.42A(1)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)> a tmk:LegislativeUnit ;
