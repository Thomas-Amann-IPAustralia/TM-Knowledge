    tmk:ordinal 4 ;
    tmk:text "the certification trade mark may be assigned only with the consent of the Commission." ;
    tmk:upstreamRef "TMA1995/s180A~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s182(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s182> ;
