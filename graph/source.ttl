    tmk:ordinal 2 ;
    tmk:text "(a) cancelling the registration of a trade mark; or" ;
    tmk:upstreamRef "TMA1995/s88(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(1)(b)> a tmk:LegislativeUnit ;
