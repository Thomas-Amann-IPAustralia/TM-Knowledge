    tmk:ordinal 11 ;
    tmk:text "(c) the article or substance or goods of the same description; or" ;
    tmk:upstreamRef "TMA1995/s87(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s87(d)> a tmk:LegislativeUnit ;
