    tmk:ordinal 22 ;
    tmk:text "Note 2: For deceptively similar see section 10." ;
    tmk:upstreamRef "TMA1995/s120(3)(d)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(d)~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5df7d887a654b56c378bcdd9c37706cfe6bec17660853178c0ff04f8c158c5df" ;
    tmk:ordinal 23 ;
    tmk:text "Note 3: For well known in Australia see subsection (4)." ;
    tmk:upstreamRef "TMA1995/s120(3)(d)~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120(3)(d)~4> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s120> ;
