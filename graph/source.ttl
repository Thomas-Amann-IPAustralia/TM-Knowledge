<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.3(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.3> ;
