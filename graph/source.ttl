    tmk:ordinal 3 ;
    tmk:text "(b) file the document; or" ;
    tmk:upstreamRef "TMR1995/r21.33(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.33(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.33> ;
