    tmk:contentHash "sha256:7b0c4309c0308faee14fa49e520a39b722cc576af62201b1c44fc7f3b989c602" ;
    tmk:ordinal 4 ;
    tmk:text "(b) the High Court under section 75 of the Constitution." ;
    tmk:upstreamRef "TMA1995/s191(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2760a27486a6b7302770e98607f788624b7ddc21e6e06834db00bcfd5c9e78ea" ;
    tmk:ordinal 5 ;
    tmk:text "(3) A prosecution for an offence against this Act may not be started in the Federal Court." ;
    tmk:upstreamRef "TMA1995/s191(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4d21aa4d732ae7b47c1e5106e28f1c72f837e4f687ec728511c791bf8d8a0c9a" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The Federal Circuit and Family Court of Australia (Division 2) has jurisdiction with respect to matters arising under this Act." ;
    tmk:upstreamRef "TMA1995/s191A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a843c3941384c100f1f3715250840c058c1ce6ef6819efeadc5b3bb7f7e2d49d" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The jurisdiction of the Federal Circuit and Family Court of Australia (Division 2) to hear and determine appeals against decisions, directions or orders of the Registrar is exclusive of the jurisdiction of any other court except the jurisdiction of:" ;
    tmk:upstreamRef "TMA1995/s191A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:754c916f8dfbfd320b5b0fb3eb4e4bb9cde7dcb477f7477f5185372648401cab" ;
    tmk:ordinal 3 ;
    tmk:text "(a) the Federal Court under subsection 191(2) of this Act; and" ;
    tmk:upstreamRef "TMA1995/s191A(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7b0c4309c0308faee14fa49e520a39b722cc576af62201b1c44fc7f3b989c602" ;
    tmk:ordinal 4 ;
    tmk:text "(b) the High Court under section 75 of the Constitution." ;
    tmk:upstreamRef "TMA1995/s191A(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s191A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:528f1d9c2cb9d7783ec3e67cec577198646c976d442eff5e47e49e421d83f61f" ;
    tmk:ordinal 5 ;
    tmk:text "(3) A prosecution for an offence against this Act may not be started in the Federal Circuit and Family Court of Australia (Division 2)." ;
    tmk:upstreamRef "TMA1995/s191A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s196~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s196> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:61512a82195504313c5fba837efb02f71c0d65665f4087933a8db3870e2cdeb0" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar may appear and be heard at the hearing of an appeal to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) against a decision or direction of the Registrar." ;
    tmk:upstreamRef "TMA1995/s196~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s2(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:18c934ad46c68e637d139dedbf6f1fbaab7b98af86fecf3359613f3aad5f3ff2" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Part 1 commences on the day on which this Act receives the Royal Assent." ;
    tmk:upstreamRef "TMA1995/s2(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s2(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s2> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bdf136558161aa5d3a775df44386601c03c3a3cc8b38ab2db20bca85138c6ea8" ;
    tmk:ordinal 2 ;
    tmk:text "(2) This Act, other than Part 1, commences on 1 January 1996." ;
    tmk:upstreamRef "TMA1995/s2(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3418420d73bfd8173a75068689fd325dc8492136b35fdc9ef45cb71eb7d68c46" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If a trade mark is registered, the registered owner of the trade mark has, subject to this Part, the exclusive rights:" ;
    tmk:upstreamRef "TMA1995/s20(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7af01d9dc59c7ee7d92dce9bd0c3b40c896c8200d3c62651e41db03b9c06207d" ;
    tmk:ordinal 2 ;
    tmk:text "(a) to use the trade mark; and" ;
    tmk:upstreamRef "TMA1995/s20(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:86b242993b33772fda58388090d4d3e8e16dbf8c8ef18ed3aec4ba36ea5365e1" ;
    tmk:ordinal 3 ;
    tmk:text "(b) to authorise other persons to use the trade mark;" ;
    tmk:upstreamRef "TMA1995/s20(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f134f1d6da807fe6e57538b51de55c7514dfb7aaf572973a756a9f251417a343" ;
    tmk:ordinal 8 ;
    tmk:text "(2) The registered owner of a trade mark has also the right to obtain relief under this Act if the trade mark has been infringed." ;
    tmk:upstreamRef "TMA1995/s20(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0e549b1dd65480b63276a5a6be6a5162a74fc7ebfe681443dfd19449cf6648f4" ;
    tmk:ordinal 9 ;
    tmk:text "Note: For what amounts to an infringement of a trade mark see Part 12." ;
    tmk:upstreamRef "TMA1995/s20(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dd5561052b1ed875eef830d2db5d70f5d81a07a7c5574d36724bd081db9a1b5e" ;
    tmk:ordinal 10 ;
    tmk:text "(3) The rights are taken to have accrued to the registered owner as from the date of registration of the trade mark." ;
    tmk:upstreamRef "TMA1995/s20(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ad60ec01950c8f6f76206dbc1d903432eb029044acb7950215b57f8a1dfab1d9" ;
    tmk:ordinal 11 ;
    tmk:text "Note: For date of registration see section 6." ;
    tmk:upstreamRef "TMA1995/s20(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:09b0f1472d7ba494956af12e7d55b9a733286f7a7f966908f3a6c53ccd839b6a" ;
    tmk:ordinal 12 ;
    tmk:text "(4) If the trade mark is registered subject to conditions or limitations, the rights of the registered owner are restricted by those conditions or limitations." ;
    tmk:upstreamRef "TMA1995/s20(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(4)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:905dc28d81c8786fa4d8be28afacf1be3383911fb4aff53a05578c6bd46fcc93" ;
    tmk:ordinal 13 ;
    tmk:text "Note: For limitations see section 6." ;
    tmk:upstreamRef "TMA1995/s20(4)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d2de326e8809f552b973219391baf5f97c5de32560528a6bb6fc82a8ef1afcab" ;
    tmk:ordinal 14 ;
    tmk:text "(5) If the trade mark is registered in the name of 2 or more persons as joint owners of the trade mark, the rights granted to those persons under this section are to be exercised by them as if they were the rights of a single person." ;
    tmk:upstreamRef "TMA1995/s20(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d76b69e5b8d3ed565a0f1bf6bc435f95fa6cbb9525d0c71adf75f388ab1ec5b2" ;
    tmk:ordinal 2 ;
    tmk:text "(a) summon witnesses; and" ;
    tmk:upstreamRef "TMA1995/s202(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:869f36c0d039acf33a0b7b4e823090568c8d4e46d6b8e1dc6ad28604af10ccf9" ;
    tmk:ordinal 4 ;
    tmk:text "(c) require the production of documents or articles; and" ;
    tmk:upstreamRef "TMA1995/s202(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:af3a0f052af40edbe5c240a3c0633962964f7521ee6c0319a2378082ece62585" ;
    tmk:ordinal 6 ;
    tmk:text "(e) notify any person of any matter that, in his or her opinion, should be brought to the person’s notice." ;
    tmk:upstreamRef "TMA1995/s202(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202(e)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b0b62f3ee5deee91e88e7142a71016a5251d309f2802000f22e15d7702a44445" ;
    tmk:ordinal 7 ;
    tmk:text "Note: For the awarding of costs see section 221." ;
    tmk:upstreamRef "TMA1995/s202(e)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:742bff4b87458e1451467f8ea462e332972e7c866bbde6de672a9f2645d3bf47" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar may, for the purposes of this Act:" ;
    tmk:upstreamRef "TMA1995/s202~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s203~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s203> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:72f10fa763072143a7ded2d5068fced30b967c3d486f8f76606db7f31257e88a" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar may not exercise a power under this Act in any way that adversely affects a person applying for the exercise of that power without first giving that person a reasonable opportunity of being heard." ;
    tmk:upstreamRef "TMA1995/s203~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a88f3e03d8225a48e7ef34161611d41874d7cdab18ece55fa9d7f0cf0147d608" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the Registrar is required under this Act to do any act or thing; and" ;
    tmk:upstreamRef "TMA1995/s204(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:cabcfe529fb19b5ac5ccade02428591addfa1b603682e7fff064b80efb336d6f" ;
    tmk:ordinal 3 ;
    tmk:text "(b) no time or period is provided within which the act or thing is to be done;" ;
    tmk:upstreamRef "TMA1995/s204(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a5461a4dfe82c04bf0a61bec47c4f91312ce74619864b4191ed1fad2b0655256" ;
    tmk:ordinal 1 ;
    tmk:text "If:" ;
    tmk:upstreamRef "TMA1995/s204~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d3377ba0780b75200f82eb77ea71b3d0c735927b510ec24c97fa362ae7e2596c" ;
    tmk:ordinal 4 ;
    tmk:text "the Registrar is to do the act or thing as soon as practicable." ;
    tmk:upstreamRef "TMA1995/s204~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ae87b2646f4a03dad25c5a83bd3fbeb42a67b0b991897a3053c3325e0e5b32b4" ;
    tmk:ordinal 1 ;
    tmk:text "(1) There is to be at least one Deputy Registrar of Trade Marks." ;
    tmk:upstreamRef "TMA1995/s205(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c2770b848f030be5cb8d734653ccc72f3bac4b4fe9a4e9cf690b547faf1d19d7" ;
    tmk:ordinal 2 ;
    tmk:text "(2) Subject to any direction by the Registrar, a Deputy Registrar has all the powers and functions of the Registrar, except the powers of delegation under section 206." ;
    tmk:upstreamRef "TMA1995/s205(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0aae7684d154eb32b109eecec0dfff1755547a1fd468e6c239a417a516965584" ;
    tmk:ordinal 3 ;
    tmk:text "(3) A power or function of the Registrar, when exercised by a Deputy Registrar, is taken to have been exercised by the Registrar." ;
    tmk:upstreamRef "TMA1995/s205(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:919ee0e49d8b5214b30842287f494511b8e50804dc20767b0daf28225019eb98" ;
    tmk:ordinal 4 ;
    tmk:text "(4) The exercise of a power or function of the Registrar by a Deputy Registrar does not prevent the exercise of the power or function by the Registrar." ;
    tmk:upstreamRef "TMA1995/s205(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:430a84d493348da3effc8b49fc3eff7ba883ca2556856b2a48a979bb8fea64d9" ;
    tmk:ordinal 5 ;
    tmk:text "(5) If the exercise of a power or function by the Registrar is dependent on the opinion, belief or state of mind of the Registrar in relation to a matter, that power or function may be exercised by a Deputy Registrar on his or her opinion, belief or state of mind in relation to that matter." ;
    tmk:upstreamRef "TMA1995/s205(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9fff6c7a7fe63e9dee1b4d2d41325bd38fb0e7288a7721cf5930f3aa0517ec98" ;
    tmk:ordinal 6 ;
    tmk:text "(6) If the operation of a provision of this Act or another Act is dependent on the opinion, belief or state of mind of the Registrar in relation to a matter, that provision may operate on the opinion, belief or state of mind of a Deputy Registrar in relation to that matter." ;
    tmk:upstreamRef "TMA1995/s205(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
