    tmk:ordinal 16 ;
    tmk:text "(ii) an appeal had been made against the decision but had not yet been decided; and" ;
    tmk:upstreamRef "TMA1995/s11(2)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(2)(c)> a tmk:LegislativeUnit ;
