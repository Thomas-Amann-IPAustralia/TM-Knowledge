    tmk:contentHash "sha256:6a6ff1fa8f6cbf3825db53de0739a11638ec855ed061b68a1201b5248298a0a7" ;
    tmk:ordinal 24 ;
    tmk:text "(a) if paragraph (b) does not apply—the day on which the application was lodged with the Trade Marks Office under the repealed Act; or" ;
    tmk:upstreamRef "TMA1995/s241(5)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s241(5)(b)> a tmk:LegislativeUnit ;
