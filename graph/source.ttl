    tmk:ordinal 15 ;
    tmk:text "in relation to those goods and/or services at any time before the period of one month ending on the day on which the nonuse application is filed;" ;
    tmk:upstreamRef "TMA1995/s92(4)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(4)~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92> ;
