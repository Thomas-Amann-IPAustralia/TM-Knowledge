    tmk:ordinal 28 ;
    tmk:text "(b) ending on the priority date for the registration of the applicant’s trade mark;" ;
    tmk:upstreamRef "TMA1995/s44(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1f35d12d8466cad220a241a4dd6b5771ac5f1a3cd0bf8a63a518e94bd4afb3c1" ;
    tmk:ordinal 22 ;
    tmk:text "the Registrar may accept the application for the registration of the applicant’s trade mark subject to any conditions or limitations that the Registrar thinks fit to impose. If the applicant’s trade mark has been used only in a particular area, the limitations may include that the use of the trade mark is to be restricted to that particular area." ;
    tmk:upstreamRef "TMA1995/s44~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
