    tmk:contentHash "sha256:454bee96605ff93ce81aeeb05fb5d2c9d14c64955c46cb958d8e7cb91938f671" ;
    tmk:ordinal 5 ;
    tmk:text "(2) A person infringes a registered trade mark if the person uses as a trade mark a sign that is substantially identical with, or deceptively similar to, the trade mark in relation to:" ;
    tmk:upstreamRef "TMA1995/s120(2)" .

