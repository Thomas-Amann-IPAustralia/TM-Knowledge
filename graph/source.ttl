    tmk:ordinal 6 ;
    tmk:text "(d) request that the application be amended in accordance with the Act." ;
    tmk:upstreamRef "TMR1995/r4.9(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9(2)(d)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9> ;
