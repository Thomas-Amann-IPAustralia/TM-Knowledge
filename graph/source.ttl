<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100(3)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s100> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d96375e670645a123d6b22f4e35356fbed2cf44e819d3519064e611f57b43bc4" ;
    tmk:ordinal 23 ;
    tmk:text "(c) the opponent has established that the trade mark was not used by its registered owner in relation to those goods and/or services during that period because of circumstances (whether affecting traders generally or only the registered owner of the trade mark) that were an obstacle to the use of the trade mark during that period." ;
    tmk:upstreamRef "TMA1995/s100(3)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106(2)> a tmk:LegislativeUnit ;
