    tmk:contentHash "sha256:5243187e2a244a6383843cc1f16cefdb0f1adb8ff09fa06202dd350fd67e7609" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of section 30 of the Act (which deals with publishing particulars of applications), the Registrar must publish the following particulars of the application:" ;
    tmk:upstreamRef "TMR1995/r4.7(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(1)(a)> a tmk:LegislativeUnit ;
