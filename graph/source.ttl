    tmk:ordinal 2 ;
    tmk:text "(2) The Registrar must give a copy of the notice to the opponent." ;
    tmk:upstreamRef "TMR1995/r5.13(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13A(3)(a)> a tmk:LegislativeUnit ;
