    tmk:ordinal 4 ;
    tmk:text "(3) A trade mark may be registered as a defensive trade mark in respect of particular goods or services even if it is already registered otherwise than as a defensive trade mark in the name of the applicant in respect of those goods or services." ;
    tmk:upstreamRef "TMA1995/s185(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s185(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s185> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:407ef4c6fcc11aff8d4341753bb41af0f821741e645afc477c4ecafdab36fb3c" ;
    tmk:ordinal 5 ;
    tmk:text "(4) A trade mark that is registered as a defensive trade mark in respect of particular goods or services may be subsequently registered otherwise than as a defensive trade mark in the name of the registered owner in respect of the same goods or services." ;
    tmk:upstreamRef "TMA1995/s185(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s186~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s186> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2763c17d0e607eaf7779c6ec2c456d83f3f6b7f99df142a82534db1f8b410d22" ;
    tmk:ordinal 1 ;
    tmk:text "Subject to this Part, the provisions of this Act (other than subsection 20(1), paragraph 27(1)(b), sections 41 and 59, sections 121 and 127, Part 9—Removal of trade mark from Register for nonuse and Part 16—Certification Trade Marks) apply to defensive trade marks and so apply as if a reference to a trade mark included a reference to a defensive trade mark." ;
    tmk:upstreamRef "TMA1995/s186~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4447354a5f18a9519eda6b89f6d92c3d894c66694a52f942294aaa3505cd5d46" ;
    tmk:ordinal 2 ;
    tmk:text "(a) an application for the registration of a trade mark as a defensive trade mark may be rejected; or" ;
    tmk:upstreamRef "TMA1995/s187(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:754cf348fa0e524be91ee0b04e04e9e9606f6fd3df21a487ca6066e509c304c5" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the registration of a trade mark as a defensive trade mark may be opposed;" ;
    tmk:upstreamRef "TMA1995/s187(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187(d)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a03f96dbe38584fb9fe5d3f88c6d416e897b4a70356b1d46ab8067fa61e22563" ;
    tmk:ordinal 7 ;
    tmk:text "Note: Division 2 of Part 4 sets out the main grounds for rejecting an application but section 41 does not apply to defensive trade marks (see section 186). Division 2 of Part 5 sets out the main grounds for opposing registration." ;
    tmk:upstreamRef "TMA1995/s187(d)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s187~1> a tmk:LegislativeUnit ;
