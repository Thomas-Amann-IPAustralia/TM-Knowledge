    tmk:upstreamRef "TMM/Part60/2/4/2/4/1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/11/4/11/2> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.21>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.22> ;
    tmk:contentHash "sha256:fe617df9bf6a883edb65d3f8153e68c315851e26ed822e02a18439e0c107434b" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/11/4/11/2/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/11/4/11/2/prov/1> ;
    tmk:headingPath "4.11.2 General Description",
        "60.4.11 Deferment of Acceptance",
        "Part 60 The Madrid Protocol" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/11> ;
    tmk:ordinal 2 ;
    tmk:partId "Part60" ;
    tmk:text "The acceptance of an IRDA may be deferred. Regulation 17A.21 sets out the grounds on which a deferment request can be made, and on which the Registrar may defer acceptance on their own initiative. Regulation 17A.22 outlines the timeframe for deferment for each of the grounds. The holder of an IRDA, like a national applicant, can still attempt to overcome any grounds for rejection whilst the IRDA is deferred." ;
    tmk:upstreamRef "TMM/Part60/4/11/4/11/2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/11/4/11/3> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48> ;
    tmk:contentHash "sha256:3e7f3f4f50e5d72229c574981f53ffb9ce6e0df37bc41845e8e039263984dcba" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/11/4/11/3/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/11/4/11/3/prov/1> ;
    tmk:headingPath "4.11.3 Request for deferment by applicant",
        "60.4.11 Deferment of Acceptance",
        "Part 60 The Madrid Protocol" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/11> ;
    tmk:ordinal 3 ;
    tmk:partId "Part60" ;
    tmk:text "Deferment is possible on request by the applicant if: a conflicting trade mark is pending, or the holder has taken non-use action under section 92 or Part 17A, Subdivision D of the Regulations against a conflicting trade mark; or a conflicting trade mark is not renewed but is still within the 6 month grace period; or the holder has begun proceedings to have the Register or the Record of international registrations rectified in respect of the conflicting trade mark; or the holder is seeking to establish honest concurrent use, prior use or other circumstances." ;
    tmk:upstreamRef "TMM/Part60/4/11/4/11/3" .

