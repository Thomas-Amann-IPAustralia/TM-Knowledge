    tmk:ordinal 20 ;
    tmk:text "the trade mark that is the subject of the IRDA becomes a protected international trade mark after the opposition has been dismissed or withdrawn." ;
    tmk:upstreamRef "TMR1995/r17A.36~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36~4> a tmk:LegislativeUnit ;
