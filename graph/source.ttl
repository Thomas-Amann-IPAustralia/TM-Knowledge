    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of subsection 37(1) of the Act (which deals with lapsing), the prescribed period, for an application in respect of which a report is made under regulation 4.8, is:" ;
    tmk:upstreamRef "TMR1995/r4.12(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.12(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.12> ;
    tmk:authorityKind "law" ;
