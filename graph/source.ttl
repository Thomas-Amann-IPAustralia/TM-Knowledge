    tmk:upstreamRef "TMR1995/r17A.8(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.8(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.8> ;
