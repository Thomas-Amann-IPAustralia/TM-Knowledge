    tmk:contentHash "sha256:f904ac3de044959b37a9aa708db51719a2f3f9f7840fb984b8b364a2abe8beb8" ;
    tmk:ordinal 13 ;
    tmk:text "Note 3: In addition, the regulations may provide for the effect of a protected international trade mark: see Part 17A." ;
    tmk:upstreamRef "TMA1995/s120~1~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3a4f0d90d1536eeb664633320c6a49360d3b6593e3550c50d455e8c0c74bfab7" ;
    tmk:ordinal 1 ;
    tmk:text "(1) This section applies to a registered trade mark if the registered owner, or an authorised user of the trade mark having power to do so, has caused to be displayed on goods (registered goods) in respect of which the trade mark is registered, or on their package, or on the container in which they are offered to the public, a notice (notice of prohibition) prohibiting any act that is under subsection (2) a prohibited act in relation to the goods." ;
    tmk:upstreamRef "TMA1995/s121(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:341e5bbc6bddf4f19d18a93a0356ad687d9db46b4e2b13231398743853f1a10b" ;
    tmk:ordinal 2 ;
    tmk:text "Note 1: An authorised user of the trade mark may not have power to cause notices of prohibition to be displayed on goods etc. because of the terms of the agreement between the authorised user and the registered owner of the trade mark (see section 26)." ;
    tmk:upstreamRef "TMA1995/s121(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(1)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e8562ecaf07f00cbe61f3fa902e1dd6f83b39232ded13c97914c1b2d9a27480d" ;
    tmk:ordinal 3 ;
    tmk:text "Note 2: For registered owner and registered trade mark see section 6." ;
    tmk:upstreamRef "TMA1995/s121(1)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(1)~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dc90ffe53c0cff16430b22b895b90d2f32e3a64a63b3e79f097bbf7a4c6e027e" ;
    tmk:ordinal 4 ;
    tmk:text "Note 3: For authorised user see section 8." ;
    tmk:upstreamRef "TMA1995/s121(1)~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(1)~4> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3a629f411448cae9c0326cd1480fa8bd063907c1401e21d8c7e3f11cf10e6569" ;
    tmk:ordinal 5 ;
    tmk:text "Note 4: In addition, the regulations may provide for the effect of a protected international trade mark: see Part 17A." ;
    tmk:upstreamRef "TMA1995/s121(1)~4" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:14c5fe0599a5e0c576ea07eeffb6cbdf455b91586b54eb4ee4c20ee627ec099f" ;
    tmk:ordinal 7 ;
    tmk:text "(a) applying the trade mark to registered goods, or using the trade mark in physical relation to them, after the state, condition, getup or packaging in which they were originally offered to the public has been altered;" ;
    tmk:upstreamRef "TMA1995/s121(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a6cc912e998a84b7c667ff70625dfdb35e7ebefddd14800cf88fa4132fc4c023" ;
    tmk:ordinal 8 ;
    tmk:text "(b) altering, or partially removing or obliterating, any representation of the trade mark applied to registered goods or used in physical relation to them;" ;
    tmk:upstreamRef "TMA1995/s121(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:92d133239e28252d2413eb9702906000f56546e98ec6f895b7314d2b7559cce7" ;
    tmk:ordinal 9 ;
    tmk:text "(c) if the trade mark has been applied to registered goods, or used in physical relation to them, together with other matter indicating that the registered owner or authorised user has dealt with the goods—removing or obliterating, totally or in part, any representation of the trade mark without totally removing or obliterating the other matter;" ;
    tmk:upstreamRef "TMA1995/s121(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(2)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c802792c8e9224f9747397bc9b185d1e2df1f645bd290f2836812bff1ca35c4d" ;
    tmk:ordinal 10 ;
    tmk:text "(d) applying another trade mark to registered goods or using another trade mark in physical relation to them;" ;
    tmk:upstreamRef "TMA1995/s121(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(2)(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:145f9d96bd07be692691ac72ed758b9eed300921f0e28927031f4a627402baba" ;
    tmk:ordinal 11 ;
    tmk:text "(e) if the trade mark has been applied to registered goods or used in physical relation to them—using on the goods, or on the packaging or container of the goods, any matter that is likely to injure the reputation of the trade mark." ;
    tmk:upstreamRef "TMA1995/s121(2)(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(2)(e)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
