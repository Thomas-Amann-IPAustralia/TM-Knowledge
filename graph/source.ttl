    tmk:contentHash "sha256:8f03334e5f28297cbddb786f0c78faa1212bf0a8fa89ca8badef40c444f030f0" ;
    tmk:ordinal 18 ;
    tmk:text "(b) whether it arose by way of proprietary interest, contract, arrangement, understanding, a combination of those things, or otherwise." ;
    tmk:upstreamRef "TMA1995/s122A(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s122A> ;
