    tmk:ordinal 9 ;
    tmk:text "(a) a decision of a court made before that day; or" ;
    tmk:upstreamRef "TMA1995/s228(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228(2)(b)> a tmk:LegislativeUnit ;
