    tmk:ordinal 14 ;
    tmk:text "(a) the registered owner of a registered trade mark; or" ;
    tmk:upstreamRef "TMA1995/s215(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f494ac598cd04b6904d12d4a449f983a0e8aa07349990c7b71b2d97f70aa7ab9" ;
    tmk:ordinal 15 ;
    tmk:text "(b) a person whose claim to an interest in, or to a right in respect of, a trade mark is recorded in the Register;" ;
    tmk:upstreamRef "TMA1995/s215(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7a60a4bdc0cc87e3621c45f0a8c3a3d41738ac8e981f809ad486378503bc003a" ;
    tmk:ordinal 17 ;
    tmk:text "(5) An address for service must be an address in Australia or New Zealand." ;
    tmk:upstreamRef "TMA1995/s215(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f1afd920412216ed977b6f83a55700f9f07f064a4bcddf351a213dd5a463b28c" ;
    tmk:ordinal 18 ;
    tmk:text "(6) If this Act provides that a document is to be served on, or given or sent to, a person:" ;
    tmk:upstreamRef "TMA1995/s215(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(6)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:242b236aefcfff6335b90a5c8eb63c393cdd4ccab972d64d21a735b81d3e18b3" ;
    tmk:ordinal 19 ;
    tmk:text "(a) if the person has an address for service—the document may be served on, or given or sent to, the person by a prescribed means to that address; or" ;
    tmk:upstreamRef "TMA1995/s215(6)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(6)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c7368bfd11ed1cf622ec23c943efe821e31b35c0310e1f7f71d7784169868476" ;
    tmk:ordinal 20 ;
    tmk:text "(b) if the person does not have an address for service—the document may be served on an agent of the person in Australia or New Zealand or may be sent by a prescribed means to any address of the person in Australia or New Zealand that is known to the Registrar." ;
    tmk:upstreamRef "TMA1995/s215(6)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:548525a13c24107cae65a60d1a8510f7d49675cb15afb45bad3a086dbc5f888f" ;
    tmk:ordinal 21 ;
    tmk:text "(7) Subsection (6) does not affect the operation of section 28A of the Acts Interpretation Act 1901." ;
    tmk:upstreamRef "TMA1995/s215(7)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e19feabda91abe0202a635a072bf441ed0e447a72f3173a00dc11f91a519de6d" ;
    tmk:ordinal 22 ;
    tmk:text "Note: Subsection 28A(1) of the Acts Interpretation Act 1901 provides that a document may be served (this term includes given, or sent, to):" ;
    tmk:upstreamRef "TMA1995/s215(7)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:623554eeb229c44d566d212116991470e7dd1ebf3d1a1d1e24f5c36b7abcd96e" ;
    tmk:ordinal 23 ;
    tmk:text "“(a) on a natural person:" ;
    tmk:upstreamRef "TMA1995/s215(7)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)~3> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e1a82adb3ca843ed4c7c7c728dfe05f5f8c43071f15bf7b5c909f57a102fd964" ;
    tmk:ordinal 24 ;
    tmk:text "(i) by delivering it to the person personally; or" ;
    tmk:upstreamRef "TMA1995/s215(7)~3" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)~4> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7cb3b745e2fdd3e3998ca2567756930b447f4d30c3ab7f3ee784949cf431bd43" ;
    tmk:ordinal 25 ;
    tmk:text "(ii) by leaving it at, or by sending it by prepaid post to, the address of the place of residence or business of the person last known to the person serving the document; or" ;
    tmk:upstreamRef "TMA1995/s215(7)~4" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(7)~5> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:96153a76d93e663a96de906c51c383e93b64bb854f682ab76347ab4a6e573c6e" ;
    tmk:ordinal 26 ;
    tmk:text "(b) on a body corporate—by leaving it at, or sending it by prepaid post to, the head office, a registered office or a principal office of the body corporate.”." ;
    tmk:upstreamRef "TMA1995/s215(7)~5" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215(8)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s215> ;
    tmk:authorityKind "law" ;
