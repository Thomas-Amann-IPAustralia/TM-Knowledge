    tmk:ordinal 13 ;
    tmk:text "(c) the reference in regulation 13.1 to the particulars of registration of the registered trade mark is taken to be a reference to the particulars of the protected international trade mark recorded in the Record of International Registrations." ;
    tmk:upstreamRef "TMR1995/r17A.39(3)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4> ;
