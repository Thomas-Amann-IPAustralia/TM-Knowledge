    tmk:upstreamRef "TMR1995/r21.20~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.21A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.21A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d6d2aaea028c98ff4669fe9c3fc8914126d6f588141c0bd2cab144b475e398b6" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If a fee is payable in respect of the doing of an act by the Registrar or the ComptrollerGeneral of Customs, the Registrar or ComptrollerGeneral of Customs must not do the act until the fee has been paid." ;
    tmk:upstreamRef "TMR1995/r21.21A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.21A(2)> a tmk:LegislativeUnit ;
