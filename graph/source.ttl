    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:6c37bcdca98603cab2986134a998a5e6858aa77deee58a0ee2ee00ec4e71e25e" ;
    tmk:ordinal 6 ;
    tmk:text "(2) For subregulation (1) the conditions are as follows:" ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5d97bd59ac7a739af1e591bc526ce26c45dc3ee3934ded4011bdc80ad7749717" ;
    tmk:ordinal 7 ;
    tmk:text "(a) within 12 months after the trade mark became a protected international trade mark the Registrar gave notice in writing of the Registrar’s intention to exercise a power or powers mentioned in subregulation (1), to:" ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)(a)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:10788dc98becc0dc3e4a46100f6e9da8c1874e51de2d4609e8f44b8b42233e7d" ;
    tmk:ordinal 8 ;
    tmk:text "(i) the holder of the protected international trade mark; and" ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)(a)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)(a)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5ecebdcbed4e4424335a2688239ed7df2caf4aaef713bb2aba0dde81bb65fda3" ;
    tmk:ordinal 9 ;
    tmk:text "(ii) any person recorded under regulation 17A.62 as claiming an interest or right in respect of the protected international trade mark;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1a0730517134c990cea3edb591bb7df6b3d7cefed10f59a732cd16e8c02ad61c" ;
    tmk:ordinal 10 ;
    tmk:text "(b) the Registrar gave the opportunity to be heard to each person mentioned in subparagraph (a)(i) or (ii), in relation to the Registrar’s intention to exercise a power mentioned in subregulation (1);" ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:aeb721372444cb488f0cd07d21edcb56b3431e126cac201b09b887bfa1e15737" ;
    tmk:ordinal 11 ;
    tmk:text "(c) the Registrar is satisfied, having regard to all the circumstances that existed when the trade mark became a protected international trade mark (whether or not the Registrar knew then of their existence), and the grounds on which the extension of protection could have been opposed under regulation 17A.34, that:" ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)(c)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f3101286a3d581814dad8b564bebfcfad82676227103eabc604c56dbfe0c1366" ;
    tmk:ordinal 12 ;
    tmk:text "(i) the trade mark should not have become protected for some or all of the goods or services in respect of which it is protected; or" ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)(c)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)(c)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d0724246537f008ce4a0b96c14fa741afdc1de590b04a7a8af8f2a95938d0733" ;
    tmk:ordinal 13 ;
    tmk:text "(ii) the protection of the trade mark should have been subject to a condition or limitation, or an additional or different condition or limitation;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)(c)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(2)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a2e52778bf872b10e47745d2f787d3a46681dd1738a9ad4746671be5411849f8" ;
    tmk:ordinal 14 ;
    tmk:text "(d) the Registrar is satisfied that is it reasonable to exercise the power or powers mentioned in subregulation (1)." ;
    tmk:upstreamRef "TMR1995/r17A.42A(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:548619b240dc80c08399a8aecfe78c7b9ecc3d7d06130774f1b09e8df09c0a01" ;
    tmk:ordinal 15 ;
    tmk:text "(3) For paragraph (2)(c), the circumstances to which the Registrar must have regard include the following:" ;
    tmk:upstreamRef "TMR1995/r17A.42A(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3b88be8ce8c93d6c44901ae45949edd2653f279eb88a2aabea12842ae0ef24bf" ;
    tmk:ordinal 16 ;
    tmk:text "(a) any error or omission (including an error or omission of judgment) that led directly or indirectly to the trade mark becoming protected for some or all of the goods or services in respect of which it is protected;" ;
    tmk:upstreamRef "TMR1995/r17A.42A(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.42A> ;
