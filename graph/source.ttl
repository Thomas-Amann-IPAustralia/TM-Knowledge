    tmk:ordinal 1 ;
    tmk:text "(1) If:" ;
    tmk:upstreamRef "TMA1995/s243(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:95bc287e7cfa6be8dbb101c48ecb4e5b55e6eb73467fd20cb21e8b08cf39b883" ;
    tmk:ordinal 2 ;
    tmk:text "(a) before 1 January 1996 a person made a number of applications each seeking the registration of one and the same trade mark but in respect of goods or services of different classes; and" ;
    tmk:upstreamRef "TMA1995/s243(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f83fe50494af719c8137081524d8c5037b7cdf6bc16322f9e16f0d6fdfe6e38f" ;
    tmk:ordinal 3 ;
    tmk:text "(b) all the applications were lodged, or were taken under the repealed Act to have been lodged, on the same day with the Trade Marks Office;" ;
    tmk:upstreamRef "TMA1995/s243(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d126eaab04c885ed1f55d7619fe7e11288ddce55277eba625876b89345f3682a" ;
    tmk:ordinal 5 ;
    tmk:text "(2) This section applies if, immediately before 1 January 1996, a number of linked applications for the registration of a trade mark were pending and had not been accepted." ;
    tmk:upstreamRef "TMA1995/s243(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:32ae5b463db2655403c087cf9f9ce32ba7d7113d90b4be7fd4341e9c4b40dd8f" ;
    tmk:ordinal 6 ;
    tmk:text "Note: For pending see subsection 11(2)." ;
    tmk:upstreamRef "TMA1995/s243(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d49d215a0994372b5e97461c7d5b9f2fc0633c3796ceb033707057450cd0a94a" ;
    tmk:ordinal 7 ;
    tmk:text "(3) If, at any time on or after 1 January 1996, there are linked applications pending, the applicant may, subject to subsection (4), apply to the Registrar to have some or all of those applications dealt with under this Act as if they were one application for the registration of the trade mark in respect of all goods and services specified in those applications." ;
    tmk:upstreamRef "TMA1995/s243(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c8c138f9e1d428f81c684bb637698fb9e11938b798531a197a35a6d9023f76e2" ;
    tmk:ordinal 8 ;
    tmk:text "Note: For pending see subsection 11(1)." ;
    tmk:upstreamRef "TMA1995/s243(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d2f5f49ec1f7330ef64587d901daa8b9a298914abdcef152de24da487e3d3c3f" ;
    tmk:ordinal 9 ;
    tmk:text "(4) If:" ;
    tmk:upstreamRef "TMA1995/s243(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7f636b782f664a19c289a294e8dc4e41293676d3610438015d3cabf1850067f6" ;
    tmk:ordinal 10 ;
    tmk:text "(a) one of the linked applications has been accepted under Part 4; and" ;
    tmk:upstreamRef "TMA1995/s243(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7f1a08f3060b3977706ba0c42bf4bcab5493a8534102324c2b3fa8684b82306d" ;
    tmk:ordinal 11 ;
    tmk:text "(b) the acceptance has been advertised;" ;
    tmk:upstreamRef "TMA1995/s243(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8866f4f87de056d252ab332cc10f35253d1b4d9b8805b70a41b253a3e53077b8" ;
    tmk:ordinal 13 ;
    tmk:text "(5) If an application is made under subsection (3), the Registrar must deal with the linked applications as if they were a single application for the registration of a trade mark made on 1 January 1996." ;
    tmk:upstreamRef "TMA1995/s243(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1ccec6561bf9dce1a84e793adb7bd839e6f33cc063ec3490beee00499332fd79" ;
    tmk:ordinal 14 ;
    tmk:text "(6) The filing date for the single application taken to have been made under subsection (5) is the day on which the linked applications were lodged, or were taken to have been lodged (as the case may be), with the Trade Marks Office under the repealed Act." ;
    tmk:upstreamRef "TMA1995/s243(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:79b552fac3175b4d1fb65543eb2bcbb6289c5532d11f6b74493d311a61c0f1c5" ;
    tmk:ordinal 4 ;
    tmk:text "the applications are called linked applications in this section." ;
    tmk:upstreamRef "TMA1995/s243~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s243> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8aa1fc8ef855cac121e9eb5e2a8014f6dc9e1fdf7b422e0400620a0b9c109f68" ;
    tmk:ordinal 12 ;
    tmk:text "that application may not be included in the application made to the Registrar under subsection (3)." ;
    tmk:upstreamRef "TMA1995/s243~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3dadc950bdd855a136d0645d1d31eec527cd31324f8ec80ea7388e2d34f64a61" ;
    tmk:ordinal 1 ;
    tmk:text "(1) Subject to any agreement between the registered owner of a registered trade mark and an authorised user of the trade mark, the authorised user may do any of the following:" ;
    tmk:upstreamRef "TMA1995/s26(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:67d6e4affbabb41d75807cdcc81e8fd4ccb91e78c75c032ec6a21d2e73fd0103" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the authorised user may use the trade mark in relation to the goods and/or services in respect of which the trade mark is registered, subject to any condition or limitation subject to which the trade mark is registered;" ;
    tmk:upstreamRef "TMA1995/s26(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8fad24879553034a5c34f2983b5ed34166270c51b22305059013b1a036e3e06c" ;
    tmk:ordinal 3 ;
    tmk:text "(b) the authorised user may (subject to subsection (2)) bring an action for infringement of the trade mark:" ;
    tmk:upstreamRef "TMA1995/s26(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:02a62d17e0cbb65732eb5fe14327ffc50e6cf25c0c5c11e97e139745a7ceac19" ;
    tmk:ordinal 4 ;
    tmk:text "(i) at any time, with the consent of the registered owner; or" ;
    tmk:upstreamRef "TMA1995/s26(1)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f88fa835617e00cf01751539c1389bc03ea8fdf65a96f917b4c1ed64b460f675" ;
    tmk:ordinal 5 ;
    tmk:text "(ii) during the prescribed period, if the registered owner refuses to bring such an action on a particular occasion during the prescribed period; or" ;
    tmk:upstreamRef "TMA1995/s26(1)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(b)(iii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9a9a2b478a0e2506c6009cc2436c47c70246d5b4873f3a5ef5fa29bfb9453711" ;
    tmk:ordinal 6 ;
    tmk:text "(iii) after the end of the prescribed period, if the registered owner has failed to bring such an action during the prescribed period;" ;
    tmk:upstreamRef "TMA1995/s26(1)(b)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3b64040119cd70dae11d54546d44c0e6e941b45830841f246ac75dfc194cb288" ;
    tmk:ordinal 7 ;
    tmk:text "(c) the authorised user may cause to be displayed on goods in respect of which the trade mark is registered, or on their package, or on the container in which they are offered to the public, a notice prohibiting any act that is under subsection 121(2) a prohibited act in relation to the goods;" ;
    tmk:upstreamRef "TMA1995/s26(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8c338ba7e9dda32324dd5ad679ae238f3576a9f63edd0b90f553844c2f5385bb" ;
    tmk:ordinal 8 ;
    tmk:text "(d) the authorised user may:" ;
    tmk:upstreamRef "TMA1995/s26(1)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(d)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:73207ebdcb07829d963782ac9c2251d1be06096a4800fdda5f3ae6e67ab39599" ;
    tmk:ordinal 9 ;
    tmk:text "(i) give to the ComptrollerGeneral of Customs a notice under section 132 objecting to the importation of goods that infringe the trade mark; or" ;
    tmk:upstreamRef "TMA1995/s26(1)(d)(i)" .

