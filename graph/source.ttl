    tmk:ordinal 2 ;
    tmk:text "(a) the request is made within a period prescribed in subregulation 4.12(1) or that period as extended under regulation 4.12 or section 224 of the Act; and" ;
    tmk:upstreamRef "TMR1995/r4.13(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.13(1)(b)> a tmk:LegislativeUnit ;
