    tmk:ordinal 8 ;
    tmk:text "(b) a request is made to renew the registration of the trade mark within the period of 12 months following the expiry;" ;
    tmk:upstreamRef "TMR1995/r22.2(5)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r22.2~1> a tmk:LegislativeUnit ;
