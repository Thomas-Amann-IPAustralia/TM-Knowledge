    tmk:ordinal 27 ;
    tmk:text "(a) beginning before the priority date for the other trade mark in respect of:" ;
    tmk:upstreamRef "TMR1995/r4.15A(5)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(5)(a)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:authorityKind "law" ;
