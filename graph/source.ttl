    tmk:ordinal 17 ;
    tmk:text "(i) does an act that is prohibited under the notice of prohibition; or" ;
    tmk:upstreamRef "TMA1995/s121(3)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121(3)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s121> ;
