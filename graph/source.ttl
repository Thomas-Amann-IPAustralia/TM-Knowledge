    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:51b4d919709316123c3194e5b411188a597ce99ae46bdb83fb954d2ec963d07a" ;
    tmk:ordinal 8 ;
    tmk:text "(3) The Registrar may adjourn an oral hearing from time to time or from place to place by notifying the person." ;
    tmk:upstreamRef "TMR1995/r21.16(3)" .

