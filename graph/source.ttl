    tmk:upstreamRef "TMA1995/s4(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s4(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s4> ;
