    tmk:ordinal 6 ;
    tmk:text "(a) the recording of the assignment or transmission; and" ;
    tmk:upstreamRef "TMA1995/s110(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2856cf375c6176d01e4a019e862d2680d7ebaa2f30d2429e739bdcabf0b2a4a4" ;
    tmk:ordinal 7 ;
    tmk:text "(b) the registration of the beneficiary as the owner of the trade mark." ;
    tmk:upstreamRef "TMA1995/s110(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s111~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s111> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d01646e32f685196b7d3497bb5f947d9eb39ee23e14c38450f86fd7a86056019" ;
    tmk:ordinal 1 ;
    tmk:text "If an application made under section 107 or 109 in relation to the assignment or transmission of a trade mark complies with this Act, the Registrar must notify in accordance with the regulations any person recorded under Part 11 as claiming an interest in, or a right in respect of, the trade mark." ;
    tmk:upstreamRef "TMA1995/s111~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s115~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s115> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:60ed2763be6092d4e12cca58bde8741aa4b2b40becadddb8cc1a3deb6ab04bad" ;
    tmk:ordinal 1 ;
    tmk:text "The regulations may provide for the amendment and cancellation of particulars entered in the Register under this Division." ;
    tmk:upstreamRef "TMA1995/s115~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11> ;
    tmk:authorityKind "law" ;
