    tmk:lastAmended "2022-04-20" ;
    tmk:partId "Part32A" ;
    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/2.4-section-43--deception-and-confusion"^^xsd:anyURI ;
