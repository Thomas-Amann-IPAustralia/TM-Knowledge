    tmk:ordinal 3 ;
    tmk:text "(3) The goods and/or services must be grouped according to the appropriate classes described in Schedule 1." ;
    tmk:upstreamRef "TMR1995/r4.4(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(4)> a tmk:LegislativeUnit ;
