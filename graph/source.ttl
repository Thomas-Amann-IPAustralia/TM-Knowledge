    tmk:ordinal 8 ;
    tmk:text "Note: For approved form and file see section 6." ;
    tmk:upstreamRef "TMA1995/s107(2)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s107~1> a tmk:LegislativeUnit ;
