    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5a474d184e21f2d158b2e536411ef3e5002e6bbb411201c272452e3e13fc8b09" ;
    tmk:ordinal 11 ;
    tmk:text "(b) a trade mark that is being used by the person in respect of similar or closely related goods or similar or closely related services." ;
    tmk:upstreamRef "TMA1995/s83A(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83A(4)(b)~1> a tmk:LegislativeUnit ;
