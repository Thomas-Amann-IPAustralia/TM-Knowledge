    tmk:contentHash "sha256:3301a30e1d5c22c6bfab50c6f2a9108f7c3509f3ea5aa3448d951771608dfebb" ;
    tmk:ordinal 12 ;
    tmk:text "(5) In addition to the Registrar’s other powers, the Registrar may direct a person to provide a written summary of submissions." ;
    tmk:upstreamRef "TMR1995/r21.16(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:880356207a32690a206ca255f46e6be1fb7345c0a367871d3224679bc013d04c" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the words ‘Patent’, ‘Patented’, ‘By Royal Letters Patent’, ‘Protected International Trade Mark’, ‘Registered’, ‘Registered Design’, ‘Copyright’ ‘Plant Breeder’s Rights’, ‘EL rights’, or words or symbols to the same effect (including the symbols ‘©’ and ‘®’);" ;
    tmk:upstreamRef "TMR1995/r4.15(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:04ebad61efbe841139acb34439d3ba1719c6b4faf3ad076d721f68e058bfbce4" ;
    tmk:ordinal 4 ;
    tmk:text "(c) a representation of the Arms, or of a flag or seal, of the Commonwealth or of a State or Territory;" ;
    tmk:upstreamRef "TMR1995/r4.15(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15(da)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
