    tmk:ordinal 7 ;
    tmk:text "(3) The holder must notify the Registrar, in writing, of the holder’s address for service in Australia or New Zealand." ;
    tmk:upstreamRef "TMR1995/r17A.17(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.18(1)> a tmk:LegislativeUnit ;
