    tmk:ordinal 5 ;
    tmk:text "(a) the request for extension of protection to Australia was in respect of a trade mark whose registration had also been sought in 1 or more Convention countries; and" ;
    tmk:upstreamRef "TMR1995/r17A.4(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(2)(b)> a tmk:LegislativeUnit ;
