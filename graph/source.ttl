    tmk:ordinal 2 ;
    tmk:text "(1) The Registrar may revoke the registration of a trade mark if he or she is satisfied that:" ;
    tmk:upstreamRef "TMA1995/s84A(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s84A(1)(a)> a tmk:LegislativeUnit ;
