    tmk:ordinal 12 ;
    tmk:text "(i) to alter or deface; or" ;
    tmk:upstreamRef "TMA1995/s26(1)(e)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(e)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:849165781f9cc346d7ed685781fb58a35a15397b8453ce30ee598f38cfc734b1" ;
    tmk:ordinal 13 ;
    tmk:text "(ii) to make any addition to; or" ;
    tmk:upstreamRef "TMA1995/s26(1)(e)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(e)(iii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3e4a24e005ef51e1b3f9e4b54139398975fb967630f9d18853738af33d262b9b" ;
    tmk:ordinal 14 ;
    tmk:text "(iii) to remove, erase or obliterate, wholly or partly;" ;
    tmk:upstreamRef "TMA1995/s26(1)(e)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(f)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bfbf0718b17d3b46feb221e9f961c01facdbbf6d8dd0ff740e787a7f8ff0fe27" ;
    tmk:ordinal 16 ;
    tmk:text "(f) the authorised user may give permission to any person to apply the trade mark to goods, or in relation to goods or services, in respect of which the trade mark is registered." ;
    tmk:upstreamRef "TMA1995/s26(1)(f)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(1)(f)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
