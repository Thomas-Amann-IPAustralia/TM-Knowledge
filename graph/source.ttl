    tmk:contentHash "sha256:8689b433bf3b238a4f05a68b1ee934050083b44b65f4ad7ca28dd5437bf4f386" ;
    tmk:ordinal 13 ;
    tmk:text "(6) An oral hearing must be conducted with as little formality and technicality, and as quickly, as the requirements of the Act, these Regulations and a proper consideration of the matters before the Registrar, allow." ;
    tmk:upstreamRef "TMR1995/r21.16(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(7)> a tmk:LegislativeUnit ;
