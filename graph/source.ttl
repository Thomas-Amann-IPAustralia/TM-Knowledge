    tmk:ordinal 17 ;
    tmk:text "(c) the trade mark had not been registered under section 53." ;
    tmk:upstreamRef "TMA1995/s11(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:abe639c6795f256414837f02a4aa0ac27a4412ffeb2c7220200dea1b54e881db" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If the application complies with this Act, the Registrar must, at, or within, the time provided for in the regulations:" ;
    tmk:upstreamRef "TMA1995/s110(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:042bd07547152679152982393326d4554b720909e4aedf09bdc55db343c3aad5" ;
    tmk:ordinal 2 ;
    tmk:text "(a) enter the particulars of the assignment or transmission in the Register; and" ;
    tmk:upstreamRef "TMA1995/s110(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e58b3fd677b2f3af16bc0e635dfb240efe23976b51930512b891685b7d867eaa" ;
    tmk:ordinal 3 ;
    tmk:text "(b) register the person to whom the trade mark has been assigned or transmitted (beneficiary) as the owner of the trade mark in relation to the goods and/or services in respect of which the assignment or transmission has effect." ;
    tmk:upstreamRef "TMA1995/s110(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7014fa93b298dc0a35428e9225185dad612a558af98da608d191d1bb3a482b36" ;
    tmk:ordinal 4 ;
    tmk:text "(2) The particulars are taken to have been entered in the Register on the day on which the application was filed, and the registration of the beneficiary as the owner of the trade mark is taken to have had effect from and including that day." ;
    tmk:upstreamRef "TMA1995/s110(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s110> ;
