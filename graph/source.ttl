    tmk:chunkKind "body" ;
    tmk:citesCase <https://data.ipaustralia.gov.au/tmk/ref/CASE/1929/CLR/41/475>,
        <https://data.ipaustralia.gov.au/tmk/ref/CASE/1929/HCA/6>,
