    tmk:ordinal 14 ;
    tmk:text "Note 1: The Reader’s Guide gives information about penalties (see the paragraphs under the subheading Crimes Act 1914)." ;
    tmk:upstreamRef "TMA1995/s153(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s153(3)~2> a tmk:LegislativeUnit ;
