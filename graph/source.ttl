    tmk:contentHash "sha256:60cd9a707d3955452a091f6fefbcbae91a9e4db08a06a0f04fa0a479b8d032a6" ;
    tmk:ordinal 3 ;
    tmk:text "(i) goods and/or services to be dealt with or provided in a particular place (specified place) in Australia (otherwise than for export from Australia); or" ;
    tmk:upstreamRef "TMA1995/s102(1)(a)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102(1)(a)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102> ;
