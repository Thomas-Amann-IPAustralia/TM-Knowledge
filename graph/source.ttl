    tmk:ordinal 3 ;
    tmk:text "(a) the document must be in English, be in the form (if any) specified in a direction under section 213B of the Act and be legible; or" ;
    tmk:upstreamRef "TMR1995/r21.2(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.2(2)(b)> a tmk:LegislativeUnit ;
