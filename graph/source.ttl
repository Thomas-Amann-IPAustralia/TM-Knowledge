    tmk:ordinal 1 ;
    tmk:text "(1) This regulation applies to an opposition if:" ;
    tmk:upstreamRef "TMR1995/r5.16(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.16(3)> a tmk:LegislativeUnit ;
