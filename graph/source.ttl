    tmk:ordinal 4 ;
    tmk:text "(i) a translation of the earlier application into English; and" ;
    tmk:upstreamRef "TMR1995/r17A.19(1)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.19(1)(b)(ii)> a tmk:LegislativeUnit ;
