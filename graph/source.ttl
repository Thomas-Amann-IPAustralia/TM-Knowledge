    tmk:ordinal 3 ;
    tmk:text "(a) be in an approved form; and" ;
    tmk:upstreamRef "TMA1995/s75(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75> ;
