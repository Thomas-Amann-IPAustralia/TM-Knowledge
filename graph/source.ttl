    tmk:ordinal 4 ;
    tmk:text "Note: For priority date see section 12." ;
    tmk:upstreamRef "TMA1995/s60(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s60~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s60> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f41363a7d4d4cf58a7022f536b7ff5129445002a0ccf9eca7f105aae6fa0f709" ;
    tmk:ordinal 1 ;
    tmk:text "The registration of a trade mark in respect of particular goods or services may be opposed on the ground that:" ;
    tmk:upstreamRef "TMA1995/s60~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b3f780a1a08049ffb53cfbb89a945139bc3881265c54308848e0b464c09bc535" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The registration of a trade mark in respect of particular goods (relevant goods) may be opposed on the ground that the trade mark contains or consists of a sign that is a geographical indication for goods (designated goods) originating in:" ;
    tmk:upstreamRef "TMA1995/s61(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:02593ba054c76054af612e60a275b73f394e7a381fbacc3c821e3a9f75882804" ;
    tmk:ordinal 2 ;
    tmk:text "(a) a country, or in a region or locality in a country, other than the country in which the relevant goods originated; or" ;
    tmk:upstreamRef "TMA1995/s61(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3579ff1edf7fae3a92e4d985769219639d901887756a1d5a0f2a947096a5cb14" ;
    tmk:ordinal 3 ;
    tmk:text "(b) a region or locality in the country in which the relevant goods originated other than the region or locality in which the relevant goods originated;" ;
    tmk:upstreamRef "TMA1995/s61(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a4ce47e4490aa714242baa6ec96b707cd2b3d224f1e879cc086b6a5e0c7cd1ea" ;
    tmk:ordinal 5 ;
    tmk:text "(2) An opposition on a ground referred to in subsection (1) fails if the applicant establishes that:" ;
    tmk:upstreamRef "TMA1995/s61(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:325ef20067ff24818fcbb1a00d93ccb7861d08dbf6577dcb1f98e8332d4ab004" ;
    tmk:ordinal 6 ;
    tmk:text "(a) the relevant goods originated in the country, region or locality identified by the geographical indication; or" ;
    tmk:upstreamRef "TMA1995/s61(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)(aa)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ca356fbb594f903f1ead6acd6d078a053a9083be17f77c75ca2a31878663a591" ;
    tmk:ordinal 7 ;
    tmk:text "(aa) the sign is not recognised as a geographical indication for the designated goods in the country in which the designated goods originated; or" ;
    tmk:upstreamRef "TMA1995/s61(2)(aa)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:56279471aa1e3f1e94cb220004e6f80b1e11294971a06a09099a914a94005c4c" ;
    tmk:ordinal 8 ;
    tmk:text "(b) the sign has ceased to be used as a geographical indication for the designated goods in the country in which the designated goods originated; or" ;
    tmk:upstreamRef "TMA1995/s61(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8d20e2dd94ca16219ba1bd15a2b20184bb4f9c11f4c04d5beef667a8443a98ab" ;
    tmk:ordinal 9 ;
    tmk:text "(c) the applicant, or a predecessor in title of the applicant, used the sign in good faith in respect of the relevant goods, or applied in good faith for the registration of the trade mark in respect of the relevant goods, before:" ;
    tmk:upstreamRef "TMA1995/s61(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)(c)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f20e028f9feb3fb4aaf42b82cffca3d89772cafab2d2e20ed829ce861b0e8d5e" ;
    tmk:ordinal 10 ;
    tmk:text "(i) 1 January 1996; or" ;
    tmk:upstreamRef "TMA1995/s61(2)(c)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)(c)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0473ae89b4a1428831562781d718b0c6143883591abba405df7ec97dba3c3ea1" ;
    tmk:ordinal 11 ;
    tmk:text "(ii) the day on which the sign was recognised as a geographical indication for the designated goods in their country of origin;" ;
    tmk:upstreamRef "TMA1995/s61(2)(c)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)(d)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9498ed39197d6cf2c13c4a8616f3538dbe3b614fc0fb386eb56422f70e5d044e" ;
    tmk:ordinal 13 ;
    tmk:text "(d) if the registration of the trade mark is being sought in respect of wine or spirits (relevant wine or spirits)—the sign is identical with the name that, on 1 January 1995, was, in the country in which the relevant wine or spirits originated, the customary name of a variety of grapes used in the production of the relevant wine or spirits." ;
    tmk:upstreamRef "TMA1995/s61(2)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(2)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:22679d597f382f95ad363867137554987ba1278711cbd0786dc49eb9ccaf1432" ;
    tmk:ordinal 12 ;
    tmk:text "whichever is the later; or" ;
    tmk:upstreamRef "TMA1995/s61(2)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:57aa288008bd0a534f6ef4ffe7930dd8768f92cf7c021bbbcd98ad7fd9892466" ;
    tmk:ordinal 14 ;
    tmk:text "(3) An opposition on a ground referred to in subsection (1) also fails if the applicant establishes that:" ;
    tmk:upstreamRef "TMA1995/s61(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:23940e2384cf2cae49a12267db38029ea952007d2683e506e08623da5d37e2be" ;
    tmk:ordinal 15 ;
    tmk:text "(a) although the sign is a geographical indication for the designated goods, it is also a geographical indication for the relevant goods; and" ;
    tmk:upstreamRef "TMA1995/s61(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:41a2a26de65a98205679b98c2fc37d68ea3ce211c7082a5a0ece3a1f32e9b774" ;
    tmk:ordinal 16 ;
    tmk:text "(b) the applicant has not used, and does not intend to use, the trade mark in relation to the relevant goods in a way that is likely to deceive or confuse members of the public as to the origin of the relevant goods." ;
    tmk:upstreamRef "TMA1995/s61(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:381a10de4b87315e559f3f42fee2426a537bf1f2aa26d7a4f25fd295361cce3c" ;
    tmk:ordinal 17 ;
    tmk:text "(4) An opposition on a ground referred to in subsection (1) also fails if the applicant establishes that:" ;
    tmk:upstreamRef "TMA1995/s61(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7ebb5d4a38567c8e35a1d6fccb296fe178487e2a9c1b325bdbfda5bee82fcdb0" ;
    tmk:ordinal 18 ;
    tmk:text "(a) the sign consists of a word or term that is a geographical indication; and" ;
    tmk:upstreamRef "TMA1995/s61(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:aefdd3b8fdeed09cafbb67ea86796fa3dd2c71ba944409775c3a80db9cb67101" ;
    tmk:ordinal 19 ;
    tmk:text "(b) the word or term is a common English word or term; and" ;
    tmk:upstreamRef "TMA1995/s61(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(4)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7e7d4da7f83404f6403948f566c3742f6b259fc4d249f620eec7311555f3eeaa" ;
    tmk:ordinal 20 ;
    tmk:text "(c) the applicant has not used, and does not intend to use, the trade mark in relation to the relevant goods in a way that is likely to deceive or confuse members of the public as to the origin of the relevant goods." ;
    tmk:upstreamRef "TMA1995/s61(4)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(4)(c)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fef6dcc0928d1404964b97d64c79fc8a3f682a5a5c2f9166a1654d012fec14ea" ;
    tmk:ordinal 21 ;
    tmk:text "Note 1: For applicant, predecessor in title and geographical indication see section 6." ;
    tmk:upstreamRef "TMA1995/s61(4)(c)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61(4)(c)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8a3b12beff0ba6ecabebad1700e14a818dab23eab41e0c6612ca09f1577730b1" ;
    tmk:ordinal 22 ;
    tmk:text "Note 2: For originate (in relation to wine only) see section 15." ;
    tmk:upstreamRef "TMA1995/s61(4)(c)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3b6b2fa238ed3e76c3192d915748bc4ca79009fc663f8c85c09d019087a1f5f8" ;
    tmk:ordinal 4 ;
    tmk:text "if the relevant goods are similar to the designated goods or the use of a trade mark in respect of the relevant goods would be likely to deceive or cause confusion." ;
    tmk:upstreamRef "TMA1995/s61~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s62A~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s62A> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a2ce1aa66f443f745a769fb72df4f8198754a51f71c00cfd28a92d188e9bef38" ;
    tmk:ordinal 1 ;
    tmk:text "The registration of a trade mark may be opposed on the ground that the application was made in bad faith." ;
    tmk:upstreamRef "TMA1995/s62A~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5028d04b32457944ab15e00d926b8d077b49d3b4834ed3c0cf4b2401ea117831" ;
    tmk:ordinal 1 ;
    tmk:text "(1) If the particulars of the application have been published under section 30, the application may be amended as provided in this section." ;
    tmk:upstreamRef "TMA1995/s65(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5e047018dd855fe5672a182c993e0846e03a99efdc54080e90edd65ac8989f9b" ;
    tmk:ordinal 2 ;
    tmk:text "(2) An amendment may be made to the representation of the trade mark if the amendment does not substantially affect the identity of the trade mark as at the time when the particulars of the application were published." ;
    tmk:upstreamRef "TMA1995/s65(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1fea24cce70104883746f85f981e4f762e2a9341dfdf20724ebf659f6c3583da" ;
    tmk:ordinal 3 ;
    tmk:text "(3) An amendment may be made to an application to which section 51 applies to remove one or more trade marks from the application." ;
    tmk:upstreamRef "TMA1995/s65(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:edce598a37fb83c439ee6ef339338a5608773628e00b9a7b788a0ae32cd18dda" ;
    tmk:ordinal 4 ;
    tmk:text "(4) An amendment may be made to correct an error in the classification of goods or services specified in the application." ;
    tmk:upstreamRef "TMA1995/s65(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ec058fa304ba8cb0915a561226d15e6c1d6027e0e5876fd7bad58f33e1d44e73" ;
    tmk:ordinal 5 ;
    tmk:text "(5) An amendment may be made to add to the class or classes of goods or services specified in the application one or more other classes of goods or services if the Registrar is of the opinion that it is fair and reasonable in all the circumstances to do so." ;
    tmk:upstreamRef "TMA1995/s65(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(6)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f1d596ce21d81ad204feb5fdcc4368f6165540a3f31e9d0414b755d4bb711949" ;
    tmk:ordinal 6 ;
    tmk:text "(6) An amendment may be made to change the type of registration sought in the application (for example, an application for the registration of a trade mark as a certification trade mark may be amended to an application for registration as a collective trade mark)." ;
    tmk:upstreamRef "TMA1995/s65(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(7)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bf2fedc3940fcff1fda0aed977664214ff1a1cd8161458e02d063177778d3ac5" ;
    tmk:ordinal 7 ;
    tmk:text "(7) An amendment may be made to any other particular specified in the application unless the amendment would have the effect of extending the rights that (apart from the amendment) the applicant would have under the registration if it were granted." ;
    tmk:upstreamRef "TMA1995/s65(7)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(8)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2bf16750cbb02167e07e36795be447de2575e15545fa815718c4b90d7d70d7e9" ;
    tmk:ordinal 8 ;
    tmk:text "(8) Without limiting subsection (7), if the application specifies an applicant without legal personality, an amendment may be made under that subsection to change the reference to the specified applicant to a reference to a person with legal personality if that person can be identified as having made the application." ;
    tmk:upstreamRef "TMA1995/s65(8)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:aaabf6b70e7bf1d2fe7de181aee2cf7612017c699b21bdeed4d6c7de0815a3c5" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar may, at the request of the person who has filed an application (other than an application for the registration of a trade mark), a notice or other document for the purposes of this Act or at the request of the person’s agent, amend the application, notice or document:" ;
    tmk:upstreamRef "TMA1995/s66(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:32a2ff8dd97a8afacb2668ab2a0e0d7c313e212a08841e7dececb04e02a68904" ;
    tmk:ordinal 2 ;
    tmk:text "(a) to correct a clerical error or an obvious mistake; or" ;
    tmk:upstreamRef "TMA1995/s66(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s66(1)(b)> a tmk:LegislativeUnit ;
