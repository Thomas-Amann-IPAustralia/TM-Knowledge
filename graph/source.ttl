    tmk:lastAmended "2026-07-22" ;
    tmk:partId "Part31" ;
    tmk:sourceUrl "https://manuals.ipaustralia.gov.au/trademark/4.-practice-for-examining-trade-marks-containing-the-signs-specified-in-reg-4.15"^^xsd:anyURI ;
    tmk:upstreamRef "TMM/Part31/4" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part54/2> a tmk:Page ;
    rdfs:label "2. Summonsing a witness"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:070c0ab2fac1234c419bdc9ce057c984a202d5829ce162f0e86ea3aed3f0cc15" ;
    tmk:lastAmended "2025-04-02" ;
    tmk:partId "Part54" ;
