    tmk:ordinal 9 ;
    tmk:text "the fee payable in relation to the request is the fee that would have been payable for lodgment of an application for restoration of the trade mark under subsection 71(1) of the repealed Act." ;
    tmk:upstreamRef "TMR1995/r22.2~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r3A.3(1)> a tmk:LegislativeUnit ;
