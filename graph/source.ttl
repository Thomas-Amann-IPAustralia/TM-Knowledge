    tmk:ordinal 14 ;
    tmk:text "(ii) a trade mark in respect of which the Registrar has received notification of an IRDA;" ;
    tmk:upstreamRef "TMR1995/r4.15A(2)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(2)(b)> a tmk:LegislativeUnit ;
