    tmk:ordinal 12 ;
    tmk:text "Note 2: For registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s101~2~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:93a9adc35d9d0bb43fe600bb6e897e851ad9c68bae4c3fd81ea41c7453603ab7" ;
    tmk:ordinal 1 ;
    tmk:text "(1) This section applies if an application for the removal of a trade mark (challenged trade mark) from the Register is made on the ground referred to in paragraph 92(4)(b) and:" ;
    tmk:upstreamRef "TMA1995/s102(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7f52446c420586fb0a8eb6ec999d66fb252bcf6a1057186a61807fcf3f3586d7" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the applicant is the registered owner of a trade mark that is substantially identical with, or deceptively similar to, the challenged trade mark and is registered in respect of the goods and/or services specified in the application subject to the condition or limitation that the use of the trade mark is to be restricted to:" ;
    tmk:upstreamRef "TMA1995/s102(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102(1)(a)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102> ;
