    tmk:upstreamRef "TMM/Part60/4/7/4/7/15/1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/7/4/7/17> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.28(2A)> ;
    tmk:contentHash "sha256:eabfd019377b0aae606503641b64dc3039385a41af27758a10bc0d2e9e31c7f5" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/7/4/7/17/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/7/4/7/17/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/4/7/4/7/17/prov/2> ;
    tmk:headingPath "4.7.17 Sanctions",
        "60.4.7 Examination of an IRDA",
        "Part 60 The Madrid Protocol" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/7> ;
    tmk:ordinal 23 ;
    tmk:partId "Part60" ;
    tmk:text "In addition to sections 39 to 44 of the Trade Marks Act 1995, subregulation 17A.28(2A) of the Trade Marks Regulations 1995 provides a further ground for rejecting an IRDA if granting protection would be inconsistent with sanctions laws. The relevant sanctions laws are: Autonomous Sanctions Act 2011 (Cth); Charter of the United Nations Act 1945 (Cth); and regulations made pursuant to those laws. Applications which are currently under sanction are from: Russian Federation Belarus Examiners must not issue a refusal for this ground without first consulting with Sarah Cannon, Examination Director. If an examiner considers that this ground may apply, or has any other queries relating to sanctions, please e-mail: Sarah Cannon Director, Examination Section C sarah.cannon@ipaustralia.gov.au." ;
    tmk:upstreamRef "TMM/Part60/4/7/4/7/17" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part9/4/4/7/2> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(3)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(4)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
    tmk:contentHash "sha256:fe6cb4b716ca83d5365e459b7fe3cca0fbd33d6c275ca10a4ea676839470d351" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part9/4/4/7/2/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part9/4/4/7/2/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part9/4/4/7/2/prov/2> ;
    tmk:headingPath "4.7 Section 65A – amend application to correct a clerical error or an obvious mistake after publication",
        "4.7.2 Kind of amendments that could be made under section 65A",
        "Part 9 Amendments and Changes to Name and Address",
        "Part 9.4. Amendment after particulars of an application have been published (Sections 63, 65 and 65A)" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part9/4> ;
    tmk:ordinal 11 ;
    tmk:partId "Part9" ;
    tmk:text "It will not be appropriate to limit the Registrar’s discretion under this section by comprehensively listing the kinds of amendments that may be “in” or “out” of this provision. The amendment must be to “correct a clerical error or obvious mistake”, but it must also be the Registrar’s opinion that “it is fair and reasonable in all the circumstances of the case to make the amendment”. Considerations would include: i. the timing of an amendment request in the life of an application (a request many months after filing would be unlikely to be allowed); and ii. whether a search locates conflicting marks whose rights may be affected by the change. In this last scenario it may be necessary to notify those trade mark owners, in line with processes used for notification of owners of cited marks in section 44(3) and 44(4) acceptances. Section 65A amendments might include amendments to trade marks to correct misspellings (e.g. changing GEEN FELDS to GREEN FIELDS) or amendments to the classification including the wording of goods and/or services." ;
    tmk:upstreamRef "TMM/Part9/4/4/7/2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17.1> a tmk:LegislativeProvision ;
    rdfs:label "Evidence in support of applications"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ca6307444eefa3c31e7104bd64e152782c19b25bc906fd5023d8962d9198f8c6" ;
    tmk:text "An applicant for registration of a defensive trade mark must file evidence in support of the application at, or as soon as practicable after, the time of filing of the application." ;
    tmk:upstreamRef "TMR1995/r17.1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.35> a tmk:LegislativeProvision ;
    rdfs:label "Registrar must notify parties of dismissal or discontinuance of opposition"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:dd9bcfd1b32429c0677dc7bf7eaa087c4e8babd0f6a42b9545afb60ddd56d0ca" ;
    tmk:text "If an opposition is dismissed under regulation 17A.34B or discontinued, the Registrar must notify the parties of the dismissal or discontinuance." ;
    tmk:upstreamRef "TMR1995/r17A.35" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.41> a tmk:LegislativeProvision ;
    rdfs:label "Cancellation of international registration"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:88ce744da0203389ad12c0e0dbacef82ac17948bb796c204c2429fcb729f2ef7" ;
    tmk:text "If the International Bureau cancels, in whole or in part, the international registration of a trade mark that is a protected international trade mark, the trade mark ceases to be a protected international trade mark, to the extent of the cancellation, when the international registration is cancelled." ;
    tmk:upstreamRef "TMR1995/r17A.41" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48Y> a tmk:LegislativeProvision ;
    rdfs:label "Registrar must notify parties of dismissal or discontinuance of opposition"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4df9d5f4eca102b4ce4a0cfa1602affbfab04809851575eef9c3769e3fa75df4" ;
    tmk:text "If an opposition is dismissed under regulation 17A.48K or discontinued, the Registrar must notify the parties of the dismissal or discontinuance." ;
    tmk:upstreamRef "TMR1995/r17A.48Y" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.10> a tmk:LegislativeProvision ;
    rdfs:label "Notification of withdrawal of application etc."@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2800e4d688c15d5e627436938b4fb7b532800507ec47d014d35feb466beb2d53" ;
    tmk:text "If an application, notice or request is withdrawn in accordance with regulation 21.9, the Registrar must publish the withdrawal in a computer database maintained by the Trade Marks Office." ;
    tmk:upstreamRef "TMR1995/r21.10" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.20G> a tmk:LegislativeProvision ;
    rdfs:label "Registrar must notify parties of dismissal or discontinuance of opposition"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2c9854dc9c836a9d8c66d0f0abe13b84975350de50cc4f5c512e27881757a3ce" ;
    tmk:text "If an opposition is dismissed or discontinued, the Registrar must notify the parties of the dismissal or discontinuance." ;
    tmk:upstreamRef "TMR1995/r21.20G" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.20> a tmk:LegislativeProvision ;
    rdfs:label "Registrar must notify parties of dismissal or discontinuance of opposition"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ed7934500d1aa8fd111fce5c133cfbd92322bfdc57f6763b33d0d0d9351baafa" ;
    tmk:text "If an opposition is dismissed under section 222 of the Act or regulation 5.8 or discontinued, the Registrar must notify the parties of the dismissal or discontinuance." ;
    tmk:upstreamRef "TMR1995/r5.20" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r6.2> a tmk:LegislativeProvision ;
    rdfs:label "Request to amend before publication of details"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:be71fe055fd619442dddba7eee7b34427fc7efc13075d596012c8acd691e52e0" ;
    tmk:text "For the purposes of paragraph 64(b) of the Act (which deals with amendments before publication), the period for requesting an amendment is 14 days after filing the application for the registration of the trade mark." ;
    tmk:upstreamRef "TMR1995/r6.2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.22> a tmk:LegislativeProvision ;
    rdfs:label "Registrar must notify parties of dismissal or discontinuance of opposition"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b0ed394016ab4666f5a2e36c5586c0aa7c867d38f150b5b167fa5ab46117bd26" ;
    tmk:text "If an opposition is dismissed under regulation 9.10 or discontinued, the Registrar must notify the parties of the dismissal or discontinuance." ;
    tmk:upstreamRef "TMR1995/r9.22" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.5> a tmk:LegislativeProvision ;
    rdfs:label "Application for removal"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2ee44d786c40f6960534f33748153459e23dcac2dcabd6fa0208090737ce8907" ;
    tmk:text "For paragraph 92(2)(a) of the Act, an application for removal must be in an approved form." ;
    tmk:upstreamRef "TMR1995/r9.5" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/sch1> a tmk:LegislativeProvision ;
    rdfs:label "Classification of goods and services"@en-AU ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
