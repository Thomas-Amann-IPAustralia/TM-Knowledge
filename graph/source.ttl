<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r12.2> tmk:authorityStatus tmk:NotHeld ;
    tmk:upstreamRef "TMR1995/r12.2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.28(2A)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ce7004e47316b9a78007677efb3accc60a8529d9517ee1b522f8ce3ae39eda6b" ;
    tmk:text "(2A) A ground for rejecting an IRDA is that, if the trade mark that is the subject of the IRDA were to become a protected international trade mark, this would result in:" ;
    tmk:upstreamRef "TMR1995/r17A.28(2A)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.33(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5646f7f47bbe68c53a7fb01967dc8ab13541623b74d4af33fec65ee13a4e44e5" ;
    tmk:text "(1) If the Registrar publishes the acceptance of an IRDA in a computer database maintained by the Trade Marks Office in accordance with regulation 17A.25, a person may oppose the extension of protection by filing a notice of intention to oppose within 2 months from the publication of the acceptance." ;
    tmk:upstreamRef "TMR1995/r17A.33(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ae7cbac8edacea08ad7dee350407d798a3a3646459d51dce20ea145efb9babc9" ;
    tmk:text "(a) a document filed in support of the IRDA was amended contrary to the Act; or" ;
    tmk:upstreamRef "TMR1995/r17A.34(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:042f7a9470c99444fe96419eb98fdeacc4c1007fa9136b5bb2bfb96511f150a9" ;
    tmk:text "(b) the Registrar accepted the IRDA on the basis of evidence provided, or a representation made, by the holder that was false in a material particular." ;
    tmk:upstreamRef "TMR1995/r17A.34(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fb19a21a84413c20afbb235226476c1e579dc62714b4c8807a32eec510877e24" ;
    tmk:ordinal 2 ;
    tmk:text "(2) If the Registrar decides that the statement is adequate, the Registrar must give a copy of the statement to the holder of the IRDA." ;
    tmk:upstreamRef "TMR1995/r17A.34B(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:743a09961584671eeff3e3a31917f0ccb540ae048a73e03e60a558592b4fd6a2" ;
    tmk:ordinal 4 ;
    tmk:text "(a) the Registrar may direct the opponent to rectify the inadequacy by filing more information on the basis for one or more of the grounds; or" ;
    tmk:upstreamRef "TMR1995/r17A.34B(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a3fd6a20bac7f961a71fcd26b977c389ab7840f96a04a6b2432f21285de963ff" ;
    tmk:ordinal 5 ;
    tmk:text "(b) if all the grounds are inadequately particularised, the Registrar may dismiss the opposition: or" ;
    tmk:upstreamRef "TMR1995/r17A.34B(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34B> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:938e112cbe4884804357fd25c30bfaa9ffa8cf23a89c981595de28e167973508" ;
    tmk:ordinal 16 ;
    tmk:text "(5) If the Registrar decides that the information filed under paragraph (3)(a) rectifies the inadequacy of the statement, the Registrar must give a copy of the statement and the information filed in relation to paragraph (3)(a) to the holder of the IRDA." ;
    tmk:upstreamRef "TMR1995/r17A.34B(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34C(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMR1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.34C> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
