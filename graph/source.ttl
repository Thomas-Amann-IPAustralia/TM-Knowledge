    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f9eb37328c1817f9b5d79a073ef026283d3065431b552db58ff2fbf73b7754e6" ;
    tmk:ordinal 7 ;
    tmk:text "(e) to the Register is taken to be a reference to the Record of International Registrations; and" ;
    tmk:upstreamRef "TMR1995/r17A.39(2)(e)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39(2)(f)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.39> ;
