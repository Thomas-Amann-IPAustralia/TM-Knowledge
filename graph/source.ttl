    tmk:contentHash "sha256:7dfcd119d5cb705f201802e010b4a5655bdfa46805cd05cb84ca3244d304f023" ;
    tmk:ordinal 8 ;
    tmk:text "the trade mark that is the subject of the IRDA becomes a protected international trade mark at the end of the relevant period or that period as extended, as the case requires. However, this subregulation has effect subject to subregulation (2AA)." ;
    tmk:upstreamRef "TMR1995/r17A.36~1" .

