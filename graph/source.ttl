    tmk:contentHash "sha256:37bab9375336f68c2d31d64f9d37a51d190ad852e09c377b5ca75a7fa70d678c" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/2/2/2/2/1/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part60/2/2/2/2/1/prov/1> ;
