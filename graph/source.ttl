    tmk:contentHash "sha256:4187ec36106aa27112518ca1c507576d86e62a0de015fe7a8624e0f21db17398" ;
    tmk:ordinal 19 ;
    tmk:text "(3) If the Registrar in either case is satisfied:" ;
    tmk:upstreamRef "TMA1995/s44(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(3)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
