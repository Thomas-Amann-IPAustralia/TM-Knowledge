    tmk:upstreamRef "TMA1995/s11(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11> ;
