    tmk:ordinal 6 ;
    tmk:text "(4) The Registrar must, in accordance with a request made under subregulation (3), extend a period, unless:" ;
    tmk:upstreamRef "TMR1995/r17A.20(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20(4)(a)> a tmk:LegislativeUnit ;
