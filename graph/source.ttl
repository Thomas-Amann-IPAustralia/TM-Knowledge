    tmk:ordinal 10 ;
    tmk:text "Note 1: If an extension of the time for acceptance of an IRDA is sought after the end of a period mentioned in subregulation (1), or of an extended period mentioned in subregulation (3), application must be made under section 224 of the Act." ;
    tmk:upstreamRef "TMR1995/r17A.20~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.20~1~2> a tmk:LegislativeUnit ;
