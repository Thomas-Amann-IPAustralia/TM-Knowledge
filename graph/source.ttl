    tmk:upstreamRef "TMM/Part12/2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/3/3/6> a tmk:Chunk,
        tmk:ManualPassage ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMM> ;
    tmk:authorityKind "practice" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:chunkKind "body" ;
    tmk:citesPassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/8> ;
    tmk:contentHash "sha256:860d1e9abe401d45d42b2c376d0fca952a4c0a898243a9b406ef1ac16539a840" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part12/3/3/6/internal/0> ;
    tmk:headingPath "3. Conditions for a valid divisional application",
        "3.6 Divisional and Series applications",
        "Part 12 Divisional Applications" ;
    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/3> ;
    tmk:ordinal 8 ;
    tmk:partId "Part12" ;
    tmk:text "Divisional applications may be filed for some only of the goods and/or services of a series application. The divisional trade mark/s must be the same as the trade mark/s appearing in the series parent at the time of filing the divisional. Part 13.8 Divisional Applications from Series" ;
    tmk:upstreamRef "TMM/Part12/3/3/6" .

