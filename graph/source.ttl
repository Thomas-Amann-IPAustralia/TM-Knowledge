    tmk:ordinal 9 ;
    tmk:text "(d) if an application to register the trade mark was made in only 1 Convention country—from (and including) the day on which the application was made in that country; or" ;
    tmk:upstreamRef "TMR1995/r17A.4(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(e)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4> ;
