    tmk:ordinal 4 ;
    tmk:text "Note: For registered trade mark see section 6." ;
    tmk:upstreamRef "TMA1995/s112(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s112~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s112> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5e7f35687bb63575c568ae9049ea3bb5424e26e8a5bab3278e7473beba0864d7" ;
    tmk:ordinal 1 ;
    tmk:text "This Part makes provision:" ;
    tmk:upstreamRef "TMA1995/s112~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s115~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s115> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:60ed2763be6092d4e12cca58bde8741aa4b2b40becadddb8cc1a3deb6ab04bad" ;
    tmk:ordinal 1 ;
    tmk:text "The regulations may provide for the amendment and cancellation of particulars entered in the Register under this Division." ;
    tmk:upstreamRef "TMA1995/s115~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s116~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s116> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:65c00e596b20a413ec16b81bf0b6a403475064032d31b2aad7ee5fd870dd1cf3" ;
    tmk:ordinal 1 ;
    tmk:text "The fact that a record has been made in the Register under this Part that a person claims an interest in, or a right in respect of, a registered trade mark is not proof or evidence that the person has that right or interest." ;
    tmk:upstreamRef "TMA1995/s116~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11> ;
