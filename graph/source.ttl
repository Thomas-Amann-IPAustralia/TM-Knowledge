    tmk:ordinal 10 ;
    tmk:text "Note 1: For prescribed court see section 190." ;
    tmk:upstreamRef "TMA1995/s88(2)(e)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s88(2)(e)~2> a tmk:LegislativeUnit ;
