    tmk:contentHash "sha256:e6501fa07e0824418cdba095bbaca74e6ecbe85726cd4251fb3505da6d745cbb" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part52/5/5/1~1/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part52/5/5/1~1/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part52/5/5/1~1/prov/10>,
