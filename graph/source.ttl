    tmk:text "the trade mark that is the subject of the IRDA becomes a protected international trade mark at the end of the 7month period." ;
    tmk:upstreamRef "TMR1995/r17A.36~8" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.37> ;
