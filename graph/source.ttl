    tmk:text "a registered trade mark that is applied to any goods, or in relation to any goods or services, in respect of which the trade mark is registered;" ;
    tmk:upstreamRef "TMA1995/s26(1)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s26> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:60fb7baea7268918a052213e1cc4fb6071f09b403f697c7961e9f40de651406e" ;
    tmk:ordinal 21 ;
    tmk:text "(2) If the authorised user brings an action for infringement of the trade mark, the authorised user must make the registered owner of the trade mark a defendant in the action. However, the registered owner is not liable for costs if he or she does not take part in the proceedings." ;
    tmk:upstreamRef "TMA1995/s26(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ef83022e7a048f1d01d28a8cc271fb03b419d20a0d523f02729877b2c5e37e3a" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A person may apply for the registration of a trade mark in respect of goods and/or services if:" ;
    tmk:upstreamRef "TMA1995/s27(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fb3edb79ce1b4c1b374550098c90935a374babe3ac705b752bdfcbcd5ef162ce" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the person claims to be the owner of the trade mark; and" ;
    tmk:upstreamRef "TMA1995/s27(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:62a6549d230e2de86507cb3482932e1be6663bb6145185f983f187eb4a068fd8" ;
    tmk:ordinal 3 ;
    tmk:text "(b) one of the following applies:" ;
    tmk:upstreamRef "TMA1995/s27(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(1)(b)(i)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:de812371a28a18a682d31539393e957ebb280bd747ef45d9fa76f080fd09cd6a" ;
    tmk:ordinal 4 ;
    tmk:text "(i) the person is using or intends to use the trade mark in relation to the goods and/or services;" ;
    tmk:upstreamRef "TMA1995/s27(1)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(1)(b)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:f86f8e76632173a1eb3ca3c0778af9888a8f74d09bee1c9b4763a85633f50301" ;
    tmk:ordinal 5 ;
    tmk:text "(ii) the person has authorised or intends to authorise another person to use the trade mark in relation to the goods and/or services;" ;
    tmk:upstreamRef "TMA1995/s27(1)(b)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(1)(b)(iii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4a4be127c828a18e941856d449482adc4c5d50d19f5fb3db2cea991ff998324a" ;
    tmk:ordinal 6 ;
    tmk:text "(iii) the person intends to assign the trade mark to a body corporate that is about to be constituted with a view to the use by the body corporate of the trade mark in relation to the goods and/or services." ;
    tmk:upstreamRef "TMA1995/s27(1)(b)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(1)(b)(iii)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
