<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s18(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s18> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e8859ef5323d12b021065a1a2bcd2fc919e285802923aeec8ae5c938224a15e7" ;
    tmk:ordinal 1 ;
    tmk:text "(1) The regulations may provide that a sign specified in the regulations is not to be used as a trade mark or as part of a trade mark." ;
    tmk:upstreamRef "TMA1995/s18(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s19(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s19> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b2b215091f3eb5b39952a39cc013bd20424c53c68315108154b77d4cfc4c269b" ;
    tmk:ordinal 5 ;
    tmk:text "(2) The registration of a trade mark may be in respect of goods or services of more than one class." ;
    tmk:upstreamRef "TMA1995/s19(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s25C> tmk:authorityStatus tmk:NotHeld ;
