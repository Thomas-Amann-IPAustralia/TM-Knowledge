    tmk:ordinal 9 ;
    tmk:text "(a) be in accordance with the regulations; and" ;
    tmk:upstreamRef "TMA1995/s27(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
