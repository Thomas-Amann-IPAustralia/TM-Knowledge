    tmk:ordinal 2 ;
    tmk:text "(a) defines a certification trade mark; and" ;
    tmk:upstreamRef "TMA1995/s168(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168> ;
