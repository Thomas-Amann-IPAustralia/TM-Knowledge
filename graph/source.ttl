    tmk:ordinal 5 ;
    tmk:text "Note: For registered owner, registered trade mark and Register see section 6." ;
    tmk:upstreamRef "TMA1995/s83(1)(c)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83(2)~1> a tmk:LegislativeUnit ;
