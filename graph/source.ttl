    tmk:ordinal 4 ;
    tmk:text "Note: For this Act see section 6." ;
    tmk:upstreamRef "TMA1995/s33(1)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(2)~1> a tmk:LegislativeUnit ;
