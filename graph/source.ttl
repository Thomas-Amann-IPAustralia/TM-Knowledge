    tmk:ordinal 7 ;
    tmk:text "(4) The application may be made only on either or both of the following grounds:" ;
    tmk:upstreamRef "TMR1995/r5.13A(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.14(4)> a tmk:LegislativeUnit ;
