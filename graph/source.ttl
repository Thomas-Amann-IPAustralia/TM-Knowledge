    tmk:ordinal 13 ;
    tmk:text "(6) In the circumstances mentioned in subregulation (5), the Registrar may make a decision by reference to relevant information that is held in the Trade Marks Office." ;
    tmk:upstreamRef "TMR1995/r21.15(6)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(7)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15> ;
