    tmk:ordinal 8 ;
    tmk:text "(2) The application must:" ;
    tmk:upstreamRef "TMA1995/s27(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(2)(a)> a tmk:LegislativeUnit ;
