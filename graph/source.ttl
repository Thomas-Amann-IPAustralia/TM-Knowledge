    tmk:ordinal 8 ;
    tmk:text "(a) an error or omission by the person, the person’s agent, the Registrar or an employee;" ;
    tmk:upstreamRef "TMR1995/r5.13A(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13A(4)(b)> a tmk:LegislativeUnit ;
