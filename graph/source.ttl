    tmk:ordinal 9 ;
    tmk:text "(b) there are grounds under this Act for rejecting it;" ;
    tmk:upstreamRef "TMA1995/s33(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:bf8c0b25fc506600b605bbda09111bada1f72bcb3bbe7eb03bcb5b890decb812" ;
    tmk:ordinal 12 ;
    tmk:text "(4) The Registrar may not reject an application without giving the applicant an opportunity of being heard." ;
    tmk:upstreamRef "TMA1995/s33(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(4)~1> a tmk:LegislativeUnit ;
