    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:76be070f3ad4ba8e6317aff10356d69b2fc0550ca72a9c6a8b0ccfa9b4617981" ;
    tmk:ordinal 4 ;
    tmk:text "the unrenewed trade mark is taken to be a registered trade mark for the purposes of the application at any time when the registration of the unrenewed trade mark could have been renewed under section 79." ;
    tmk:upstreamRef "TMA1995/s80~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A> ;
