    tmk:ordinal 75 ;
    tmk:text "predecessor in title, in relation to a person who claims to be the owner of a trade mark, means:" ;
    tmk:upstreamRef "TMA1995/s6/predecessor-in-title" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/predecessor-in-title(a)> a tmk:LegislativeUnit ;
