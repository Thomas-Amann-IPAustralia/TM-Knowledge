    tmk:ordinal 5 ;
    tmk:text "(c) provide further documents or evidence in support of the application; and" ;
    tmk:upstreamRef "TMR1995/r4.9(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.9(2)(d)> a tmk:LegislativeUnit ;
