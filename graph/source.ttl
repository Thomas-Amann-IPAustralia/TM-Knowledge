    tmk:ordinal 6 ;
    tmk:text "(iii) in respect of which an application for registration, or an IRDA, has been made by another person; and" ;
    tmk:upstreamRef "TMR1995/r17A.21(1)(b)(iii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.21(1)(c)> a tmk:LegislativeUnit ;
