    tmk:contentHash "sha256:59825a241b964511b67b171ead9b4eac69c7230b30162b6eba741f388cd3a1ff" ;
    tmk:ordinal 11 ;
    tmk:text "(b) Sydney Paralympic Organising Committee Limited incorporated under the law of New South Wales;" ;
    tmk:upstreamRef "TMR1995/r4.7(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7> ;
