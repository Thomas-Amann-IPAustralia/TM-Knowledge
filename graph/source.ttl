    tmk:ordinal 6 ;
    tmk:text "Note 1: For registered owner see section 6." ;
    tmk:upstreamRef "TMA1995/s102(1)(b)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102(1)(b)~2> a tmk:LegislativeUnit ;
