    tmk:ordinal 3 ;
    tmk:text "(b) the filing date of each of those applications is the same; and" ;
    tmk:upstreamRef "TMA1995/s82A(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s82A> ;
