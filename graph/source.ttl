    tmk:ordinal 3 ;
    tmk:text "(b) no time or period is provided within which the act or thing is to be done;" ;
    tmk:upstreamRef "TMA1995/s204(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204~1> a tmk:LegislativeUnit ;
