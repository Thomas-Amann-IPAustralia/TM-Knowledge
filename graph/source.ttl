    tmk:text "(b) a document is not filed, or is taken not to have been filed, if the fee for filing the document is not paid in accordance with the regulations; or" ;
    tmk:upstreamRef "TMA1995/s223(4)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224(4)> a tmk:LegislativeUnit ;
