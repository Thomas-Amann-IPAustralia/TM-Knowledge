    tmk:ordinal 1 ;
    tmk:text "(1) In this Act, unless the contrary intention appears:" ;
    tmk:upstreamRef "TMA1995/s6(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6(2)> a tmk:LegislativeUnit ;
