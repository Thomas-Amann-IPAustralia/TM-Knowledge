    tmk:ordinal 2 ;
    tmk:text "(a) the Registrar is required under this Act to do any act or thing; and" ;
    tmk:upstreamRef "TMA1995/s204(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s204> ;
