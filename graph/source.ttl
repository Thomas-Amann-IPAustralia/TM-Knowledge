    tmk:ordinal 26 ;
    tmk:text "(i) the similar goods or closely related services; or" ;
    tmk:upstreamRef "TMA1995/s44(4)(a)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(4)(a)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
