    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5049e83cfd9fd73b56ad8c2749fbdbacfbfa695dbc318d5ad71686f999ac8f6c" ;
    tmk:ordinal 1 ;
    tmk:text "The Registrar may require a request under section 63 or 66 to be in writing if the Registrar is of the opinion that the amendment requested is not minor." ;
    tmk:upstreamRef "TMA1995/s66A~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s67~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s67> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0e33a522024b62eb371b8d10227f7d7742f657a54e7f2b6b45c8c4dbfe89b896" ;
    tmk:ordinal 1 ;
    tmk:text "An appeal lies to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) from a decision of the Registrar under this Part." ;
    tmk:upstreamRef "TMA1995/s67~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s68(1)(a)> a tmk:LegislativeUnit ;
