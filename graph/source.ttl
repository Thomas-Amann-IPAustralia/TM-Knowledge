    tmk:text "(d) must include a representation of the trade mark that is sufficient to identify the trade mark; and" ;
    tmk:upstreamRef "TMR1995/r3A.3(3)(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r3A.3(3)(e)> a tmk:LegislativeUnit ;
