    tmk:onPage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part15/2> ;
    tmk:ordinal 5 ;
    tmk:partId "Part15" ;
    tmk:text "The time allowed (two working days), after the filing in Australia of an application, to claim priority based on the filing of an application in a Convention country (subsection 29(1), reg. 4.5) - this act is prescribed by paragraph 21.28(aa)." ;
    tmk:upstreamRef "TMM/Part15/2/2/2/2" .

