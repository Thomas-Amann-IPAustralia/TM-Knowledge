    tmk:ordinal 17 ;
    tmk:text "(4) If, when dealing with the application under the repealed Act as provided by paragraph (2)(a), the Registrar withdraws the acceptance of the application under subsection 44(3) of that Act, the following provisions apply:" ;
    tmk:upstreamRef "TMA1995/s241(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s241(4)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s241> ;
