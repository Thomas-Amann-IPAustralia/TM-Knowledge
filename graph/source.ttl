    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2cdfc54b63a631533df024150b4ddb3a52e67698bb3cba081fc9a11d0ee4f25c" ;
    tmk:ordinal 2 ;
    tmk:text "(1) If the Registrar decides that a person may be heard by way of written submissions, the Registrar must:" ;
    tmk:upstreamRef "TMR1995/r21.16(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2fd8630ee1280c6d4a1691bc9e11744ce25e5d662c206e26ed194d9fe7547ad7" ;
    tmk:ordinal 3 ;
    tmk:text "(a) notify the person of the period in which the submissions must be filed (being at least 10 business days); and" ;
    tmk:upstreamRef "TMR1995/r21.16(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:da2aef2d3527fefdc92c2e2e9f732ff5240ce921c4a72e09f8a99f8f0b51d180" ;
    tmk:ordinal 4 ;
    tmk:text "(b) determine the matter after considering the written submissions; and" ;
    tmk:upstreamRef "TMR1995/r21.16(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(1)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16> ;
