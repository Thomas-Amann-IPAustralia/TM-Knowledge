    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8baecec255266933012c252d29fb9e4408d69c426bc956bc5ebed7238e63fb21" ;
    tmk:ordinal 5 ;
    tmk:text "(2) A report under subregulation (1) must include notification of the date on which the application will lapse if it is not accepted earlier." ;
    tmk:upstreamRef "TMR1995/r4.8(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.8> ;
