    tmk:ordinal 1 ;
    tmk:text "Application for registration under this Act" ;
    tmk:upstreamRef "TMA1995/s11~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11~2> a tmk:LegislativeUnit ;
