    tmk:ordinal 10 ;
    tmk:text "(a) a person appears in person; or" ;
    tmk:upstreamRef "TMR1995/r21.16(4)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(4)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
