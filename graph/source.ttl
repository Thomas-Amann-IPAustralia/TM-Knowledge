    tmk:ordinal 20 ;
    tmk:text "(a) that there has been honest concurrent use of the 2 trade marks; or" ;
    tmk:upstreamRef "TMA1995/s44(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(3)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
