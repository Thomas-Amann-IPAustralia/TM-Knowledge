    tmk:ordinal 11 ;
    tmk:text "(c) does not request an oral hearing after being notified under paragraph (2)(b); or" ;
    tmk:upstreamRef "TMR1995/r21.15(5)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(5)(d)> a tmk:LegislativeUnit ;
