    tmk:ordinal 10 ;
    tmk:text "(ii) to authorise the use of the trade mark in Australia; or" ;
    tmk:upstreamRef "TMA1995/s92(4)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(4)(a)(iii)> a tmk:LegislativeUnit ;
