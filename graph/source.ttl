    tmk:ordinal 4 ;
    tmk:text "in relation to the goods and/or services in respect of which the trade mark is registered." ;
    tmk:upstreamRef "TMA1995/s20~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s20> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
