    tmk:ordinal 10 ;
    tmk:text "(a) a person is granted an extension of time in which to file a notice of opposition; and" ;
    tmk:upstreamRef "TMA1995/s52(5)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s52(5)(b)> a tmk:LegislativeUnit ;
