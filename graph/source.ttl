    tmk:contentHash "sha256:f1c451a58f1d66a5c80ed2454c140f60394584f1af4377c31642f8688dde5b83" ;
    tmk:ordinal 15 ;
    tmk:text "(3) Without limiting the particulars that may be included in an application, the application must:" ;
    tmk:upstreamRef "TMA1995/s27(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:724cdf3e6a7a1812722a609193a356bdd3390af3abb8ab5b0e04be6f3690382b" ;
    tmk:ordinal 18 ;
    tmk:text "(4) Regulations made for the purposes of paragraph (3)(b) may apply, adopt or incorporate any matter contained in any listing of goods and/or services published by the Registrar from time to time and made available for inspection by the public at the Trade Marks Office and its suboffices (if any)." ;
    tmk:upstreamRef "TMA1995/s27(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d645441a5bd4f559aebe28690e7edb7482c9d475338a6bf725c96af233afd86c" ;
    tmk:ordinal 19 ;
    tmk:text "(5) An application may be made in respect of goods and services of one or more of the classes provided for in regulations made under subsection 19(3)." ;
    tmk:upstreamRef "TMA1995/s27(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s28~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s28> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:29a0afca7bf7198ba0345611e2040501497a6a464b680f3205c0be8a3a53fafd" ;
    tmk:ordinal 1 ;
    tmk:text "If the relations between 2 or more persons interested in a trade mark are such that none of them is entitled to use the trade mark except:" ;
    tmk:upstreamRef "TMA1995/s28~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s28~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s28> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ed64d4f4d7b0c9fbce73f8e3bf04e7e5605420dc3e72b50aa5b8fee4c5eacfce" ;
    tmk:ordinal 4 ;
    tmk:text "the persons may together apply for its registration under subsection 27(1)." ;
    tmk:upstreamRef "TMA1995/s28~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:3ef602f8e6343ecb453c6f1b92fc355645b38176b9845b5e22f8469a00575d11" ;
    tmk:ordinal 2 ;
    tmk:text "(a) a person has made an application for the registration of a trade mark in one or more than one Convention country; and" ;
    tmk:upstreamRef "TMA1995/s29(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c9865ae8fec08d5b59dfd08c114e729ee28e0cd1d204a206cdeb50b55266db52" ;
    tmk:ordinal 3 ;
    tmk:text "(b) within 6 months after the day on which that application, or the first of those applications, was made, that person or another person (successor in title) of whom that person is a predecessor in title applies to the Registrar for the registration of the trade mark in respect of some or all of the goods and/or services in respect of which registration was sought in that country or those countries;" ;
    tmk:upstreamRef "TMA1995/s29(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e0e7b9e35fa13dc16820d8b592b31e970d6a766776d9558bb2291560c4b682d8" ;
    tmk:ordinal 6 ;
    tmk:text "(2) The priority claimed is for the registration of the trade mark in respect of the goods or services:" ;
    tmk:upstreamRef "TMA1995/s29(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:b19fc9a381d6cda55cd59ea1f115b23ee3dcc53eeed0a36fc6c87f553312b3ca" ;
    tmk:ordinal 7 ;
    tmk:text "(a) if an application to register the trade mark was made in only one Convention country—from (and including) the day on which the application was made in that country; or" ;
    tmk:upstreamRef "TMA1995/s29(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d7f361d2f958aa48e343a96984116a7ad1a6e7fa802f22f9f89063fdee72738e" ;
    tmk:ordinal 9 ;
    tmk:text "(3) The regulations may provide for the filing of documents in support of a notice claiming priority and, in particular, for the filing of certified copies of any application for the registration of the trade mark made in a Convention country." ;
    tmk:upstreamRef "TMA1995/s29(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29(3)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9059baa7aa7e3be6e019cfb3e1ad972366c94a44a09147c3e2a7047e7e172117" ;
    tmk:ordinal 10 ;
    tmk:text "Note: For Convention country see section 225." ;
    tmk:upstreamRef "TMA1995/s29(3)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:d6866cf92b75e95b9ef7658d5511ebbb8c2a88323848daf3c63fd518a4d7adec" ;
    tmk:ordinal 4 ;
    tmk:text "that person or that person’s successor in title may, when filing the application, or within the prescribed period after filing the application but before the application is accepted, claim a right of priority for the registration of the trade mark in respect of any or all of those goods and/or services in accordance with the regulations." ;
    tmk:upstreamRef "TMA1995/s29~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29~1~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c079d3291c395e1cec6ab58944e84750edf7c0969c8897809e5f99519633b6ab" ;
    tmk:ordinal 5 ;
    tmk:text "Note: For month see section 6." ;
    tmk:upstreamRef "TMA1995/s29~1~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s3(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:7a49470c9f615d7d0718d8a78e5fe75385147c66feadc240e14ee8015eccef0b" ;
    tmk:ordinal 1 ;
    tmk:text "(1) This Act binds the Crown in right of the Commonwealth, of each of the States, of the Australian Capital Territory and of the Northern Territory." ;
    tmk:upstreamRef "TMA1995/s3(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s3(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ed9f23f2480574800ef7b90459d2d9065080eaa4c9291b24e2fb738ebc63bb77" ;
    tmk:ordinal 2 ;
    tmk:text "(2) Nothing in this Act makes the Crown liable to be prosecuted for an offence." ;
    tmk:upstreamRef "TMA1995/s3(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(1)(b)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> ;
