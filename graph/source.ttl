    tmk:ordinal 2 ;
    tmk:text "(a) a copy of any earlier application certified in the trade marks office (however described) of the Convention country in which it was filed; and" ;
    tmk:upstreamRef "TMR1995/r17A.19(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.19(1)(b)> a tmk:LegislativeUnit ;
