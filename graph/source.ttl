    tmk:ordinal 5 ;
    tmk:text "(c) notify the person of the Registrar’s decision in relation to the matter." ;
    tmk:upstreamRef "TMR1995/r21.16(1)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.16(2)> a tmk:LegislativeUnit ;
