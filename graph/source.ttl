    tmk:ordinal 4 ;
    tmk:text "date of recording means the date recorded in the International Register as the recordal date for a request made under Article 3ter (2) of the Protocol for extension of protection to Australia." ;
    tmk:upstreamRef "TMR1995/r17A.2/date-of-recording" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/holder> a tmk:LegislativeUnit ;
