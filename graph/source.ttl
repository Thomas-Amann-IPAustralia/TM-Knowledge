    tmk:ordinal 17 ;
    tmk:text "(i) used the trade mark in Australia; or" ;
    tmk:upstreamRef "TMA1995/s92(4)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92(4)(b)(ii)> a tmk:LegislativeUnit ;
