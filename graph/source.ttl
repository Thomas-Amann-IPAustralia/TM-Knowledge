    tmk:ordinal 2 ;
    tmk:text "(2) The Registrar may give the person an opportunity to be heard by:" ;
    tmk:upstreamRef "TMR1995/r21.15(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(2)(a)> a tmk:LegislativeUnit ;
