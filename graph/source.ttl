    tmk:ordinal 4 ;
    tmk:text "(a) be in the approved form; and" ;
    tmk:upstreamRef "TMR1995/r5.13A(3)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13A(3)(b)> a tmk:LegislativeUnit ;
