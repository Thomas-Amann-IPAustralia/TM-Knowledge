    tmk:ordinal 2 ;
    tmk:text "(a) if a number has been allocated to the application in the Trade Marks Office—the number;" ;
    tmk:upstreamRef "TMR1995/r4.7(1)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(1)(b)> a tmk:LegislativeUnit ;
