    tmk:ordinal 2 ;
    tmk:text "(2) The request must:" ;
    tmk:upstreamRef "TMA1995/s75(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75> ;
