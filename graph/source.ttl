    tmk:contentHash "sha256:a997393ec85c68f8a982b243919a3298505f172eec6dd9e6619dbc8622a6b395" ;
    tmk:ordinal 5 ;
    tmk:text "the unrenewed protected international trade mark is taken to be a protected international trade mark for the purposes of the application or the IRDA, at any time when the registration of the unrenewed protected international trade mark could have been renewed under Article 7 of the Protocol." ;
    tmk:upstreamRef "TMR1995/r17A.42~1" .

