    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c1a342e6479937b99c21224945272526a6374797a82481f343e230167c341c0b" ;
    tmk:ordinal 7 ;
    tmk:text "(a) published by the Registrar; and" ;
    tmk:upstreamRef "TMR1995/r4.4(6)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4(6)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:aa5c86a91887e4d3d7eb67b1c85e1a64086e95d6161e1186caad50e5ff36a257" ;
    tmk:ordinal 8 ;
    tmk:text "(b) made available for inspection by the public at the Trade Marks Office and its suboffices (if any)." ;
    tmk:upstreamRef "TMR1995/r4.4(6)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.5~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.5> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:58e04feba766716be5909073b3cb8a080bb025692d37e891df2e04576187f5cd" ;
    tmk:ordinal 1 ;
    tmk:text "For the purposes of subsection 29(1) of the Act (which deals with claims for priority), the prescribed period in relation to a claim for a right of priority for an application is 2 working days after filing the application." ;
    tmk:upstreamRef "TMR1995/r4.5~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:9c2d67e3a1da80189fe4082e75dfe228f19285068d518e4f73cb4696ba410c8b" ;
    tmk:ordinal 1 ;
    tmk:text "(1) For the purposes of subsection 29(1) of the Act (which deals with claims for priority), an applicant must claim a right of priority for an application by filing notice of the claim." ;
    tmk:upstreamRef "TMR1995/r4.6(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:64dfefafd46612a2ceda2182a8b65e33a347fd6ea83c2239a63d737266595696" ;
    tmk:ordinal 2 ;
    tmk:text "(2) Any notice under subregulation (1) must specify, in respect of the earlier application or, if there is more than 1 earlier application, in respect of each earlier application:" ;
    tmk:upstreamRef "TMR1995/r4.6(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:2f935586acd91705310e32c95d0355191fd71b3e0054d045f961a7ee027faa0d" ;
    tmk:ordinal 3 ;
    tmk:text "(a) the Convention country in which the earlier application was filed at the trade marks office (or its equivalent) of that Convention country; and" ;
    tmk:upstreamRef "TMR1995/r4.6(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:1870780429a5f213d8fd906e599c58c10273646cfbe52130f2a7f64f7dc93911" ;
    tmk:ordinal 4 ;
    tmk:text "(b) the date on which the earlier application was filed." ;
    tmk:upstreamRef "TMR1995/r4.6(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:068ddd8f69ae8d7040c94d073e612a28067d171cb5a590766e6e88abfbda4bd2" ;
    tmk:ordinal 5 ;
    tmk:text "(3) If, as a result of a claim for a right of priority, more than 1 priority date applies in relation to an application, a person who claims a right of priority under subsection 29(1) of the Act must specify the goods and/or services to which each priority date relates." ;
    tmk:upstreamRef "TMR1995/r4.6(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.6> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:e0a6fcd3218538288f05d890d21423a688ea01fbaabc459f487a723c8372dfeb" ;
    tmk:ordinal 6 ;
    tmk:text "(4) The applicant must inform the Registrar of the number allocated to each earlier application in the trade marks office, or its equivalent, of the Convention country in which each earlier application was filed." ;
    tmk:upstreamRef "TMR1995/r4.6(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.7> ;
