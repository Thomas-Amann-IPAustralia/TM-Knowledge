    tmk:ordinal 1 ;
    tmk:text "(1) If:" ;
    tmk:upstreamRef "TMA1995/s228(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228(1)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
