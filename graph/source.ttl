    tmk:ordinal 4 ;
    tmk:text "(3) Except for cases in which the court directs the Commission to appear, a delegate of the Commission may appear before the court and be heard at his or her discretion." ;
    tmk:upstreamRef "TMA1995/s182(3)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s182(4)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s182> ;
