    tmk:ordinal 15 ;
    tmk:text "(i) the period allowed for appealing against the decision had not yet ended; or" ;
    tmk:upstreamRef "TMA1995/s11(2)(b)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s11(2)(b)(ii)> a tmk:LegislativeUnit ;
