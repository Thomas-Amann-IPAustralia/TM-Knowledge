    tmk:text "(d) goods or services to be exported to the specified market." ;
    tmk:upstreamRef "TMA1995/s102(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102(d)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s102> ;
