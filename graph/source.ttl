    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:0626c5d86e17329e29d83838ed0baa79379610b747e563b96d60d79bf2edb3cd" ;
    tmk:ordinal 3 ;
    tmk:text "(b) if the request for extension of protection to Australia was made under Article 3ter (2) of the Protocol—the date of recording of the request." ;
    tmk:upstreamRef "TMR1995/r17A.4(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.4(2)> a tmk:LegislativeUnit ;
