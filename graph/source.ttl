        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r9.2> ;
    tmk:contentHash "sha256:3bcf37ff2b7065b437d13d6b495e14d2520804b99abf2b682d2056bb098bf22c" ;
    tmk:hasCitation <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/2/2/1/2/prov/0>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/2/2/1/2/prov/1>,
        <https://data.ipaustralia.gov.au/tmk/ns/cite/TMM/Part15/2/2/1/2/prov/10>,
