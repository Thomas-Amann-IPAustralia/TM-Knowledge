    tmk:ordinal 5 ;
    tmk:text "(c) provide further documents or evidence in support of the IRDA;" ;
    tmk:upstreamRef "TMR1995/r17A.17(2)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.17(2)(d)> a tmk:LegislativeUnit ;
