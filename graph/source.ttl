    tmk:ordinal 2 ;
    tmk:text "(2) However, if the application is made after the period mentioned in subregulation 5.13(1) has ended, the Registrar must not grant the extension unless the Registrar is satisfied that there is sufficient reason for the delay in making the application." ;
    tmk:upstreamRef "TMR1995/r5.13B(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.13B(3)> a tmk:LegislativeUnit ;
