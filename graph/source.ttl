    tmk:ordinal 8 ;
    tmk:text "(5) The Registrar may decide a matter if each person that is a party to the matter:" ;
    tmk:upstreamRef "TMR1995/r21.15(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(5)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15> ;
