    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:ce655e7902891fe01bfe5df279f3645ebfedad9d715e20ea44bd665837f1fb93" ;
    tmk:ordinal 5 ;
    tmk:text "(b) any other act is done in Australia to export goods or export services which, if done in relation to goods or services to be dealt with or provided in the course of trade in Australia, would constitute a use of the trade mark in Australia;" ;
    tmk:upstreamRef "TMA1995/s228(1)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
