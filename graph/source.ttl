    tmk:ordinal 10 ;
    tmk:text "(c) by other means that the Registrar states in the notification." ;
    tmk:upstreamRef "TMR1995/r17A.48B(3)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.48B(4)> a tmk:LegislativeUnit ;
