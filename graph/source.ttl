    tmk:ordinal 10 ;
    tmk:text "(b) a translation of the words into English." ;
    tmk:upstreamRef "TMR1995/r4.3(6)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(7)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:69d7e77db3f23382c4571de7f1666ee32f06b20ebe9f9d2d234c9d7633463928" ;
    tmk:ordinal 11 ;
    tmk:text "(7) If a trade mark for which registration is sought contains or consists of a sign that is a colour, scent, shape, sound or an aspect of packaging, or any combination of those features, the application for registration of the trade mark must include a concise and accurate description of the trade mark." ;
    tmk:upstreamRef "TMR1995/r4.3(7)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3(8)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.3> ;
    tmk:authorityKind "law" ;
