    tmk:ordinal 1 ;
    tmk:text "(1) In the course of an examination of an IRDA for which a right of priority is claimed, the Registrar may notify the holder that the holder is required to file:" ;
    tmk:upstreamRef "TMR1995/r17A.19(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.19(1)(a)> a tmk:LegislativeUnit ;
