    tmk:ordinal 7 ;
    tmk:text "costs does not include the costs mentioned in paragraph 105(2)(b) of the Act." ;
    tmk:upstreamRef "TMR1995/r21.13/costs" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.15> ;
