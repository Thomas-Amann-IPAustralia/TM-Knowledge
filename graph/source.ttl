    tmk:ordinal 14 ;
    tmk:text "(4) The time allowed for doing a relevant act may be extended, whether before or after that time has expired." ;
    tmk:upstreamRef "TMA1995/s224(4)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s224(5)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
