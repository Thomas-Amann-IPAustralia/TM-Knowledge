    tmk:ordinal 4 ;
    tmk:text "(ii) in relation to services that are to be exported from Australia (export services); or" ;
    tmk:upstreamRef "TMA1995/s228(1)(a)(ii)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228(1)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s228> ;
