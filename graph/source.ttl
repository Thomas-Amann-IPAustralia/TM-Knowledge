    tmk:contentHash "sha256:d464b69b70bf01640285af90604d42028a19280a638e3f24784e042248783f82" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A document that is required to be in an approved form and that is filed must be in English and be legible." ;
    tmk:upstreamRef "TMR1995/r21.2(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.2(2)> a tmk:LegislativeUnit ;
