    tmk:ordinal 1 ;
    tmk:text "(1) The Registrar may by signed instrument delegate all or any of his or her powers or functions to a prescribed employee, or employees in a prescribed class." ;
    tmk:upstreamRef "TMA1995/s206(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206(1)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206> ;
