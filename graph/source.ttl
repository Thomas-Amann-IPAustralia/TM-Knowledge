    tmk:ordinal 13 ;
    tmk:text "Note 2: For filing date see section 6." ;
    tmk:upstreamRef "TMA1995/s72(3)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s72(d)> a tmk:LegislativeUnit ;
