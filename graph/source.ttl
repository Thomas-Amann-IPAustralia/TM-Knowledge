    tmk:ordinal 12 ;
    tmk:text "(d) the service or services of the same description;" ;
    tmk:upstreamRef "TMA1995/s87(d)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s87~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s87> ;
    tmk:authorityKind "law" ;
