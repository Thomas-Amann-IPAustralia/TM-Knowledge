    tmk:ordinal 5 ;
    tmk:text "(b) in relation to which the trade mark is used;" ;
    tmk:upstreamRef "TMA1995/s8(3)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8(4)> a tmk:LegislativeUnit ;
