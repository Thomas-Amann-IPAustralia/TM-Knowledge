    tmk:contentHash "sha256:e686ab78f04bd8d93570a8849218bc553061e15a821663e8a5a823481210d5a0" ;
    tmk:ordinal 9 ;
    tmk:text "(b) similar services or closely related goods;" ;
    tmk:upstreamRef "TMA1995/s101(4)(b)" .

