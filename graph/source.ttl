    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:c3163704811d5cfcdb448890fc6439ff0010d19f87c95b29080629306db911c4" ;
    tmk:ordinal 2 ;
    tmk:text "(2) The Registrar must enter in the Register in accordance with this Act:" ;
    tmk:upstreamRef "TMA1995/s207(2)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(2)(a)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:a802b083c71c29920d4aba181fb091133aef8b2eff9771657a1cca2e311ae35c" ;
    tmk:ordinal 3 ;
    tmk:text "(a) all particulars of registered trade marks, certification trade marks and defensive trade marks, and all other matters, that were on the old register when the repealed Act was repealed, with the exception of particulars and other matters relating to registered users of trade marks; and" ;
    tmk:upstreamRef "TMA1995/s207(2)(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(2)(a)~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:fe71aacd1f710941f36ea003f04086b5b5691a48d379d7cb09b2ea3a4544302a" ;
    tmk:ordinal 4 ;
    tmk:text "Note 1: For old register see section 6." ;
    tmk:upstreamRef "TMA1995/s207(2)(a)~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(2)(a)~2> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:5be07d8c7d5dcb656b240ee49359ff36d5d6c0edf3ef288224ae2aa88a9d6f6e" ;
    tmk:ordinal 5 ;
    tmk:text "Note 2: See subsection (3) for entries relating to associated trade marks." ;
    tmk:upstreamRef "TMA1995/s207(2)(a)~2" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(2)(b)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:686ab82ef446ee3db63a787eabc75a3bd6b18dd13031c5da4b334830a45bd463" ;
    tmk:ordinal 6 ;
    tmk:text "(b) particulars of trade marks, certification trade marks, collective trade marks and defensive trade marks, and all other matters, that are required to be registered under this Act; and" ;
    tmk:upstreamRef "TMA1995/s207(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(2)(c)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
    tmk:authorityKind "law" ;
