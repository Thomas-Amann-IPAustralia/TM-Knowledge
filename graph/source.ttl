    tmk:contentHash "sha256:d20d4471b4878e5b896e835d2a24d0a9053a44ae4bedf3675fec0530db296a43" ;
    tmk:ordinal 7 ;
    tmk:text "(2) If the Registrar decides that a person may be heard by way of an oral hearing, the Registrar must give notification of the date, time and place of the hearing to the person at least 10 business days before the day the hearing is to begin." ;
    tmk:upstreamRef "TMR1995/r21.16(2)" .

