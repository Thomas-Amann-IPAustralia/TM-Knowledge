    tmk:ordinal 6 ;
    tmk:text "(b) a person specified in the instrument, being a person referred to in subsection (1)." ;
    tmk:upstreamRef "TMA1995/s206(2)(b)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(1)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
    tmk:authorityKind "law" ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:8958f9a984140516e95fef02f6bf4c6dd2c99d4c78a4b321997ee83167092c4e" ;
    tmk:ordinal 1 ;
    tmk:text "(1) A Register of Trade Marks is to be kept at the Trade Marks Office." ;
    tmk:upstreamRef "TMA1995/s207(1)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207(2)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207> ;
