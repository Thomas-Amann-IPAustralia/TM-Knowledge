    tmk:ordinal 28 ;
    tmk:text "(i) the similar goods or closely related services; or" ;
    tmk:upstreamRef "TMR1995/r4.15A(5)(a)(i)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A(5)(a)(ii)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
