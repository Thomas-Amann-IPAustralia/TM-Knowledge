    tmk:contentHash "sha256:24804dcf31bde8045cf9d7f684dcbb33ae3cee76cc4d88e72f99ec2596ac0222" ;
    tmk:ordinal 2 ;
    tmk:text "(a) the trade mark contains or consists of scandalous matter; or" ;
    tmk:upstreamRef "TMA1995/s42(a)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(3)> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ns/doc/TMA1995>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:authorityKind "law" ;
    tmk:authorityStatus tmk:Current ;
    tmk:capturedIn tmk:snapshot-c490a9927f1a ;
    tmk:contentHash "sha256:4187ec36106aa27112518ca1c507576d86e62a0de015fe7a8624e0f21db17398" ;
    tmk:ordinal 19 ;
    tmk:text "(3) If the Registrar in either case is satisfied:" ;
    tmk:upstreamRef "TMA1995/s44(3)" .

