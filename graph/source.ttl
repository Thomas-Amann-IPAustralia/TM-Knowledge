    tmk:contentHash "sha256:d645441a5bd4f559aebe28690e7edb7482c9d475338a6bf725c96af233afd86c" ;
    tmk:ordinal 19 ;
    tmk:text "(5) An application may be made in respect of goods and services of one or more of the classes provided for in regulations made under subsection 19(3)." ;
    tmk:upstreamRef "TMA1995/s27(5)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27A> tmk:authorityStatus tmk:NotHeld ;
