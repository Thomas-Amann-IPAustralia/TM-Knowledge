    tmk:ordinal 1 ;
    tmk:text "The applicant may appeal to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) against a decision of the Registrar:" ;
    tmk:upstreamRef "TMA1995/s35~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s36~1> a tmk:LegislativeUnit ;
    dcterms:isPartOf <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s36> ;
