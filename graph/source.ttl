    tmk:contentHash "sha256:f33a101bf0ac5e33c0717a8836b93664f07cc25a8538875cb86194d458314db2" ;
    tmk:ordinal 30 ;
    tmk:text "Note 1: An authorised use of the trade mark by a person is taken to be a use of the trade mark by the owner of the trade mark (see subsection 7(3))." ;
    tmk:upstreamRef "TMA1995/s44~2~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44~2~2> a tmk:LegislativeUnit ;
