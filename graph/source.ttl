    tmk:text "(c) an appeal is made from the decision on the opposition within the appeal period, or any extension of that period; and" ;
    tmk:upstreamRef "TMR1995/r17A.36(4)(c)" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.36(4)(d)> a tmk:LegislativeUnit ;
