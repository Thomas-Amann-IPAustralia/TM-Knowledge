    tmk:contentHash "sha256:5c157b08d083fde230843faf4b2d3e65daf28bba8426d6d9ce40694041829659" ;
    tmk:ordinal 32 ;
    tmk:text "Note: Section 44 of the Act provides for rejection of an application on the grounds that the trade mark is substantially identical with, or deceptively similar to, a registered trade mark or a trade mark for which registration is being sought." ;
    tmk:upstreamRef "TMR1995/r4.15A~2~1" .

<https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15~1> a tmk:LegislativeUnit ;
