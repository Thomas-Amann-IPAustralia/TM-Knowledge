        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6/6/1> ;
    tmk:goldRecord "GC-0029" ;
    tmk:notLabel "authorised user"@en-AU,
        "letter of consent"@en-AU ;
    tmk:origin "approved" ;
