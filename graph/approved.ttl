    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6/6/1> ;
    tmk:spanEnd 728 ;
    tmk:spanStart 614 ;
    tmk:supportingText "A section 43 ground for rejection should not be raised merely because a trade mark contains the image of a person." ;
    tmk:tier 3 .

tmka:GR-0044 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0027 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0044" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:8e7a69fc516a2b4b11213363298946680a0c24f0d1bcddc9f0d803c24c151e53" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6/6/2~1> ;
    tmk:spanEnd 949 ;
    tmk:spanStart 704 ;
    tmk:supportingText "However, a relevant connotation may arise if the deceased person’s estate (or other authorised entity) has continued to control the use of the person’s name/image after their death, e.g. by commercialising directly or licensing to third parties." ;
    tmk:tier 3 .

tmka:GR-0046 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0031 ;
    tmk:assertionPredicate tmk:constrainsExaminerTo ;
    tmk:assertionSubject tmkc:GC-0052 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0046" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:61ba688909678ff820013ed093969ede20b94f2231822735f4c59fc06b0d38cb" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/7%231> ;
    tmk:spanEnd 1448 ;
    tmk:spanStart 1161 ;
    tmk:supportingText "Other phone numbers which do not appear to represent a phoneword should not be queried or researched specifically in respect of section 43, unless other information before the examiner gives them particular reason to suspect that the applicant may not be the licensed user of the number." ;
    tmk:tier 3 .

tmka:GR-0048 a tmk:ApprovedAssertion ;
    rdfs:comment "The sentence reads \"which could viewed as\" — a missing word in the source. Copied exactly; a corrected supporting text does not land on the passage and the record fails."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0034 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0048" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:65247b2f3e686037e599b398b4f74f74a7e40836d32f3e2761a6a12ade582ed8" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/8/8/3> ;
    tmk:spanEnd 1659 ;
    tmk:spanStart 1405 ;
    tmk:supportingText "Examiners will also need to consider raising a section 41 ground for rejection in relation to any trade mark which could viewed as a radio call sign or frequency that simply consists of that material or with other descriptive or non distinctive elements." ;
    tmk:tier 3 .

tmka:GR-0052 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0012 ;
    tmk:assertionPredicate tmk:extendsTo ;
    tmk:assertionSubject tmkc:GC-0017 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0052" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:b338dd460c75842d9658f27fd99008fdf4da4df0d87c90928e6f3157d4509c62" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/4> ;
    tmk:spanEnd 173 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The same considerations apply to services as to goods, though careful consideration needs to be given to circumstances which may mitigate the risk of deception or confusion." ;
    tmk:tier 3 .

tmka:GR-0054 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject tmkc:GC-0013 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0054" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:f62b4939d149235abeefb52354519f2d89394eeed2e2bc8257b6ca5d9d6532c9" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/5> ;
    tmk:spanEnd 462 ;
    tmk:spanStart 349 ;
    tmk:supportingText "The condition of registration or specification amendment must directly address the connotation in the trade mark." ;
    tmk:tier 3 .

tmka:GR-0056 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0050 ;
    tmk:assertionPredicate tmk:excludesBasis ;
    tmk:assertionSubject tmkc:GC-0001 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0056" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:4a152ff8e285012f7bc44941664602f7d5ebbe7775f61faa73472e1827a6bc60" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/7> ;
    tmk:spanEnd 649 ;
    tmk:spanStart 436 ;
    tmk:supportingText "When faced with this type of reference it is important to remember that the connotation must be from the trade mark itself and not from any other external considerations such as a reputation in another trade mark." ;
    tmk:tier 3 .

tmka:GR-0057 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0006 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0037 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0057" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:7790025faf8751ea416943459edd4d4cc890374c4fc86f400a1ff604c9dd376e" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/10%231> ;
    tmk:spanEnd 266 ;
    tmk:spanStart 0 ;
    tmk:supportingText "If a trade mark, or some part of the trade mark, contains a reference to Indigenous people and a connotation arises from the mark that would be likely to deceive or confuse consumers within the relevant market, then a ground for rejection under s43 should be raised." ;
    tmk:tier 3 .

tmka:GR-0058 a tmk:ApprovedAssertion ;
    rdfs:comment "Note \"s 43\" with a space here, against \"s43\" in TMM/Part29/10#1 and \"section 43\" elsewhere. Three spellings, one provision, one Part."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0006 ;
    tmk:assertionPredicate tmk:dependsOnExternalSource ;
    tmk:assertionSubject tmkc:GC-0018 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0058" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:4c484f11bb81ae9e0b8453152cd0145a12d14fa09ab434e1c68288097f23886a" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/11%231> ;
    tmk:spanEnd 696 ;
    tmk:spanStart 384 ;
    tmk:supportingText "If during examination of a new application research reveals that a trade mark is identical or similar to a listed EU GI, consideration should then be given to whether or not the use of the trade mark would potentially deceive or confuse Australian consumers and make grounds for rejection under s 43 appropriate." ;
    tmk:tier 3 .

tmka:GX-0001 a tmk:ReasoningExpectation ;
    rdfs:comment "Tier 1 on the view that this is structural. If deciding where the quotation ends is a reading rather than a parse, it is Tier 3."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:caveat "The chunk boundary is upstream's; the sentence boundary between the quotation and the practice guidance is not marked in the text."@en-AU ;
    tmk:derivedFrom <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:expectedConclusion "The passage contains both quoted legislative text and the Registrar's practice, and the two must be distinguishable in any output derived from it."@en-AU ;
    tmk:explanationRequired true ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:given <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:goldRecord "GX-0001" ;
    tmk:inferenceKind "classification" ;
    tmk:mustNotConclude tmkp:PU-0004 ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:tier 1 .

tmka:GX-0004 a tmk:ReasoningExpectation ;
    rdfs:comment "Low confidence and high value. This is the record most likely to be in the wrong file."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:caveat "The clause \"at different points of the assessment\" is a reconciliation. If it is wrong, or if the two passages really do conflict, the conclusion should be rewritten or the whole record moved to prohibited-uses."@en-AU ;
    tmk:derivedFrom <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4> ;
    tmk:expectedConclusion "The Manual states both that the section's application is mandatory with no discretion to accept, and that where there is doubt a connotation exists the ground should not be raised. Both apply, at different points of the assessment."@en-AU ;
    tmk:explanationRequired true ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:given <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4> ;
    tmk:goldRecord "GX-0004" ;
    tmk:inferenceKind "consistency" ;
    tmk:mustNotConclude tmkp:PU-0001,
        tmkp:PU-0007 ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:tier 3 .

tmka:GX-0005 a tmk:ReasoningExpectation ;
    rdfs:comment "Tier 3 because misrouting a question sends an examiner to the wrong test, and the misrouting is invisible: both destinations are about confusion."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:derivedFrom <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/3> ;
    tmk:expectedConclusion "A question about confusion arising from similarity between two marks is not answered by the section 43 material, and the Manual allocates it to section 44 and Part 26."@en-AU ;
    tmk:explanationRequired true ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:given tmkc:GC-0004,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3> ;
    tmk:goldRecord "GX-0005" ;
    tmk:inferenceKind "classification" ;
    tmk:mustNotConclude tmkp:PU-0008,
        tmkp:PU-0018 ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:tier 3 .

tmka:GX-0010 a tmk:ReasoningExpectation ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:caveat "\"Likely to be viewed as a phoneword\" is itself an evaluative judgement. The inference states the practice conditional on that judgement having been made by a person."@en-AU ;
    tmk:derivedFrom <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/7%231> ;
    tmk:expectedConclusion "Where a mark contains material likely to be viewed as a phoneword, the applicable practice turns on whether the applicant is the owner or authorised user, and the ground is reconsidered on information establishing that they are."@en-AU ;
    tmk:explanationRequired true ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:given tmkc:GC-0031,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/7%231> ;
    tmk:goldRecord "GX-0010" ;
    tmk:inferenceKind "classification" ;
    tmk:mustNotConclude tmkp:PU-0001,
        tmkp:PU-0002 ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:tier 2 .

tmka:GX-0011 a tmk:ReasoningExpectation ;
    rdfs:comment "See GE-0015 and GE-0146: the two sentences differ in one clause and are otherwise word for word."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:derivedFrom <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/10%231> ;
    tmk:expectedConclusion "These two passages state the same rule with different subject matter, so neither is redundant and neither generalises the other."@en-AU ;
    tmk:explanationRequired true ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:given <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/10%231> ;
    tmk:goldRecord "GX-0011" ;
    tmk:inferenceKind "consistency" ;
    tmk:mustNotConclude tmkp:PU-0007 ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:tier 2 .

tmka:GX-0013 a tmk:ReasoningExpectation ;
    rdfs:comment "A system asked to find support for a proposition will find this passage by word overlap and cite it. The expected inference is that it says the opposite."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:derivedFrom <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/4%231> ;
    tmk:expectedConclusion "This passage does not support the proposition that descriptive matter in a mark gives rise to a section 43 ground; it states the opposite, subject to the specification covering the goods described."@en-AU ;
    tmk:explanationRequired true ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:given <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/4%231> ;
    tmk:goldRecord "GX-0013" ;
    tmk:inferenceKind "consistency" ;
    tmk:mustNotConclude tmkp:PU-0007 ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:tier 3 .

