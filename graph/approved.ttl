    tmk:sourceContentHash "sha256:3016fc2af55085c99f6f508c674df732dbefbd36582932ac716f701313b98e1c" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~2> ;
    tmk:spanEnd 1876 ;
    tmk:spanStart 1704 ;
    tmk:supportingText "An applicant may overcome a section 43 ground for rejection in relation to a name by providing the well-known person’s written permission to use their name as a trade mark." ;
    tmk:tier 3 .

tmka:GR-0040 a tmk:ApprovedAssertion ;
    rdfs:comment "Flagged deliberately: if the relationship model cannot hold \"the more X, the less Y\", a large part of the Manual's reasoning cannot be represented at all. Better to know that now than at Stage 4."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0028 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0026 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0040" ;
    tmk:isStale false ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:3016fc2af55085c99f6f508c674df732dbefbd36582932ac716f701313b98e1c" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~2> ;
    tmk:spanEnd 455 ;
    tmk:spanStart 244 ;
    tmk:supportingText "The more common the name, whether it is a given name, surname, or combination of both, the less likely consumers will be to make this assumption, as many well-known people have names shared by many other people." ;
    tmk:tier 3 .

tmka:GR-0042 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0006 ;
    tmk:assertionPredicate tmk:doesNotGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0030 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0042" ;
