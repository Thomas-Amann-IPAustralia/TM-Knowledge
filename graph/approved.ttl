        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/7> ;
    tmk:goldRecord "GC-0050" ;
    tmk:notLabel "acquired distinctiveness"@en-AU,
        "reputation in another trade mark"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkp:PU-0004 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "shacl" ;
    tmk:goldRecord "PU-0004" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "Section 43 of the Act requires the connotation to be obvious, direct and immediate." ;
    tmk:prohibitionKind "authority_conflation" ;
    tmk:prohibitionReason "The section requires no such thing. That formulation is the Manual's statement of practice. Attributing it to the Act gives an examiner a statutory requirement that does not exist and takes away the Registrar's discretion in the same sentence."@en-AU ;
    tmk:reviewStatus "approved" .

