    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part51/10%231~1> ;
    tmk:goldRecord "GC-0042" ;
    tmk:notLabel "opposition"@en-AU,
        "revocation of registration"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0043 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "This record exists to make the scope question concrete. If it is out of scope, saying so is more useful than correcting its labels."@en-AU ;
    skos:altLabel "divisional"@en-AU,
        "parent application"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "divisional application"@en-AU ;
