    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2> ;
    tmk:spanEnd 588 ;
    tmk:spanStart 579 ;
    tmk:surface "Examiners" .

tmka:GR-0001 a tmk:ApprovedAssertion ;
    rdfs:comment "Modality recorded as `must` on the reading that \"mandatory\" is obligation. The sentence contains no modal verb at all, so nothing in the grammar supports the reading — it is entirely a legal judgement."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0006 ;
    tmk:assertionPredicate tmk:appliesTo ;
    tmk:assertionSubject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0001" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:b6690f96b0ebc5181ac9b42c2669b0de831371538a8cc414e94d5e54796ceeff" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:spanEnd 434 ;
    tmk:spanStart 359 ;
    tmk:supportingText "The application of section 43 is, by the wording of the section, mandatory." ;
    tmk:tier 3 .

tmka:GR-0002 a tmk:ApprovedAssertion ;
    rdfs:comment "Tier 3: a wrong reading here either removes a discretion that exists or preserves one that does not."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0051 ;
    tmk:assertionPredicate tmk:constrainsExaminerTo ;
    tmk:assertionSubject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0002" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:b6690f96b0ebc5181ac9b42c2669b0de831371538a8cc414e94d5e54796ceeff" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:spanEnd 542 ;
    tmk:spanStart 435 ;
    tmk:supportingText "There is, therefore, no discretion to accept a trade mark that is caught by the provisions of this section." ;
    tmk:tier 3 .

tmka:GR-0003 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0002 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0003" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:b6690f96b0ebc5181ac9b42c2669b0de831371538a8cc414e94d5e54796ceeff" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:spanEnd 777 ;
    tmk:spanStart 543 ;
    tmk:supportingText "However for a trade mark to be caught by these provisions it is necessary for a decision maker to be clearly satisfied that use of the trade mark for the specified goods and / or services would be likely to deceive or cause confusion." ;
    tmk:tier 3 .

tmka:GR-0005 a tmk:ApprovedAssertion ;
    rdfs:comment "The object is arguably wrong: the excluded basis is the *comparison*, not section 44 — section 44 is where the comparison belongs. GR-0006 records that half. If the two should be one record, say so."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:assertionPredicate tmk:excludesBasis ;
    tmk:assertionSubject tmkc:GC-0001 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0005" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:f77c8cbb077e1682c601fc3ba31e570dd8097297d2a240565a044a3135e70190" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3> ;
    tmk:spanEnd 106 ;
    tmk:spanStart 0 ;
    tmk:supportingText "A connotation must arise from the trade mark itself, and not through a comparison with another trade mark." ;
    tmk:tier 3 .

tmka:GR-0006 a tmk:ApprovedAssertion ;
    rdfs:comment "Modality left null on purpose. The sentence states where something is dealt with; it directs nobody to do anything, and inventing a modality for it would be exactly the guess the schema forbids."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:assertionPredicate tmk:allocatesTo ;
    tmk:assertionSubject <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3> ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0006" ;
    tmk:isStale false ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:f77c8cbb077e1682c601fc3ba31e570dd8097297d2a240565a044a3135e70190" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3> ;
    tmk:spanEnd 236 ;
    tmk:spanStart 107 ;
    tmk:supportingText "Such comparisons are dealt with under the provisions of section 44 of the Act, and discussed in detail in Part 26 of this Manual." ;
    tmk:tier 2 .

tmka:GR-0007 a tmk:ApprovedAssertion ;
    rdfs:comment "Recording `may` here and `may` on GR-0034 flattens two different things into one value. If the modality vocabulary needs a fourth value for possibility, this record is the argument for it."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0038 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0001 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0007" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:1379f8631cf727764dfdb50bbaf252431c91e4e73945cafb375b69e38113fce7" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/2> ;
    tmk:spanEnd 84 ;
    tmk:spanStart 0 ;
    tmk:supportingText "A connotation may result from the whole trade mark or from a part of the trade mark." ;
    tmk:tier 2 .

tmka:GR-0008 a tmk:ApprovedAssertion ;
    rdfs:comment "`requiresElement` is probably the wrong predicate — the sentence lists sufficient sources, not necessary elements. Left in deliberately as an example of a predicate that reads plausibly and says the wrong thing."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0050 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject tmkc:GC-0001 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0008" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:1379f8631cf727764dfdb50bbaf252431c91e4e73945cafb375b69e38113fce7" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/2> ;
    tmk:spanEnd 213 ;
    tmk:spanStart 85 ;
    tmk:supportingText "It may result from a dictionary meaning or from a connection in the minds of the buying public with some person, place or thing." ;
    tmk:tier 2 .

tmka:GR-0010 a tmk:ApprovedAssertion ;
    rdfs:comment "Subject and object may be the wrong way round: it is s 33(3) that requires the ground, not the ground that requires s 33(3). Direction is a common and invisible error in relationship extraction."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(3)> ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject tmkc:GC-0006 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0010" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:5a52a4dd52ef95b0e001380666cfbc14b907dda998e67a97a99859e9c179e298" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4> ;
    tmk:spanEnd 185 ;
    tmk:spanStart 57 ;
    tmk:supportingText "The Registrar must be satisfied that a ground for rejection exists before section 33(3) can be applied to reject the trade mark." ;
    tmk:tier 3 .

tmka:GR-0011 a tmk:ApprovedAssertion ;
    rdfs:comment "A negative \"should\". Whether a negative should is weaker, stronger or the same as a positive one is a reading, and the modality vocabulary cannot express the difference."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0006 ;
    tmk:assertionPredicate tmk:constrainsExaminerTo ;
    tmk:assertionSubject tmkc:GC-0007 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0011" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:5a52a4dd52ef95b0e001380666cfbc14b907dda998e67a97a99859e9c179e298" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4> ;
    tmk:spanEnd 282 ;
    tmk:spanStart 186 ;
    tmk:supportingText "If there is doubt that a connotation exists, then the ground for rejection should not be raised." ;
    tmk:tier 3 .

tmka:GR-0012 a tmk:ApprovedAssertion ;
    rdfs:comment "The supporting text is the Manual's proposition, not the Court's words. The Court is cited in the next sentence. If a relationship's supporting text must be the sentence naming the case, this record is wrong and the rule should be stated."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:assertionPredicate tmk:interprets ;
    tmk:assertionSubject <https://data.ipaustralia.gov.au/tmk/ref/CASE/2000/FCA/720> ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0012" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:4a55810237a8dcf24587418ccacf418cc126ea299e516b2e35e8270f21d56352" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/3> ;
    tmk:spanEnd 178 ;
    tmk:spanStart 0 ;
    tmk:supportingText "At least at the examination stage, deception and confusion must result from something within the trade mark under consideration, not through a comparison with another trade mark." ;
    tmk:tier 3 .

tmka:GR-0013 a tmk:ApprovedAssertion ;
    rdfs:comment "Direction again: the Manual cites the case, so `citesAuthorityFor` with the case as subject may be backwards."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:assertionPredicate tmk:citesAuthorityFor ;
    tmk:assertionSubject <https://data.ipaustralia.gov.au/tmk/ref/CASE/2006/FCA/1663> ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0013" ;
    tmk:isStale false ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:deb607cbc7ae6fd37a648887567b1d4002a2af161e5ab51e486bee19095a59a0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~1> ;
    tmk:spanEnd 288 ;
    tmk:spanStart 49 ;
    tmk:supportingText "The underlying purpose of section 43 is to prevent the public being deceived or confused as to the nature of the goods by reason of the secondary meaning connoted by the mark in question (Pfizer Products Inc v Karam [2006] FCA 1663, [53])." ;
    tmk:tier 3 .

tmka:GR-0014 a tmk:ApprovedAssertion ;
    rdfs:comment "This is a candidate `authority_conflation` if reproduced as the statutory test — see PU-0004. The Manual's formulation and the Act's differ and both appear within one chunk."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0014" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:deb607cbc7ae6fd37a648887567b1d4002a2af161e5ab51e486bee19095a59a0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~1> ;
    tmk:spanEnd 890 ;
    tmk:spanStart 690 ;
    tmk:supportingText "For a trade mark to trigger section 43 there must be some connotation within the trade mark that would reasonably be expected to cause deception or confusion in the mind of the relevant buying public." ;
    tmk:tier 3 .

tmka:GR-0015 a tmk:ApprovedAssertion ;
    rdfs:comment "Four subjects in one sentence — a person's name, a descriptive term, a place name, a size or use reference. Recording it as one relationship loses three of them; recording it as four repeats the sentence four times. Which is right is a modelling decision."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate tmk:doesNotGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0047 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0015" ;
    tmk:isStale false ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:deb607cbc7ae6fd37a648887567b1d4002a2af161e5ab51e486bee19095a59a0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~1> ;
    tmk:spanEnd 1541 ;
    tmk:spanStart 1278 ;
    tmk:supportingText "However, the mere presence within a trade mark of a person's name, a descriptive term, a geographical place name or a reference to the size of packages or intended use of a product does not automatically demonstrate a connotation sufficient to trigger section 43." ;
    tmk:tier 3 .

tmka:GR-0016 a tmk:ApprovedAssertion ;
    rdfs:comment "Each of the three adjectives gets its own sub-section in Part 29.3. Whether they are three requirements or one composite standard is worth stating."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject tmkc:GC-0006 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0016" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:e910adb71eb7f1d52d06e37ed7b46dc618fcc4f6c6df770466fce554ec158e85" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~2> ;
    tmk:spanEnd 1214 ;
    tmk:spanStart 1086 ;
    tmk:supportingText "For a ground for rejection to be raised the connotation must be obvious, direct, and immediate and within the trade mark itself." ;
    tmk:tier 3 .

tmka:GR-0017 a tmk:ApprovedAssertion ;
    rdfs:comment "\"Will be important\" is not a modality the vocabulary has. Left null rather than mapped to the nearest of must/may/should."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0002 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0038 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0017" ;
    tmk:isStale false ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:e910adb71eb7f1d52d06e37ed7b46dc618fcc4f6c6df770466fce554ec158e85" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~2> ;
    tmk:spanEnd 188 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The prominence and context of the potentially deceptive or confusing element in the trade mark will be important in deciding whether the trade mark is likely to deceive or cause confusion." ;
    tmk:tier 2 .

tmka:GR-0018 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0008 ;
    tmk:assertionPredicate tmk:statesThresholdFor ;
    tmk:assertionSubject tmkc:GC-0006 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0018" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:20e9513b402bf082b2df83f8f7f0c9c9631b4ffbb949ecb0422e39cceb3341e8" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/1~1> ;
    tmk:spanEnd 139 ;
    tmk:spanStart 0 ;
    tmk:supportingText "There must be a real and obvious danger of the buying public being deceived and/or confused by the secondary meaning within the trade mark." ;
    tmk:tier 3 .

tmka:GR-0022 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0002 ;
    tmk:assertionPredicate tmk:constrainsExaminerTo ;
    tmk:assertionSubject tmkc:GC-0049 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0022" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:d222f7d371d8e06883804bb5b725e0a62be4d39b890ebdbb2fc9ecfcd28d0d16" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2> ;
    tmk:spanEnd 248 ;
    tmk:spanStart 91 ;
    tmk:supportingText "Each application must be considered as it stands in the current marketplace, not in the marketplace as it was in the past and not as it may be in the future." ;
    tmk:tier 3 .

tmka:GR-0023 a tmk:ApprovedAssertion ;
    rdfs:comment "Two unnumbered instrument references in one sentence, neither citable. See GE-0059 and GE-0060."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0049 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0023" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:d222f7d371d8e06883804bb5b725e0a62be4d39b890ebdbb2fc9ecfcd28d0d16" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2> ;
    tmk:spanEnd 425 ;
    tmk:spanStart 249 ;
    tmk:supportingText "A sign regarded as deceptive or confusing under the previous legislation may no longer have the same connotation and a ground for rejection may not apply under the current Act." ;
    tmk:tier 3 .

tmka:GR-0024 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0040 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0039 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0024" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:075c40b25607ef6a911a15b27e74937b83afcd489266936a56e4839208f9bb3b" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/4> ;
    tmk:spanEnd 216 ;
    tmk:spanStart 0 ;
    tmk:supportingText "In some cases a connotation giving rise to a section 43 ground for rejection may not be obvious during examination and will only emerge at opposition when the full facts of a case are available to the decision maker." ;
    tmk:tier 2 .

tmka:GR-0032 a tmk:ApprovedAssertion ;
    rdfs:comment "Subject and object are the wrong way round if `isOvercomeBy` reads as \"X is overcome by Y\". Left as written so the direction problem is visible on at least one record."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0006 ;
    tmk:assertionPredicate tmk:isOvercomeBy ;
    tmk:assertionSubject tmkc:GC-0013 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0032" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:86800dcce4d41f73e2792ad626162693402011f3c8ba4135bbf91f045f2a7b2f" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/4> ;
    tmk:spanEnd 1202 ;
    tmk:spanStart 1000 ;
    tmk:supportingText "A section 43 ground for rejection may be overcome by the applicant agreeing to a condition of registration limiting use of the trade mark to goods containing the substance indicated by the relevant INN." ;
    tmk:tier 3 .

