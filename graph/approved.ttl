        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/7> ;
    tmk:goldRecord "GC-0049" ;
    tmk:notLabel "priority date"@en-AU,
        "the marketplace as it was"@en-AU ;
    tmk:origin "approved" ;
    tmk:qualifies tmkc:GC-0001 ;
    tmk:reviewStatus "approved" .

tmkc:GC-0050 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The first not_label is quoted practice: reputation in another mark is an external consideration and expressly not the source of a connotation."@en-AU ;
    skos:altLabel "fame"@en-AU,
        "noted for"@en-AU,
        "well known for"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
