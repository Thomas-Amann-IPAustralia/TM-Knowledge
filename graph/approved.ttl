tmkc:GC-0052 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "\"State of the Register\" is a not_label because the Manual names it as a specific source in the INN-stem discussion, where it is evidence of common use rather than research into a fact."@en-AU ;
    skos:altLabel "informed by research"@en-AU,
        "research"@en-AU,
        "research indicates"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "examiner research"@en-AU ;
