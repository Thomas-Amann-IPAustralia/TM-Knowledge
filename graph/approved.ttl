        "confusion between trade marks"@en-AU,
        "deceptively similar"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0007 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The not_label is a live one: a passage quoted in 29.3.1 places the onus on the applicant, in the context of earlier legislation. Whether the two sit together is a legal question, not a drafting one."@en-AU ;
    skos:altLabel "presumption in favour of registrability"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "presumption of registrability"@en-AU ;
    skos:related tmkc:GC-0006 ;
