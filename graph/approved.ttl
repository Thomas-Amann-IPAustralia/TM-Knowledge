tmkp:PU-0002 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "eval" ;
    tmk:goldRecord "PU-0002" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "No section 43 ground arises here, so the application can proceed to acceptance." ;
    tmk:prohibitionKind "evaluative_conclusion" ;
    tmk:prohibitionReason "An assurance that no ground arises is an examination decision. It also speaks to grounds the system was never asked about — acceptance turns on every ground, not on section 43 alone."@en-AU ;
    tmk:reviewStatus "approved" .

tmkp:PU-0008 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "shacl" ;
    tmk:goldRecord "PU-0008" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "Because the mark closely resembles an earlier registered mark, a connotation arises that will deceive or confuse consumers." ;
    tmk:prohibitionKind "unsupported_inference" ;
    tmk:prohibitionReason "This reasons from a comparison between marks, which the Manual and the cited authority both put outside section 43. It is the most likely cross-contamination in the pilot, because Part 26 and Part 29 share almost all of their vocabulary."@en-AU ;
    tmk:reviewStatus "approved" .

tmkp:PU-0018 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "eval" ;
    tmk:goldRecord "PU-0018" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "Confusion under section 43 and confusion under section 44 are assessed the same way." ;
    tmk:prohibitionKind "ambiguity_collapse" ;
    tmk:prohibitionReason "One is confusion arising from a connotation within the mark; the other is confusion between the mark and another sign. The Manual keeps them apart expressly, and a distributional model will not."@en-AU ;
    tmk:reviewStatus "approved" .

tmkc:GC-0004 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "\"Caused to wonder\" comes from a passage quoted from a decision under earlier legislation. Whether it is a synonym or a test is a reading."@en-AU ;
    skos:altLabel "cause confusion"@en-AU,
        "caused to wonder"@en-AU,
        "confuse"@en-AU ;
    skos:broader tmkc:GC-0002 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "confusion"@en-AU ;
