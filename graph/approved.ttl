    tmk:notLabel "onus on the applicant"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0008 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The not_labels are both phrases the Manual uses to say what the test is *not*, which makes them unusually well-evidenced near-misses."@en-AU ;
    skos:altLabel "finite and non-trivial probability"@en-AU,
        "real and obvious danger"@en-AU,
        "real tangible danger"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "real and tangible danger"@en-AU ;
