tmkc:GC-0035 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Low confidence, and deliberately included at low confidence. The not_labels are the point: the owner of the phoneword and the owner of the trade mark are different roles that the same word names."@en-AU ;
    skos:altLabel "authorised user"@en-AU,
        "licensed owner or operator"@en-AU,
