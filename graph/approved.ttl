tmkc:GC-0011 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The not_labels matter: Part 29.9.7 says expressly that the connotation must come from the mark itself and not from external considerations such as reputation in another mark. So \"surrounding circumstances\" is admissible and \"external considerations\" is not, and the two phrases look alike."@en-AU ;
    skos:altLabel "all the surrounding circumstances"@en-AU,
        "relevant circumstances"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "surrounding circumstances"@en-AU ;
    skos:related tmkc:GC-0044 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:goldRecord "GC-0011" ;
    tmk:notLabel "external considerations"@en-AU,
        "reputation in another trade mark"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0015 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The second not_label is unsure: Part 12 discusses deleting goods and filing a divisional as related moves, and whether deletion is a limitation or something else is a practice question."@en-AU ;
