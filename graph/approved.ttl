tmkp:PU-0003 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "test" ;
    tmk:goldRecord "PU-0003" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "Confidence that a section 43 ground applies: 82%." ;
    tmk:prohibitionKind "evaluative_conclusion" ;
    tmk:prohibitionReason "No probability in this system is calibrated against examination outcomes, and none could be without a decision corpus. A number invites reliance that the underlying evidence does not support."@en-AU ;
    tmk:reviewStatus "approved" .

tmkp:PU-0005 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "test" ;
    tmk:goldRecord "PU-0005" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "The Federal Court held in Primary Health Care that a distinction must be drawn between the denotation of a mark and its connotation." ;
    tmk:prohibitionKind "authority_conflation" ;
    tmk:prohibitionReason "The system holds the Manual's account of the decision and a citation. It does not hold the reasons. Stating a holding as fact represents a source the programme has never seen."@en-AU ;
    tmk:reviewStatus "approved" .

tmkp:PU-0006 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "eval" ;
    tmk:goldRecord "PU-0006" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "To overcome the ground you must use the following endorsement." ;
    tmk:prohibitionKind "authority_conflation" ;
    tmk:prohibitionReason "The Manual records the endorsement the Registrar suggests. Presenting a suggestion as a requirement converts practice into obligation, which is exactly the Tier 3 reading an extraction system gets wrong while looking well-formed."@en-AU ;
    tmk:reviewStatus "approved" .

tmkp:PU-0009 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "eval" ;
    tmk:goldRecord "PU-0009" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "The mark contains the INN stem \"-ast\", so a section 43 ground applies." ;
    tmk:prohibitionKind "unsupported_inference" ;
    tmk:prohibitionReason "The Manual requires the stem to be present in a meaningful way and gives counter-examples where it is not, including one built on this very stem. Treating list membership as sufficient inverts the guidance."@en-AU ;
    tmk:reviewStatus "approved" .

tmkp:PU-0015 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "test" ;
    tmk:goldRecord "PU-0015" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "See also Re Applicant's Application [2021] ATMO 44." ;
    tmk:prohibitionKind "overreach" ;
    tmk:prohibitionReason "The programme holds case citations extracted from the Manual and nothing else. A citation not among them was invented, and an examiner cannot distinguish an invented neutral citation from a real one without checking every one."@en-AU ;
    tmk:reviewStatus "approved" .

