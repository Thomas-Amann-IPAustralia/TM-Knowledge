    rdfs:comment "GR-0007 and this record carry the same modality value for two different readings. If that is unacceptable, the vocabulary has to grow — and that is a decision, not a bug report."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0013 ;
    tmk:assertionPredicate tmk:isOvercomeBy ;
    tmk:assertionSubject tmkc:GC-0023 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0034" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:c4235ae85720f19a20037d7a4f5a41161ef68438cf8e1ea2d8e36b90b621b1bb" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/5> ;
    tmk:spanEnd 554 ;
    tmk:spanStart 350 ;
    tmk:supportingText "A section 43 ground for rejection may be overcome by the applicant agreeing to a condition of registration limiting use of the trade mark to goods containing substances belonging to the relevant INN stem." ;
    tmk:tier 3 .

tmka:GR-0035 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0023 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0024 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0035" ;
