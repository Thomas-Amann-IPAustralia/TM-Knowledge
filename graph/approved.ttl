        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s42>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:notLabel "amendment"@en-AU,
        "series application"@en-AU ;
