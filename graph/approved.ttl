        "misdescriptive"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkp:CQ-0001 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must state the statutory test in the words of s 43 and separately state the Manual's practice guidance, marked as practice rather than as law. Must convey that the section is mandatory in application while the threshold question — whether the decision maker is clearly satisfied — is an evaluative one."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "The Manual's own text quotes s 43 in full inside TMM/Part29/1#1, so an answer can appear to cite the Act while only having read the Manual. That is a grounding failure that will not show up as a missing source."@en-AU ;
    tmk:expectsConcept tmkc:GC-0001,
        tmkc:GC-0002,
        tmkc:GC-0006,
        tmkc:GC-0053 ;
    tmk:expectsConceptLabel "connotation"@en-AU,
        "ground for rejection"@en-AU,
        "likely to deceive or cause confusion"@en-AU ;
    tmk:goldRecord "CQ-0001" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "retrieval" ;
    tmk:questionText "What guidance does the Manual give on when a ground for rejection under section 43 should be raised?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~1> .

tmkp:CQ-0003 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must not answer yes or no. Must set out the criteria the Manual applies and state that the outcome depends on the specification and the surrounding circumstances, and must point to the route by which such a ground is overcome rather than leaving the applicant with a refusal."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "applicant" ;
    tmk:caveat "An answer that reads as advice on this applicant's mark has crossed from retrieval into an evaluative conclusion — see PU-0001."@en-AU ;
    tmk:expectsConcept tmkc:GC-0013,
        tmkc:GC-0017,
        tmkc:GC-0019 ;
    tmk:expectsConceptLabel "condition of registration"@en-AU,
        "geographical origin"@en-AU,
        "geographical reference"@en-AU ;
    tmk:goldRecord "CQ-0003" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "retrieval" ;
    tmk:questionText "My trade mark has a place name in it. Will that stop it being registered?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/4>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/5> .

tmkp:CQ-0004 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must state that the endorsement limiting use to goods containing the designated substance addresses the section 43 ground only, and must not imply that it disposes of a section 41 or section 44 ground."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "The Manual states this negatively — \"unlikely to assist in overcoming grounds… raised for other reasons\". A summariser will drop the negation."@en-AU ;
    tmk:expectsConcept tmkc:GC-0013,
        tmkc:GC-0022,
        tmkc:GC-0023 ;
    tmk:expectsConceptLabel "INN stem"@en-AU,
        "International Non-Proprietary Name"@en-AU,
        "condition of registration"@en-AU ;
    tmk:goldRecord "CQ-0004" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "retrieval" ;
    tmk:questionText "Where a trade mark contains an INN stem, what does the Manual say about raising section 43 alongside a ground under section 41 or section 44?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/4> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/5>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/6~1> .

tmkp:CQ-0005 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must reach Part 29.6 from a term Part 29.6 never uses. Ranking the deceased-persons material above the general material would be a wrong ordering rather than a wrong answer."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:expectsConcept tmkc:GC-0014,
        tmkc:GC-0026,
        tmkc:GC-0029,
        tmkc:GC-0100 ;
    tmk:expectsConceptLabel "endorsement"@en-AU,
        "well-known person"@en-AU,
        "written permission"@en-AU ;
    tmk:goldRecord "CQ-0005" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "search" ;
    tmk:questionText "Where do I find the practice on celebrity names in trade marks?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~2> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6/6/1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6/6/2~1> .

tmkp:CQ-0006 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must surface the permission route and the endorsement wording, and must make clear that the endorsement is the Registrar's suggested form of words rather than a statutory requirement."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "applicant" ;
    tmk:expectsConcept tmkc:GC-0014,
        tmkc:GC-0029,
        tmkc:GC-0100 ;
    tmk:expectsConceptLabel "endorsement"@en-AU,
        "written permission"@en-AU ;
    tmk:goldRecord "CQ-0006" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "search" ;
    tmk:questionText "Can I register a brand that uses a famous sportsperson's name if they have signed off on it?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~2> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~1> .

tmkp:CQ-0007 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must send the reader to section 44, and must say why section 43 is not the answer: a connotation arises from the mark itself, not from a comparison with another mark."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "applicant" ;
    tmk:caveat "This is the highest-frequency false positive in the pilot area. An answer that lands anywhere in Part 29.3 is wrong in a way that reads entirely plausibly."@en-AU ;
    tmk:expectsBoundaryLabel "deceptively similar"@en-AU ;
    tmk:expectsConcept tmkc:GC-0001 ;
    tmk:expectsConceptLabel "connotation"@en-AU,
        "deceptively similar"@en-AU ;
    tmk:goldRecord "CQ-0007" ;
    tmk:mustNotConclude tmkp:PU-0008,
        tmkp:PU-0018 ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "search" ;
    tmk:questionText "Confusion between my mark and someone else's — which section is that?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/3> ;
    tmk:testsBoundaryOf tmkc:GC-0001,
        tmkc:GC-0002,
        tmkc:GC-0004,
        tmkc:GC-0056,
        tmkc:GC-0058,
        tmkc:GC-0065,
        tmkc:GC-0080 .

tmkp:CQ-0008 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must distinguish the fact that a stem is listed from the conclusion that a ground arises, because the Manual makes the second turn on whether the stem appears in the mark in a meaningful way."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "The annex chunks carry no sentence context at all, so a retrieval system can return a correct hit that tells the reader nothing."@en-AU ;
    tmk:expectsConcept tmkc:GC-0023 ;
    tmk:expectsConceptLabel "INN stem"@en-AU ;
    tmk:goldRecord "CQ-0008" ;
    tmk:mustNotConclude tmkp:PU-0009 ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "search" ;
    tmk:questionText "Is \"-profen\" on the restricted list?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/2> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/6~1> .

tmkp:CQ-0009 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must present the criteria as a set that must all be met, must include the mitigating-elements criterion, and must not compress them into a single likelihood judgement."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:expectsConcept tmkc:GC-0010,
        tmkc:GC-0011,
        tmkc:GC-0017 ;
    tmk:expectsConceptLabel "average consumer"@en-AU,
        "geographical reference"@en-AU,
        "surrounding circumstances"@en-AU ;
    tmk:goldRecord "CQ-0009" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "reasoning" ;
    tmk:questionText "What has to be established before a standalone geographical reference in a trade mark is treated as likely to cause confusion?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/4> .

tmkp:CQ-0010 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must attribute the difference to the reasons the Manual gives, and must not offer a general rule about place names that the Manual does not state."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "Both examples are stated in the Manual with their outcomes. Answering from the citations alone is impossible — no decision text exists in the programme (Q-11)."@en-AU ;
    tmk:expectsConcept tmkc:GC-0019,
        tmkc:GC-0050,
        tmkc:GC-0130 ;
    tmk:expectsConceptLabel "geographical origin"@en-AU,
        "purchasing decision"@en-AU,
        "reputation"@en-AU ;
    tmk:goldRecord "CQ-0010" ;
    tmk:mustNotConclude tmkp:PU-0007 ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "reasoning" ;
    tmk:questionText "Why was no section 43 ground raised for BALI on bras, when one was raised for SHETLAND on clothing?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~2> .

tmkp:CQ-0011 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must answer in the negative and state the condition under which it does arise — a connotation directly contradicted by the specification. Must keep the two worked PLATYPUS examples distinguishable rather than merging them."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:expectsConcept tmkc:GC-0008,
        tmkc:GC-0012,
        tmkc:GC-0047,
        tmkc:GC-0129 ;
    tmk:expectsConceptLabel "descriptive matter"@en-AU,
        "real and tangible danger"@en-AU,
        "specification"@en-AU ;
    tmk:goldRecord "CQ-0011" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "reasoning" ;
    tmk:questionText "Does a descriptive term inside a trade mark trigger section 43 on its own?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/4%231> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/1~1> .

tmkp:CQ-0012 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must decline to reach the conclusion, must state the considerations the Manual says bear on it, and must surface the presumption of registrability — that where there is doubt a connotation exists, the ground should not be raised."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "This question is deliberately one the system must not answer. It is bounded by PU-0001 and PU-0004."@en-AU ;
    tmk:expectsConcept tmkc:GC-0007,
        tmkc:GC-0118 ;
    tmk:expectsConceptLabel "obvious, direct and immediate"@en-AU,
        "presumption of registrability"@en-AU ;
    tmk:goldRecord "CQ-0012" ;
    tmk:mustNotConclude tmkp:PU-0001,
        tmkp:PU-0002,
        tmkp:PU-0003 ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "reasoning" ;
    tmk:questionText "Is the connotation in this trade mark strong enough to warrant a ground for rejection?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~2> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> .

tmkp:CQ-0015 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must keep the currency of the Manual text and the currency of the market separate, and must not present one as evidence about the other."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "29.6 asks how well known a person is \"as at the priority date\", while 29.3.2 asks about the current marketplace. Whether those are the same moment is a legal reading, not a drafting inconsistency to be smoothed over."@en-AU ;
    tmk:expectsConcept tmkc:GC-0016,
        tmkc:GC-0049,
        tmkc:GC-0090 ;
    tmk:expectsConceptLabel "current marketplace"@en-AU,
        "priority date"@en-AU ;
    tmk:goldRecord "CQ-0015" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "currency" ;
    tmk:questionText "At what point in time is the marketplace assessed when deciding whether a sign is likely to deceive or cause confusion?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/4>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~2> .

tmkp:CQ-0017 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must reach beyond Part 29 into the Parts that apply s 43 to particular subject matter, and must distinguish material that states the ground from material that merely mentions it in a list."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "maintainer" ;
    tmk:caveat "Of the chunks citing the provision, some carry the edge only because upstream read a bare \"section 43\" out of prose and resolved it by convention. Those are inferences, not IP Australia's assertions (Q-07)."@en-AU ;
    tmk:expectsConcept tmkc:GC-0006,
        tmkc:GC-0053 ;
    tmk:expectsConceptLabel "ground for rejection"@en-AU ;
    tmk:goldRecord "CQ-0017" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "impact" ;
    tmk:questionText "If section 43 were amended, which parts of the Manual would need reviewing?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/2/4/2/4/1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/2/2%231> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/2%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/5/5/5>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/5/5/2> .

tmkp:CQ-0018 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must identify that the practice depends on an externally maintained list rather than on the Manual's own text, and must name the annex as a derived artefact that goes stale silently."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "maintainer" ;
    tmk:expectsConcept tmkc:GC-0022,
        tmkc:GC-0023 ;
    tmk:expectsConceptLabel "INN stem"@en-AU,
        "International Non-Proprietary Name"@en-AU ;
    tmk:goldRecord "CQ-0018" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "impact" ;
    tmk:questionText "The WHO has notified a new International Non-Proprietary Name. What in our practice material is affected?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/4> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/3>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/5> .

tmkp:CQ-0019 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must trace the dependency through passages that use the concept without citing the passage that defines it, and must not limit itself to passages that link."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "maintainer" ;
    tmk:caveat "Unresolvable internal references are dropped upstream rather than recorded (Q-08), so the absence of a link is not evidence of the absence of a dependency."@en-AU ;
    tmk:expectsConcept tmkc:GC-0001,
        tmkc:GC-0005 ;
    tmk:expectsConceptLabel "connotation"@en-AU,
        "denotation"@en-AU ;
    tmk:goldRecord "CQ-0019" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "impact" ;
    tmk:questionText "If the practice on connotation in Part 29.2 changed, what else would have to change with it?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/1~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~1> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/2/4/2/4/1> .

tmkp:CQ-0020 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must name the citation and the instrument, must state that the instrument is not held, and must not silently omit the citation from a list of authorities."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "maintainer" ;
    tmk:caveat "Q-24. Only two instruments are held, so every citation to an earlier Act is unresolvable by construction rather than by error."@en-AU ;
    tmk:expectsConceptLabel "superseded legislation"@en-AU ;
    tmk:goldRecord "CQ-0020" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "impact" ;
    tmk:questionText "Which citations in the section 43 material point at legislation we do not hold?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/1~2> ;
    tmk:reviewStatus "approved" .

tmkp:CQ-0021 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must give a passage-level citation, not a Part-level one, and must label each cited passage by authority type. An answer that cites \"Part 29\" has not answered."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "TMM/Part29/1#1 quotes s 43 in full, so a system can satisfy a citation check while never having opened the legislation."@en-AU ;
    tmk:goldRecord "CQ-0021" ;
    tmk:mustNotConclude tmkp:PU-0004 ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "provenance" ;
    tmk:questionText "Which exact passage does that statement come from, and is it the Act or the Manual?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:reviewStatus "approved" .

tmkp:CQ-0022 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must report the extraction method and, where the citation was inferred, the certainty attached to it — and must not present a `default` resolution as though IP Australia had named the instrument."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "maintainer" ;
    tmk:caveat "TMM/Part29/1#1 carries an authored link; TMM/Part29/10#1 carries a bare \"s43\" resolved by convention. The pair is the test."@en-AU ;
    tmk:goldRecord "CQ-0022" ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "provenance" ;
    tmk:questionText "Did the Manual's authors link that section themselves, or did we work it out from the wording?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/10%231> ;
    tmk:reviewStatus "approved" .

tmkp:CQ-0023 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must list the decisions at citation level and must state that the holdings are not held, rather than paraphrasing what the courts decided from the Manual's summary of them."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "The Manual's own characterisation of a decision is Manual text. Repeating it as though it were the decision is an authority conflation — PU-0002."@en-AU ;
    tmk:expectsConcept tmkc:GC-0001 ;
    tmk:expectsConceptLabel "connotation"@en-AU ;
    tmk:goldRecord "CQ-0023" ;
    tmk:mustNotConclude tmkp:PU-0005,
        tmkp:PU-0015 ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "provenance" ;
    tmk:questionText "Which decisions does the Manual rely on for the proposition that a connotation must arise from the mark itself?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/3> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3> .

tmkp:CQ-0024 a tmk:CompetencyQuestion ;
    tmk:answerShape "Must separate what the Act requires from what the Manual records as practice, including for the suggested endorsement wording, which is the Registrar's suggestion rather than a prescribed form."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:askedBy "examiner" ;
    tmk:caveat "The Manual states practice; it does not bind the Registrar's discretion and it is not legislation (Q-12). Every answer in the pilot has to keep that visible, and this question tests it directly."@en-AU ;
    tmk:expectsConcept tmkc:GC-0013,
        tmkc:GC-0014,
        tmkc:GC-0100 ;
    tmk:expectsConceptLabel "condition of registration"@en-AU,
        "endorsement"@en-AU ;
    tmk:goldRecord "CQ-0024" ;
    tmk:mustNotConclude tmkp:PU-0004,
        tmkp:PU-0006 ;
    tmk:origin "approved" ;
    tmk:pilotInScope true ;
    tmk:questionCategory "provenance" ;
    tmk:questionText "Is that a requirement, or is it how we usually do it?"@en-AU ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/4> ;
    tmk:reviewStatus "approved" ;
    tmk:supportingSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~2> .

tmkp:GA-0001 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0001" ;
    tmk:mustNotConclude tmkp:PU-0001,
        tmkp:PU-0004 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That \"obvious, direct and immediate\" is the Manual's formulation and not the section's words. That the section is mandatory in application but engages only where the decision maker is clearly satisfied. That the Manual states practice and does not bind the Registrar's discretion."@en-AU ;
    tmk:questionText "What is the test under section 43 and where does it come from?"@en-AU ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~2> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0003 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0003" ;
    tmk:mustNotConclude tmkp:PU-0001,
        tmkp:PU-0002,
        tmkp:PU-0003 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That the assessment is the decision maker's. That where there is doubt a connotation exists, the ground should not be raised. That the presumption of registrability applies to this section."@en-AU ;
    tmk:questionText "Is this connotation strong enough for a ground for rejection?"@en-AU ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(3)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~2> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0004 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0004" ;
    tmk:mustNotConclude tmkp:PU-0007 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That the criteria are cumulative. That the third — no other elements or surrounding circumstances mitigating the risk — is part of the test and not a footnote. That a qualifier such as \"made in\" is not necessary for a connotation to arise."@en-AU ;
    tmk:questionText "When does a place name in a mark cause confusion?"@en-AU ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0005 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0005" ;
    tmk:mustNotConclude tmkp:PU-0006 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That the wording is the endorsement the Registrar suggests, not a prescribed form. That the INN-stem endorsement differs from the INN endorsement in TMM/Part29/5/5/4 and the two are not interchangeable. That the endorsement addresses the section 43 ground only."@en-AU ;
    tmk:questionText "What endorsement is used where a mark contains an INN stem?"@en-AU ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/5> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0007 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0007" ;
    tmk:mustNotConclude tmkp:PU-0007 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That the answer is no, and that the criteria rather than the presence of the name decide it. That the Manual's examples are examples with stated reasons and not a rule. That an ambiguous or fanciful reference, or a word not seen as geographical, does not give rise to the ground."@en-AU ;
    tmk:questionText "Does a country name in a mark always need a limitation?"@en-AU ;
    tmk:requiresCase <https://data.ipaustralia.gov.au/tmk/ref/CASE/1968/HCA/72>,
        <https://data.ipaustralia.gov.au/tmk/ref/CASE/2003/ATMO/7> ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~2> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0009 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0009" ;
    tmk:mustNotConclude tmkp:PU-0005,
        tmkp:PU-0015 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That what is held is the Manual's quotation of the decisions, not the decisions. That the quotations are partial and edited by the Manual. That no decision text is available to check them against."@en-AU ;
    tmk:questionText "How have the courts treated the difference between denotation and connotation?"@en-AU ;
    tmk:requiresCase <https://data.ipaustralia.gov.au/tmk/ref/CASE/2010/ATMO/85>,
        <https://data.ipaustralia.gov.au/tmk/ref/CASE/2017/FCAFC/174> ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/1~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/1~2> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0010 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0010" ;
    tmk:mustNotConclude tmkp:PU-0004 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That the term is not defined in the Act. That the working meaning comes from ordinary dictionary definitions as expanded by decisions. That for section 43 the Manual gives it a wider meaning than the dictionary sense, including direct statements."@en-AU ;
    tmk:questionText "What does connotation mean for the purposes of section 43?"@en-AU ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/1~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/2> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0011 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0011" ;
    tmk:mustNotConclude tmkp:PU-0008,
        tmkp:PU-0018 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That the answer is no, and why: a connotation must arise from the mark itself. That comparisons between marks are dealt with under section 44 and in Part 26. That the qualification \"at least at the examination stage\" is part of the rule."@en-AU ;
    tmk:questionText "Two marks are similar and consumers may be confused. Is that section 43?"@en-AU ;
    tmk:requiresCase <https://data.ipaustralia.gov.au/tmk/ref/CASE/2000/FCA/720> ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/3> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0012 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0012" ;
    tmk:mustNotConclude tmkp:PU-0001 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That the mark as a whole is what is considered. That other features can diminish the impact rather than automatically cure it. That the Act contemplates a connotation arising from a sign contained in the mark, so the part and the whole are both operative."@en-AU ;
    tmk:questionText "Can other elements in the mark neutralise a problematic connotation?"@en-AU ;
    tmk:requiresCase <https://data.ipaustralia.gov.au/tmk/ref/CASE/2009/FCA/428> ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/5>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:reviewStatus "approved" .

tmkp:GA-0013 a tmk:RetrievalQuestion ;
    tmk:approvedBy "TC" ;
    tmk:authorityDistinctionRequired true ;
    tmk:goldRecord "GA-0013" ;
    tmk:mustNotConclude tmkp:PU-0001,
        tmkp:PU-0009 ;
    tmk:origin "approved" ;
    tmk:qualificationsExpected "That membership of the list is not sufficient. That the stem must be included in a meaningful way, and that the Manual gives factors and counter-examples for when it is not. That the goods must be pharmaceutical or veterinary for the practice to engage at all."@en-AU ;
    tmk:questionText "The mark contains letters that appear on the INN stem list. What follows?"@en-AU ;
    tmk:requiresCase <https://data.ipaustralia.gov.au/tmk/ref/CASE/2012/ATMO/117> ;
    tmk:requiresProvision <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:requiresSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/5>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/6~1> ;
    tmk:reviewStatus "approved" .

tmkp:GS-0003 a tmk:SearchQuestion ;
    tmk:approvedBy "TC" ;
    tmk:goldRecord "GS-0003" ;
    tmk:origin "approved" ;
    tmk:queryText "confusion with an existing registered trade mark"@en-AU ;
    tmk:relevantPassage tmkp:GS-0003-relevant-0,
        tmkp:GS-0003-relevant-1 ;
    tmk:reviewStatus "approved" ;
    tmk:temptingButIrrelevant <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/1~1> ;
    tmk:usesManualTerminology false .

tmkc:GC-0020 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The Manual's examples both contain place names, which is what makes this a genuine trap rather than a distinction on paper."@en-AU ;
    skos:altLabel "company name element"@en-AU,
        "trading name element"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "business identifier"@en-AU ;
    skos:related tmkc:GC-0017 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/6> ;
    tmk:goldRecord "GC-0020" ;
    tmk:notLabel "geographical origin"@en-AU,
        "geographical reference"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0021 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Whether \"made in\" and \"product of\" are labels for this concept or examples of it is a modelling choice, not a legal one — but it changes how the entity annotations attach."@en-AU ;
    skos:altLabel "made in"@en-AU,
        "product of"@en-AU,
        "qualifier"@en-AU,
        "qualifying information"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "geographical qualifier"@en-AU ;
    skos:related tmkc:GC-0017,
        tmkc:GC-0019 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:goldRecord "GC-0021" ;
    tmk:notLabel "standalone geographical reference"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0033 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Generic and country-code TLDs are treated differently by the Manual, so holding them as alt labels of one concept may be wrong."@en-AU ;
    skos:altLabel "TLD"@en-AU,
        "country-code TLD"@en-AU,
        "generic TLD"@en-AU ;
    skos:broader tmkc:GC-0032 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "top level domain"@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/8/8/1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/8/8/2> ;
    tmk:goldRecord "GC-0033" ;
    tmk:notLabel "second level domain"@en-AU,
        "subdomain"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0037 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Low confidence and high sensitivity. The labelling here should be checked against how the office actually speaks about this material, not just against the passage."@en-AU ;
    skos:altLabel "Aboriginal designed"@en-AU,
        "Indigenous connection"@en-AU,
        "reference to Indigenous people"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "claim to Indigenous origin"@en-AU ;
    skos:related tmkc:GC-0028 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/10%231> ;
    tmk:goldRecord "GC-0037" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:mayGiveRiseTo tmkc:GC-0006 ;
    tmk:notLabel "Indigenous applicant"@en-AU,
        "prescribed sign"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0039 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The first not_label is the most valuable one in this file: acquired distinctiveness is section 41 material and means something a system must never carry into section 43, but the two are described in almost identical words."@en-AU ;
    skos:altLabel "developed secondary meaning"@en-AU,
        "meaning acquired through use in a trade"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "connotation developed over time"@en-AU ;
    skos:related tmkc:GC-0001,
        tmkc:GC-0040 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/4> ;
    tmk:goldRecord "GC-0039" ;
    tmk:mayGiveRiseTo tmkc:GC-0040 ;
    tmk:notLabel "acquired distinctiveness"@en-AU,
        "reputation"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0042 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "On the edge of the pilot. It is here mainly because the not_label — revocation of *registration* — is a different thing under a different provision and the labels are one word apart."@en-AU ;
    skos:altLabel "revoke acceptance"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "revocation of acceptance"@en-AU ;
    skos:related tmkc:GC-0040 ;
