    tmk:reviewStatus "approved" ;
    tmk:sourceContentHash "sha256:d222f7d371d8e06883804bb5b725e0a62be4d39b890ebdbb2fc9ecfcd28d0d16" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2> ;
    tmk:spanEnd 531 ;
    tmk:spanStart 519 ;
    tmk:surface "10 years ago" .

tmka:GE-0062 a tmk:EntityMention ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GE-0062" ;
