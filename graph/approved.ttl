    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/4>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/4> ;
    tmk:goldRecord "GC-0046" ;
    tmk:notLabel "IP Australia"@en-AU,
        "examiner"@en-AU ;
    tmk:origin "approved" ;
