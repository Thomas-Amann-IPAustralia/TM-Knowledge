tmkc:GC-0002 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Whether this should be one concept or two is a real question. The Manual quotes Lord Denning distinguishing them sharply, then applies them as a single threshold. We have kept them together with the two narrower concepts underneath; splitting them is a defensible correction."@en-AU ;
    skos:altLabel "deceive or confuse"@en-AU,
        "deception or confusion"@en-AU,
        "likelihood of deception or confusion"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:narrower tmkc:GC-0003,
        tmkc:GC-0004 ;
    skos:prefLabel "likely to deceive or cause confusion"@en-AU ;
    skos:related tmkc:GC-0008 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~2> ;
    tmk:goldRecord "GC-0002" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:notLabel "deceptively similar"@en-AU,
        "likelihood of confusion between trade marks"@en-AU,
        "substantially identical"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

<https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/3> tmk:allocatesTo <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> .

