    tmk:assertionSubject tmkc:GC-0006 ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GR-0039" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "approved" ;
