        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/4%231> ;
    tmk:goldRecord "GC-0008" ;
    tmk:notLabel "actual probability of deception"@en-AU,
        "mere possibility of confusion"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0031 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The not_label is well evidenced: the Manual says other phone numbers that do not appear to represent a phoneword should not be queried."@en-AU ;
    skos:altLabel "SMS word"@en-AU,
        "alphabetic phone number"@en-AU,
        "phone word"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
