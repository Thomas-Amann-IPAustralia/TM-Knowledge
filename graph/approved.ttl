tmkc:GC-0022 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The first not_label is the whole difficulty of Part 29.5: an INN and an INN stem are governed by different rules and named almost identically."@en-AU ;
    skos:altLabel "INN"@en-AU,
        "generic name for a pharmaceutical substance"@en-AU,
        "notified INN"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "International Non-Proprietary Name"@en-AU ;
    skos:related tmkc:GC-0023,
        tmkc:GC-0025 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/1> ;
    tmk:goldRecord "GC-0022" ;
    tmk:notLabel "INN stem"@en-AU,
        "brand name"@en-AU,
        "trade mark"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0028 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The first not_label is a genuine collision inside one Part: an \"endorsement\" on a registration and an \"endorsement\" by a celebrity are unrelated ideas sharing a word, two screens apart."@en-AU ;
    skos:altLabel "connection with or approval of"@en-AU,
