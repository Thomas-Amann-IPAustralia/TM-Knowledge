    tmk:surface "the current Act" .

tmka:GE-0061 a tmk:EntityMention ;
    rdfs:comment "Arguably should not be annotated at all. If your rule is that only dates bearing on an application are annotated, deleting this record is the correction — and that rule is worth stating explicitly."@en-AU ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-09-02"^^xsd:date ;
    tmk:extractionMethod "expert_elicitation" ;
    tmk:goldRecord "GE-0061" ;
