    tmk:spanEnd 373 ;
    tmk:spanStart 192 ;
    tmk:supportingText "Some INN stems consist of simple two or three letter combinations and their presence in a larger word may not be meaningful and as a result would not lead to deception or confusion." ;
    tmk:tier 3 .

