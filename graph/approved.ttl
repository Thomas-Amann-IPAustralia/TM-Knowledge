    tmk:goldRecord "GC-0028" ;
    tmk:notLabel "endorsement"@en-AU,
        "written permission"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0029 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "\"Letter of consent\" is a not_label because it is a term of art used in the section 42 and section 44 material for a different mechanism."@en-AU ;
