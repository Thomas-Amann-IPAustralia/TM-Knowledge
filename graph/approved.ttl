    tmk:spanEnd 228 ;
    tmk:spanStart 49 ;
    tmk:supportingText "If a trade mark contains a name of a person (or group of people) which is well known in relation to the specified goods or services, the provisions of section 43 may be triggered." ;
    tmk:tier 3 .

tmka:GR-0039 a tmk:ApprovedAssertion ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:assertionObject tmkc:GC-0029 ;
