tmkp:PU-0007 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "eval" ;
    tmk:goldRecord "PU-0007" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "A trade mark containing the name of a country will attract a section 43 ground unless the specification is limited to goods from that country." ;
    tmk:prohibitionKind "unsupported_inference" ;
    tmk:prohibitionReason "The Manual sets criteria and gives examples on both sides — SHETLAND attracting a ground, BALI not. A general rule extracted from them discards the criteria that decided each one."@en-AU ;
    tmk:reviewStatus "approved" .

tmkc:GC-0026 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "\"Celebrity\" is an alt label on the strength of ordinary usage, not of the corpus — the Manual never uses the word. The not_labels point at Part 22 material, where a name is a distinctiveness question under section 41 rather than a connotation question."@en-AU ;
    skos:altLabel "celebrity"@en-AU,
        "person well known in relation to the goods or services"@en-AU,
        "well known person"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:narrower tmkc:GC-0027 ;
    skos:prefLabel "well-known person"@en-AU ;
    skos:related tmkc:GC-0028,
        tmkc:GC-0030 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~2> ;
    tmk:goldRecord "GC-0026" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:mayGiveRiseTo tmkc:GC-0006 ;
    tmk:notLabel "name of a person"@en-AU,
        "signature"@en-AU,
        "surname"@en-AU ;
    tmk:origin "approved" ;
    tmk:qualifies tmkc:GC-0028 ;
    tmk:reviewStatus "approved" .

tmkp:PU-0001 a tmk:ProhibitedUse ;
    tmk:approvedBy "TC" ;
    tmk:detectableBy "eval" ;
    tmk:goldRecord "PU-0001" ;
    tmk:origin "approved" ;
    tmk:prohibitedOutput "This trade mark should be rejected under section 43 because the connotation is likely to deceive or cause confusion." ;
    tmk:prohibitionKind "evaluative_conclusion" ;
    tmk:prohibitionReason "Whether a connotation exists and whether it is likely to deceive is the decision maker's evaluative judgement on the material before them. The Manual requires the decision maker to be clearly satisfied; a system that states the conclusion has substituted itself for that person."@en-AU ;
    tmk:reviewStatus "approved" .

tmkc:GC-0017 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The first not_label is the important one: every geographical indication is a geographical reference and the reverse is false, and the two terms are used within a few paragraphs of each other."@en-AU ;
    skos:altLabel "geographic reference"@en-AU,
        "place name"@en-AU,
        "reference to a geographical location"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:narrower tmkc:GC-0019 ;
    skos:prefLabel "geographical reference"@en-AU ;
    skos:related tmkc:GC-0018,
        tmkc:GC-0020 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:extendsTo tmkc:GC-0012 ;
    tmk:goldRecord "GC-0017" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:notLabel "business identifier"@en-AU,
        "geographical indication"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0023 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "\"Prefix\" and \"suffix\" are listed as not_labels because the Manual uses them to describe a stem's *position*, not as names for it — a stem can be a prefix, a suffix or an infix."@en-AU ;
    skos:altLabel "INN-stem"@en-AU,
        "common stem"@en-AU,
        "stem"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "INN stem"@en-AU ;
    skos:related tmkc:GC-0022,
        tmkc:GC-0024 ;
    tmk:approvedBy "TC" ;
    tmk:approvedDate "2026-08-25"^^xsd:date ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/2> ;
    tmk:goldRecord "GC-0023" ;
    tmk:isOvercomeBy tmkc:GC-0013 ;
    tmk:notLabel "International Non-Proprietary Name"@en-AU,
        "prefix"@en-AU,
        "suffix"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

tmkc:GC-0013 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Whether an endorsement is the record of a condition or a separate thing is exactly the sort of tacit distinction this exercise is trying to surface."@en-AU ;
    skos:altLabel "condition"@en-AU,
        "conditions or limitations"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "condition of registration"@en-AU ;
