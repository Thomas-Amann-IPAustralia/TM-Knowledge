        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/4> ;
    tmk:goldRecord "GC-0041" ;
    tmk:notLabel "research"@en-AU,
        "state of the Register"@en-AU ;
    tmk:origin "approved" ;
    tmk:reviewStatus "approved" .

