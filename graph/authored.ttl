    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual connects the examiner with considering a suggested restriction of the specification. It does not make the specification itself the source of a constraint on the examiner, so constrainsExaminerTo would overstate the relationship."@en-AU ;
    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether a more specific predicate is intended for an examiner's consideration of specification restrictions."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0107" ;
