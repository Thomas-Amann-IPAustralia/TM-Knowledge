tmka:GR-0573 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0119 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0038 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual requires consideration of the whole mark and connects significant additional material with possible prima facie capability. The composition of the whole mark therefore qualifies the assessment, rather than making a registrable component sufficient by itself."@en-AU ;
    tmk:confidence 9.5e-01 ;
    tmk:expertShouldCheck "Whether qualifies adequately captures the requirement to assess the mark in its entirety."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0573" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:1d0ca984f70e8f1f2cf8f7afea5c49ce03b0a429ef6b1590263e5b333dda94ee" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/8/8/5/1> ;
    tmk:spanEnd 739 ;
    tmk:spanStart 524 ;
    tmk:supportingText "However a trade mark must be considered in its entirety and if a trade mark containing an acronym also contains other material of a significant nature, the combination could be prima facie capable of distinguishing." ;
    tmk:tier 3 .

tmka:GR-0574 a tmk:AuthoredAssertion ;
