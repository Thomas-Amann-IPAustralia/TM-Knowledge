tmkc:GC-0168 a skos:Concept,
        tmk:GroundOfRefusal,
        tmk:LegalConcept ;
    rdfs:comment "The ground section 43 creates, held apart from the general idea of a ground for rejection (GC-0006), which until 2026-10-08 carried this ground under the general name — its alternative label 's 43 objection' and its section 43 basis said so. On the owner's ruling A2 the signed GC-0006 is the general concept and this one is the section 43 ground; edges whose sentence is about section 43 point here."@en-AU ;
    skos:altLabel "ground for rejection under section 43"@en-AU,
        "grounds for rejection under section 43"@en-AU,
        "s 43 ground for rejection"@en-AU,
        "s 43 objection"@en-AU,
        "section 43 grounds for rejection"@en-AU,
        "section 43 objection"@en-AU ;
    skos:broader tmkc:GC-0006 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "section 43 ground for rejection"@en-AU ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 43 creates one ground among the closed set the Act contains, and the Manual names it as 'a section 43 ground for rejection' throughout Part 29. The signed GC-0006 named the same ground under the general label; the owner confirmed that reading (A2), so the ground gets a concept of its own and GC-0006 keeps the general idea."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:expertShouldCheck "Whether the labels 'section 43 objection' and 's 43 objection' should sit here or on a separate 'objection' concept — the Manual uses objection and ground for rejection interchangeably (GC-0006's own note)."@en-AU ;
    tmk:goldRecord "GC-0168" ;
    tmk:isAssessedIn tmkc:GC-0092 ;
    tmk:isOvercomeBy tmkc:GC-0013,
        tmkc:GC-0015,
        tmkc:GC-0029 ;
