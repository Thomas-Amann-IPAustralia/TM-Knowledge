    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual identifies consumers within the relevant market as the reference point for the rejection ground. Read with the preceding mandatory-application statements, this qualifies when the absence of discretion operates."@en-AU ;
    tmk:confidence 7.7e-01 ;
    tmk:expertShouldCheck "Whether the relevant-market qualification should attach only to the likelihood test rather than directly to mandatory application."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0181" ;
    tmk:isStale false ;
    tmk:modality "should" ;
