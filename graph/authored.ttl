    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual connects potential deception or confusion with the appropriateness of section 43 grounds for rejection in the listed EU GI context. Its direction to consider that connection is practice guidance, not a legislative rule."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether the relationship needs an explicit restriction to the listed EU GI context."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
