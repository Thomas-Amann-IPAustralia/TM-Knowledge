    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9%231> ;
    tmk:spanEnd 671 ;
    tmk:spanStart 465 ;
    tmk:supportingText "A typical example is where a geographical reference connotes that the goods and/or services claimed are of a certain quality or standard, or exhibit attributes for which the geographical reference is known." ;
    tmk:tier 3 .

tmka:GR-0125 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0059 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0017 ;
