    tmk:supportingText "applicant, in relation to an application, means the person in whose name the application is for the time being proceeding." ;
    tmk:tier 3 .

tmka:GR-0692 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0181 ;
    tmk:assertionPredicate tmk:statesThresholdFor ;
    tmk:assertionSubject tmkc:GC-0058 ;
    tmk:authoredBy "claude-code-agent-S027" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Capable of distinguishing is the standard a trade mark must meet; the section 41 ground is made out when it does not."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Whether 'states the threshold for' reads naturally to an examiner for a test the mark must fail."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0692" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:d773c3e7dbd7a31ecaea7e73c57f760b2b86346c6ff576b9efa9fbe29b4adb62" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41> ;
    tmk:spanEnd 299 ;
    tmk:spanStart 4 ;
    tmk:supportingText "An application for the registration of a trade mark must be rejected if the trade mark is not capable of distinguishing the applicant’s goods or services in respect of which the trade mark is sought to be registered (the designated goods or services) from the goods or services of other persons." ;
    tmk:tier 3 .

tmka:GR-0693 a tmk:AuthoredAssertion ;
