    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "In its section 60 discussion, the Manual quotes the Registrar’s delegate as requiring the likelihood of confusion to depend on the opponent’s trade mark reputation. This relationship is confined to that context; it is not a general requirement of every deception or confusion test."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether the ontology can preserve the section 60 limitation, without implying that reputation is required under section 43."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0081" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:a2e55a9cce6fa9de49e06f308ec7c59533bfabdee8d9e7730083d061c47001c1" ;
