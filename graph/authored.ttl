    tmk:typedBy tmka:GT-0128 .

tmkc:GC-0156 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: An approved form is a form the Registrar has approved for use under the particular provision that requires it."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "approved form"@en-AU ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 6 expressly defines a provision-specific form approved by the Registrar, making this a distinct legal and procedural concept rather than a generic phrase. No existing concept captures that approval status. The Manual identifies regulation 21.1 as concerning compliance with instructions on approved forms and reports that regulation 21.25 requires an extension-of-time application to use an approved form. Instrument_or_record is the closest group because the concept concerns a form used in the process, not the act of filing it."@en-AU ;
    tmk:confidence 9.8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/approved-form> ;
    tmk:expertShouldCheck "Check the full text of the cited Regulations before adding detailed requirements; the supplied Manual passages only identify relevant provisions and report the requirement under regulation 21.25."@en-AU ;
    tmk:goldRecord "GC-0156" ;
    tmk:labelKey "approved form" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.25> ;
    tmk:notLabel "application for an extension of time"@en-AU,
        "declaration"@en-AU,
        "trade mark application"@en-AU ;
    tmk:notLabelKey "application for an extension of time",
        "declaration",
        "trade mark application" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "approved form" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/approved-form> ;
    tmk:typedBy tmka:GT-0156 .

tmkc:GC-0165 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: The Record of International Registrations is the record maintained by the Registrar under Part 17A containing prescribed particulars of international registrations designating Australia and protected international trade marks."@en-AU ;
    skos:altLabel "Record of International Registration"@en-AU,
        "Record of international registrations"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Record of International Registrations"@en-AU ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Regulation 17A.2 expressly identifies this as the record required by regulation 17A.66. The latter provision requires the Registrar to maintain it and specifies particulars for each notified IRDA and each protected international trade mark. It is therefore a distinct statutory record, not a generic phrase or a duplicate of GC-0089 Register of Trade Marks. Regulation 17A.2 also distinguishes it from the International Register maintained by the International Bureau."@en-AU ;
    tmk:confidence 9.9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.66> ;
    tmk:expertShouldCheck "Check whether the singular Manual form 'Record of International Registration' should be retained as an alternative label or treated as an editorial inconsistency."@en-AU ;
    tmk:goldRecord "GC-0165" ;
    tmk:labelKey "record of international registration" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.66> ;
    tmk:notLabel "International Register"@en-AU,
        "Register of Trade Marks"@en-AU,
        "international registration designating Australia"@en-AU,
        "international registration of a trade mark"@en-AU ;
    tmk:notLabelKey "international register",
        "international registration designating australia",
        "international registration of a trade mark",
        "register of trade mark" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "record of international registration" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.66> ;
    tmk:typedBy tmka:GT-0165 .

