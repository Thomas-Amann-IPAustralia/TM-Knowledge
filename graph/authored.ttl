    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part54/1/1/1> ;
    tmk:typedBy tmka:GT-0144 .

tmkc:GC-0149 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Summary, not a definition: Summary: This is a defined Madrid-system role associated with the holder, whose Office the Manual describes as the holder's \"home\" Office for presenting certain requests to the IB."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Contracting Party of the holder"@en-AU ;
    skos:related tmkc:GC-0113,
        tmkc:GC-0132 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Regulations expressly define this term by reference to the Madrid Regulations, making it a distinct legal concept rather than a generic phrase or a duplicate of the Madrid Protocol. The referenced substantive definition is unavailable in the supplied passages. The Manual explains the associated Office's procedural role in transmitting limitation and subsequent-designation requests; this supports process_role, while not equating the Contracting Party with its Office. No references were supplied under PROVISIONS, so legislative_basis is empty."@en-AU ;
    tmk:confidence 8.8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/contracting-party-of-the-holder> ;
    tmk:expertShouldCheck "Check Rule 1(xxvibis) of the Madrid Regulations for the substantive definition, which is not supplied, and confirm whether process_role is the best classification for the Contracting Party rather than its Office."@en-AU ;
    tmk:goldRecord "GC-0149" ;
    tmk:labelKey "contracting party of the holder" ;
    tmk:notLabel "Madrid Protocol"@en-AU,
        "Office of the Contracting Party of the holder"@en-AU,
