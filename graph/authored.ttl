    tmk:assertionSubject tmkc:GC-0119 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Not being prima facie capable of distinguishing is the threshold at which the section 41 ground is appropriate; threshold first, ground second."@en-AU ;
    tmk:confidence 7.5e-01 ;
    tmk:expertShouldCheck "Whether the threshold belongs to the section 41 ground alone; GC-0006 is the general concept."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0088" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:e4ce3e7118c5dfc0d4b120d6349f5570ff8ba92a135af19225b5f65221d8f5a1" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/15/15/13> ;
    tmk:spanEnd 1323 ;
    tmk:spanStart 1140 ;
    tmk:supportingText "The trade marks have some inherent adaptation to distinguish but they are not prima facie capable of distinguishing. In this instance a section 41 ground for rejection is appropriate." ;
    tmk:tier 3 .

tmka:GR-0089 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-08 by S026: subject GC-0006 -> GC-0168 — ground-for-rejection edges sorted between the general concept GC-0006 and the section 43 ground GC-0168 by whether the sentence is about section 43 (ruling A2). The judgement and evidence are the original author's."@en-AU ;
