    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:3016fc2af55085c99f6f508c674df732dbefbd36582932ac716f701313b98e1c" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~2> ;
    tmk:spanEnd 1072 ;
    tmk:spanStart 856 ;
    tmk:supportingText "The closer the link between the goods/services and the particular field in which the name is well-known, the more likely that consumers will assume that use of the trade mark is associated with the well-known person." ;
    tmk:tier 3 .

