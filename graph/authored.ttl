    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The section 41 note reproduced in the Manual expressly identifies geographical origin as something a sign may indicate. No listed specific predicate captures that indicative relationship; geographical origin itself is not a sign."@en-AU ;
    tmk:confidence 9.7e-01 ;
    tmk:expertShouldCheck "Whether a more specific predicate for 'indicates' should be added to the ontology."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0127" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ee2c68417e69415114259b277a220f8a15008a9a754251fd8f9b9787107cffe7" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/6/6/1> ;
    tmk:spanEnd 523 ;
    tmk:spanStart 132 ;
    tmk:supportingText "Note 1: Trade marks that are not [to any extent] inherently adapted to distinguish goods or services are mostly trade marks that consist wholly of a sign that is ordinarily used to indicate: a. the kind, quality, quantity, intended purpose, value, geographical origin, or some other characteristic, of goods or services; or b. the time of production of goods or of the rendering of services." ;
    tmk:tier 2 .

