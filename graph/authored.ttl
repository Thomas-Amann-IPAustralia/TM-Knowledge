    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "A person ends an application, notice or request by giving notice in writing. A transition, and one somebody performs."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Withdrawal is distinct from lapsing precisely in that somebody does it. That is the distinction GT-0098 puts under strain, and the two records should be read together."@en-AU ;
