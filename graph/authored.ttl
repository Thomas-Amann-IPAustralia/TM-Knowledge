    tmk:spanEnd 877 ;
    tmk:spanStart 647 ;
    tmk:supportingText "When the IB notifies IP Australia that ownership of a certification IRDA or protected international trade mark has been changed, the consent of the ACCC to that change must be gained before the change can have effect in Australia." ;
    tmk:tier 3 .

tmka:GR-0362 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0108 ;
