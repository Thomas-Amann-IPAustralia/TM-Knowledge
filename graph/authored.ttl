    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part30/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part30/3%231> ;
    tmk:expertShouldCheck "Whether the ground reaches use that would be contrary to law only in some circumstances. The Manual's annexes suggest practice draws that line, and this record does not carry it."@en-AU ;
