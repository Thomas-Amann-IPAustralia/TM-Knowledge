    tmk:spanEnd 637 ;
    tmk:spanStart 439 ;
    tmk:supportingText "If, having regard to the evidence and the circumstances, an examiner is satisfied it is proper for the application to be accepted, then it is appropriate to exercise the discretion under s 44(3)(b)." ;
    tmk:tier 3 .

tmka:GR-0232 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0064 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0071 ;
