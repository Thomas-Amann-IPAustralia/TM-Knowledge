    tmk:sourceContentHash "sha256:be7ebe89c273e99bd6bdd4f0a39584903353c1236cad36f992403c53c447dcc8" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/2%231> ;
    tmk:spanEnd 1594 ;
    tmk:spanStart 1451 ;
    tmk:supportingText "(iii) In considering whether there is a likelihood of deception or confusion all surrounding circumstances have to be taken into consideration." ;
    tmk:tier 3 .

tmka:GR-0103 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0004 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0011 ;
