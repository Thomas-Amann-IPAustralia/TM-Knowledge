tmkc:GC-0098 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Automatic on the expiry of the acceptance period, so it is not a decision anybody makes. That is what separates it from rejection and from withdrawal."@en-AU ;
    skos:altLabel "lapse"@en-AU,
        "lapses"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "lapsing of an application"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual quotes the statutory effect. Held because the vocabulary needs a way to say an application ended without anybody deciding anything."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part16/1/1/1> ;
