    tmk:supportingText "If a trade mark is within its 6 month grace period (as per section 79) in which the registration has expired however renewal may be requested, a claimed interest may be recorded in the database, however this will only be entered in the Register if the trade mark is renewed." ;
    tmk:tier 2 .

tmka:GR-0272 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0084 ;
