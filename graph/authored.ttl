    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/2/2%231> ;
    tmk:spanEnd 309 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Paragraph 39(2)(a) of the Trade Marks Act states that a trade mark may be rejected if it contains or consists of a sign that is prescribed in the regulations for the purposes of section 39(2), OR is a sign so nearly resembling the prescribed sign as to be likely to be taken for it (subparagraph 39(2)(b)(i))." ;
    tmk:tier 3 .

