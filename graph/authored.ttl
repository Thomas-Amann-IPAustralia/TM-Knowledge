    tmk:authoringReasoning "The Manual expressly describes assignment of certification trade marks and the processes for recording it. This supports assignment applying to certification trade marks, subject to additional recording requirements."@en-AU ;
    tmk:confidence 9.4e-01 ;
    tmk:expertShouldCheck "Whether appliesTo is intended to cover procedural steps as well as statutory provisions."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0273" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:7e550cd0f187d6e623016fae142da9fcbea467b6e756951dd00e6dd45535b910" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part43/6%231> ;
    tmk:spanEnd 225 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The assignment of a certification trade mark follows the same processes as that of a partial assignment or a full assignment. However additional requirements apply for the recording of assignment of certification trade marks." ;
    tmk:tier 3 .

tmka:GR-0274 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0108 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0107 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual expressly contrasts certification and collective trade marks by their assignability. No listed predicate captures that contrast more specifically; this does not establish that either category is a kind of the other."@en-AU ;
    tmk:confidence 7.6e-01 ;
    tmk:expertShouldCheck "Whether an express contrast in assignability warrants related_to rather than none in this ontology."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0274" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:2467c10042049ddf4a49fb1f0994d37ef4ba385d613b45622dbbe8d959a9f4e5" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part43/4%231~1> ;
    tmk:spanEnd 1354 ;
    tmk:spanStart 1035 ;
    tmk:supportingText "Collective trade marks cannot be assigned (section 166) and therefore no details of the assignment are to be entered on the database. The applicant for the assignment should be advised that the recordal of assignment cannot proceed. Certification trade marks can be assigned and follow the usual process for assignment." ;
    tmk:tier 2 .

tmka:GR-0275 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0107 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0084 ;
