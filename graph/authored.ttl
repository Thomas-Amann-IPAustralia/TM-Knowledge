    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "A divisional application's priority date is its parent's filing date, unless the convention claim is made again."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether the sentence states this relationship, read the way the predicate reads."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0254" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:0844d76c717898594da741660eaabf8b3031c217bede52bb2156955ca12c2e73" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/5%231> ;
    tmk:spanEnd 464 ;
    tmk:spanStart 147 ;
    tmk:supportingText "A divisional application will have the filing date of its parent application as the priority date, unless the convention priority claim of the parent is also made when filing the divisional application or within the period provided for in regulation 4.5, that is, within two working days after filing the application." ;
    tmk:tier 3 .

