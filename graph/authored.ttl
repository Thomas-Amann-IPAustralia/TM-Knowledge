tmka:GR-0180 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0004 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0047 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual's quoted reasoning treats descriptive matter as qualifying the treatment of confusion risk in comparing marks. It permits some discounting or acceptance of risk while expressly rejecting complete exclusion of descriptive elements."@en-AU ;
    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether qualifies adequately captures acceptance of confusion risk without implying that descriptive matter is disregarded."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0180" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:8979210fe6d20ce40fa188a45baaafae229763daacc2a91e563380480d2e6fcb" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/6/6/7~2> ;
    tmk:spanEnd 1216 ;
    tmk:spanStart 932 ;
    tmk:supportingText "A descriptive element within a trade mark may be to some extent discounted in a comparison (or to paraphrase Hornsby, a certain risk of confusion due to the presence of that element may be accepted), but those descriptive elements cannot be entirely ignored in the overall comparison." ;
    tmk:tier 3 .

