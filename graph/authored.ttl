tmka:GR-0204 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0063 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0056 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The statutory wording reproduced in the Manual supports nearly resembling defence emblems as a potential basis for unlawful use, subject to the stated membership and written-authority conditions. The connection to the general use-contrary-to-law ground is inferred rather than expressly stated for this example."@en-AU ;
    tmk:confidence 8.6e-01 ;
    tmk:expertShouldCheck "Whether the anchor encompasses the 'capable of being mistaken' test as well as the section 39 'likely to be taken for' test."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0204" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:9100e3e74a461dfe30b3ea55590d9bfb40c46275ebf4392b5b84dc6ae31c35c0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part30/3/3/5/5~1> ;
    tmk:spanEnd 2154 ;
    tmk:spanStart 1768 ;
    tmk:supportingText "Under section 83(1) \"a person who is not a member of the Defence Force is guilty of an offence if: (a) the person uses or wears a defence emblem or an emblem so nearly resembling a defence emblem as to be capable of being mistaken for such an emblem; and (b) the person does not have the written authority of the Minister, or of a person authorised in writing by the Minister to do so.\"" ;
    tmk:tier 3 .

tmka:GR-0206 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-08 by S026: subject GC-0101 -> GC-0041 — an authored duplicate withdrawn in favour of the signed concept (ruling A1, ADR-0080 c2). The judgement and evidence are the original author's. Re-read on 2026-10-09 in the structure review (ADR-0131): was GC-0041 related GC-0058."@en-AU ;
    tmk:assertionObject tmkc:GC-0058 ;
