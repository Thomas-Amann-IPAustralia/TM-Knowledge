    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "It is the subject matter the whole scheme operates on, not a ground, a test, a factor or an exception. Typing it into one of the four would misdescribe it, and none_of_these is an answer rather than a gap."@en-AU ;
    tmk:conceptGroup "none_of_these" ;
    tmk:confidence 7e-01 ;
    tmk:expertShouldCheck "Whether the taxonomy is meant to cover subject-matter concepts at all. Several records in this pass came out none_of_these for this reason."@en-AU ;
    tmk:goldRecord "GT-0072" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s17> .

