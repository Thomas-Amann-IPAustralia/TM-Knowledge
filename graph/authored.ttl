    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual says it allows acceptance where the application would otherwise be rejected. That is taking a case out of the rule."@en-AU ;
    tmk:conceptGroup "exception" ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Nothing specific."@en-AU ;
    tmk:goldRecord "GT-0068" ;
