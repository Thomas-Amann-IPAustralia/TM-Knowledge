tmka:GT-0069 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "It is neither a ground, nor a question the decision maker answers, nor material feeding one, nor something taking a case out of a rule — it is the form an acceptance can take. none_of_these is an answer, and this is one of the places the four groups genuinely do not reach."@en-AU ;
    tmk:conceptGroup "none_of_these" ;
    tmk:confidence 6e-01 ;
    tmk:expertShouldCheck "This is a good test of whether the taxonomy needs a fifth group for remedies and outcomes. Several records in this pass fall the same way."@en-AU ;
    tmk:goldRecord "GT-0069" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> .

tmka:GT-0070 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "Section 44 cannot be answered without answering this, and section 14 gives the test for answering it. That makes it a question the decision maker has to answer rather than material feeding one."@en-AU ;
    tmk:conceptGroup "legal_test" ;
    tmk:confidence 7e-01 ;
    tmk:expertShouldCheck "The Manual's 'considered together with' language cuts towards factor; the statutory definition cuts towards test. This record follows the statute."@en-AU ;
    tmk:goldRecord "GT-0070" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/4%231> .

