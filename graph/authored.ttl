    tmk:notLabelKey "date of registration",
        "priority date" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "filing date" ;
    tmk:qualifies tmkc:GC-0041,
        tmkc:GC-0106,
        tmkc:GC-0111 ;
