    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual describes section 84B as mandating revocation in the specified circumstances where registration has overlooked an opposition component or an extension application. Opposition alone is not sufficient; the relationship is conditional on the stated registration error and timing."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether mayGiveRiseTo adequately represents a mandatory consequence once the stated conditions are met."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0161" ;
