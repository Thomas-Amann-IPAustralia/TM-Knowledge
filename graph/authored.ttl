    tmk:typedBy tmka:GT-0090 .

tmkc:GC-0094 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Available where information received after acceptance indicates the mark should not have been accepted. Distinct from revocation of registration under sections 84A to 84D, which the Manual gives a separate Part. GC-0042 already holds this term."@en-AU ;
    skos:altLabel "revoke acceptance"@en-AU ;
