tmkc:GC-0104 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "The Manual grounds it in section 17: use is inherent in what a trade mark is, so a mark that is not used may be removed. The onus sits on the opponent once the application is opposed, which is unusual and worth carrying."@en-AU ;
    skos:altLabel "non-use removal"@en-AU,
        "removal of a trade mark from the Register for non-use"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "removal for non-use"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Stated in terms, with the section 17 rationale in the same passage — which is what ties this concept back to 'use of a trade mark' rather than leaving it as free-standing procedure."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part48/1%231> ;
    tmk:expertShouldCheck "Whether the onus point should be a relationship record rather than a note."@en-AU ;
    tmk:goldRecord "GC-0104" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s17>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92> ;
    tmk:notLabel "cancellation of registration"@en-AU,
        "rectification of the Register"@en-AU,
        "revocation of registration"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part48/1%231> ;
    tmk:typedBy tmka:GT-0104 .

tmkc:GC-0109 a skos:Concept,
        tmk:LegalConcept,
        tmk:SubjectMatter ;
    rdfs:comment "Requires an existing registration and a reputation extensive enough that use on other goods would be taken to indicate a connection. It is the one registration in the Act that does not require an intention to use."@en-AU ;
    skos:altLabel "defensive registration"@en-AU,
        "defensive trade marks"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "defensive trade mark"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The passage states the qualifying condition, though in the past tense about the 1955 Act. The record is honest about that: the evidence is historical framing of a requirement the Manual carries forward, which is weaker than a current statement."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/1/1/1> ;
    tmk:expertShouldCheck "The evidence is a sentence about the 1955 Act. If Part 34 states the current requirement elsewhere, that passage should replace this one."@en-AU ;
    tmk:goldRecord "GC-0109" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s185>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/defensive-trade-mark> ;
    tmk:notLabel "certification trade mark"@en-AU,
        "collective trade mark"@en-AU,
        "registered trade mark"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/1/1/1> ;
    tmk:typedBy tmka:GT-0109 .

tmkc:GC-0123 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Available at any time while the thing withdrawn is still being considered, and the Registrar must publish it. Distinct from lapsing, which happens without anybody doing anything."@en-AU ;
    skos:altLabel "notice of withdrawal"@en-AU,
