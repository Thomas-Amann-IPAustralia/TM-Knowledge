    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual supports a conditional connection between resemblance to a listed EU GI and a possible section 43 ground for rejection. The relationship is inferred because resemblance and potentially deceptive or confusing use, rather than GI status alone, are the relevant circumstances."@en-AU ;
    tmk:confidence 9.1e-01 ;
    tmk:expertShouldCheck "Whether mayGiveRiseTo adequately preserves the intervening conditions of resemblance and potentially deceptive or confusing use."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0412" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:4c484f11bb81ae9e0b8453152cd0145a12d14fa09ab434e1c68288097f23886a" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/11%231> ;
    tmk:spanEnd 696 ;
    tmk:spanStart 384 ;
    tmk:supportingText "If during examination of a new application research reveals that a trade mark is identical or similar to a listed EU GI, consideration should then be given to whether or not the use of the trade mark would potentially deceive or confuse Australian consumers and make grounds for rejection under s 43 appropriate." ;
    tmk:tier 3 .

