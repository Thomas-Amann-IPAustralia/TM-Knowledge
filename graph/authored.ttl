tmka:GR-0469 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0003 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0049 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual requires deception to be assessed in the current marketplace rather than against past or hypothetical future conditions. This supports treating the current marketplace as qualifying the assessment of deception, not as causing deception."@en-AU ;
    tmk:confidence 9.2e-01 ;
    tmk:expertShouldCheck "Whether qualifies should target the assessment of deception rather than the deception concept itself."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
