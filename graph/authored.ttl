    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part6/1/1/2> ;
    tmk:spanEnd 759 ;
    tmk:spanStart 623 ;
    tmk:supportingText "Where an expedited application has a citation against it, the cited application, if it is not already being examined, will be expedited." ;
    tmk:tier 3 .

tmka:GR-0310 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0128 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0127 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects making a decision with hearing one or both parties, while also allowing a decision on the written record. No listed, more specific predicate captures that procedural relationship without adding a causal or mandatory element."@en-AU ;
    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether 'hearing one or both parties' denotes the procedural hearing concept recorded by the anchor."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0310" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:369fb740c40f02298288472041b52f65f86e5e44fdfde3f4aae66bdff1b2c16b" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part49/6/6/1> ;
    tmk:spanEnd 454 ;
    tmk:spanStart 370 ;
    tmk:supportingText "The decision may be made after hearing one or both parties or on the written record." ;
    tmk:tier 2 .

tmka:GR-0311 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0102 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0128 ;
