tmka:GT-0128 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "A proceeding. Section 33(4) makes an opportunity to be heard a precondition of rejection, which ties hearings to examination and not to opposition alone."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether a hearing is a step inside the examination process or a process beside it. Section 33(4) suggests one answer and Part 51 arguably another."@en-AU ;
    tmk:goldRecord "GT-0128" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> .

tmka:GT-0129 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "What the applicant claims, as written in the application. A part of the document, and the part amendment operates on."@en-AU ;
    tmk:conceptGroup "instrument_or_record" ;
    tmk:confidence 7e-01 ;
    tmk:expertShouldCheck "Whether specification, classification and the goods themselves are three concepts or one thing with three aspects. They are typed into three different groups by this pass, which is a strong claim and rests on a thin argument."@en-AU ;
    tmk:goldRecord "GT-0129" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part27/1%231> .

