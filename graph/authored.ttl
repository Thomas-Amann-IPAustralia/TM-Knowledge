    tmk:sourceContentHash "sha256:9406c7d3659f50cebafa4383dc3e816f2383b5aef6d6a886a11257a7517ab0c0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/3/3/3~1> ;
    tmk:spanEnd 261 ;
    tmk:spanStart 0 ;
    tmk:supportingText "If a divisional application is considered valid, section 46(2) requires the Registrar to, unless the parent application has since lapsed, amend the parent application by excluding the goods and/or services in respect of which the divisional application is made." ;
    tmk:tier 3 .

tmka:GR-0171 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-judged on 2026-10-08 by S026 under the owner's ruling C4 (review/rulings/2026-10-08-chat-ontology-review.yaml). The evidence is the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0045 ;
    tmk:assertionPredicate tmk:constrainsRole ;
    tmk:assertionSubject tmkc:GC-0051 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The mandatory application of section 43 binds the decision maker: no discretion to accept a mark caught by it."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Nothing in the reading."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0171" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:b6690f96b0ebc5181ac9b42c2669b0de831371538a8cc414e94d5e54796ceeff" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:spanEnd 777 ;
    tmk:spanStart 435 ;
    tmk:supportingText "There is, therefore, no discretion to accept a trade mark that is caught by the provisions of this section. However for a trade mark to be caught by these provisions it is necessary for a decision maker to be clearly satisfied that use of the trade mark for the specified goods and / or services would be likely to deceive or cause confusion." ;
    tmk:tier 3 .

tmka:GR-0172 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0127 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0045 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The passage identifies the Registrar as an administrative decision maker and describes a determination that the Registrar may make. This supports an actor–decision relationship, but does not expressly identify a written decision instrument."@en-AU ;
    tmk:confidence 7.6e-01 ;
    tmk:expertShouldCheck "Whether GC-0127 includes determinations generally or only formal decision records."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0172" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ead98ad86ebc658bd8bb8ec256f6b1265c329ca7806d9126c529498d08e6bc4c" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part2/3/2/3/2> ;
    tmk:spanEnd 1628 ;
    tmk:spanStart 1209 ;
    tmk:supportingText "However, if the Registrar becomes aware that an application has been or may have been filed in the name of a person who has not authorised the filing, the Registrar may decide that the application does not meet minimum filing requirements unless and until further information is provided that the person named as the applicant did in fact file the application or authorise the filing of the application on their behalf." ;
    tmk:tier 2 .

tmka:GR-0173 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0047 ;
    tmk:assertionPredicate skos:related ;
