    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly describes Indigenous-origin material as capable of forming a connotation that misleads consumers about the source's Indigenous connection. It identifies a possible source of deception, not a necessary element of deception generally."@en-AU ;
    tmk:confidence 9.8e-01 ;
    tmk:expertShouldCheck "Whether the neighbour covers all Indigenous-connection references described, rather than only express claims of origin."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0086" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:7790025faf8751ea416943459edd4d4cc890374c4fc86f400a1ff604c9dd376e" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/10%231> ;
    tmk:spanEnd 618 ;
    tmk:spanStart 389 ;
    tmk:supportingText "This type of material can form a connotation within a trade mark which would lead consumers into being misled into thinking that the goods or services bearing the applicant’s mark come from a source with an Indigenous connection." ;
    tmk:tier 3 .

