    tmk:supportingText "a significant number or a significant sector of relevant Australian consumers would know that use of the deceased person’s name/image is associated with their estate (or other authorised entity);" ;
    tmk:tier 2 .

tmka:GR-0097 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0009 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0045 ;
    tmk:authoredBy "gpt-6.1-sol" ;
