tmka:GR-0396 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-09 by S027: object GC-0006 -> GC-0181 — ground-for-rejection edges whose sentence is about section 41 point at that section's ground (ruling B4). The judgement and evidence are the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0181 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0038 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects applicability of the section 41(4) ground with the character of the trade mark as a whole. I infer that whole-mark assessment qualifies the applicability of the ground; this is not stated as a general rule for all grounds."@en-AU ;
    tmk:confidence 7.8e-01 ;
    tmk:expertShouldCheck "Whether the whole-mark statement supplies a qualifying assessment or merely explains the preceding conclusion."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0396" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
