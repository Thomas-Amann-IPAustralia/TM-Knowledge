tmka:GT-0116 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "Section 6 defines the applicant as the person in whose name the application stands for the time being. A party — and one whose identity can change without the application changing, which is only sayable if it is a role."@en-AU ;
    tmk:conceptGroup "process_role" ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Nothing about the group. What is worth checking is the concept: Part 10 treats getting the applicant's identity right as a substantive matter, and a bare role typing does not carry that weight."@en-AU ;
