tmkc:GC-0127 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "The Manual's Part 52 opens by listing what gets decided — oppositions to registration, to removal for non-use, to procedural matters — and section 205 makes a Deputy Registrar's decision the Registrar's. Relabelled on 2026-10-08 (review E3): the bare label 'decision' matched 178 passages, most of them ordinary uses; the concept is the decision the Registrar or a delegate makes."@en-AU ;
    skos:altLabel "decision of the Registrar"@en-AU,
        "decisions of the Registrar"@en-AU,
        "delegate's decision"@en-AU,
        "written decision"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Registrar's decision"@en-AU ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The record's own evidence (Part 52.1) is about a decision made by the Registrar or the Registrar's delegate; the label now says so. Relabelled on the owner's ruling E3."@en-AU ;
    tmk:confidence 6e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part52/1%231~1> ;
    tmk:expertShouldCheck "This record's evidence does not define a decision. Either Part 52 defines it somewhere this pass did not reach, or the record should be redrawn or dropped."@en-AU ;
    tmk:goldRecord "GC-0127" ;
    tmk:labelKey "decision of the registrar",
        "delegate decision",
        "registrar decision",
        "written decision" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s35> ;
    tmk:notLabel "adverse report"@en-AU,
