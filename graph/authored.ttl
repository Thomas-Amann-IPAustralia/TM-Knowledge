tmka:GR-0126 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0017 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0011 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "Under the Manual's assessment, surrounding circumstances can mitigate the risk of confusion associated with a standalone geographical reference. The relationship qualifies the reference's potentially confusing effect; it does not establish that surrounding circumstances invariably overcome a ground for rejection."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether qualifies should target confusion rather than the geographical reference itself."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0126" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:67e2721f9a84ad01289f7b3ee6a65ec86e7be0a016c468e3eb7c3094b6166356" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:spanEnd 723 ;
    tmk:spanStart 250 ;
    tmk:supportingText "A trade mark containing a standalone geographical reference will cause confusion if each of the following criteria are met: Consumers would have reason to associate the goods/services with the geographical location; The association between the place and the goods/services would influence the purchasing decision of an average consumer of the goods/services. There are no other elements in the mark, or surrounding circumstances, which would mitigate the risk of confusion." ;
    tmk:tier 3 .

tmka:GR-0127 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0019 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0073 ;
