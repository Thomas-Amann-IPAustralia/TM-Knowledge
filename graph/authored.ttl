    tmk:spanEnd 179 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Subsection 39(2) relates to trade marks that may be rejected because they contain or consist of any of the signs prescribed in regulation 4.15 for the purposes of this subsection." ;
    tmk:tier 2 .

tmka:GR-0198 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-09 by S027: object GC-0006 -> GC-0182 — ground-for-rejection edges whose sentence is about section 39 point at that section's ground (ruling B4). The judgement and evidence are the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0182 ;
