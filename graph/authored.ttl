tmkc:GC-0132 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Summary, not a definition: Summary: In the international-registration examination context, the holder is the party to whom examination reports are directed and who responds to those reports. Relabelled on 2026-10-08 (review E3): the Manual's 'holder' is almost always this one (about 65 of 71 passages); the not-labels veto the rest — copyright holder, title holder, interest holder."@en-AU ;
    skos:altLabel "IRDA holder"@en-AU,
        "holder"@en-AU,
        "holder of the international registration"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "holder of an international registration"@en-AU ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "Regulation 17A.2 defines the holder in relation to an international registration, and the Manual uses the bare word in that sense in nearly every passage. The preferred label now names the sense; 'holder' stays as an alternative because the Manual uses it so, and the not-labels veto the ordinary uses (owner's rulings E2 and E3)."@en-AU ;
    tmk:confidence 8.4e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part27/x-relevant-legislation26%231> ;
    tmk:expertShouldCheck "Check the complete definition in regulation 17A.2: the supplied statutory passage stops at ‘holder means:’ and does not establish precisely who qualifies as the holder."@en-AU ;
    tmk:goldRecord "GC-0132" ;
    tmk:labelKey "holder",
        "holder of an international registration",
        "holder of the international registration",
        "irda holder" ;
