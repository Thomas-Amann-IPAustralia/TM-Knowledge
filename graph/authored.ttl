        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:mayGiveRiseTo tmkc:GC-0063 ;
    tmk:notLabel "geographical indication"@en-AU,
        "geographical name"@en-AU,
        "plant varietal name"@en-AU ;
    tmk:notLabelKey "geographical indication",
        "geographical name",
