    tmk:spanEnd 204 ;
    tmk:spanStart 0 ;
    tmk:supportingText "As with national collective trade marks (see Part 33.5 Collective Trade Marks) it is not possible to change the ownership of an IRDA or protected international trade mark which is a collective trade mark." ;
    tmk:tier 2 .

tmka:GR-0368 a tmk:AuthoredAssertion ;
