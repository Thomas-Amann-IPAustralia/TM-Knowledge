    tmk:spanStart 0 ;
    tmk:supportingText "A collective trade mark is a sign used, or intended to be used, in relation to goods or services dealt with or provided in the course of trade by members of an association" ;
    tmk:tier 2 .

tmka:GR-0674 a tmk:AuthoredAssertion ;
