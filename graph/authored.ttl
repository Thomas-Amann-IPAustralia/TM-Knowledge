    tmk:authoringReasoning "Typed to match similarity of goods and services, since section 44 puts the two in the same position in the same sentence."@en-AU ;
    tmk:conceptGroup "legal_test" ;
    tmk:confidence 6e-01 ;
    tmk:expertShouldCheck "Type this and 'similarity of goods and services' the same way."@en-AU ;
