tmka:GR-0443 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0004 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0034 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects use of a radio call sign or frequency with confusion where the trade mark owner lacks the corresponding operating licence. This is conditional practice concerning class 38 broadcasting or related services, not a statement that all radio call signs cause confusion."@en-AU ;
    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether the relationship adequately preserves the licensing and service limitations."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0443" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:65247b2f3e686037e599b398b4f74f74a7e40836d32f3e2761a6a12ade582ed8" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/8/8/3> ;
    tmk:spanEnd 1220 ;
    tmk:spanStart 1063 ;
    tmk:supportingText "This is because confusion would be created if the owner of the trade mark did not in fact have the license to operate with that radio call sign or frequency." ;
    tmk:tier 3 .

tmka:GR-0446 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0059 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0038 ;
