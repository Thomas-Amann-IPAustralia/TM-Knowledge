    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:026ac3fc63c8f8f03c5b135ff4a979ae3dc65208af6298e595864511d166668e" ;
