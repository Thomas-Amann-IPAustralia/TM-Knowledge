tmka:GT-0043 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "What the concept names is the dividing: part of a parent application carried into a new one, keeping the priority date and taking a new number."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 6e-01 ;
    tmk:expertShouldCheck "GC-0043 (signed) and GC-0110 (authored) are both 'divisional application'. Both are typed procedural_step and neither displaces the other. The group itself is the weakest in this pass — see the alternatives. Decide it together with GT-0079, which was typed the other way on the same reasoning."@en-AU ;
    tmk:goldRecord "GT-0043" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
