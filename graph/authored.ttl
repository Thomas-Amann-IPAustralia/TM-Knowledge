tmka:GR-0298 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0058 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject tmkc:GC-0120 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly requires demonstrated capacity to distinguish where an application proceeds despite no inherent adaptation to distinguish. This is a conditional requirement for proceeding, not an assertion that such marks inherently possess that capacity."@en-AU ;
    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether the conditional requirement for proceeding is adequately represented by requiresElement between these legal-test concepts."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
