tmkc:GC-0054 a skos:Concept,
        tmk:GroundOfRefusal,
        tmk:LegalConcept ;
    rdfs:comment "The Manual records that there are currently no regulations made for the purposes of section 18, so this ground is never raised in examination. The concept is real in law and inert in practice, and that gap is the most useful thing about the record."@en-AU ;
    skos:altLabel "prohibited signs"@en-AU,
        "sign that is not to be used as a trade mark"@en-AU ;
    skos:broader tmkc:GC-0073 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "prohibited sign"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 39(1) names the class by reference to regulations under section 18, and the Manual states that no such regulations exist. Both halves are explicit, so the concept is recorded with its inertness attached rather than as a live ground."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part31/1%231> ;
    tmk:expertShouldCheck "Whether 'prohibited sign' is the right preferred label. The Manual's Part 31 title pairs it with 'prescribed', and the Act itself uses neither word for s 39(1)."@en-AU ;
    tmk:goldRecord "GC-0054" ;
    tmk:labelKey "prohibited sign",
        "sign that is not to be used as a trade mark" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s18>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39(1)> ;
    tmk:mayGiveRiseTo tmkc:GC-0182 ;
    tmk:notLabel "prescribed sign"@en-AU,
        "scandalous matter"@en-AU,
        "sign so nearly resembling"@en-AU ;
    tmk:notLabelKey "prescribed sign",
        "scandalous matter",
        "sign so nearly resembling" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "prohibited sign" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part31/1%231> ;
    tmk:typedBy tmka:GT-0054 .

tmkc:GC-0082 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "Control by the owner is the whole of it: section 8(2) makes use authorised only to the extent the user acts under the owner's control. Section 7(3) then treats authorised use as use by the owner, which is why it matters to section 41 and section 44(4)."@en-AU ;
    skos:altLabel "authorised use of a trade mark"@en-AU ;
    skos:broader tmkc:GC-0081 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "authorised use"@en-AU ;
    tmk:allocatesTo tmkc:GC-0085 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 8 defines it and limits it by control. Held apart from 'authorised user' because the Act defines the person in 8(1) and the use in 8(2), and evidence questions attach to the second."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part19A/1%231> ;
    tmk:expertShouldCheck "Whether the definition source should be a Part 19A passage on control rather than the general opening. This record cites the opening because it names authorised use in the list of questions use bears on."@en-AU ;
    tmk:goldRecord "GC-0082" ;
    tmk:labelKey "authorised use",
        "authorised use of a trade mark" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s7(3)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8(2)> ;
    tmk:notLabel "assignment"@en-AU,
        "authorised user"@en-AU,
        "use of a trade mark"@en-AU ;
    tmk:notLabelKey "assignment",
        "authorised user",
        "use of a trade mark" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "authorised use" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8> ;
    tmk:typedBy tmka:GT-0082 .

tmkc:GC-0076 a skos:Concept,
        tmk:LegalConcept,
        tmk:SubjectMatter ;
    rdfs:comment "The Manual distinguishes a colour used as the trade mark from colour as an aspect of packaging or of a label — the same colour can be either, and which it is changes the examination."@en-AU ;
    skos:altLabel "colour and coloured trade marks"@en-AU,
        "coloured trade mark"@en-AU ;
    skos:broader tmkc:GC-0073,
        tmkc:GC-0074 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "colour trade mark"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Stated in terms at the head of the Manual's section on colour."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part21/4%231> ;
    tmk:expertShouldCheck "Whether the two uses of colour the Manual distinguishes should be two concepts."@en-AU ;
    tmk:goldRecord "GC-0076" ;
    tmk:labelKey "colour and coloured trade mark",
        "colour trade mark",
        "coloured trade mark" ;
