    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states circumstances in which an INN stem gives rise to a section 43 ground for rejection, including meaningful inclusion and unrestricted goods. It does not make an INN stem necessary for grounds for rejection generally."@en-AU ;
    tmk:confidence 9.7e-01 ;
    tmk:expertShouldCheck "Whether the edge adequately preserves the meaningful-inclusion and goods-restriction conditions."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0418" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:c4235ae85720f19a20037d7a4f5a41161ef68438cf8e1ea2d8e36b90b621b1bb" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/5> ;
    tmk:spanEnd 349 ;
    tmk:spanStart 0 ;
    tmk:supportingText "A ground for rejection under section 43 exists where a trade mark to be used in relation to pharmaceuticals or veterinary substances consists of an INN stem, or contains a notified INN stem in a meaningful way, and use of the trade mark in respect of the goods covered by the specification are not restricted to substances indicated by the INN stem." ;
    tmk:tier 3 .

tmka:GR-0419 a tmk:AuthoredAssertion ;
