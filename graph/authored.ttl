    tmk:actsAs tmkc:GC-0045 ;
    tmk:actsUnderDirectionOf tmkc:GC-0046 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 206 creates the role in terms; the Manual names the delegate as the one who accepts."@en-AU ;
    tmk:confidence 9.5e-01 ;
    tmk:consults tmkc:GC-0175 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part18/2%231> ;
    tmk:expertShouldCheck "Whether 'their delegate' is too loose a label — in the Manual it always follows 'the Registrar or'."@en-AU ;
    tmk:goldRecord "GC-0171" ;
    tmk:holdsDelegationFrom tmkc:GC-0046 ;
    tmk:labelKey "delegate",
        "delegate of the registrar",
        "registrar delegate",
        "their delegate" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206> ;
    tmk:notLabel "Deputy Registrar"@en-AU,
        "Registrar"@en-AU ;
    tmk:notLabelKey "deputy registrar",
