    tmk:spanEnd 1093 ;
    tmk:spanStart 883 ;
    tmk:supportingText "For example, the Registrar may consider that it is not reasonable to revoke acceptance if the applicant agrees to amend the application so that certain conditions and limitations are placed upon the trade mark." ;
    tmk:tier 3 .

tmka:GR-0455 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0149 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0042 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects proposed revocation with a limitation-recordal procedure that may involve the Office of the Contracting Party of the holder. The relationship to the Contracting Party itself is indirect, and no more specific listed predicate fits."@en-AU ;
    tmk:confidence 7.6e-01 ;
    tmk:expertShouldCheck "Whether the relationship should attach only to the Contracting Party’s Office rather than to the Contracting Party of the holder."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0455" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:976fa61374f82dc69d214f969806b8a7d80734290bf099fa51e6056f61af3675" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/15/4/15/2~2> ;
    tmk:spanEnd 516 ;
    tmk:spanStart 0 ;
    tmk:supportingText "If the holder does respond to the notice of intention to revoke acceptance of their IRDA through an Australian or New Zealand address for service, and the submissions in regards to the proposed revocation amends goods and services that have not been notified to the IB as refused, the holder will be required to submit an MM6 [Request for the recordal of a Limitation of the List of Goods and Services] form directly to the IB or through their \"home\" Office (i.e., the Office of the Contracting Party of the holder)." ;
    tmk:tier 2 .

tmka:GR-0456 a tmk:AuthoredAssertion ;
