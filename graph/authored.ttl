    tmk:supportingText "If the evidence does not support the applicant's complete claim, the examiner should consider suggesting the specification be restricted to include only the range of goods/services for which the mark is demonstrated to be capable of distinguishing and to which the grounds for rejection do not pertain." ;
    tmk:tier 2 .

tmka:GR-0108 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0012 ;
    tmk:assertionPredicate skos:related ;
