        "similar services"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "similarity of goods and services"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 14 defines the term and the Manual states the practice point that classification does not settle it. Both are explicit."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/4%231> ;
    tmk:expertShouldCheck "Whether 'goods of the same description' is a synonym or a narrower concept. Section 14(1)(b) makes it one of two ways goods can be similar, which argues narrower."@en-AU ;
    tmk:goldRecord "GC-0070" ;
    tmk:isDefinedIn <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s14>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/similar-goods>,
