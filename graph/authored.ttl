tmkc:GC-0136 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Summary, not a definition: Summary: The Office of origin is an office acting within the Madrid Protocol process, which the Manual describes as having verified the priority claim for an international registration designating Australia."@en-AU ;
    skos:altLabel "Office of Origin"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Office of origin"@en-AU ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "This is a named institutional role, not a generic phrase or a duplicate of the Registrar or Madrid Protocol concepts. The Manual describes its priority-verification role and distinguishes it from the International Bureau in classification disputes. Regulation 17A.2 expressly points to Article 2(2) for its meaning; because that Article is absent, the quotation provides a supported role description rather than a complete legal definition. None of the listed PROVISIONS is supplied with text establishing its legislative basis."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/4/4/1> ;
    tmk:expertShouldCheck "Check Article 2(2) of the Protocol for the full definition: regulation 17A.2 incorporates it, but that Article is not supplied here."@en-AU ;
    tmk:goldRecord "GC-0136" ;
    tmk:labelKey "office of origin" ;
    tmk:notLabel "International Bureau"@en-AU,
        "Registrar"@en-AU ;
    tmk:notLabelKey "international bureau",
        "registrar" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "office of origin" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/4/4/1> ;
    tmk:typedBy tmka:GT-0136 .

tmkc:GC-0154 a skos:Concept,
        tmk:LegalConcept,
        tmk:LegalTest ;
    rdfs:comment "Summary, not a definition: Summary: Deceptively similar describes a trade mark that so nearly resembles another trade mark that it is likely to deceive or cause confusion."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "deceptively similar"@en-AU ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 10 expressly defines a comparison between trade marks, making this a distinct legal test rather than a generic phrase. Section 6 points to that definition. It is not a duplicate of GC-0002, which captures the likelihood of deception or confusion, or GC-0056, which captures near resemblance: this concept combines those elements into the statutory relationship between trade marks. The supplied Manual passages explain its role in infringement under section 120, but are not themselves legislation."@en-AU ;
    tmk:confidence 9.8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s10> ;
    tmk:expertShouldCheck "Check links to section 44 and regulation 4.15A against their text, which is not supplied here."@en-AU ;
    tmk:goldRecord "GC-0154" ;
    tmk:labelKey "deceptively similar" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s10> ;
    tmk:mayGiveRiseTo tmkc:GC-0064 ;
    tmk:notLabel "likely to deceive or cause confusion"@en-AU,
        "so nearly resembling"@en-AU,
        "substantially identical"@en-AU ;
    tmk:notLabelKey "likely to deceive or cause confusion",
        "so nearly resembling",
        "substantially identical" ;
    tmk:origin "authored" ;
