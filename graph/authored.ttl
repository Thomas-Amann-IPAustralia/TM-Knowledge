    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly treats potentially mitigating surrounding circumstances as relevant to its stated criteria for confusion from a standalone geographical reference. This supports qualification of the confusion assessment, not a general rule that surrounding circumstances prevent confusion."@en-AU ;
    tmk:confidence 9.6e-01 ;
