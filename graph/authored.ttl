    tmk:tier 3 .

tmka:GR-0089 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0014 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0006 ;
