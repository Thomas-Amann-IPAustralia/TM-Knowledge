tmka:GK-0001 a tmk:Correction ;
    rdfs:comment "The general concept; the section 43 ground is GC-0168."@en-AU ;
    tmk:addedValue "alt_labels: grounds for rejecting",
        "alt_labels: grounds for rejection" ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "GC-0006 is the general idea of a ground for rejection — Part 20 places grounds in sections 39 to 44 — but it carried the section 43 ground's own label and basis. Those move to GC-0168, the section 43 ground (ruling A2). The plural forms the Manual uses throughout come from the withdrawn duplicate GC-0053 (ruling A1)."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:corrects tmkc:GC-0006 ;
    tmk:expertShouldCheck "Whether 'objection' (an alternative label the linker now skips as too general, ruling E1) belongs here at all."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GK-0001" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:ruling "review/rulings/2026-10-08-chat-ontology-review.yaml#A2+A1" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part17/3%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/5%231> ;
    tmk:withdrawnValue "alt_labels: s 43 objection",
        "legislative_basis: TMA1995/s43" .

tmka:GK-0002 a tmk:Correction ;
