    tmk:spanEnd 1580 ;
    tmk:spanStart 1267 ;
    tmk:supportingText "If submissions are received requesting the deletion of certain goods/services from an application that also state that a divisional application is to be filed from that application, any deletion or amendment to the specification of goods/services should be delayed until the divisional application has been filed." ;
    tmk:tier 3 .

tmka:GR-0107 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0012 ;
    tmk:assertionPredicate skos:related ;
