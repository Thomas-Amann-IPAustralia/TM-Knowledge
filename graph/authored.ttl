tmkc:GC-0138 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Summary, not a definition: Summary: The International Bureau is the body within the World Intellectual Property Organisation identified by the Regulations, with roles in priority claims and classification matters described in the Manual."@en-AU ;
    skos:altLabel "IB"@en-AU,
        "International Bureau of WIPO"@en-AU,
        "International Bureau of the World Intellectual Property Organisation"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "International Bureau"@en-AU ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Regulations expressly define the term as a named body, so it fits process_role. The Manual describes its acceptance of verified priority claims and states that its opinion stands in classification disputes involving Madrid Protocol export applications. These are descriptions of practice, not additional legislative definitions. No existing concept identifies this body; the Madrid Protocol is a distinct international instrument."@en-AU ;
    tmk:confidence 9.9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/international-bureau> ;
    tmk:expertShouldCheck "Check the precise scope of its functions against the applicable Madrid Protocol provisions; the supplied passages describe only selected roles."@en-AU ;
    tmk:goldRecord "GC-0138" ;
    tmk:keeps tmkc:GC-0161 ;
    tmk:labelKey "ib",
        "international bureau",
        "international bureau of the world intellectual property organisation",
        "international bureau of wipo" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2> ;
    tmk:notLabel "Madrid Protocol"@en-AU,
        "Office of Origin"@en-AU,
        "United International Bureau for the Protection of Intellectual Property (BIRPI)"@en-AU,
        "World Intellectual Property Organisation"@en-AU ;
    tmk:notLabelKey "madrid protocol",
        "office of origin",
        "united international bureau for the protection of intellectual property birpi",
        "world intellectual property organisation" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "international bureau" ;
    tmk:prevailsOver tmkc:GC-0136 ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/international-bureau> ;
