    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "A grouping of sign kinds the Manual uses as a heading, sitting one level under sign. Subject matter by the same argument as sign."@en-AU ;
    tmk:conceptGroup "subject_matter" ;
    tmk:confidence 7.5e-01 ;
