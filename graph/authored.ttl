tmka:GR-0627 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-08 by S026: subject GC-0102 -> GC-0040 — an authored duplicate withdrawn in favour of the signed concept (ruling A1, ADR-0080 c2). The judgement and evidence are the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0158 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject tmkc:GC-0040 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly makes filing the notice a requirement for contesting the opposition and maintaining rights, rather than for commencing opposition proceedings. The same passage excludes proceedings commenced before 15 April 2013."@en-AU ;
    tmk:confidence 9.1e-01 ;
    tmk:expertShouldCheck "Whether the opposition concept can carry a requirement limited to contesting proceedings commenced under the newer procedure."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0627" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:1174f0c870bd9dc53e31817668968307cad112de4c1a05bceb33e13913542ef2" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part47/3%231> ;
    tmk:spanEnd 503 ;
    tmk:spanStart 206 ;
    tmk:supportingText "Once an opponent has filed a notice of opposition (comprised of a notice of intention to oppose and an adequate statement of grounds and particulars) the trade mark applicant or IRDA holder must file a notice of intention to defend if they wish to contest the opposition and maintain their rights." ;
    tmk:tier 3 .

tmka:GR-0629 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0158 ;
