        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(2)> ;
    tmk:mayGiveRiseTo tmkc:GC-0006,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
