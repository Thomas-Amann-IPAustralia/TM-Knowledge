    tmk:confidence 9.4e-01 ;
    tmk:expertShouldCheck "Whether this conditional examination guidance supports a direct qualifies relationship to the ground for rejection."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0448" ;
