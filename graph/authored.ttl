    tmk:spanStart 938 ;
    tmk:supportingText "Phonewords appearing in a composite trade mark containing additional distinctive elements will usually have sufficient inherent adaptation to distinguish and not attract a section 41 ground for rejection." ;
    tmk:tier 3 .

tmka:GR-0575 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-read on 2026-10-09 in the structure review (ADR-0131): was GC-0120 related GC-0119."@en-AU ;
    tmk:assertionObject tmkc:GC-0119 ;
    tmk:assertionPredicate tmk:isDistinguishedFrom ;
    tmk:assertionSubject tmkc:GC-0120 ;
    tmk:authoredBy "claude-code-agent-S029" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Every mark falls into one of three categories, these two among them."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether the sentence states this relationship, read the way the predicate reads."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0575" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:5a98371ccfdfb4a4f333e505716c18c9c7b6fb903adb5be22c344fb6a950ad3e" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/3%231~1> ;
    tmk:spanEnd 997 ;
    tmk:spanStart 603 ;
    tmk:supportingText "All trade marks examined will fall into one of three categories: a. trade marks that are sufficiently inherently adapted to distinguish and are therefore prima facie capable of distinguishing; b. trade marks that have some limited inherent adaptation to distinguish but are not prima facie capable of distinguishing; c. trade marks that, prima facie, have no inherent adaptation to distinguish." ;
    tmk:tier 3 .

tmka:GR-0576 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0120 ;
