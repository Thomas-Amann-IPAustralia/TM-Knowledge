    tmk:spanEnd 602 ;
    tmk:spanStart 389 ;
    tmk:supportingText "Following the hearing the delegate, as an administrative decision maker, will decide, on the basis of the evidence and the parties’ submissions, whether or not the opposed trade mark may be registered or protected" ;
    tmk:tier 3 .

tmka:GR-0654 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0045 ;
