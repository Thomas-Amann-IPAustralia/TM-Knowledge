tmkc:GC-0126 a skos:Concept,
        tmk:LegalConcept,
        tmk:SignContent ;
    rdfs:comment "A term entered on the Register of Protected Geographical Indications and Other Terms (the Wine Register) under the Wine Australia Act 2013 — Australian and European wine geographical indications, traditional expressions, quality wine terms and additional terms. Wine has a dedicated statutory scheme, unlike other geographical indications, which are principally protected through certification trade marks (owner's ruling A4)."@en-AU ;
    skos:altLabel "protected term"@en-AU,
        "term on the Wine Register"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "term protected under the Wine Australia Act"@en-AU ;
    tmk:authoredBy "claude-code-agent-S029" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "\"Protected term\" is the Manual's own name for a term on the Wine Register — 20 uses, all in Part 32B — so recognition finds the concept where the Manual discusses it."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/1/1/1> ;
    tmk:expertShouldCheck "Whether \"protected term\" is used anywhere outside wine for something else."@en-AU ;
    tmk:goldRecord "GC-0126" ;
    tmk:isProtectedThrough tmkc:GC-0170 ;
    tmk:labelKey "protected term",
        "term on the wine register",
        "term protected under the wine australia act" ;
