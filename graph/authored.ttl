    tmk:expertShouldCheck "Whether accepted naming conventions sufficiently identifies plant variety names for this relationship."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0151" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:94d2b8f375cd4df08c21d7e4a9625b80416dd3dfdfb83e9d0b880fd8f35e30a5" ;
