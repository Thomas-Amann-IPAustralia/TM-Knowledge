tmkc:GC-0124 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Part 6 of the Act governs amendment before registration and Division 1 of Part 8 after it — two regimes, and which one applies depends on where the mark has got to."@en-AU ;
    skos:altLabel "amendment"@en-AU,
        "amendments"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "amendment of an application"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states both regimes and their boundary in one sentence. Amending the specification is also one of the Manual's named ways of overcoming a section 44 ground, which is why this concept matters to examination and not only to administration."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part9/1%231> ;
    tmk:expertShouldCheck "Whether amendment before and after registration are one concept. The Act's structure argues they are two."@en-AU ;
    tmk:goldRecord "GC-0124" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s63>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s64>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83> ;
    tmk:notLabel "divisional application"@en-AU,
        "rectification of the Register"@en-AU,
        "withdrawal"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part9/1%231> ;
    tmk:typedBy tmka:GT-0124 .

tmkc:GC-0125 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "Examination of Class 31 plant applications takes in the Plant Breeder's Rights Act 1994 — legislation outside the Trade Marks Act entirely. That is the interesting thing about this concept and the reason it is held."@en-AU ;
    skos:altLabel "plant varietal names"@en-AU,
        "plant variety denomination"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "plant varietal name"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states the interaction in terms. Held because it is one of two places where examination reaches outside the trade marks legislation, and a vocabulary built only from the Act would never find it."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/1/1/1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/1/1/2> ;
    tmk:expertShouldCheck "The legislative_basis. This record names s 41 and s 43 as the grounds the varietal name bears on, which is an inference from Part 22.27's title rather than a citation in the quoted passage."@en-AU ;
    tmk:goldRecord "GC-0125" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43> ;
    tmk:notLabel "generic term"@en-AU,
        "geographical indication"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/1/1/1> ;
    tmk:typedBy tmka:GT-0125 .

