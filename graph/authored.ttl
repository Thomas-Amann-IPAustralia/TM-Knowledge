tmkc:GC-0108 a skos:Concept,
        tmk:LegalConcept,
        tmk:SubjectMatter ;
    rdfs:comment "Distinguishes the goods or services of members of an association from those of non-members. The Manual's own contrast is the useful part: unlike a certification mark, use of a collective mark need not be subject to approved rules."@en-AU ;
    skos:altLabel "collective trade marks"@en-AU,
        "collective trademark"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "collective trade mark"@en-AU ;
    skos:related tmkc:GC-0086 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms by the Manual. The near-miss against certification marks is drawn from the same passage."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part33/1%231> ;
    tmk:expertShouldCheck "The spelling. The Manual's own heading writes 'collective trademark' as one word and the body writes two; this record prefers the two-word form and keeps the other as an alt_label."@en-AU ;
    tmk:goldRecord "GC-0108" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s162>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/collective-trade-mark> ;
