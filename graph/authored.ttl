    tmk:typedBy tmka:GT-0075 .

tmkc:GC-0076 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The Manual distinguishes a colour used as the trade mark from colour as an aspect of packaging or of a label — the same colour can be either, and which it is changes the examination."@en-AU ;
    skos:altLabel "colour and coloured trade marks"@en-AU,
