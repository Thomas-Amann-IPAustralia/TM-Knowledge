tmka:GR-0658 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0173 ;
    tmk:assertionPredicate tmk:consults ;
    tmk:assertionSubject tmkc:GC-0044 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "When a delegate is unsure of the correct decision they consult a delegate who is a subject matter expert and/or escalate up the chain of command (Examiner -> Senior Examiner -> Examination Team Leader); standard practice, not unique to s 43 (owner's ruling C6). Part 10 says it in terms: if in doubt about an applicant's legal personality, consult the team leader first."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "The Manual's instance is doubt about an applicant's legal personality (Part 10); extending it to every doubt is the owner's ruling C6."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0658" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:92edbc6081d23de5927c3ff12afed0d8425bb68ce937e8d3f6b4cebfc03fcce7" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part10/1/1/2> ;
    tmk:spanEnd 841 ;
    tmk:spanStart 774 ;
    tmk:supportingText "In such cases, consult with your team leader in the first instance." ;
    tmk:tier 3 .

tmka:GR-0659 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0173 ;
    tmk:assertionPredicate tmk:escalatesTo ;
    tmk:assertionSubject tmkc:GC-0044 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "When a delegate is unsure of the correct decision they consult a delegate who is a subject matter expert and/or escalate up the chain of command (Examiner -> Senior Examiner -> Examination Team Leader); standard practice, not unique to s 43 (owner's ruling C6). Part 9: an examiner refers a section 65A request to their team leader, who decides it."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "The team leader decides a section 65A request; whether referring a matter the team leader holds the power for is escalation or allocation."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0659" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ee56930dffbd99f47d53ed61d545fb201c691374b17ef897c9550fba29b5d641" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part9/4/4/7/1> ;
    tmk:spanEnd 958 ;
    tmk:spanStart 642 ;
    tmk:supportingText "If an examiner believes they have a request for an amendment (probably most commonly to the statement of goods or services, but also possibly to the trade mark) which cannot be made under section 65, but which appears to meet the criteria for section 65A, they should refer it to their team leader for consideration." ;
    tmk:tier 3 .

