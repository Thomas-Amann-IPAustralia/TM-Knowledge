    tmk:authoringReasoning "A change in ownership of a certification IRDA or protected international trade mark needs the ACCC's consent before it has effect in Australia."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "The subject was 'change of ownership' in general, which needs no consent outside certification marks."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
