    tmk:sourceContentHash "sha256:19378a19d1b2f3981ebd9159c446c0ca320c4a37070a36216a287b510649c43b" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/26/4/26/2> ;
    tmk:spanEnd 386 ;
    tmk:spanStart 0 ;
    tmk:supportingText "It is possible that the holder of a protected international trade mark may already own an existing Australian trade mark registration for the same trade mark containing some or all of the goods and/or services claimed in the protected international trade mark, and which has an earlier priority date than the protected international trade mark in respect of those goods and/or services." ;
    tmk:tier 2 .

tmka:GR-0567 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0136 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0114 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects a protected international trade mark's transformation pathway with cessation or limitation of its basic trade mark in the Office of origin. This supports a contextual relationship, but I am unsure that any more specific supplied predicate accurately captures it."@en-AU ;
    tmk:confidence 8.8e-01 ;
    tmk:expertShouldCheck "Whether this transformation connection warrants a direct relationship to the Office of origin rather than only to the basic trade mark."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0567" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:a2a9500f7a9a1e7ac886a7f21d6f126431ad1e766907398fdfa8896fa2e141e5" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/4/25/4/25/2> ;
    tmk:spanEnd 428 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The Madrid Protocol provides for the transformation of an IRDA or protected international trade mark into a national application. There are two circumstances in which an IRDA or protected international trade mark could be transformed: The basic trade mark has ceased to exist or its scope has been limited in the Office of origin within the 5 year dependency period or as a result of an action that commenced within that period." ;
    tmk:tier 2 .

