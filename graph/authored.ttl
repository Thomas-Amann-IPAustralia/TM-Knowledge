tmka:GT-0126 tmk:authoredBy "claude-code-agent-S027" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "term protected under the Wine Australia Act is a term protected under the Wine Australia Act, as a mark may contain one: something a trade mark contains or conveys — a word, name, image or sign within it, or a meaning — so `sign_content`. Retyped on the owner's ruling B1 of 2026-10-09 (ADR-0126): a kind says what a concept is, and what it does is an edge. What it does is on its edges: GR-0635 is protected through Register of Protected Geographical Indications and Other Terms; GR-0636 may give rise to use contrary to law."@en-AU ;
    tmk:conceptGroup "sign_content" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether this is better read as something about the mark's context than about what the mark itself contains or conveys."@en-AU ;
    tmk:goldRecord "GT-0126" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/1/1/1> .

