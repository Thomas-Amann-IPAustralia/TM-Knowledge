    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual describes the owner's permission to use the certification trade mark, conditional on compliance with its rules. The listed predicates do not specifically express this owner–mark use relationship."@en-AU ;
    tmk:confidence 9.1e-01 ;
    tmk:expertShouldCheck "Whether the passage's reference to the owner supports the registered-owner record without qualification."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0275" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
