tmkc:GC-0148 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Summary, not a definition: Summary: A lawyer is a statutorily defined legal professional whom the Manual identifies as an example of someone an applicant may authorise to make an evidence declaration on their behalf."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "lawyer"@en-AU ;
    skos:related tmkc:GC-0041 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 6 expressly defines the term, and the Manual passages give lawyers a procedural role as possible authorised declarants. This is a distinct process role, not a generic phrase or an existing concept. The declaration guidance is Registrar practice, whereas the definition is statutory. None of the listed PROVISIONS is supplied with text establishing a legislative basis for this role."@en-AU ;
    tmk:confidence 9.9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/lawyer> ;
    tmk:expertShouldCheck "The supplied passages do not establish how the cited sections 41(3), 41(4) and 44 ground this role; check those links before recording them as legislative bases."@en-AU ;
    tmk:goldRecord "GC-0148" ;
    tmk:labelKey "lawyer" ;
    tmk:notLabel "trade mark attorney"@en-AU ;
    tmk:notLabelKey "trade mark attorney" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "lawyer" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/lawyer> ;
    tmk:typedBy tmka:GT-0148 .

tmkc:GC-0169 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "A geographical indication for wine, entered on the Wine Register under the Wine Australia Act 2013. Different from other geographical indications: wine GIs have a dedicated statutory scheme, while other GIs are principally protected through certification trade marks (owner's ruling A4). The Act itself is not in the corpus; the Manual's account of it is."@en-AU ;
    skos:altLabel "Australian GIs"@en-AU,
        "Australian Geographical Indications"@en-AU,
        "European GIs"@en-AU,
        "European Geographical Indications"@en-AU,
        "geographical indication for wine"@en-AU ;
    skos:broader tmkc:GC-0018,
        tmkc:GC-0126 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "wine geographical indication"@en-AU ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Part 32B lists Australian and European geographical indications as categories of term on the Wine Register. The owner ruled that wine GIs are different from other GIs because they have their own statutory scheme, so they are a concept of their own, narrower than GI (GC-0018)."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/1/1/3> ;
    tmk:expertShouldCheck "Whether the Australian/European split matters to examination; the Manual examines both alike."@en-AU ;
    tmk:goldRecord "GC-0169" ;
    tmk:isProtectedThrough tmkc:GC-0170 ;
    tmk:labelKey "australian geographical indication",
        "australian gis",
        "european geographical indication",
        "european gis",
        "geographical indication for wine",
        "wine geographical indication" ;
    tmk:notLabel "certification trade mark"@en-AU,
        "geographical origin"@en-AU ;
    tmk:notLabelKey "certification trade mark",
        "geographical origin" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "wine geographical indication" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/1/1/3> ;
