tmkc:GC-0117 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Defined in five different places across the Regulations as well as in section 6 — one per opposition type. The multiplicity is real and this record does not resolve it."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "opponent"@en-AU ;
    skos:related tmkc:GC-0040,
        tmkc:GC-0041,
