    tmk:typedBy tmka:GT-0099 .

tmkc:GC-0100 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "The Manual treats an endorsement as what goes on the Register to record that an application was accepted on evidence or other circumstances. It is a record of how a ground was overcome, which makes it evidence about the mark's history."@en-AU ;
    skos:altLabel "endorsements"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "endorsement"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states what an endorsement is for and when it is entered. Held apart from disclaimer because one records how a ground was overcome and the other limits a right."@en-AU ;
    tmk:confidence 7.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/6%231> ;
    tmk:expertShouldCheck "Whether the corpus defines 'endorsement' anywhere more directly. This record rests on a passage about when one is entered rather than on a definition."@en-AU ;
    tmk:goldRecord "GC-0100" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(3)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(3)> ;
    tmk:notLabel "conditions or limitations"@en-AU,
        "disclaimer"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/6%231> ;
    tmk:typedBy tmka:GT-0100 .

tmkc:GC-0101 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "Formal evidence filed to overcome a section 41 ground, once the Registrar remains satisfied after submissions that the mark is not capable of distinguishing. The Manual makes the sequence explicit and it matters: evidence comes after argument, not instead of it."@en-AU ;
    skos:altLabel "evidence of use of the trade mark"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "evidence of use"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states the trigger, the sequence and the actor in one sentence. Held apart from 'use of a trade mark' because this is the proof, not the fact."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/3%231> ;
    tmk:expertShouldCheck "Whether evidence of use under section 41 and evidence of use under section 44(4) are the same concept. The Manual treats them in different Parts with different requirements."@en-AU ;
    tmk:goldRecord "GC-0101" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(3)(b)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)> ;
    tmk:notLabel "evidence in support"@en-AU,
        "honest concurrent use"@en-AU,
        "prior use"@en-AU,
        "use of a trade mark"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/3%231> ;
    tmk:typedBy tmka:GT-0101 .

tmkc:GC-0104 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "The Manual grounds it in section 17: use is inherent in what a trade mark is, so a mark that is not used may be removed. The onus sits on the opponent once the application is opposed, which is unusual and worth carrying."@en-AU ;
    skos:altLabel "non-use removal"@en-AU,
        "removal of a trade mark from the Register for non-use"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "removal for non-use"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Stated in terms, with the section 17 rationale in the same passage — which is what ties this concept back to 'use of a trade mark' rather than leaving it as free-standing procedure."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part48/1%231> ;
    tmk:expertShouldCheck "Whether the onus point should be a relationship record rather than a note."@en-AU ;
