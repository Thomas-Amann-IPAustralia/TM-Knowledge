    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The presumption of registrability governs the Registrar's decision until the Registrar is satisfied, on the balance of probabilities, that a ground for rejection exists."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "The standard — the balance of probabilities — lives only in the supporting text; whether it needs a concept of its own."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0091" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:4434badb3a68042ce5bdf03e2539496bb5086a8571511b10e130307941a41eb0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/4%231~2> ;
    tmk:spanEnd 328 ;
    tmk:spanStart 0 ;
    tmk:supportingText "It is clear from both the Oregon and Sports Warehouse decisions (as well as from other decisions from the Courts) that once the Registrar is satisfied on the balance of probabilities that a ground for rejection does exist, then the presumption of registrability no longer forms a part of the Registrar’s decision making process." ;
    tmk:tier 3 .

