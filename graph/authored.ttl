tmkc:GC-0141 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: A legally significant date associated with registration, whose effective date the Manual describes as affected by priority claims and potentially differing between goods or services."@en-AU ;
    skos:altLabel "effective date of registration"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "date of registration"@en-AU ;
    skos:related tmkc:GC-0088,
        tmkc:GC-0157 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The statutory fragment expressly introduces a defined term, making this more than a generic date phrase, but omits its defining content. The Manual supplies the best available explanation of its effective-date usage. It relates registration to priority dates without establishing that the concepts are identical, so it is not treated as a duplicate of priority date or filing date. A temporal attribute fits none of the listed groups closely. The cited provisions are not reproduced, so their grounding role cannot be verified from these passages; the Manual explanation is practice, not legislation."@en-AU ;
    tmk:confidence 7.8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7/7/2> ;
    tmk:expertShouldCheck "Check the complete section 6 definition, whether 'effective date of registration' is equivalent to the statutory term, and which of the cited provisions actually ground it."@en-AU ;
    tmk:goldRecord "GC-0141" ;
    tmk:labelKey "date of registration",
        "effective date of registration" ;
    tmk:notLabel "filing date"@en-AU,
        "priority date"@en-AU ;
    tmk:notLabelKey "filing date",
        "priority date" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "date of registration" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7/7/2> ;
    tmk:typedBy tmka:GT-0141 .

tmkc:GC-0153 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: A statement by an opponent that forms part of a notice of opposition and, together with the notice of intention to oppose, completes that notice."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "statement of grounds and particulars"@en-AU ;
    skos:related tmkc:GC-0134,
        tmkc:GC-0143,
        tmkc:GC-0158 ;
    tmk:allocatesTo tmkc:GC-0117 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Regulations expressly name and partially define this document. TMM/Part47/1/1/1 explains that it must be filed to complete the notice of opposition and cites regulation 17A.32. It is a distinct component of GC-0103 notice of opposition, not a duplicate of that concept or of opposition generally. The supplied definition is incomplete, so no claim is made about its required contents. The Manual passage explains practice and cites legislation; it is not itself legislation."@en-AU ;
    tmk:confidence 9.4e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.29/statement-of-grounds-and-particulars> ;
    tmk:expertShouldCheck "The supplied legislative definitions stop at the colon, so the required contents cannot be established from these passages; check the complete definitions and the filing requirements in regulation 17A.32."@en-AU ;
    tmk:goldRecord "GC-0153" ;
    tmk:labelKey "statement of ground and particular" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.29>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.32> ;
    tmk:notLabel "notice of intention to oppose"@en-AU,
        "notice of opposition"@en-AU ;
    tmk:notLabelKey "notice of intention to oppose",
        "notice of opposition" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "statement of ground and particular" ;
    tmk:qualifies tmkc:GC-0040 ;
    tmk:requiresElement tmkc:GC-0156 ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.29/statement-of-grounds-and-particulars> ;
    tmk:typedBy tmka:GT-0153 .

tmkc:GC-0173 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "An EL1 delegate who leads an examination team: delegated to accept applications, the examiner's first point of escalation, and holder of particular powers (for example, notifying a proposed revocation of acceptance, Part 38; most section 65A amendments, Part 9)."@en-AU ;
