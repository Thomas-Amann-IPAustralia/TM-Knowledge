    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly makes a connotation with specified characteristics necessary for raising the ground discussed here. This records section 43 examination practice, not a requirement for every ground for rejection."@en-AU ;
    tmk:confidence 9.8e-01 ;
    tmk:expertShouldCheck "Whether the ground-for-rejection record can preserve the section 43 limitation."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0060" ;
