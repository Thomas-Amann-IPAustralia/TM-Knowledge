    tmk:confidence 9.2e-01 ;
    tmk:expertShouldCheck "Whether the priority-endorsement relationship warrants a more specific predicate than related_to."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0108" ;
