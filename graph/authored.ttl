    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/2/3/2/3/2> ;
    tmk:spanEnd 644 ;
    tmk:spanStart 344 ;
    tmk:supportingText "A ground for rejection under section 41(4) is applicable if research identifies a plant name of the relevant type that only differs from the applied for trade mark by words that are common to the trade. The trade mark as a whole would be material that others may think to use without improper motive." ;
    tmk:tier 3 .

tmka:GR-0399 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0008 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0010 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual directs assessment of the danger of confusion through the impressions or recollections of an ordinary consumer. This supports treating the ordinary-consumer perspective as qualifying application of the threshold, rather than as a separate threshold."@en-AU ;
    tmk:confidence 9.1e-01 ;
    tmk:expertShouldCheck "Whether qualifies adequately captures the ordinary consumer as the perspective through which the threshold is assessed."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0399" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ff78e74e76e34f56e8a4389e3702730469d50db7b0b71313c753905da2ecdb86" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/6/6/4~1> ;
    tmk:spanEnd 1095 ;
    tmk:spanStart 844 ;
    tmk:supportingText "What needs to be assessed is the effect of the similarities and differences on the impression or recollection an ordinary consumer of the goods or services would have of the trade marks and whether this creates a real and tangible danger of confusion." ;
    tmk:tier 3 .

tmka:GR-0400 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0008 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0009 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual situates the assessment of confusion within the relevant market and then specifies the real tangible danger threshold. This supports treating the relevant market as qualifying the assessment, rather than changing the threshold itself."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Whether qualifies adequately captures the market as the context for assessing the danger of confusion."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0400" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ec2c9157aa588c1c4651346920be94440d5e1fa047984b714fc5fa2041e5de57" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/x-annex-a1---citing-multiple-names%231~1> ;
    tmk:spanEnd 337 ;
    tmk:spanStart 0 ;
    tmk:supportingText "As with any conflict between marks, citations in respect of this scenario will depend on the likelihood of the two trade marks being confused within the relevant market. The tests require that there be a real tangible danger of confusion occurring if the two trade marks are used in relation to similar or closely related goods/services." ;
    tmk:tier 3 .

tmka:GR-0404 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0025 ;
