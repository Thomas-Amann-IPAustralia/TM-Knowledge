    tmk:confidence 9.4e-01 ;
    tmk:expertShouldCheck "Whether the relationship should be limited expressly to primary meanings competing with geographical significance."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0485" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:6faf8d041a78624c617a49597c119c0a2483797145a953f4fb524858fb7ca707" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/15/15/1~2> ;
    tmk:spanEnd 1892 ;
    tmk:spanStart 1672 ;
    tmk:supportingText "If there is a primary meaning for a sign other than the geographical name, the ordinary signification of the sign may not be that of the geographical name and the sign may be inherently adapted to distinguish the claims." ;
    tmk:tier 3 .

