    tmk:spanEnd 723 ;
    tmk:spanStart 609 ;
    tmk:supportingText "There are no other elements in the mark, or surrounding circumstances, which would mitigate the risk of confusion." ;
    tmk:tier 3 .

tmka:GR-0104 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0003 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0011 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual directs that surrounding circumstances should be considered in assessing likelihood of deception or confusion in the goods-and-services context. They therefore qualify that assessment rather than independently establish deception."@en-AU ;
    tmk:confidence 9.3e-01 ;
    tmk:expertShouldCheck "Whether the relationship needs an express limitation to the assessment involving goods and services discussed here."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0104" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:1388f5f15605b8ae58b2db5db22a66ceb75d846aa24d831d205a819647fc6892" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/4/4/3~2> ;
    tmk:spanEnd 1591 ;
    tmk:spanStart 1016 ;
    tmk:supportingText "In assessing the likelihood of deception or confusion in a case of goods and services, consideration should be given to consumer expectations. Factors which influence consumer expectations include whether the services are performed upon, in relation to, or by means of certain goods. Consideration should also be given to the marketplace realities and surrounding circumstances including: the circumstances in which the marks will be used, the circumstances in which the goods or services will be bought and sold, and the character of the consumers of the goods and services." ;
    tmk:tier 3 .

tmka:GR-0105 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0010 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0011 ;
