    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual links inherent adaptation to the geographical meaning and ambiguity about other traders' desire to use it. This supports a qualifying relationship, not a categorical absence of inherent adaptation for every geographical reference."@en-AU ;
    tmk:confidence 8.7e-01 ;
