    tmk:authoringReasoning "The Manual expressly identifies the specification as a target of amendment within an application. Its instruction to delay amendment is conditional on the stated divisional-filing circumstances."@en-AU ;
    tmk:confidence 9.3e-01 ;
    tmk:expertShouldCheck "Whether appliesTo adequately represents an amendment's target within the broader application."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0106" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:1ccc40ab4041240f3a3d63e4f7f80b9d744ddccc90bfc04c08476f64a96584da" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/2%231> ;
    tmk:spanEnd 1580 ;
    tmk:spanStart 1267 ;
    tmk:supportingText "If submissions are received requesting the deletion of certain goods/services from an application that also state that a divisional application is to be filed from that application, any deletion or amendment to the specification of goods/services should be delayed until the divisional application has been filed." ;
    tmk:tier 3 .

tmka:GR-0107 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0012 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0044 ;
