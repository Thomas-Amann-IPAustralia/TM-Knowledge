tmkc:GC-0182 a skos:Concept,
        tmk:GroundOfRefusal,
        tmk:LegalConcept ;
    rdfs:comment "The ground section 39 creates: a trade mark that contains or consists of a prohibited sign (s 39(1), 'must') or a prescribed sign or one so nearly resembling it (s 39(2), 'may'). Until 2026-10-09 the two signs themselves were filed as the ground and as kinds of sign at once; on the owner's ruling B4 they are signs and this is the ground they give rise to."@en-AU ;
    skos:altLabel "ground for rejection under section 39"@en-AU,
        "ground for rejection under section 39(2)"@en-AU,
        "grounds for rejection under s 39(1)"@en-AU ;
    skos:broader tmkc:GC-0006 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "section 39 ground for rejection"@en-AU ;
    tmk:authoredBy "claude-code-agent-S027" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 39 states reasons an application must or may be rejected, and the Manual speaks of 'a section 39 ground for rejection' (Part 31). A prohibited sign and a prescribed sign are what the ground is about — each is 'a sign that ...' in the Act's own words — not the ground."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part31/1%231> ;
    tmk:expertShouldCheck "Whether practice treats subsections 39(1) and 39(2) as one ground or two."@en-AU ;
    tmk:goldRecord "GC-0182" ;
    tmk:isOvercomeBy tmkc:GC-0029 ;
    tmk:labelKey "ground for rejection under s 39 1",
        "ground for rejection under section 39",
        "ground for rejection under section 39 2",
        "section 39 ground for rejection" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39> ;
    tmk:notLabel "prescribed sign"@en-AU,
        "prohibited sign"@en-AU,
        "section 43 ground for rejection"@en-AU ;
    tmk:notLabelKey "prescribed sign",
        "prohibited sign",
        "section 43 ground for rejection" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "section 39 ground for rejection" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part31/1%231>,
