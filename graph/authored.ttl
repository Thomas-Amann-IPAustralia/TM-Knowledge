    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual identifies substantial identity as one alternative that can support section 44 grounds for rejection, subject to the other stated conditions. Substantial identity alone is not presented as sufficient."@en-AU ;
    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether the ontology preserves the accompanying goods or services conditions."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0195" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:135958d31e67cdecb3d990c4c05085c8f408f4ceb46e6e579eefe78042ae8f05" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/5/5/6/1> ;
    tmk:spanEnd 464 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Under subsections 44(1) and 44(2) there are grounds for rejecting an application if the trade mark is substantially identical or deceptively similar to another trade mark the subject of an application or registration and is to be used in respect of goods or services, similar to goods or services covered by that other application or registration, or goods that are closely related to those other services or services that are closely related to those other goods." ;
    tmk:tier 3 .

