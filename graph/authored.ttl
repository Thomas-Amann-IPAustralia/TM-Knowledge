tmkc:GC-0116 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Defined by the Act as the person in whose name the application currently stands — so the applicant can change without the application changing. The Manual's Part 10 treats getting the identity right as a formality requirement in its own right."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "applicant"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms, and the 'for the time being' clause is the part worth keeping — it is what makes assignment of a pending application coherent."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part10/1%231> ;
    tmk:expertShouldCheck "Whether the definition source should be Part 10.1 on the name requirement or a passage about who may apply under section 27."@en-AU ;
    tmk:goldRecord "GC-0116" ;
    tmk:hasStatutoryBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s203>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27(2)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(7)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s92> ;
    tmk:isDefinedIn <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/applicant> ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27>,
