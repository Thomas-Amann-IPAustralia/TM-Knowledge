tmkc:GC-0077 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The Manual's test is functional rather than formal: whatever the sound is, it must serve the purpose of identifying the trade source."@en-AU ;
    skos:altLabel "auditory trade mark"@en-AU,
