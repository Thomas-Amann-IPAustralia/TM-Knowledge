    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly allocates responsibility for establishing reputation to the opponent. This is a statement of the Manual's account of the opposition burden, rather than a quotation from legislation."@en-AU ;
    tmk:confidence 9.1e-01 ;
