tmkc:GC-0150 a skos:Concept,
        tmk:LegalConcept,
        tmk:SubjectMatter ;
    rdfs:comment "Summary, not a definition: Summary: International registration of a trade mark is registration of that mark in the International Register, rather than its protection specifically in Australia."@en-AU ;
    skos:altLabel "international registration"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "international registration of a trade mark"@en-AU ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Regulations expressly define the term, making it a distinct legal concept best classified as a registration record. It is broader than GC-0113, international registration designating Australia, because its definition does not require an Australian designation. The Manual also distinguishes international registration from Australian protection by describing the effect of cancellation on a protected international trade mark. The defining legislative passage is regulation 17A.2. The only reference supplied under PROVISIONS, regulation 17A.27, is described in the Manual as defining a declaration period for limitations, so it is not listed as a legislative basis for this concept."@en-AU ;
    tmk:confidence 9.7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/international-registration> ;
    tmk:expertShouldCheck "Confirm the relationship to GC-0113 and GC-0114 against their full definitions; only their labels are supplied."@en-AU ;
    tmk:goldRecord "GC-0150" ;
    tmk:isExcludedFrom tmkc:GC-0104 ;
    tmk:isRecordedIn tmkc:GC-0161,
        tmkc:GC-0165 ;
    tmk:labelKey "international registration",
        "international registration of a trade mark" ;
    tmk:notLabel "International Register"@en-AU,
        "Record of International Registrations"@en-AU,
        "international application"@en-AU,
        "international registration designating Australia"@en-AU,
        "protected international trade mark"@en-AU ;
    tmk:notLabelKey "international application",
        "international register",
        "international registration designating australia",
        "protected international trade mark",
        "record of international registration" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "international registration of a trade mark" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2/international-registration> ;
    tmk:typedBy tmka:GT-0150 .

tmkc:GC-0093 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Section 33(1) makes acceptance mandatory unless the Registrar is satisfied of a defect or a ground — that is the presumption of registrability in operation. Acceptance is not registration: section 33 accepts, publication and opposition follow, and registration comes later."@en-AU ;
    skos:altLabel "accept the application"@en-AU,
        "accepted"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "acceptance"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Both the Act and the Manual state it in terms, and the Manual explicitly ties it to the presumption of registrability."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/4%231~1> ;
    tmk:expertShouldCheck "Nothing specific."@en-AU ;
    tmk:goldRecord "GC-0093" ;
    tmk:labelKey "accept the application",
        "acceptance",
        "accepted" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(2)> ;
    tmk:notLabel "deferment of acceptance"@en-AU,
