tmka:GT-0122 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "Examination taken out of filing order. A step, and a variant of the one typed at GT-0092."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "The Manual's modality is that the Registrar *may* expedite, on a reasonable belief. This typing carries none of that, and the may/must distinction is the thing the concept's own note singles out."@en-AU ;
