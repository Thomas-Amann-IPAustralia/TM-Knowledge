tmkc:GC-0095 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "The Manual expects it to be rare and records that the Registrar is not obliged to consider it even on a third party's request. That discretion is the most examinable thing about the concept."@en-AU ;
    skos:altLabel "revoke the registration"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "revocation of registration"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Stated in terms, with the discretion stated separately in the same passage."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part62/1%231> ;
