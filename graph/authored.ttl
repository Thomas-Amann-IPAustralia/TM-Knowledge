    tmk:spanEnd 224 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Although reg 5.4(3) gives the objector the option to request a hearing, regs 21.15 and 21.16 provide that it is at the Registrar’s discretion whether such a hearing would be an oral hearing, or by way of written submissions." ;
    tmk:tier 2 .

tmka:GR-0178 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0047 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0008 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual qualifies the significance of descriptive matter for section 43 by requiring a real and tangible danger of false consumer expectations resulting in confusion. The relationship to descriptive matter is contextual rather than a threshold defining descriptive matter itself."@en-AU ;
    tmk:confidence 8.8e-01 ;
    tmk:expertShouldCheck "Whether this contextual qualification should instead be recorded only against the section 43 ground for rejection."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0178" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:14a837dcde1a12b578590df4144304bdc6e1066b865971b068bda35119a32802" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/2/2/1~1> ;
    tmk:spanEnd 2111 ;
    tmk:spanStart 1846 ;
    tmk:supportingText "It does not follow that all trade marks containing descriptive matter would attract a section 43 objection. Only if there is a real and tangible danger that the consumer’s expectations may turn out to be false and result in confusion, would section 43 be triggered." ;
    tmk:tier 3 .

tmka:GR-0179 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0047 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0015 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects specification amendment with replacing trade marks by generic descriptions of the goods or services. This supports a relationship only if the anchor includes such generic descriptions, rather than being confined to descriptive matter within a trade mark."@en-AU ;
    tmk:confidence 7.2e-01 ;
    tmk:expertShouldCheck "Whether generic descriptions in specifications fall within the intended scope of the descriptive matter concept."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0179" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:dcd054bec406f9e646670a1d4cb39964a00292b5cdd9379736a445cb65fcb94c" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part14/6/6/3/2> ;
    tmk:spanEnd 303 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Examiners should familiarise themselves with the list in Annex A3 and if these, or other, trade marks appear in a specification, the applicant should be requested to delete them and provide a generic description of the goods or services, along the lines of the alternative descriptions given in Annex 3." ;
    tmk:tier 2 .

tmka:GR-0180 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0004 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0047 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual's quoted reasoning treats descriptive matter as qualifying the treatment of confusion risk in comparing marks. It permits some discounting or acceptance of risk while expressly rejecting complete exclusion of descriptive elements."@en-AU ;
    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether qualifies adequately captures acceptance of confusion risk without implying that descriptive matter is disregarded."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0180" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:8979210fe6d20ce40fa188a45baaafae229763daacc2a91e563380480d2e6fcb" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/6/6/7~2> ;
    tmk:spanEnd 1216 ;
    tmk:spanStart 932 ;
    tmk:supportingText "A descriptive element within a trade mark may be to some extent discounted in a comparison (or to paraphrase Hornsby, a certain risk of confusion due to the presence of that element may be accepted), but those descriptive elements cannot be entirely ignored in the overall comparison." ;
    tmk:tier 3 .

tmka:GR-0181 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0051 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0009 ;
