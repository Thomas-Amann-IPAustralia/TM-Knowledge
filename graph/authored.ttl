tmka:GT-0095 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "A registration is undone under sections 84A to 84D in circumstances where it appears it should not have occurred. A transition."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "The Manual records that the Registrar is not obliged to consider revocation even where a third party requests it. That discretion is a modality on the step, and this group carries no modality — which is a limit of the group rather than of the record."@en-AU ;
