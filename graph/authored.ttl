    tmk:spanEnd 981 ;
    tmk:spanStart 826 ;
    tmk:supportingText "In addition, a stem may not be included meaningfully in a trade mark where its presence is clearly overwhelmed by the meaning of the trade mark as a whole." ;
    tmk:tier 3 .

tmka:GR-0136 a tmk:AuthoredAssertion ;
