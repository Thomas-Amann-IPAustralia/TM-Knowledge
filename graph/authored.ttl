    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The reproduced judicial principles include the character of probable acquirers among surrounding circumstances. This supports a connection with the ordinary-consumer concept, although identifying probable acquirers with that concept is an inference rather than an express equivalence."@en-AU ;
    tmk:confidence 7.8e-01 ;
    tmk:expertShouldCheck "Whether the character of probable acquirers should be mapped to ordinary consumer or recorded as a separate factor."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0105" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:be7ebe89c273e99bd6bdd4f0a39584903353c1236cad36f992403c53c447dcc8" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/2%231> ;
    tmk:spanEnd 1804 ;
    tmk:spanStart 1595 ;
    tmk:supportingText "These include the circumstances in which the marks will be used, the circumstances in which the goods and services will be bought and sold and the character of the probable acquirers of the goods and services." ;
    tmk:tier 2 .

