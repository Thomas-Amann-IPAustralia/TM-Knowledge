    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly identifies the meaning of the whole trade mark as a factor that can negate meaningful inclusion of an INN stem. This is a qualification, not an unconditional exclusion."@en-AU ;
    tmk:confidence 9.8e-01 ;
    tmk:expertShouldCheck "Whether the neighbour should be confined here to the meaning of the whole trade mark rather than all its other features."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0135" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:66817de6196f7150720015e718aecdc209059307b7d11869b0767ecd18e8e89a" ;
