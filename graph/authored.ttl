tmkc:GC-0130 a skos:Concept,
        tmk:Context,
        tmk:LegalConcept ;
    rdfs:comment "The reputation a trade mark has acquired — the basis of the section 60 opposition ground and of a defensive registration (section 185). Not the reputation of a place or person, which is the signed GC-0050 and which excludes 'reputation in another trade mark' (owner's ruling A3: two separate concepts)."@en-AU ;
    skos:altLabel "reputation in Australia"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "reputation of a trade mark"@en-AU ;
    tmk:allocatesTo tmkc:GC-0117 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Relabelled on the owner's ruling A3 — reputation of a trade mark and reputation of a place are two separate concepts. This record's evidence (Part 34, sections 60 and 185) is about a trade mark's reputation, the sense the signed GC-0050 excludes."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/1/1/1> ;
    tmk:expertShouldCheck "Whether reputation under section 60 and under section 185 is one idea; this record still holds both."@en-AU ;
    tmk:goldRecord "GC-0130" ;
    tmk:labelKey "reputation in australia",
        "reputation of a trade mark" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s185>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s60> ;
    tmk:mayGiveRiseTo tmkc:GC-0003 ;
    tmk:notLabel "connotation"@en-AU,
        "evidence of use"@en-AU,
        "use of a trade mark"@en-AU ;
    tmk:notLabelKey "connotation",
        "evidence of use",
        "use of a trade mark" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "reputation of a trade mark" ;
