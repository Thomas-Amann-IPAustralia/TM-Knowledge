    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states the position and its statutory basis in one sentence."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part21/3%231> ;
    tmk:expertShouldCheck "Whether the historical Coca-Cola position belongs in the record. It is in the same passage and this record leaves it in the notes rather than the labels."@en-AU ;
    tmk:goldRecord "GC-0075" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/sign> ;
    tmk:notLabel "colour trade mark"@en-AU,
