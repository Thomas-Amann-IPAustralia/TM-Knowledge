tmkc:GC-0126 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "A term entered on the Register of Protected Geographical Indications and Other Terms (the Wine Register) under the Wine Australia Act 2013 — Australian and European wine geographical indications, traditional expressions, quality wine terms and additional terms. Wine has a dedicated statutory scheme, unlike other geographical indications, which are principally protected through certification trade marks (owner's ruling A4)."@en-AU ;
    skos:altLabel "term on the Wine Register"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "term protected under the Wine Australia Act"@en-AU ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Part 32B says the Wine Australia Act protects certain terms and that the Wine Register lists them; that list, not wine geographical indications alone, is what an examiner checks under s 42(b). Wine GIs are one category of it and have a concept of their own (GC-0169). Part 32B.2 examines a Wine Register entry under s 42(b), which is now the first legislative basis."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/1/1/1> ;
    tmk:expertShouldCheck "Whether the four Wine Register categories need concepts of their own beyond wine GIs."@en-AU ;
    tmk:goldRecord "GC-0126" ;
    tmk:isProtectedThrough tmkc:GC-0170 ;
    tmk:labelKey "term on the wine register",
        "term protected under the wine australia act" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s42(b)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s43>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s61> ;
    tmk:mayGiveRiseTo tmkc:GC-0063 ;
    tmk:notLabel "geographical indication"@en-AU,
        "geographical name"@en-AU,
        "plant varietal name"@en-AU ;
    tmk:notLabelKey "geographical indication",
        "geographical name",
        "plant varietal name" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "term protected under the wine australia act" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/1/1/1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/1/1/3>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/2/1%231> ;
    tmk:typedBy tmka:GT-0126 .

tmkc:GC-0144 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: A subpoena is a court-issued document requiring a named person to attend court to give oral evidence, produce documents or other things, or both."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "subpoena"@en-AU ;
    skos:related tmkc:GC-0046,
        tmkc:GC-0131 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly defines a subpoena as a court-issued document and describes its service on, and handling by, the Registrar of Trade Marks. It is a distinct procedural instrument, not a goods or services category, generic phrase or existing concept. The Manual passages describe practice and court requirements; they do not establish that the cited Trade Marks Act provisions ground the concept."@en-AU ;
    tmk:confidence 9.9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part54/1/1/1> ;
    tmk:expertShouldCheck "Check the relevance of TMA1995/s154 and TMA1995/s202(b): their text is not supplied, so their relationship to subpoenas cannot be verified from these passages."@en-AU ;
    tmk:goldRecord "GC-0144" ;
    tmk:labelKey "subpoena" ;
    tmk:notLabel "service of a subpoena"@en-AU,
        "subpoena for production"@en-AU,
        "subpoena to give evidence"@en-AU ;
    tmk:notLabelKey "service of a subpoena",
        "subpoena for production",
        "subpoena to give evidence" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "subpoena" ;
