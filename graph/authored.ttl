tmkc:GC-0111 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "A claim under the Paris Convention that moves the priority date back to an earlier foreign filing. The Manual defines 'Convention country' by two routes — Paris signatory or full WTO member — which is worth carrying because they are not the same set."@en-AU ;
    skos:altLabel "claim for priority"@en-AU,
        "convention claim"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "convention application"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual defines the country; the application type is the mechanism built on it. The record is honest that the evidence carries the first more strongly than the second."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1/1/2> ;
    tmk:expertShouldCheck "Whether 'Convention country' should be a separate concept. Its definition is the evidence this record rests on, which is an argument that it should."@en-AU ;
    tmk:goldRecord "GC-0111" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29> ;
    tmk:notLabel "divisional application"@en-AU,
        "international registration"@en-AU,
        "priority date"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1/1/2> ;
    tmk:typedBy tmka:GT-0111 .

tmkc:GC-0124 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Part 6 of the Act governs amendment before registration and Division 1 of Part 8 after it — two regimes, and which one applies depends on where the mark has got to."@en-AU ;
    skos:altLabel "amendment"@en-AU,
        "amendments"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "amendment of an application"@en-AU ;
    skos:related tmkc:GC-0121 ;
    tmk:appliesTo tmkc:GC-0012 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states both regimes and their boundary in one sentence. Amending the specification is also one of the Manual's named ways of overcoming a section 44 ground, which is why this concept matters to examination and not only to administration."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part9/1%231> ;
    tmk:expertShouldCheck "Whether amendment before and after registration are one concept. The Act's structure argues they are two."@en-AU ;
    tmk:goldRecord "GC-0124" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s63>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s64>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83> ;
    tmk:notLabel "divisional application"@en-AU,
        "rectification of the Register"@en-AU,
        "withdrawal"@en-AU ;
