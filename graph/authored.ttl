    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether the neighbour’s broader capacity-to-distinguish concept appropriately includes inherent capacity to distinguish."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
