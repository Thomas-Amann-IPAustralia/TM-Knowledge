tmkc:GC-0089 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "Kept under section 207. The Act also defines 'old register' and the Regulations define a 'Record of International Registrations', and the three must not be merged — an entry in one is not an entry in another."@en-AU ;
    skos:altLabel "Register"@en-AU,
        "the Register"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Register of Trade Marks"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms. Held with the near-misses named because the corpus contains three registers and the Madrid Part turns on the distinction."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part39/1%231> ;
    tmk:expertShouldCheck "Whether the preferred label should be 'Register' as the Act has it. This record uses the fuller form because 'Register' alone collides with the other two registers."@en-AU ;
    tmk:goldRecord "GC-0089" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207>,
