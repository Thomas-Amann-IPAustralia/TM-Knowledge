    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/4>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/7> .

tmka:GT-0042 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "An acceptance is undone and the application returns to an earlier state. A transition."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "GC-0042 (signed) and GC-0094 (authored) are both 'revocation of acceptance'. Both are typed procedural_step and neither displaces the other."@en-AU ;
    tmk:goldRecord "GT-0042" ;
