    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects size and placement within the whole mark with the assessment of inherent adaptation to distinguish. This supports treating whole-mark features as qualifying that assessment, without generalising the example into a legislative rule."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether the anchor encompasses size and placement of an acronym within a composite mark."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0446" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:1d0ca984f70e8f1f2cf8f7afea5c49ce03b0a429ef6b1590263e5b333dda94ee" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/8/8/5/1> ;
    tmk:spanEnd 1733 ;
    tmk:spanStart 1542 ;
    tmk:supportingText "Example shown below would be inherently adapted to distinguish risk evaluation services as the size and placement of the acronym renders the trade mark, as a whole, capable of distinguishing." ;
    tmk:tier 3 .

tmka:GR-0447 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0058 ;
    tmk:assertionPredicate tmk:qualifies ;
