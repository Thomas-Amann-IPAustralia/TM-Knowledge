    tmk:confidence 8.4e-01 ;
    tmk:expertShouldCheck "Whether qualifies should target a separate parent-amendment requirement rather than the broader divisional-application concept."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0170" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:9406c7d3659f50cebafa4383dc3e816f2383b5aef6d6a886a11257a7517ab0c0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/3/3/3~1> ;
    tmk:spanEnd 261 ;
    tmk:spanStart 0 ;
    tmk:supportingText "If a divisional application is considered valid, section 46(2) requires the Registrar to, unless the parent application has since lapsed, amend the parent application by excluding the goods and/or services in respect of which the divisional application is made." ;
    tmk:tier 3 .

tmka:GR-0171 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0045 ;
    tmk:assertionPredicate tmk:appliesTo ;
    tmk:assertionSubject tmkc:GC-0051 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual's explanation clearly supports applying the mandatory acceptance constraint to the decision maker, subject to the stated requirement of clear satisfaction. The role-specific application is inferred rather than expressly stated in the sentence denying discretion."@en-AU ;
    tmk:confidence 8.7e-01 ;
    tmk:expertShouldCheck "Whether appliesTo appropriately connects this mandatory requirement to a process role."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0171" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:b6690f96b0ebc5181ac9b42c2669b0de831371538a8cc414e94d5e54796ceeff" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:spanEnd 777 ;
    tmk:spanStart 435 ;
    tmk:supportingText "There is, therefore, no discretion to accept a trade mark that is caught by the provisions of this section. However for a trade mark to be caught by these provisions it is necessary for a decision maker to be clearly satisfied that use of the trade mark for the specified goods and / or services would be likely to deceive or cause confusion." ;
    tmk:tier 3 .

tmka:GR-0172 a tmk:AuthoredAssertion ;
