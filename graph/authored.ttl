    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/7/22/7/3> ;
    tmk:spanEnd 346 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The ordinary signification of a sign is determined by reference to those ‘persons who will purchase, consume or trade in the goods’ (Cantarella at [59], see also at [75]) or ‘any person in Australia concerned with the goods’ (Cantarella at [70]), which the High Court also referred to as the ‘target audience’ (Cantarella at [28], [30] and [71])." ;
    tmk:tier 3 .

tmka:GR-0212 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0060 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0005 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly identifies an alternative primary meaning as a circumstance that can affect whether the ordinary signification is geographical. The relationship is conditional, not an assertion that primary meaning and ordinary signification are always identical."@en-AU ;
    tmk:confidence 9.2e-01 ;
    tmk:expertShouldCheck "Whether the primary-meaning record denotes the audience-understood meaning contemplated by this passage."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0212" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:6faf8d041a78624c617a49597c119c0a2483797145a953f4fb524858fb7ca707" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/15/15/1~2> ;
    tmk:spanEnd 1892 ;
    tmk:spanStart 1672 ;
    tmk:supportingText "If there is a primary meaning for a sign other than the geographical name, the ordinary signification of the sign may not be that of the geographical name and the sign may be inherently adapted to distinguish the claims." ;
    tmk:tier 3 .

