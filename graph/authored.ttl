    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual says deception or confusion is not likely where the geographical reference is ambiguous or fanciful — the test is not met. Written on the owner's ruling B1 (ADR-0126): what a concept does is an edge naming the ground or test it acts on."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Whether a fanciful reference never meets the test or only usually does not."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0701" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:17c928f3bdc152f1ba5a886c36379eb9e74ab1b2afcb0cef15aa9cc5ee4cf3d6" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9%231> ;
    tmk:spanEnd 1864 ;
    tmk:spanStart 1565 ;
    tmk:supportingText "Deception or confusion is not likely to occur if the geographic reference is ambiguous or fanciful (FORGED IN THE OUTBACK on Vehicles, ANTARCTIC BERRIES for Frozen strawberries) or when a word will not be seen as a geographical reference in the eyes of an average consumer (MOCHA for confectionery)." ;
    tmk:tier 3 .

