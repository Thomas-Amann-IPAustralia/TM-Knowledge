    tmk:isStale false ;
    tmk:kindOfAffirmed "\"Under the Madrid Protocol assignment and transmission of a trade mark are known as change of ownership\" (Part 60.4.24.2): a transmission is one kind of change of ownership, and \"change of ownership\" does not name it alone."@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
