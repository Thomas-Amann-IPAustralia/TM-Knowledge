    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0512" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:bbb448dfa5dc6eb0abb00c9f61a31096c1992d37d2c0b960e0c6e00f43b122b1" ;
