    tmk:spanEnd 889 ;
    tmk:spanStart 669 ;
    tmk:supportingText "The tests lie in the perception of the ordinary person, as noted by Kitto J in Southern Cross Refrigerating Co v Toowoomba Foundry Pty Ltd [1954] HCA 82 at [4] (referred to with approval by French J in Woolworths Metro):" ;
    tmk:tier 3 .

tmka:GR-0086 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0003 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0037 ;
