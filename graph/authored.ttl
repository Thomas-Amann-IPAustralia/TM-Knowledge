    tmk:spanEnd 175 ;
    tmk:spanStart 0 ;
    tmk:supportingText "There are no provisions for extensions of time in the Madrid Protocol. A holder of an IRDA may however, take advantage of IP Australia's existing extension of time provisions." ;
    tmk:tier 2 .

tmka:GR-0280 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0092 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0112 ;
