    tmk:supportingText "4.2.1 Where deferment has been requested for the purpose of gathering evidence to prove “prior use”, “honest concurrent use” or “other circumstances”, the examiner’s report is checked to ensure that a section 44 ground for rejection has been raised." ;
    tmk:tier 2 .

tmka:GR-0231 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0093 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0068 ;
