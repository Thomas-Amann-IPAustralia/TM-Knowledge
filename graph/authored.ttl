    tmk:spanEnd 188 ;
    tmk:spanStart 0 ;
    tmk:supportingText "It may be possible for the applicant to overcome a citation by filing evidence of use or other circumstances which would allow the application to proceed under s 44(3) or 44(4) of the Act." ;
    tmk:tier 3 .

tmka:GR-0231 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0093 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0068 ;
