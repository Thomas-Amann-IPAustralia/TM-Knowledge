    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The same office as GC-0046, reached from Part 52 and the section 6 definition rather than from Part 29. Section 205 makes a Deputy Registrar's exercise of a power the Registrar's, which is a statement about who acts."@en-AU ;
    tmk:conceptGroup "process_role" ;
    tmk:confidence 7.5e-01 ;
    tmk:expertShouldCheck "Whether GC-0115 and the signed GC-0046 are the same concept. If they are, the merge is a vocabulary decision that retires one id, and nothing in this typing should be read as endorsing the split."@en-AU ;
    tmk:goldRecord "GT-0115" ;
