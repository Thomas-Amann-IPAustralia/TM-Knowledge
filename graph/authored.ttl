    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The open, inclusive category section 6 defines and section 17 builds on. The widest thing in the vocabulary, and still a thing."@en-AU ;
    tmk:conceptGroup "subject_matter" ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Nothing on the group. The pairing with GC-0072 is what to look at — the two are typed identically and the Manual's whole point is that they differ."@en-AU ;
    tmk:goldRecord "GT-0073" ;
