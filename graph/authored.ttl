    tmk:authoringReasoning "The Manual expressly describes determining the ordinary signification of a sign. This supports applying the ordinary-signification assessment to signs, with meaning assessed by reference to the relevant audience."@en-AU ;
    tmk:confidence 9.4e-01 ;
    tmk:expertShouldCheck "Whether appliesTo is appropriate for an assessment of a sign’s meaning rather than a provision applying to subject matter."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0211" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:081b45d6a3bf620d41577222325905dc7b22e29e23052acec1fbb9f4cdd94d56" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/7/22/7/3> ;
    tmk:spanEnd 346 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The ordinary signification of a sign is determined by reference to those ‘persons who will purchase, consume or trade in the goods’ (Cantarella at [59], see also at [75]) or ‘any person in Australia concerned with the goods’ (Cantarella at [70]), which the High Court also referred to as the ‘target audience’ (Cantarella at [28], [30] and [71])." ;
    tmk:tier 3 .

tmka:GR-0212 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0060 ;
