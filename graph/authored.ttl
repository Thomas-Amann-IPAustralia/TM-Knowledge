tmka:GR-0478 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-judged on 2026-10-08 by S026 under the owner's ruling D5 (review/rulings/2026-10-08-chat-ontology-review.yaml). The evidence is the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0064 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0154 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The sentence is the section 44 'one practical judgement' principle: a substantially identical or deceptively similar mark on similar goods usually attracts a citation."@en-AU ;
    tmk:confidence 7.5e-01 ;
    tmk:expertShouldCheck "The subject was the s 43 'confusion' concept, which excludes section 44 confusion (D5 sample)."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0478" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ca94aaf4bca44f15972702623bd772b5d12c2a453fc5ef45a1d61d8603f22dc8" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/4/4/3/1~3> ;
    tmk:spanEnd 543 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Applying the one practical judgement principle endorsed by the Federal Court, while each case must be considered on its merits, generally speaking, the use of a substantially identical trade mark, (or a deceptively similar trade mark approaching the level of substantial identity), in relation to goods which are generally sold through retail/wholesale channels, and retail/wholesale services for selling such goods, would give rise to a real, tangible danger of confusion. In such cases, a ground for rejection under s 44 will be appropriate." ;
    tmk:tier 3 .

tmka:GR-0479 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-08 by S026: subject GC-0053 -> GC-0006 — ground-for-rejection edges sorted between the general concept GC-0006 and the section 43 ground GC-0168 by whether the sentence is about section 43 (ruling A2). The judgement and evidence are the original author's. Re-pointed on 2026-10-09 by S027: subject GC-0006 -> GC-0182 — ground-for-rejection edges whose sentence is about section 39 point at that section's ground (ruling B4). The judgement and evidence are the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0029 ;
    tmk:assertionPredicate tmk:isOvercomeBy ;
    tmk:assertionSubject tmkc:GC-0182 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual identifies competent-authority consent as a means of avoiding the subsection 39(2) ground. Treating this as overcoming the ground is an inference; the passage also does not expressly require written consent."@en-AU ;
    tmk:confidence 7.8e-01 ;
    tmk:expertShouldCheck "Whether avoiding a ground falls within the intended scope of isOvercomeBy."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0479" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:e0a8f61449b9539c0337def16e84fd8edbf15d5e40a7edd94c0a9e992341b7af" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part31/4/4/3> ;
    tmk:spanEnd 442 ;
    tmk:spanStart 218 ;
    tmk:supportingText "If an examiner becomes aware that a trade mark includes such matter the applicant should be requested to provide consent to its use from the competent authority in order to avoid a ground of rejection under subsection 39(2)." ;
    tmk:tier 3 .

tmka:GR-0482 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0078 ;
