    tmk:authoringReasoning "The Manual lists the section 41 ground among the 'absolute' grounds for rejection in sections 39 to 43."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0693" ;
    tmk:isStale false ;
