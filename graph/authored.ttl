tmka:GT-0044 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Part 29 passages this record rests on describe what the examiner does — considers the marketplace, checks the mark against the INN list. That is an office that acts, and a person who makes a judgement is not the content of the judgement."@en-AU ;
    tmk:conceptGroup "process_role" ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Whether examiner, decision maker and Registrar are three roles or three names used loosely for one. GC-0044, GC-0045 and GC-0046 hold them apart on the concept records, all three are typed process_role here, and this typing inherits the question rather than answering it."@en-AU ;
    tmk:goldRecord "GT-0044" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/3> .

