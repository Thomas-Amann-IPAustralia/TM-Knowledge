    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects the Protocol with IRDAs by contrasting the absence of Protocol extension provisions with the availability of IP Australia's provisions to IRDA holders. This supports a contextual relationship, not a Protocol requirement governing extensions."@en-AU ;
    tmk:confidence 8.7e-01 ;
    tmk:expertShouldCheck "Whether this procedural contrast supports a concept-level relationship rather than merely contextual association."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0279" ;
