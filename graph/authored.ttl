    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual's account of the Act expressly connects a prescribed sign in a trade mark with possible rejection. It supports a potential ground for rejection, not automatic rejection or classification of the sign itself as a ground."@en-AU ;
    tmk:confidence 9.5e-01 ;
    tmk:expertShouldCheck "Whether this neighbour's inclusion of 's 43 objection' improperly narrows an otherwise generic ground-for-rejection record."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0198" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
