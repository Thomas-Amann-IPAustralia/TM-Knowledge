    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms by the Manual. The near-miss against certification marks is drawn from the same passage."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part33/1%231> ;
    tmk:expertShouldCheck "The spelling. The Manual's own heading writes 'collective trademark' as one word and the body writes two; this record prefers the two-word form and keeps the other as an alt_label."@en-AU ;
    tmk:goldRecord "GC-0108" ;
    tmk:isExcludedFrom tmkc:GC-0086,
