tmka:GT-0072 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "What the whole process is about. Section 17 defines a trade mark as a sign used or intended to be used to distinguish, and Part 20 records that the definition is closed. The concept names the thing; it refuses, tests, weighs and excepts nothing."@en-AU ;
    tmk:conceptGroup "subject_matter" ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Whether the vocabulary should hold 'trade mark' the object and 'is a trade mark' the test as two concepts. One group cannot carry both, and this record takes the object reading."@en-AU ;
    tmk:goldRecord "GT-0072" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s17> .

