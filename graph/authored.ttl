tmka:GR-0484 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-read on 2026-10-09 from a second model's audit (gemini-3.1-pro-preview, audit-v1): was GC-0059 statesThresholdFor GC-0119. Re-read on 2026-10-09 in the structure review (ADR-0131): was GC-0059 related GC-0119."@en-AU ;
    tmk:assertionObject tmkc:GC-0119 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
