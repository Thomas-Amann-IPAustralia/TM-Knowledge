    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects the meaningful presence of an INN stem with the possibility of a connotation. The relationship is conditional, not an automatic consequence of including a stem."@en-AU ;
    tmk:confidence 9.7e-01 ;
