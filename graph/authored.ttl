    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/1~1> ;
    tmk:spanEnd 139 ;
    tmk:spanStart 0 ;
    tmk:supportingText "There must be a real and obvious danger of the buying public being deceived and/or confused by the secondary meaning within the trade mark." ;
    tmk:tier 3 .

tmka:GR-0062 a tmk:AuthoredAssertion ;
