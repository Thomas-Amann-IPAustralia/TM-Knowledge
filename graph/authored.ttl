tmkc:GC-0121 a skos:Concept,
        tmk:ExternalInstrument,
        tmk:LegalConcept ;
    rdfs:comment "The largest Part of the Manual by chunk count — 743 of 2,460 — and the one most easily confused with the similarity question. Part 26 says in terms that classification does not determine similarity."@en-AU ;
    skos:altLabel "classes"@en-AU,
        "classification"@en-AU,
        "the Nice Classification"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "classification of goods and services"@en-AU ;
    skos:related tmkc:GC-0044 ;
    tmk:appliesTo tmkc:GC-0025 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Held mainly to carry the near-miss: a third of the Manual is classification and the single most valuable thing the vocabulary can say about it is that it does not answer the section 44 question."@en-AU ;
    tmk:confidence 7.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part14/1%231~1> ;
    tmk:expertShouldCheck "Whether the individual classes should be concepts. This pass says no; the candidate pass found 348 class headings and they are all in `review/candidates/`."@en-AU ;
    tmk:goldRecord "GC-0121" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r3.1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.4> ;
    tmk:notLabel "similarity of goods and services"@en-AU,
        "specification of goods and services"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part14/1%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/4%231> ;
    tmk:typedBy tmka:GT-0121 .

tmkc:GC-0128 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Section 33(4) makes an opportunity to be heard a precondition of rejection, which is what ties hearings to examination rather than to opposition alone."@en-AU ;
    skos:altLabel "ex parte hearing"@en-AU,
        "inter partes hearing"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "hearing"@en-AU ;
    skos:related tmkc:GC-0040,
        tmkc:GC-0102 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 33(4) states the entitlement in terms. The concept is drawn from the Act rather than from Part 51, because Part 51's opening is about how evidence is filed rather than about what a hearing is."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part51/1%231~1> ;
    tmk:expertShouldCheck "Whether ex parte and inter partes hearings are one concept. The Manual gives them different procedures."@en-AU ;
    tmk:goldRecord "GC-0128" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s202>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(4)> ;
    tmk:notLabel "decision"@en-AU,
        "examination"@en-AU,
        "opposition"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> ;
    tmk:typedBy tmka:GT-0128 .

