tmka:GT-0121 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Nice Classification, given effect by the Regulations. A scheme originating outside the Act that Australian practice adopts."@en-AU ;
    tmk:conceptGroup "external_instrument" ;
    tmk:confidence 5.5e-01 ;
    tmk:expertShouldCheck "The lowest-confidence typing in the 53. The concept conflates a scheme, an act and a set of classes; whichever of the three the vocabulary means decides the group, and this record takes the scheme. Splitting the concept would be a better answer than moving it."@en-AU ;
