tmka:GR-0171 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-judged on 2026-10-08 by S026 under the owner's ruling C4 (review/rulings/2026-10-08-chat-ontology-review.yaml). The evidence is the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0045 ;
    tmk:assertionPredicate tmk:constrainsRole ;
    tmk:assertionSubject tmkc:GC-0051 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The mandatory application of section 43 binds the decision maker: no discretion to accept a mark caught by it."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Nothing in the reading."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0171" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:b6690f96b0ebc5181ac9b42c2669b0de831371538a8cc414e94d5e54796ceeff" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:spanEnd 777 ;
    tmk:spanStart 435 ;
    tmk:supportingText "There is, therefore, no discretion to accept a trade mark that is caught by the provisions of this section. However for a trade mark to be caught by these provisions it is necessary for a decision maker to be clearly satisfied that use of the trade mark for the specified goods and / or services would be likely to deceive or cause confusion." ;
    tmk:tier 3 .

