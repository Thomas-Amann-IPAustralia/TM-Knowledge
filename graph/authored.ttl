tmkc:GC-0106 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Renewable indefinitely at ten-year intervals from the filing date, and — unusually — any person may effect it, not only the owner."@en-AU ;
    skos:altLabel "renewal"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "renewal of registration"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Both propositions are stated in terms in the one passage."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part40/1%231> ;
    tmk:expertShouldCheck "Nothing specific."@en-AU ;
    tmk:goldRecord "GC-0106" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s75>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s77> ;
    tmk:notLabel "registration"@en-AU,
        "restoration"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part40/1%231> ;
    tmk:typedBy tmka:GT-0106 .

tmkc:GC-0107 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Distinguishes certified goods or services from uncertified ones, and the certifying is done by the owner or an approved certifier. The ACCC has a role the ordinary registration process does not have."@en-AU ;
    skos:altLabel "CTM"@en-AU,
        "certification trade marks"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "certification trade mark"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms by the Manual with the section reference attached."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part35/1%231> ;
    tmk:expertShouldCheck "Whether the ACCC's role should be part of the concept or a separate relationship."@en-AU ;
    tmk:goldRecord "GC-0107" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s168>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s169>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/certification-trade-mark> ;
    tmk:notLabel "collective trade mark"@en-AU,
        "defensive trade mark"@en-AU,
        "trade mark"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part35/1%231> ;
    tmk:typedBy tmka:GT-0107 .

tmkc:GC-0108 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Distinguishes the goods or services of members of an association from those of non-members. The Manual's own contrast is the useful part: unlike a certification mark, use of a collective mark need not be subject to approved rules."@en-AU ;
    skos:altLabel "collective trade marks"@en-AU,
        "collective trademark"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "collective trade mark"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms by the Manual. The near-miss against certification marks is drawn from the same passage."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part33/1%231> ;
    tmk:expertShouldCheck "The spelling. The Manual's own heading writes 'collective trademark' as one word and the body writes two; this record prefers the two-word form and keeps the other as an alt_label."@en-AU ;
    tmk:goldRecord "GC-0108" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s162>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/collective-trade-mark> ;
    tmk:notLabel "certification trade mark"@en-AU,
        "defensive trade mark"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part33/1%231> ;
    tmk:typedBy tmka:GT-0108 .

tmkc:GC-0109 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Requires an existing registration and a reputation extensive enough that use on other goods would be taken to indicate a connection. It is the one registration in the Act that does not require an intention to use."@en-AU ;
    skos:altLabel "defensive registration"@en-AU,
        "defensive trade marks"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "defensive trade mark"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The passage states the qualifying condition, though in the past tense about the 1955 Act. The record is honest about that: the evidence is historical framing of a requirement the Manual carries forward, which is weaker than a current statement."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/1/1/1> ;
    tmk:expertShouldCheck "The evidence is a sentence about the 1955 Act. If Part 34 states the current requirement elsewhere, that passage should replace this one."@en-AU ;
    tmk:goldRecord "GC-0109" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s185>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/defensive-trade-mark> ;
    tmk:notLabel "certification trade mark"@en-AU,
        "collective trade mark"@en-AU,
        "registered trade mark"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/1/1/1> ;
    tmk:typedBy tmka:GT-0109 .

tmkc:GC-0110 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "A limited continuation of a parent application that keeps the parent's priority date but takes a new number. The priority-date inheritance is what makes it matter to section 44. GC-0043 already holds this term."@en-AU ;
    skos:altLabel "divisional"@en-AU,
        "divisional applications"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "divisional application"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Both the Act and the Manual state it. Written from Part 12 rather than the section 43 material GC-0043 rests on; the overlap is flagged."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/1%231> ;
    tmk:expertShouldCheck "The overlap with the signed GC-0043."@en-AU ;
    tmk:goldRecord "GC-0110" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/divisional-application> ;
    tmk:notLabel "convention application"@en-AU,
        "parent application"@en-AU,
        "series of trade marks"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/1%231> ;
    tmk:typedBy tmka:GT-0110 .

tmkc:GC-0111 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "A claim under the Paris Convention that moves the priority date back to an earlier foreign filing. The Manual defines 'Convention country' by two routes — Paris signatory or full WTO member — which is worth carrying because they are not the same set."@en-AU ;
    skos:altLabel "claim for priority"@en-AU,
        "convention claim"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "convention application"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual defines the country; the application type is the mechanism built on it. The record is honest that the evidence carries the first more strongly than the second."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1/1/2> ;
    tmk:expertShouldCheck "Whether 'Convention country' should be a separate concept. Its definition is the evidence this record rests on, which is an argument that it should."@en-AU ;
    tmk:goldRecord "GC-0111" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s29>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r21.29> ;
    tmk:notLabel "divisional application"@en-AU,
        "international registration"@en-AU,
        "priority date"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1/1/2> ;
    tmk:typedBy tmka:GT-0111 .

tmkc:GC-0112 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "A treaty, administered by WIPO's International Bureau, under which one application in English with one set of fees produces one international registration. Everything in Part 60 hangs off it."@en-AU ;
    skos:altLabel "Protocol"@en-AU,
        "the Madrid Protocol"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Madrid Protocol"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms at the head of the Manual's largest Part."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/1/1/1> ;
    tmk:expertShouldCheck "Whether the bare 'Protocol' is safe as an alt_label. The Regulations define 'Protocol' separately in regulation 17A.2 and the two may not be the same term."@en-AU ;
    tmk:goldRecord "GC-0112" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r2.1/madrid-protocol> ;
    tmk:notLabel "IRDA"@en-AU,
        "Paris Convention"@en-AU,
        "international registration"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/1/1/1> ;
    tmk:typedBy tmka:GT-0112 .

tmkc:GC-0113 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The Australian half of a Madrid registration. It is examined much as a domestic application is, which is why the Manual's Parts 26 to 31 keep referring to it, and it becomes a protected international trade mark rather than a registered trade mark."@en-AU ;
    skos:altLabel "IRDA"@en-AU,
        "international registration designating Australia (IRDA)"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "international registration designating Australia"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Regulations define the term by pointing at another regulation whose text this record does not quote, so the basis is inferred rather than explicit. It is held because 86 Manual passages use the abbreviation and the vocabulary could not read them."@en-AU ;
    tmk:confidence 6e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/1/1/1> ;
    tmk:expertShouldCheck "The evidence. This record's statutory citation is a pointer, not a definition, and the definition it points at should replace it."@en-AU ;
    tmk:goldRecord "GC-0113" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r2.1/irda> ;
    tmk:notLabel "international registration"@en-AU,
        "protected international trade mark"@en-AU,
        "trade mark application"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/1/1/1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r2.1/irda> ;
    tmk:typedBy tmka:GT-0113 .

tmkc:GC-0114 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "The Madrid equivalent of a registered trade mark, and section 44's note 4 makes it citable against a domestic application. Holding it apart from 'registered trade mark' is what lets a citation search reach both."@en-AU ;
    skos:altLabel "protected international trade mark designating Australia"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "protected international trade mark"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 44's note names the term and states its effect on examination, which is the operative fact. The Regulations' own definition is a pointer, as with IRDA."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part60/1/1/1> ;
    tmk:expertShouldCheck "The definition source is a Part 60 passage about the Protocol generally rather than about protection specifically."@en-AU ;
    tmk:goldRecord "GC-0114" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.2>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r2.1/protected-international-trade-mark> ;
    tmk:notLabel "IRDA"@en-AU,
        "international registration"@en-AU,
        "registered trade mark"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44> ;
    tmk:typedBy tmka:GT-0114 .

tmkc:GC-0115 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Almost every duty and discretion in the Act is the Registrar's. Section 205 makes a Deputy Registrar's exercise of a power count as the Registrar's, which is why decisions issued by a Deputy are the Registrar's decisions. GC-0046 already holds this term."@en-AU ;
    skos:altLabel "Registrar"@en-AU,
        "the Registrar"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Registrar of Trade Marks"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined by the Act, and the Manual supplies the delegation rule that makes the role behave the way examiners meet it. Overlaps the signed GC-0046 and says so."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part52/1%231~2> ;
    tmk:expertShouldCheck "The overlap with the signed GC-0046, and whether the section 205 point belongs in this concept or in a separate 'Deputy Registrar' one."@en-AU ;
    tmk:goldRecord "GC-0115" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s200>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/registrar> ;
    tmk:notLabel "Deputy Registrar"@en-AU,
        "delegate"@en-AU,
        "prescribed court"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/registrar>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part52/1%231~2> ;
    tmk:typedBy tmka:GT-0115 .

tmkc:GC-0116 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Defined by the Act as the person in whose name the application currently stands — so the applicant can change without the application changing. The Manual's Part 10 treats getting the identity right as a formality requirement in its own right."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "applicant"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms, and the 'for the time being' clause is the part worth keeping — it is what makes assignment of a pending application coherent."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part10/1%231> ;
    tmk:expertShouldCheck "Whether the definition source should be Part 10.1 on the name requirement or a passage about who may apply under section 27."@en-AU ;
    tmk:goldRecord "GC-0116" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s27>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/applicant> ;
    tmk:notLabel "authorised user"@en-AU,
        "opponent"@en-AU,
        "registered owner"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/applicant> ;
    tmk:typedBy tmka:GT-0116 .

tmkc:GC-0117 a skos:Concept,
        tmk:LegalConcept ;
    rdfs:comment "Defined in five different places across the Regulations as well as in section 6 — one per opposition type. The multiplicity is real and this record does not resolve it."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "opponent"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states who an opponent generally is. The statutory definitions differ by proceeding and are deliberately not merged here (CLAUDE.md rule 6)."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part46/1%231> ;
    tmk:expertShouldCheck "Whether the six statutory definitions of 'opponent' are the same concept. The candidate pass found them and refused to choose; this record inherits that refusal."@en-AU ;
    tmk:goldRecord "GC-0117" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/opponent>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.2> ;
    tmk:notLabel "applicant"@en-AU,
        "objector"@en-AU,
        "requester"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part46/1%231> ;
    tmk:typedBy tmka:GT-0117 .

tmkc:GC-0118 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "The Manual is careful here and the record follows it: the expression does not appear in the Act. It is a reading of section 33's structure, endorsed by Branson J in Blount, that the Registrar must accept unless satisfied of a ground. GC-0007 already holds this term."@en-AU ;
    skos:altLabel "presumption that a trade mark is registrable"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "presumption of registrability"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Two passages, and they are in mild tension — Part 20.4 asserts the presumption and Part 22.2 says the expression is not in the Act. Both are quoted rather than reconciled, because the tension is the interesting part and resolving it would be authoring a position the corpus does not take."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/4%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/2%231> ;
    tmk:expertShouldCheck "Whether the two passages really are in tension or whether Part 22.2 is only saying the phrase is not a statutory term. The record takes the second reading and quotes both."@en-AU ;
    tmk:goldRecord "GC-0118" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(1)> ;
    tmk:notLabel "acceptance"@en-AU,
        "ground for rejection"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/4%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/2%231> ;
    tmk:typedBy tmka:GT-0118 .

tmkc:GC-0119 a skos:Concept,
        tmk:LegalConcept,
        tmk:LegalTest ;
    rdfs:comment "The first of the Manual's three categories. A mark is here if it has no ordinary signification for the goods, or has one that other traders are not likely to want without improper motive."@en-AU ;
    skos:altLabel "prima facie capable"@en-AU,
        "sufficiently inherently adapted to distinguish"@en-AU ;
