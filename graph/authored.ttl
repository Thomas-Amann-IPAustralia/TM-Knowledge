tmkc:GC-0096 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "The Manual's own gloss is the useful part: the acceptance period is 'set in abeyance'. That distinguishes it from an extension of time, which lengthens a period rather than suspending it."@en-AU ;
    skos:altLabel "defer acceptance"@en-AU,
        "deferment"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "deferment of acceptance"@en-AU ;
    skos:related tmkc:GC-0066,
        tmkc:GC-0067,
        tmkc:GC-0093 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual defines it in terms and contrasts it implicitly with the ordinary acceptance period."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part17/1%231> ;
    tmk:expertShouldCheck "Whether abeyance and extension really are different in effect, or only in procedure. The record asserts the first on the strength of one word."@en-AU ;
    tmk:goldRecord "GC-0096" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s36>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s37(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.12> ;
    tmk:notLabel "acceptance"@en-AU,
        "extension of time"@en-AU,
        "lapsing"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part17/1%231> ;
    tmk:typedBy tmka:GT-0096 .

tmkc:GC-0122 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Applications are examined in filing order unless the Registrar reasonably believes expedition is warranted. Note the modality — the Registrar *may* expedite, on a reasonable belief."@en-AU ;
    skos:altLabel "expedite examination"@en-AU ;
    skos:broader tmkc:GC-0092 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "expedited examination"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Stated in terms with both regulations cited."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part6/1%231> ;
    tmk:expertShouldCheck "Nothing specific."@en-AU ;
    tmk:goldRecord "GC-0122" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.18>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.19> ;
    tmk:notLabel "deferment of acceptance"@en-AU,
        "examination"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part6/1%231> ;
    tmk:typedBy tmka:GT-0122 .

tmkc:GC-0010 a tmk:RelevantFactor ;
    skos:related tmkc:GC-0036 ;
    tmk:qualifies tmkc:GC-0001,
