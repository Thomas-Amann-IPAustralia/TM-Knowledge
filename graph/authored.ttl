    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The party that brings an opposition. The Part 46 passage behind this record describes who may be one and who usually is."@en-AU ;
    tmk:conceptGroup "process_role" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "GC-0117's record notes the term is defined in five places across the Regulations, one per opposition type. If those are different parties rather than one, the group holds and the concept does not."@en-AU ;
