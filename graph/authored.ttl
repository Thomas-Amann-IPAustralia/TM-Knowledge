    tmk:spanEnd 373 ;
    tmk:spanStart 192 ;
    tmk:supportingText "Some INN stems consist of simple two or three letter combinations and their presence in a larger word may not be meaningful and as a result would not lead to deception or confusion." ;
    tmk:tier 3 .

tmka:GR-0420 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0002 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0025 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects the likelihood of deception or confusion to whether the pharmaceutical or veterinary goods are restricted to the substance indicated by the INN. This supports a qualifying-factor relationship, not a claim that these goods inherently cause deception or confusion."@en-AU ;
    tmk:confidence 8.4e-01 ;
    tmk:expertShouldCheck "Whether the qualifying factor should instead be represented by a separate concept for restriction to the INN-designated substance."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0420" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:86800dcce4d41f73e2792ad626162693402011f3c8ba4135bbf91f045f2a7b2f" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/4> ;
    tmk:spanEnd 434 ;
    tmk:spanStart 0 ;
    tmk:supportingText "A ground for rejection under section 43 exists where a trade mark, or part of a trade mark, to be used in relation to pharmaceuticals or veterinary substances is the same as, or may connote, a notified INN and use of the trade mark in respect of the goods covered by the specification are not restricted to the particular substance indicated by the INN. Use of such a trade mark would be likely to give rise to deception or confusion." ;
    tmk:tier 3 .

