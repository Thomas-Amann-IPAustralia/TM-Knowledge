    tmk:spanStart 0 ;
    tmk:supportingText "The assignment of a certification trade mark follows the same processes as that of a partial assignment or a full assignment. However additional requirements apply for the recording of assignment of certification trade marks." ;
    tmk:tier 3 .

tmka:GR-0274 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0108 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0107 ;
