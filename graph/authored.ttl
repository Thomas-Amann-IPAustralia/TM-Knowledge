tmka:GT-0052 tmk:authoredBy "claude-code-agent-S027" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "examiner research is the research an examiner does during examination: an act, proceeding or event that moves an application or a registration from one state to the next — so `procedural_step`. Retyped on the owner's ruling B1 of 2026-10-09 (ADR-0126): a kind says what a concept is, and what it does is an edge. What it does is on its edges: GR-0046 constrains the examiner on phoneword; GR-0186 may give rise to section 41 ground for rejection; GR-0187 may give rise to section 41 ground for rejection; GR-0189 qualifies capable of distinguishing."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 6e-01 ;
    tmk:expertShouldCheck "Whether this is a step that moves the application on, or an activity inside one."@en-AU ;
    tmk:goldRecord "GT-0052" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6%231~1>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/4> .

tmka:GT-0054 tmk:authoredBy "claude-code-agent-S027" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "prohibited sign is a sign that regulations under section 18 say is not to be used as a trade mark, as a mark may contain one: something a trade mark contains or conveys — a word, name, image or sign within it, or a meaning — so `sign_content`. Retyped on the owner's ruling B1 of 2026-10-09 (ADR-0126): a kind says what a concept is, and what it does is an edge. What it does is on its edges: GR-0481 may give rise to section 39 ground for rejection."@en-AU ;
    tmk:conceptGroup "sign_content" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether this is better read as something about the mark's context than about what the mark itself contains or conveys."@en-AU ;
    tmk:goldRecord "GT-0054" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s39> .

