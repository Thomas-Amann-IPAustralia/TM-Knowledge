    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects a meaningful INN-stem connotation with likely deception. This supports a possible causal relationship, not a claim that every connotation is deceptive."@en-AU ;
    tmk:confidence 9.7e-01 ;
    tmk:expertShouldCheck "Whether the relationship should be restricted explicitly to meaningful INN-stem connotations."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0059" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
