tmkc:GC-0092 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Section 31 gives examination two subjects and only two: whether the application was made in accordance with the Act, and whether there are grounds for rejecting it. Section 33 then makes acceptance the default unless the Registrar is satisfied of one of those."@en-AU ;
    skos:altLabel "examine and report"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "examination"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 31 states the duty and its two subjects in one sentence. Held because the whole corpus is an examination manual and the vocabulary had no word for the activity it describes."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/5%231> ;
    tmk:expertShouldCheck "Whether the definition source should be a Part 5 or Part 6 passage about the examination process rather than Part 20.5 on grounds."@en-AU ;
    tmk:goldRecord "GC-0092" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s31>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33> ;
    tmk:notLabel "expedited examination"@en-AU,
        "hearing"@en-AU,
        "opposition"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s31> ;
    tmk:typedBy tmka:GT-0092 .

tmkc:GC-0115 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Almost every duty and discretion in the Act is the Registrar's. Section 205 makes a Deputy Registrar's exercise of a power count as the Registrar's, which is why decisions issued by a Deputy are the Registrar's decisions. GC-0046 already holds this term."@en-AU ;
    skos:altLabel "Registrar"@en-AU,
        "the Registrar"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Registrar of Trade Marks"@en-AU ;
    skos:related tmkc:GC-0040,
        tmkc:GC-0041,
        tmkc:GC-0122,
        tmkc:GC-0123,
        tmkc:GC-0127,
        tmkc:GC-0128 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined by the Act, and the Manual supplies the delegation rule that makes the role behave the way examiners meet it. Overlaps the signed GC-0046 and says so."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part52/1%231~2> ;
    tmk:expertShouldCheck "The overlap with the signed GC-0046, and whether the section 205 point belongs in this concept or in a separate 'Deputy Registrar' one."@en-AU ;
    tmk:goldRecord "GC-0115" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s200>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/registrar> ;
    tmk:notLabel "Deputy Registrar"@en-AU,
        "delegate"@en-AU,
        "prescribed court"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/registrar>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part52/1%231~2> ;
    tmk:typedBy tmka:GT-0115 .

tmkc:GC-0064 a skos:Concept,
        tmk:GroundOfRefusal,
        tmk:LegalConcept ;
    rdfs:comment "The Manual's Part 26 title is 'Section 44 and Regulation 4.15A - Conflict with Other Signs'. Note that the Manual states the purpose of the section as preventing confusion, which is the same language section 43 uses for a different ground — the two must not be collapsed."@en-AU ;
    skos:altLabel "citation"@en-AU,
        "conflicting trade mark"@en-AU,
        "section 44 ground"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "conflict with other signs"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Held as the ground itself, with the comparison tests beneath it as separate concepts. The alt_label 'citation' is included because that is what examiners call the earlier mark in practice and a vocabulary that could not match it would miss most of Part 26 and all of Part 27."@en-AU ;
    tmk:confidence 7.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/1%231> ;
    tmk:expertShouldCheck "Whether 'citation' is really a synonym for the ground or the name of the cited mark. If the second, it is a separate concept and this alt_label is wrong."@en-AU ;
    tmk:goldRecord "GC-0064" ;
    tmk:isOvercomeBy tmkc:GC-0066,
        tmkc:GC-0067,
        tmkc:GC-0068 ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(2)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r4.15A> ;
    tmk:mayGiveRiseTo tmkc:GC-0042,
        tmkc:GC-0094,
        tmkc:GC-0096,
        tmkc:GC-0122 ;
    tmk:notLabel "likely to deceive or cause confusion"@en-AU,
        "prescribed sign"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/1%231> ;
    tmk:typedBy tmka:GT-0064 .

