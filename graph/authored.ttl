    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects collective trade marks with assignment by identifying Part 10 as an exception to their equivalent treatment with ordinary trade marks. This passage does not itself state that collective trade marks cannot be assigned."@en-AU ;
    tmk:confidence 9.2e-01 ;
    tmk:expertShouldCheck "Whether a more specific predicate can represent the exception to the application of Part 10 without implying an assignment prohibition."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0277" ;
    tmk:isStale false ;
