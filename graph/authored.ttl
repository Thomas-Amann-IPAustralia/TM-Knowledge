    tmk:spanEnd 454 ;
    tmk:spanStart 331 ;
    tmk:supportingText "The filing date of an IRDA is usually the date on which the international registration was filed with the Office of origin." ;
    tmk:tier 2 .

tmka:GR-0566 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0114 ;
    tmk:assertionPredicate skos:related ;
