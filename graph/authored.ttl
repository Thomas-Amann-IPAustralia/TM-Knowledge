tmkc:GC-0114 a skos:Concept,
        tmk:LegalConcept,
        tmk:SubjectMatter ;
    rdfs:comment "The Madrid equivalent of a registered trade mark, and section 44's note 4 makes it citable against a domestic application. Holding it apart from 'registered trade mark' is what lets a citation search reach both."@en-AU ;
    skos:altLabel "protected international trade mark designating Australia"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "protected international trade mark"@en-AU ;
