    tmk:typedBy tmka:GT-0079 .

tmkc:GC-0080 a skos:Concept,
        tmk:LegalConcept,
        tmk:LegalTest ;
    rdfs:comment "A third resemblance test, and the corpus defines it no better than it defines substantial identity. Distinct from both section 44 comparisons: it asks whether two marks of one owner are close enough to share an application."@en-AU ;
    skos:altLabel "resemble each other in material particulars"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "material particulars"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Act uses the phrase as the operative requirement for a series. Held apart from the section 44 comparisons because it answers a different question between different parties, and because the repository now holds three resemblance tests that a reader could easily merge."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/2%231~1> ;
    tmk:expertShouldCheck "The definition source. `TMM/Part13/2#1~1` is the Manual's section on material particulars and should be read to confirm it defines rather than merely applies the test."@en-AU ;
    tmk:goldRecord "GC-0080" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)> ;
