    tmk:spanEnd 978 ;
    tmk:spanStart 778 ;
    tmk:supportingText "If the trade mark, or some part of the trade mark, contains a connotation that would be likely to deceive or confuse consumers within the relevant market, then a ground for rejection should be raised." ;
    tmk:tier 3 .

tmka:GR-0182 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject tmkc:GC-0051 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The statutory wording reproduced in the Manual makes a causative connotation an element of the mandatory rejection trigger. The relationship to the anchor is inferred from the Manual's ensuing explanation that there is no discretion for a mark caught by the section."@en-AU ;
    tmk:confidence 8.8e-01 ;
    tmk:expertShouldCheck "Whether requiresElement may take mandatory application, rather than section 43 itself, as its subject."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0182" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:b6690f96b0ebc5181ac9b42c2669b0de831371538a8cc414e94d5e54796ceeff" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:spanEnd 358 ;
    tmk:spanStart 40 ;
    tmk:supportingText "An application for the registration of a trade mark in respect of particular goods or services must be rejected if, because of some connotation that the trade mark or a sign contained in the trade mark has, the use of the trade mark in relation to those goods or services would be likely to deceive or cause confusion." ;
    tmk:tier 3 .

tmka:GR-0183 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0002 ;
    tmk:assertionPredicate tmk:requiresElement ;
    tmk:assertionSubject tmkc:GC-0051 ;
    tmk:authoredBy "gpt-6.1-sol" ;
