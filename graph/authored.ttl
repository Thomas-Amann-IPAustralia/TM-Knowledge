    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Not being prima facie capable of distinguishing is the threshold at which the section 41 ground is appropriate; threshold first, ground second."@en-AU ;
    tmk:confidence 7.5e-01 ;
    tmk:expertShouldCheck "Whether the threshold belongs to the section 41 ground alone; GC-0006 is the general concept."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0088" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
