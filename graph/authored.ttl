tmka:GR-0059 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0003 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0001 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects a meaningful INN-stem connotation with likely deception. This supports a possible causal relationship, not a claim that every connotation is deceptive."@en-AU ;
    tmk:confidence 9.7e-01 ;
    tmk:expertShouldCheck "Whether the relationship should be restricted explicitly to meaningful INN-stem connotations."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0059" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:66817de6196f7150720015e718aecdc209059307b7d11869b0767ecd18e8e89a" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/6~1> ;
    tmk:spanEnd 191 ;
    tmk:spanStart 0 ;
    tmk:supportingText "An examiner will need to consider whether the presence of an INN stem in a word is “meaningful” enough to give rise to a connotation leading to likely deception or confusion under section 43." ;
    tmk:tier 3 .

tmka:GR-0062 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0017 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly identifies geographical references as capable of conveying connotations about grape origin, wine production or sale. It does not say that every geographical reference necessarily conveys these meanings."@en-AU ;
    tmk:confidence 9.9e-01 ;
    tmk:expertShouldCheck "Whether the relationship needs a wine-specific scope."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0062" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:671892952f127e4e7f895f72e137affe3d6a97e2b2241226928aa3b5216a520f" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/2/2%231> ;
    tmk:spanEnd 777 ;
    tmk:spanStart 481 ;
    tmk:supportingText "For example, a geographical reference can connote that: The grapes are grown at that location or within that region; The wine is produced (bottled, packaged, distributed) from that location or within that region; Wine produced at that location or within that region is also sold at that location." ;
    tmk:tier 3 .

