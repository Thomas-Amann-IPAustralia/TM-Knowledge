    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The presumption is section 33(1) — the Registrar must accept unless satisfied — and Part 20.4 states it in terms. The signed record cites only section 33(3), the rejection limb. Both additions come from the withdrawn duplicate GC-0118 (ruling A1)."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:corrects tmkc:GC-0007 ;
    tmk:expertShouldCheck "Whether section 33(3) should stay as a basis beside 33(1); it is the consequence of the presumption being displaced."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
