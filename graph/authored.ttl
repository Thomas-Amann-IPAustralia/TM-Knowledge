    tmk:supportingText "An applicant may overcome a section 43 ground for rejection in relation to a name by providing the well-known person’s written permission to use their name as a trade mark." ;
    tmk:tier 3 .

tmka:GR-0688 a tmk:AuthoredAssertion ;
    rdfs:comment "Carries the corrected reading of the signed GR-0042, which stays in eval/gold/ as signed (correction in authored/corrections.yaml)."@en-AU ;
    tmk:assertionObject tmkc:GC-0168 ;
    tmk:assertionPredicate tmk:doesNotGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0030 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "An image of a person does not by itself give rise to the section 43 ground."@en-AU ;
    tmk:confidence 9.5e-01 ;
    tmk:expertShouldCheck "Whether 'merely' leaves room for an image to give rise to the ground with something more — the edge says only that it does not by itself."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0688" ;
    tmk:isStale false ;
    tmk:modality "should" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
