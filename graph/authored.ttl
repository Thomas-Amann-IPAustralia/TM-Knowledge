tmka:GT-0049 tmk:authoredBy "claude-code-agent-S027" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "current marketplace is the marketplace as it now stands: something outside the trade mark that the assessment looks at — the goods, the market and its consumers, a person or place, a reputation, a date — so `context`. Retyped on the owner's ruling B1 of 2026-10-09 (ADR-0126): a kind says what a concept is, and what it does is an edge. What it does is on its edges: GR-0022 constrains the examiner on likely to deceive or cause confusion; GR-0023 qualifies connotation; GR-0461 constrains examiner; GR-0469 qualifies deception; and more."@en-AU ;
    tmk:conceptGroup "context" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether this is something outside the mark at all, or a meaning the mark itself conveys (sign content)."@en-AU ;
    tmk:goldRecord "GT-0049" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2> .

tmka:GT-0050 tmk:authoredBy "claude-code-agent-S027" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "reputation is a place's or person's being known for something: something outside the trade mark that the assessment looks at — the goods, the market and its consumers, a person or place, a reputation, a date — so `context`. Retyped on the owner's ruling B1 of 2026-10-09 (ADR-0126): a kind says what a concept is, and what it does is an edge. What it does is on its edges: GR-0081: likely to deceive or cause confusion requires it; GR-0124 qualifies geographical reference; GR-0139 qualifies implied endorsement; GR-0315 qualifies geographical reference; and more."@en-AU ;
    tmk:conceptGroup "context" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether this is something outside the mark at all, or a meaning the mark itself conveys (sign content)."@en-AU ;
    tmk:goldRecord "GT-0050" ;
