tmkc:GC-0074 a skos:Concept,
        tmk:LegalConcept,
        tmk:SubjectMatter ;
    rdfs:comment "Not a statutory category. The Manual groups shapes, colours, sounds, scents, moving images, holograms and gestures under this heading because the 1995 Act broadened the definition of a trade mark to reach them."@en-AU ;
    skos:altLabel "non-traditional signs"@en-AU,
        "non-traditional trade mark"@en-AU ;
    skos:broader tmkc:GC-0073 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "non-traditional sign"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual devotes a Part to the category and names it in the Part title, but never defines it — so the record is corpus_inferred and says so. It is held because the grouping drives practice: these are the signs where section 40 and the representation requirements bite hardest."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part21/1%231> ;
    tmk:expertShouldCheck "Which signs are inside the category. This record takes the Manual's Part 21 contents as the extension, and an expert may draw it differently."@en-AU ;
    tmk:goldRecord "GC-0074" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s40>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/sign> ;
    tmk:notLabel "composite trade mark"@en-AU,
        "device"@en-AU,
        "sign"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part21/1%231> ;
    tmk:typedBy tmka:GT-0074 .

tmkc:GC-0100 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "The Manual treats an endorsement as what goes on the Register to record that an application was accepted on evidence or other circumstances. It is a record of how a ground was overcome, which makes it evidence about the mark's history."@en-AU ;
    skos:altLabel "endorsements"@en-AU ;
    skos:broader tmkc:GC-0013 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "endorsement"@en-AU ;
    skos:related tmkc:GC-0012,
        tmkc:GC-0119 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states what an endorsement is for and when it is entered. Held apart from disclaimer because one records how a ground was overcome and the other limits a right."@en-AU ;
    tmk:confidence 7.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/6%231> ;
    tmk:expertShouldCheck "Whether the corpus defines 'endorsement' anywhere more directly. This record rests on a passage about when one is entered rather than on a definition."@en-AU ;
    tmk:goldRecord "GC-0100" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(3)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(3)> ;
    tmk:notLabel "conditions or limitations"@en-AU,
        "disclaimer"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/6%231> ;
    tmk:typedBy tmka:GT-0100 .

tmkc:GC-0101 a skos:Concept,
        tmk:LegalConcept,
        tmk:RelevantFactor ;
    rdfs:comment "Formal evidence filed to overcome a section 41 ground, once the Registrar remains satisfied after submissions that the mark is not capable of distinguishing. The Manual makes the sequence explicit and it matters: evidence comes after argument, not instead of it."@en-AU ;
    skos:altLabel "evidence of use of the trade mark"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "evidence of use"@en-AU ;
    skos:related tmkc:GC-0058 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states the trigger, the sequence and the actor in one sentence. Held apart from 'use of a trade mark' because this is the proof, not the fact."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/3%231> ;
    tmk:expertShouldCheck "Whether evidence of use under section 41 and evidence of use under section 44(4) are the same concept. The Manual treats them in different Parts with different requirements."@en-AU ;
    tmk:goldRecord "GC-0101" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(3)(b)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41(4)(b)> ;
    tmk:notLabel "evidence in support"@en-AU,
        "honest concurrent use"@en-AU,
        "prior use"@en-AU,
        "use of a trade mark"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/3%231> ;
    tmk:typedBy tmka:GT-0101 .

tmkc:GC-0110 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "A limited continuation of a parent application that keeps the parent's priority date but takes a new number. The priority-date inheritance is what makes it matter to section 44. GC-0043 already holds this term."@en-AU ;
    skos:altLabel "divisional"@en-AU,
        "divisional applications"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "divisional application"@en-AU ;
    tmk:appliesTo tmkc:GC-0079 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Both the Act and the Manual state it. Written from Part 12 rather than the section 43 material GC-0043 rests on; the overlap is flagged."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/1%231> ;
    tmk:expertShouldCheck "The overlap with the signed GC-0043."@en-AU ;
    tmk:goldRecord "GC-0110" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s46>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/divisional-application> ;
