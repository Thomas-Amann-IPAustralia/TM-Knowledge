tmkc:GC-0086 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Defined narrowly by the Act as an assignment by act of the parties. Transmission is the other half of the pair and covers what happens without such an act — the Manual's Part 43 title carries both."@en-AU ;
    skos:altLabel "assignment of a trade mark"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "assignment"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms by section 6. Held apart from transmission because the Act defines them separately and the difference — an act of the parties, or not — is the whole distinction."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part43/1%231~1> ;
    tmk:expertShouldCheck "Nothing specific; this is one of the cleaner records in the pass."@en-AU ;
    tmk:goldRecord "GC-0086" ;
    tmk:hasStatutoryBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s107(2)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s174> ;
    tmk:isDefinedIn <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/assignment> ;
    tmk:isPerformedBy tmkc:GC-0044,
        tmkc:GC-0115,
        tmkc:GC-0116 ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/assignment> ;
