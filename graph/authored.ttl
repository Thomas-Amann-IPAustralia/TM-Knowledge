    tmk:confidence 7.9e-01 ;
    tmk:expertShouldCheck "Whether qualifies adequately represents an evidentiary consideration in this assessment, rather than a qualification of the inherent-adaptation finding itself."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0576" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:929ab5325fbdb73e5bc6c02da2e90295b9f9b1268b61d2b59387543592ff462d" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part23/5/5/5> ;
    tmk:spanEnd 705 ;
    tmk:spanStart 545 ;
    tmk:supportingText "Has the primary meaning of the sign been displaced to the extent that, in relation to the relevant goods/services, it has come to denote those of the applicant?" ;
    tmk:tier 3 .

