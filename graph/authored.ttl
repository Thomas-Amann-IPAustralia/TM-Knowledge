    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "A convention application takes the priority date of the earlier application for the goods in common."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether the sentence states this relationship, read the way the predicate reads."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0252" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ce9a1aa86dd298535cfe9a62fd7d2bf2e003fdeeacf33bfdeba534786732a5a2" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/1/1/6> ;
    tmk:spanEnd 271 ;
    tmk:spanStart 0 ;
    tmk:supportingText "To gain the same priority date the specification of the convention application must claim at least one good or service covered by the earlier application or applications. The earlier priority date will only apply to goods and/or services in common with both applications." ;
    tmk:tier 3 .

tmka:GR-0253 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-08 by S026: subject GC-0090 -> GC-0016 — an authored duplicate withdrawn in favour of the signed concept (ruling A1, ADR-0080 c2). The judgement and evidence are the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0064 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0016 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects relative priority dates with the strength of an ‘other circumstances’ case concerning a conflicting trade mark. The inferred qualification concerns addressing the citation, not whether the section 44 ground initially arises."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether qualifying an avenue for addressing a citation sufficiently supports qualifies with the ground-of-refusal record."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0253" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:a6f270a1aaa4ede23103d2aa2b607d5ab86ee6050eeeb4e54b138fb1d8a6f095" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part28/4/28/4/4~1> ;
    tmk:spanEnd 1236 ;
    tmk:spanStart 912 ;
    tmk:supportingText "An earlier registration relied on by an applicant may have a priority date which is earlier or later than the conflicting trade mark’s priority date. Generally, an applicant seeking to rely on ‘other circumstances’ will have a more compelling case where they have the earliest rights compared to the owner of the cited mark." ;
    tmk:tier 3 .

tmka:GR-0254 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-08 by S026: object GC-0090 -> GC-0016 — an authored duplicate withdrawn in favour of the signed concept (ruling A1, ADR-0080 c2). The judgement and evidence are the original author's. Re-read on 2026-10-09 in the structure review (ADR-0131): was GC-0091 related GC-0016."@en-AU ;
