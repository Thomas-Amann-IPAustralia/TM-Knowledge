tmka:GR-0697 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0015 ;
    tmk:assertionPredicate tmk:isOvercomeBy ;
    tmk:assertionSubject tmkc:GC-0168 ;
    tmk:authoredBy "claude-code-agent-S027" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual says a geographical section 43 objection can be overcome by a specification amendment that removes the likelihood of deception. Written on the owner's ruling B1 (ADR-0126): what a concept does is an edge naming the ground or test it acts on."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether the same holds for section 43 grounds other than geographical ones."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0697" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:f62b4939d149235abeefb52354519f2d89394eeed2e2bc8257b6ca5d9d6532c9" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/5> ;
    tmk:spanEnd 215 ;
    tmk:spanStart 0 ;
    tmk:supportingText "An applicant will be able to overcome a geographical section 43 objection by agreeing to a condition of registration or a specification amendment which removes the likelihood of consumers being deceived or confused." ;
    tmk:tier 3 .

tmka:GR-0698 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-read on 2026-10-09 from a second model's audit (gemini-3.1-pro-preview, audit-v1): was GC-0168 isOvercomeBy GC-0014."@en-AU ;
    tmk:assertionObject tmkc:GC-0003 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0014 ;
    tmk:authoredBy "gemini-3.1-pro-preview" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The sentence does not mention the section 43 ground for rejection; rather, it states that an endorsement mitigates the risk of deception, meaning the endorsement qualifies how deception is assessed."@en-AU ;
    tmk:expertShouldCheck "Whether the second model's reading is right where the first model's was judged wrong; both read the same sentence."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0698" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:42e5d40cd5c1e64f072a3e0b6067cea9bb6c66e066c978ecc7d7eeb47255c963" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/2> ;
    tmk:spanEnd 586 ;
    tmk:spanStart 440 ;
    tmk:supportingText "The risk of deception can be mitigated by a suitably specific endorsement or an amendment or limitation to the specification of goods or services." ;
    tmk:tier 3 .

tmka:GR-0699 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-read on 2026-10-09 from a second model's audit (gemini-3.1-pro-preview, audit-v1): was GC-0020 doesNotGiveRiseTo GC-0168. Re-read on 2026-10-09 in the structure review (ADR-0131): was GC-0020 related GC-0006."@en-AU ;
    tmk:assertionObject tmkc:GC-0006 ;
    tmk:assertionPredicate tmk:doesNotGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0020 ;
    tmk:authoredBy "claude-code-agent-S029" ;
    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "A business identifier indicates a business, not the goods; a ground for rejection will rarely apply."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether the sentence states this relationship, read the way the predicate reads."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0699" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:44fd3704d94a457eeabdbb9439274b8d5f9a6922fc6fad03bca95b4a772b5184" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/6> ;
    tmk:spanEnd 259 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Where business identifiers are included in a trade mark (e.g. A TASMANIAN COMPANY, RIVERINA DAIRY CO.) this tends to indicate a characteristic of a business rather than the goods or services themselves. A ground for rejection will rarely apply in these cases." ;
    tmk:tier 3 .

tmka:GR-0700 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0168 ;
    tmk:assertionPredicate tmk:doesNotGiveRiseTo ;
