    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects the decision maker's treatment of confusion risk with traders' use of descriptive terms. No listed specific predicate accurately expresses that role–factor relationship without substituting a conduct concept for the neighbour."@en-AU ;
    tmk:confidence 9.4e-01 ;
    tmk:expertShouldCheck "Whether the conditional constraint warrants a more specific predicate within the ontology."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0173" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:42c9a0afaa3f6720400932fd25a10ed8af5bdb82bccb8499c4087f25a938b87e" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/6/6/7~1> ;
    tmk:spanEnd 1902 ;
    tmk:spanStart 1671 ;
    tmk:supportingText "A decision maker may have no choice but to tolerate some risk of confusion if a trader has chosen to build a business around a descriptive term and a later trader wishes to use that descriptive term in relation to its own business." ;
    tmk:tier 2 .

