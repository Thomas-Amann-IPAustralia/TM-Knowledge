    tmk:spanEnd 696 ;
    tmk:spanStart 464 ;
    tmk:supportingText "As with national applications, IP Australia will routinely expedite IRDAs with a convention claim in order to minimise the risk of a trade mark with an earlier priority date being overlooked in the examination of other applications." ;
    tmk:tier 2 .

tmka:GR-0123 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0010 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0017 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual connects a standalone geographical reference with the average consumer's associations and purchasing decision when assessing confusion. The consumer is the relevant audience, rather than itself a qualification of the geographical reference."@en-AU ;
    tmk:confidence 9.2e-01 ;
    tmk:expertShouldCheck "Whether qualifies should instead represent the role of the average consumer in this assessment."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0123" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:67e2721f9a84ad01289f7b3ee6a65ec86e7be0a016c468e3eb7c3094b6166356" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/3~1> ;
    tmk:spanEnd 608 ;
    tmk:spanStart 250 ;
    tmk:supportingText "A trade mark containing a standalone geographical reference will cause confusion if each of the following criteria are met: Consumers would have reason to associate the goods/services with the geographical location; The association between the place and the goods/services would influence the purchasing decision of an average consumer of the goods/services." ;
    tmk:tier 2 .

