tmka:GR-0465 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0131 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0046 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual connects the Registrar or delegate's assessment of rejection grounds with conditional acceptance of the application. The listed predicates do not specifically express this assessment relationship."@en-AU ;
    tmk:confidence 9.6e-01 ;
    tmk:expertShouldCheck "Whether the conditional acceptance obligation should instead be represented through a separate rule concept."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0465" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:d038cd0a5414fad209e7c46e95f9026654f04ef93c0933ae278a51a377ece44a" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/4/4/1> ;
    tmk:spanEnd 303 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The presumption of registrability applies when the Registrar or their delegate is not satisfied that any grounds for rejecting a trade mark application exist. If this is the case, the application must be accepted for possible registration provided it is otherwise in accord with the Act and Regulations." ;
    tmk:tier 2 .

tmka:GR-0467 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0008 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0048 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual presents a fanciful or unrealistic consumer understanding as a consideration in assessing deception or confusion, alongside the real tangible danger threshold. The connection to that particular threshold is inferred from context, rather than expressly stated."@en-AU ;
    tmk:confidence 7.7e-01 ;
    tmk:expertShouldCheck "Whether the contextual connection supports qualifies rather than merely mentioning both concepts."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0467" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ee8650d8222dab43788198d8fd9f43ca934317a389f76728bdf40f85c97ac032" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/4%231> ;
    tmk:spanEnd 2254 ;
    tmk:spanStart 1369 ;
    tmk:supportingText "When considering trade marks that include a clear connotation, the concept that this connotation would be understood as a fanciful or unrealistic description can also be taken into account. See Mount Everest Mineral Water Limited v Himalayan Spring Mineral Water [2010] ATMO 85 (at [15]). This concept also considers the likely expectations and level of awareness of the ordinary consumer of the goods/services. Per Scotch Whisky Association v De Witt [2007] FCA 1649 (at [61]): a label indicating bourbon, bourbon whiskey and/or made in the USA clearly connote an origin of a place other than Scotland. Labels indicating ‘Tennessee Whiskey’ again connotes an origin in a place other than Scotland. For a mark to be rejected under s 43 there must be a ‘real tangible danger of deception or confusion’. That exceptionally stupid or careless consumers might be confused does not suffice." ;
    tmk:tier 3 .

tmka:GR-0468 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0002 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0048 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "In its discussion of deception or confusion, the Manual permits consideration of whether consumers would understand a connotation as fanciful or unrealistic. This qualifies the assessment rather than establishing an automatic exception."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether qualifies accurately captures a discretionary assessment factor rather than a categorical exception."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0468" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ee8650d8222dab43788198d8fd9f43ca934317a389f76728bdf40f85c97ac032" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/4%231> ;
    tmk:spanEnd 1558 ;
    tmk:spanStart 1369 ;
    tmk:supportingText "When considering trade marks that include a clear connotation, the concept that this connotation would be understood as a fanciful or unrealistic description can also be taken into account." ;
    tmk:tier 3 .

tmka:GR-0469 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0003 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0049 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual requires deception to be assessed in the current marketplace rather than against past or hypothetical future conditions. This supports treating the current marketplace as qualifying the assessment of deception, not as causing deception."@en-AU ;
    tmk:confidence 9.2e-01 ;
    tmk:expertShouldCheck "Whether qualifies should target the assessment of deception rather than the deception concept itself."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0469" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:d222f7d371d8e06883804bb5b725e0a62be4d39b890ebdbb2fc9ecfcd28d0d16" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3/3/2> ;
    tmk:spanEnd 248 ;
    tmk:spanStart 0 ;
    tmk:supportingText "A mere possibility of deception or confusion at some indeterminate time is not sufficient. Each application must be considered as it stands in the current marketplace, not in the marketplace as it was in the past and not as it may be in the future." ;
    tmk:tier 3 .

tmka:GR-0470 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0004 ;
    tmk:assertionPredicate tmk:qualifies ;
