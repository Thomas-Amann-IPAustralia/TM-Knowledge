tmka:GR-0555 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0109 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0130 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual treats reputation as a factor affecting whether the connection needed for defensive registration can be established, rather than as an independently required element. This supports reputation qualifying eligibility for defensive registration."@en-AU ;
    tmk:confidence 8.8e-01 ;
    tmk:expertShouldCheck "Whether qualifies appropriately captures a factor affecting eligibility rather than the defensive trade mark itself."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0555" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ce1851662a61a6804b1c5dd26c33639e60a96730fb439501df4ba858b93f46c0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/6/6/2/3> ;
    tmk:spanEnd 671 ;
    tmk:spanStart 307 ;
    tmk:supportingText "While evidence of ‘reputation’ is not required under s 185, it is unlikely that the requisite connection would be taken to exist between the goods and services of the defensive application and the applicant in cases where there is no appreciable reputation arising from use of the trade mark in relation to the goods or services for which it is already registered." ;
    tmk:tier 3 .

