tmka:GT-0094 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "Available where information received after acceptance indicates the mark should not have been accepted. The application changes state."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "GC-0042 (signed) and GC-0094 (authored) are both 'revocation of acceptance'. Both are typed procedural_step and neither displaces the other. The concept's record separates it from revocation of registration under sections 84A to 84D, which is a different step and is typed separately at GT-0095."@en-AU ;
