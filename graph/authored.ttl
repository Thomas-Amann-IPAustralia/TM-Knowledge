tmka:GR-0564 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0150 ;
    tmk:assertionPredicate skos:broader ;
    tmk:assertionSubject tmkc:GC-0113 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The expression 'international registration designating Australia' identifies an international registration qualified by its designation of Australia. This supports a subtype relationship rather than equivalence."@en-AU ;
    tmk:confidence 9.8e-01 ;
    tmk:expertShouldCheck "Whether the international registration record has a broader scope than IRDAs in the ontology."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0564" ;
    tmk:isStale false ;
    tmk:kindOfAffirmed "An international registration designating Australia is an international registration — the one whose designation reaches Australia. The not-labels keep the general term from being read as the Australian designation and the reverse."@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:51221c1a2f2527b381533dfa5181b5d050df248bb4f1debb8513452f4094590e" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/4/4/1> ;
    tmk:spanEnd 923 ;
    tmk:spanStart 679 ;
    tmk:supportingText "However, if the cited mark is an international registration designating Australia (IRDA) then it is not necessary to verify the claim, as the Office of Origin has already verified it and it has been accepted by the International Bureau of WIPO." ;
    tmk:tier 2 .

