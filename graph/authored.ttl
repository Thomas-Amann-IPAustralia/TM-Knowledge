    tmk:spanEnd 831 ;
    tmk:spanStart 579 ;
    tmk:supportingText "Examiners must ensure that they are considering the current marketplace when deciding whether a sign is likely to offend under section 43, remembering there will be signs in that marketplace which have kept their connotations over long periods of time." ;
