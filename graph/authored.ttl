    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual supports other circumstances as a discretionary basis for acceptance, conditional on the examiner being satisfied that acceptance is proper after considering the evidence and circumstances. It does not make acceptance automatic."@en-AU ;
    tmk:confidence 9.4e-01 ;
    tmk:expertShouldCheck "Whether 'may' best captures the Manual’s conditional statement that exercising the discretion is appropriate."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
