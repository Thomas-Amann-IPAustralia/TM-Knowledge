    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects relative priority dates with the strength of an ‘other circumstances’ case concerning a conflicting trade mark. The inferred qualification concerns addressing the citation, not whether the section 44 ground initially arises."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether qualifying an avenue for addressing a citation sufficiently supports qualifies with the ground-of-refusal record."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0253" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:a6f270a1aaa4ede23103d2aa2b607d5ab86ee6050eeeb4e54b138fb1d8a6f095" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part28/4/28/4/4~1> ;
    tmk:spanEnd 1236 ;
    tmk:spanStart 912 ;
    tmk:supportingText "An earlier registration relied on by an applicant may have a priority date which is earlier or later than the conflicting trade mark’s priority date. Generally, an applicant seeking to rely on ‘other circumstances’ will have a more compelling case where they have the earliest rights compared to the owner of the cited mark." ;
    tmk:tier 3 .

tmka:GR-0254 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0090 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0091 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual identifies the parent application's filing date as the divisional application's priority date, subject to the stated exception. This conditional correspondence does not make filing date and priority date the same concept generally."@en-AU ;
    tmk:confidence 9.7e-01 ;
    tmk:expertShouldCheck "Whether a more specific listed predicate captures the conditional determination of priority date by filing date."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0254" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:0844d76c717898594da741660eaabf8b3031c217bede52bb2156955ca12c2e73" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/5%231> ;
    tmk:spanEnd 464 ;
    tmk:spanStart 147 ;
    tmk:supportingText "A divisional application will have the filing date of its parent application as the priority date, unless the convention priority claim of the parent is also made when filing the divisional application or within the period provided for in regulation 4.5, that is, within two working days after filing the application." ;
    tmk:tier 2 .

