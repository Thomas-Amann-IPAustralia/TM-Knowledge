    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual's examples support sufficient inherent adaptation as the threshold for prima facie capability of distinguishing. This threshold relationship is inferred from the contrasting examples rather than expressly defined."@en-AU ;
    tmk:confidence 7.8e-01 ;
    tmk:expertShouldCheck "Whether these examples sufficiently support a threshold relationship rather than merely a contextual association."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0484" ;
