tmka:GT-0093 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The point at which an application changes state. Section 33 makes acceptance the thing that must follow examination unless the Registrar is satisfied of a defect or a ground."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 7.5e-01 ;
    tmk:expertShouldCheck "Whether typing acceptance as a step loses the presumption of registrability. That presumption is the most examinable thing about section 33, no concept in this group carries it, and the reviewer's own note (OQ-0015) said the office's actual bar for it is not in the knowledge base either."@en-AU ;
