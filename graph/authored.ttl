    tmk:spanEnd 266 ;
    tmk:spanStart 0 ;
    tmk:supportingText "If a trade mark, or some part of the trade mark, contains a reference to Indigenous people and a connotation arises from the mark that would be likely to deceive or confuse consumers within the relevant market, then a ground for rejection under s43 should be raised." ;
    tmk:tier 3 .

tmka:GR-0067 a tmk:AuthoredAssertion ;
