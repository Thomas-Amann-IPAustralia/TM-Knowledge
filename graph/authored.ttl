    tmk:typedBy tmka:GT-0130 .

tmkc:GC-0141 a skos:Concept,
        tmk:Context,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: A legally significant date associated with registration, whose effective date the Manual describes as affected by priority claims and potentially differing between goods or services."@en-AU ;
    skos:altLabel "effective date of registration"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "date of registration"@en-AU ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The statutory fragment expressly introduces a defined term, making this more than a generic date phrase, but omits its defining content. The Manual supplies the best available explanation of its effective-date usage. It relates registration to priority dates without establishing that the concepts are identical, so it is not treated as a duplicate of priority date or filing date. A temporal attribute fits none of the listed groups closely. The cited provisions are not reproduced, so their grounding role cannot be verified from these passages; the Manual explanation is practice, not legislation."@en-AU ;
    tmk:confidence 7.8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7/7/2> ;
    tmk:expertShouldCheck "Check the complete section 6 definition, whether 'effective date of registration' is equivalent to the statutory term, and which of the cited provisions actually ground it."@en-AU ;
    tmk:goldRecord "GC-0141" ;
    tmk:isFixedBy tmkc:GC-0091 ;
    tmk:labelKey "date of registration",
        "effective date of registration" ;
    tmk:notLabel "filing date"@en-AU,
        "priority date"@en-AU ;
    tmk:notLabelKey "filing date",
        "priority date" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "date of registration" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part11/7/7/2> ;
    tmk:typedBy tmka:GT-0141 .

tmkc:GC-0151 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: The old register is the register kept under the repealed trade marks legislation, distinguished from the Register kept under the 1995 Act."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "old register"@en-AU ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 6 expressly defines the term. The Manual distinguishes the old register under the 1955 Act from the Register under the 1995 Act and describes the transfer of disclaimer particulars between them. This supports a distinct historical record concept, rather than a duplicate of the general Register of Trade Marks concept. The cited sections 207 and 238 concern that transition as described by the Manual; the other supplied provision references concern disclaimers or examination rather than defining the old register."@en-AU ;
    tmk:becomes tmkc:GC-0089 ;
    tmk:confidence 9.7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/old-register> ;
    tmk:expertShouldCheck "Confirm the relationship to GC-0089 and verify sections 207 and 238 directly; their transitional effects are described here only through the Manual passages."@en-AU ;
    tmk:goldRecord "GC-0151" ;
    tmk:labelKey "old register" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s207>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s238> ;
    tmk:notLabel "Register kept under the 1995 Act"@en-AU,
        "new Register"@en-AU ;
    tmk:notLabelKey "new register",
        "register kept under the 1995 act" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "old register" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/old-register> ;
    tmk:typedBy tmka:GT-0151 .

tmkc:GC-0153 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: A statement by an opponent that forms part of a notice of opposition and, together with the notice of intention to oppose, completes that notice."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "statement of grounds and particulars"@en-AU ;
