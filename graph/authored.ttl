    tmk:sourceContentHash "sha256:9100e3e74a461dfe30b3ea55590d9bfb40c46275ebf4392b5b84dc6ae31c35c0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part30/3/3/5/5~1> ;
    tmk:spanEnd 2154 ;
    tmk:spanStart 1768 ;
    tmk:supportingText "Under section 83(1) \"a person who is not a member of the Defence Force is guilty of an offence if: (a) the person uses or wears a defence emblem or an emblem so nearly resembling a defence emblem as to be capable of being mistaken for such an emblem; and (b) the person does not have the written authority of the Minister, or of a person authorised in writing by the Minister to do so.\"" ;
    tmk:tier 3 .

tmka:GR-0205 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0058 ;
    tmk:assertionPredicate skos:broader ;
    tmk:assertionSubject tmkc:GC-0119 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual describes prima facie capability as capability assessed through inherent adaptation to distinguish. Treating this as a particular form of the broader capability test is an inference, not an express classification in the passage."@en-AU ;
    tmk:confidence 7.6e-01 ;
    tmk:expertShouldCheck "Whether prima facie capability should be modelled as a subtype or as a separate preliminary assessment."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0205" ;
    tmk:isStale false ;
    tmk:kindOfAffirmed "A trade mark prima facie capable of distinguishing is capable of distinguishing on its inherent adaptation alone — the first of the Manual's three categories under section 41 — so the first is a case of the second. The not-label keeps the category apart from the section 41 test it answers."@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:c547f9f236db89250c2ef602972d1393c903e3945a1506d011f94a737ba436b1" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/5/5/3/1> ;
    tmk:spanEnd 286 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Where the Registrar or their delegate is satisfied on the balance of probabilities that the trade mark has insufficient inherent adaptation to distinguish for it to be considered prima facie capable of distinguishing, the reasons for that decision must be clearly stated and documented." ;
    tmk:tier 2 .

tmka:GR-0206 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-08 by S026: subject GC-0101 -> GC-0041 — an authored duplicate withdrawn in favour of the signed concept (ruling A1, ADR-0080 c2). The judgement and evidence are the original author's."@en-AU ;
    tmk:assertionObject tmkc:GC-0058 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0041 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects evidence of use with demonstrating capacity to distinguish in particular colours. No listed predicate precisely captures that evidentiary relationship, and the passage does not make evidence of use universally necessary."@en-AU ;
    tmk:confidence 9.4e-01 ;
    tmk:expertShouldCheck "Whether the ontology intends isOvercomeBy to include evidence demonstrating capability despite insufficient inherent adaptation."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0206" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:aad70a11e0e6736dd677702d9ee88e4aaf15d7d35f711f9eafbc58473d49c47f" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part10/3/3/5/3~1> ;
    tmk:spanEnd 430 ;
    tmk:spanStart 221 ;
    tmk:supportingText "This situation is most likely to occur when a trade mark which is lacking in inherent adaptation to distinguish is shown through evidence of use to be capable of distinguishing when used in particular colours." ;
    tmk:tier 2 .

tmka:GR-0207 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0059 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0120 ;
