    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/3%231~2> ;
    tmk:spanEnd 1214 ;
    tmk:spanStart 1086 ;
    tmk:supportingText "For a ground for rejection to be raised the connotation must be obvious, direct, and immediate and within the trade mark itself." ;
    tmk:tier 3 .

