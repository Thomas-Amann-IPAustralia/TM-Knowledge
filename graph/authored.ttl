tmka:GR-0247 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0081 ;
    tmk:assertionPredicate skos:broader ;
    tmk:assertionSubject tmkc:GC-0082 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly describes authorised use as counting as use by the owner for the purposes of the Act, citing s 7(3). This supports treating authorised use as a case of use, rather than identifying the two concepts."@en-AU ;
    tmk:confidence 9.3e-01 ;
    tmk:expertShouldCheck "Whether statutory attribution to the owner is better modelled separately from the subtype relationship."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0247" ;
    tmk:isStale false ;
    tmk:kindOfAffirmed "\"Authorised use of a trade mark is taken, for the purposes of the Act, to be use of the trade mark by the owner\" (s 7(3), Part 19A.6.3): authorised use is a case of use. The not-labels keep the authorised user's use apart from use in general, which is what recognition needs and does not deny the hierarchy."@en-AU ;
    tmk:origin "authored" ;
