tmka:GT-0124 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "An application or a registered mark's details are changed. A transition."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Part 6 of the Act governs amendment before registration and Division 1 of Part 8 after it. One concept spans two regimes and the group does not show the split."@en-AU ;
    tmk:goldRecord "GT-0124" ;
