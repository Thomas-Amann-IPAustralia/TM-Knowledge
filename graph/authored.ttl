tmka:GT-0058 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual calls it a question to be determined, and section 41(2) makes it the thing the Registrar must be satisfied about. A question the decision maker has to answer is a legal_test."@en-AU ;
    tmk:conceptGroup "legal_test" ;
    tmk:confidence 7.5e-01 ;
    tmk:expertShouldCheck "Whether the split between 'the s 41 ground' and 'the capable-of-distinguishing question' is a distinction practice actually draws."@en-AU ;
    tmk:goldRecord "GT-0058" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/3%231~1> .

tmka:GT-0059 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual calls it the first question to be determined and gives the method for answering it. That is a question the decision maker has to answer."@en-AU ;
    tmk:conceptGroup "legal_test" ;
    tmk:confidence 7.5e-01 ;
    tmk:expertShouldCheck "The concept plays both roles — a threshold question under 41(3) and one of three combined factors under 41(4). One typing cannot hold both, and this is the clearest case in the set where the four groups may be too few."@en-AU ;
    tmk:goldRecord "GT-0059" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/3%231~1> .

tmka:GT-0060 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "It is a determination the examiner must make, and the Manual sequences it as the first of two. A step in a test is still a question that must be answered."@en-AU ;
    tmk:conceptGroup "legal_test" ;
    tmk:confidence 6.5e-01 ;
    tmk:expertShouldCheck "Whether a step within a two-part process should be typed as a test or as a factor. Whatever is decided here should be applied consistently to the second step."@en-AU ;
    tmk:goldRecord "GT-0060" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/3%231~1> .

