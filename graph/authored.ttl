    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states the general position at the head of its Part on the subject."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part15/1%231~1> ;
    tmk:expertShouldCheck "Whether the legislative basis is right. `TMA1995/s224` is the general extension provision and the Manual's Part 15 covers several others."@en-AU ;
