    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part28/2%231> .

tmka:GT-0067 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "It takes a case out of the section 44 ground — the Act says the Registrar may not reject on the strength of the cited mark. That is an exception."@en-AU ;
    tmk:conceptGroup "exception" ;
