    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The delegate's assessment, reproduced in the Manual, connects the contribution of another feature with whether the whole mark is capable of distinguishing. I infer a qualifying relationship from that assessment rather than merely recording the object to which the test applies."@en-AU ;
    tmk:confidence 8.6e-01 ;
    tmk:expertShouldCheck "Whether appliesTo better captures the relationship than qualifies in this passage."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0447" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:7c415b5cb872c9c003f3b64ea44e8280c342d9a072efa91a52df9e78faa54e7f" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/7/22/7/8~2> ;
    tmk:spanEnd 768 ;
    tmk:spanStart 462 ;
    tmk:supportingText "The stylised, nondescript nature of the device element furnishes the Trade Mark with a slight degree of inherent adaptation to distinguish the services of the Applicant from other traders, but not enough to permit me to conclude that the Trade Mark as a whole is capable of distinguishing in its own right." ;
    tmk:tier 3 .

tmka:GR-0448 a tmk:AuthoredAssertion ;
    rdfs:comment "Re-pointed on 2026-10-08 by S026: object GC-0053 -> GC-0168 — ground-for-rejection edges sorted between the general concept GC-0006 and the section 43 ground GC-0168 by whether the sentence is about section 43 (ruling A2). The judgement and evidence are the original author's."@en-AU ;
