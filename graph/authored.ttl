tmka:GR-0669 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0073 ;
    tmk:assertionPredicate skos:broader ;
    tmk:assertionSubject tmkc:GC-0072 ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 17 defines a trade mark as a sign used to distinguish."@en-AU ;
    tmk:confidence 9.5e-01 ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0669" ;
    tmk:isStale false ;
    tmk:kindOfAffirmed "\"A trade mark is a sign used, or intended to be used, to distinguish goods or services ...\" (s 17). Not every sign is a trade mark, which is what the two not-labels say."@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:7616fa92fa1ab350de397590a153993cc894cf7be24733d962313419b1d4b5c8" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s17> ;
    tmk:spanEnd 213 ;
    tmk:spanStart 0 ;
    tmk:supportingText "A trade mark is a sign used, or intended to be used, to distinguish goods or services dealt with or provided in the course of trade by a person from goods or services so dealt with or provided by any other person." ;
    tmk:tier 2 .

tmka:GR-0670 a tmk:AuthoredAssertion ;
