tmka:GR-0246 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0104 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0081 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual connects use with non-use removal proceedings through a certificate attesting to use that can affect costs. It does not establish here that use necessarily defeats removal."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Whether this costs-specific connection should be recorded between the broader concepts of use and removal for non-use."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0246" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:3cb100e6a7d266ef3a5ef98b7a4128bbd5344f09545a516e49a05229309dffb1" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part55/5%231> ;
    tmk:spanEnd 625 ;
    tmk:spanStart 151 ;
    tmk:supportingText "A successful opponent to an application under Section 92 may be entitled to have its full costs paid by the removal applicant where the current proceedings have been determined in favour of the opponent and a certificate attesting to use during the alleged period of non-use (provided by the Registrar or a court in earlier proceedings) was notified to the removal applicant either before or on filing the notice of opposition in the current proceedings (subsection 105(2))." ;
    tmk:tier 2 .

tmka:GR-0247 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0081 ;
    tmk:assertionPredicate skos:broader ;
    tmk:assertionSubject tmkc:GC-0082 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly describes authorised use as counting as use by the owner for the purposes of the Act, citing s 7(3). This supports treating authorised use as a case of use, rather than identifying the two concepts."@en-AU ;
    tmk:confidence 9.3e-01 ;
    tmk:expertShouldCheck "Whether statutory attribution to the owner is better modelled separately from the subtype relationship."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0247" ;
    tmk:isStale false ;
    tmk:kindOfAffirmed "\"Authorised use of a trade mark is taken, for the purposes of the Act, to be use of the trade mark by the owner\" (s 7(3), Part 19A.6.3): authorised use is a case of use. The not-labels keep the authorised user's use apart from use in general, which is what recognition needs and does not deny the hierarchy."@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:fcc88b687a5a786ea7a648ad8253f1324b7ed91cce9ca5f42b87e0c4e0615781" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part19A/6/6/3> ;
    tmk:spanEnd 490 ;
    tmk:spanStart 352 ;
    tmk:supportingText "Authorised use of a trade mark is taken, for the purposes of the Act, to be use of the trade mark by the owner of the trade mark (s 7(3))." ;
    tmk:tier 2 .

