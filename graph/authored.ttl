    tmk:prefLabelKey "lawyer" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/lawyer> ;
    tmk:typedBy tmka:GT-0148 .

tmkc:GC-0155 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "Summary, not a definition: Summary: Pending is the statutory status of a trade mark application from filing until one of the terminating events specified in section 11 occurs. Relabelled on 2026-10-08 (review E3): the bare label 'pending' matched ordinary uses (a court action pending, an amendment pending); the concept is the section 11 status of an application."@en-AU ;
    skos:altLabel "pending applications"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
