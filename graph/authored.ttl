    tmk:spanEnd 466 ;
    tmk:spanStart 307 ;
    tmk:supportingText "Gathering evidence to overcome section 44 citation by proving “honest concurrent use”, “other circumstances” or “prior use” 6 months from the date of deferment" ;
    tmk:tier 3 .

