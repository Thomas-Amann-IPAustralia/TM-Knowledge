    tmk:authoringReasoning "The Manual expressly identifies geographical references as capable of conveying connotations about grape origin, wine production or sale. It does not say that every geographical reference necessarily conveys these meanings."@en-AU ;
    tmk:confidence 9.9e-01 ;
    tmk:expertShouldCheck "Whether the relationship needs a wine-specific scope."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0062" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:671892952f127e4e7f895f72e137affe3d6a97e2b2241226928aa3b5216a520f" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/2/2%231> ;
    tmk:spanEnd 777 ;
    tmk:spanStart 481 ;
    tmk:supportingText "For example, a geographical reference can connote that: The grapes are grown at that location or within that region; The wine is produced (bottled, packaged, distributed) from that location or within that region; Wine produced at that location or within that region is also sold at that location." ;
    tmk:tier 3 .

tmka:GR-0063 a tmk:AuthoredAssertion ;
