    tmk:sourceContentHash "sha256:53ac65102a07932fd67393905ea28f29ad056b2b475899968a88f18e877e9557" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/5%231> ;
    tmk:spanEnd 754 ;
    tmk:spanStart 590 ;
    tmk:supportingText "Sections 39 to 43 cover what are sometimes referred to as the “absolute” grounds for rejection, that is grounds which relate to the nature of the trade mark itself." ;
    tmk:tier 2 .

