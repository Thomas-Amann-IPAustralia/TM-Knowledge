    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual says a section 43 ground will generally not arise for a long deceased historical figure, even one well known in the field. Written on the owner's ruling B1 (ADR-0126): what a concept does is an edge naming the ground or test it acts on."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether 'long deceased' has a working threshold in practice."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0700" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:8e7a69fc516a2b4b11213363298946680a0c24f0d1bcddc9f0d803c24c151e53" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/6/6/2~1> ;
    tmk:spanEnd 195 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Generally, a section 43 ground for rejection will not arise in respect of long deceased historical figures, even if they were well known for the same field as the specified goods/services are in." ;
    tmk:tier 3 .

tmka:GR-0701 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0002 ;
    tmk:assertionPredicate tmk:doesNotGiveRiseTo ;
