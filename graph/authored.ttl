    tmk:spanEnd 1628 ;
    tmk:spanStart 1209 ;
    tmk:supportingText "However, if the Registrar becomes aware that an application has been or may have been filed in the name of a person who has not authorised the filing, the Registrar may decide that the application does not meet minimum filing requirements unless and until further information is provided that the person named as the applicant did in fact file the application or authorise the filing of the application on their behalf." ;
    tmk:tier 2 .

tmka:GR-0173 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0047 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0045 ;
