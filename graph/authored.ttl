    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part46/1%231> ;
    tmk:typedBy tmka:GT-0117 .

tmkc:GC-0124 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Part 6 of the Act governs amendment before registration and Division 1 of Part 8 after it — two regimes, and which one applies depends on where the mark has got to."@en-AU ;
    skos:altLabel "amendment"@en-AU,
        "amendments"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "amendment of an application"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states both regimes and their boundary in one sentence. Amending the specification is also one of the Manual's named ways of overcoming a section 44 ground, which is why this concept matters to examination and not only to administration."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part9/1%231> ;
    tmk:expertShouldCheck "Whether amendment before and after registration are one concept. The Act's structure argues they are two."@en-AU ;
    tmk:goldRecord "GC-0124" ;
    tmk:hasStatutoryBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s64>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65(5)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65A> ;
    tmk:isPerformedBy tmkc:GC-0044,
        tmkc:GC-0115,
        tmkc:GC-0116 ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s63>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s64>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s65>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s83> ;
    tmk:mayGiveRiseTo tmkc:GC-0006 ;
    tmk:notLabel "divisional application"@en-AU,
        "rectification of the Register"@en-AU,
        "withdrawal"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
