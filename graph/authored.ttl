    tmk:authoringReasoning "The Manual's example connects a place's reputation with the assessment of its name's inherent capacity to distinguish, supporting reputation as a qualifying factor for a geographical reference. This concerns geographical reputation; its inclusion within the anchor's scope is uncertain."@en-AU ;
    tmk:confidence 8.4e-01 ;
    tmk:expertShouldCheck "Whether the anchor includes geographical reputation rather than only reputation acquired by a trade mark."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0315" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
