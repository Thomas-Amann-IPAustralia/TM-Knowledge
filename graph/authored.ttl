    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part5/2/2/3> ;
    tmk:spanEnd 265 ;
    tmk:spanStart 0 ;
    tmk:supportingText "International Registrations Designating Australia (IRDA) are applications that have been filed through the Madrid Protocol. These applications are sent electronically by WIPO after they have checked formalities, fees and classification of the goods and/or services." ;
    tmk:tier 2 .

