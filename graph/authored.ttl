    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual expressly contrasts certification and collective trade marks by their assignability. No listed predicate captures that contrast more specifically; this does not establish that either category is a kind of the other."@en-AU ;
    tmk:confidence 7.6e-01 ;
    tmk:expertShouldCheck "Whether an express contrast in assignability warrants related_to rather than none in this ontology."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
