tmkc:GC-0103 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "A composite: the Regulations define it as a notice of intention to oppose plus a statement of grounds and particulars. Both components are separately defined terms, so the corpus holds three related definitions where a reader might expect one."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "notice of opposition"@en-AU ;
    tmk:appliesTo tmkc:GC-0113,
        tmkc:GC-0142,
        tmkc:GC-0143 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states the composition in terms and cites both regulations. Held as one concept with the components named as near-misses, because the commonest error here is using the whole to mean a part."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part47/1%231> ;
    tmk:expertShouldCheck "Whether the two components should be authored as concepts now. Both are defined terms in the candidate list with 44 and 47 Manual uses respectively."@en-AU ;
    tmk:goldRecord "GC-0103" ;
    tmk:labelKey "notice of opposition" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r17A.29>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMR1995/r5.2> ;
    tmk:notLabel "notice of intention to defend"@en-AU,
        "notice of intention to oppose"@en-AU,
        "statement of grounds and particulars"@en-AU ;
    tmk:notLabelKey "notice of intention to defend",
        "notice of intention to oppose",
        "statement of ground and particular" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "notice of opposition" ;
    tmk:requiresElement tmkc:GC-0040,
        tmkc:GC-0153 ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part47/1%231> ;
    tmk:typedBy tmka:GT-0103 .

tmkc:GC-0109 a skos:Concept,
        tmk:LegalConcept,
        tmk:SubjectMatter ;
    rdfs:comment "Requires an existing registration and a reputation extensive enough that use on other goods would be taken to indicate a connection. It is the one registration in the Act that does not require an intention to use."@en-AU ;
    skos:altLabel "defensive registration"@en-AU,
        "defensive trade marks"@en-AU ;
    skos:broader tmkc:GC-0088 ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "defensive trade mark"@en-AU ;
    skos:related tmkc:GC-0084 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The passage states the qualifying condition, though in the past tense about the 1955 Act. The record is honest about that: the evidence is historical framing of a requirement the Manual carries forward, which is weaker than a current statement."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/1/1/1> ;
    tmk:expertShouldCheck "The evidence is a sentence about the 1955 Act. If Part 34 states the current requirement elsewhere, that passage should replace this one."@en-AU ;
    tmk:goldRecord "GC-0109" ;
    tmk:labelKey "defensive registration",
