        "change of ownership"@en-AU,
        "transmission"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/assignment> ;
    tmk:typedBy tmka:GT-0086 .

tmkc:GC-0117 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Defined in five different places across the Regulations as well as in section 6 — one per opposition type. The multiplicity is real and this record does not resolve it."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "opponent"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual states who an opponent generally is. The statutory definitions differ by proceeding and are deliberately not merged here (CLAUDE.md rule 6)."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part46/1%231> ;
    tmk:expertShouldCheck "Whether the six statutory definitions of 'opponent' are the same concept. The candidate pass found them and refused to choose; this record inherits that refusal."@en-AU ;
    tmk:goldRecord "GC-0117" ;
    tmk:isDefinedIn <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/opponent>,
