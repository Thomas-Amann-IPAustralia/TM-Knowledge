    tmk:typedBy tmka:GT-0076 .

tmkc:GC-0080 a skos:Concept,
        tmk:LegalConcept,
        tmk:LegalTest ;
    rdfs:comment "A third resemblance test, and the corpus defines it no better than it defines substantial identity. Distinct from both section 44 comparisons: it asks whether two marks of one owner are close enough to share an application."@en-AU ;
    skos:altLabel "resemble each other in material particulars"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "material particulars"@en-AU ;
    tmk:appliesTo tmkc:GC-0074 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Act uses the phrase as the operative requirement for a series. Held apart from the section 44 comparisons because it answers a different question between different parties, and because the repository now holds three resemblance tests that a reader could easily merge."@en-AU ;
    tmk:confidence 7e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part13/2%231~1> ;
    tmk:expertShouldCheck "The definition source. `TMM/Part13/2#1~1` is the Manual's section on material particulars and should be read to confirm it defines rather than merely applies the test."@en-AU ;
    tmk:goldRecord "GC-0080" ;
    tmk:labelKey "material particular",
        "resemble each other in material particular" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51(1)> ;
    tmk:notLabel "deceptively similar"@en-AU,
        "substantially identical"@en-AU ;
    tmk:notLabelKey "deceptively similar",
        "substantially identical" ;
    tmk:origin "authored" ;
    tmk:prefLabelKey "material particular" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s51> ;
    tmk:typedBy tmka:GT-0080 .

tmkc:GC-0083 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "The person, as against the use. Section 8(1) makes control the test for both, but the Act keeps them in separate subsections and section 26 gives the authorised user rights of its own."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "authorised user"@en-AU ;
    skos:related tmkc:GC-0085,
        tmkc:GC-0088 ;
    tmk:actsUnderControlOf tmkc:GC-0084 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms by section 8(1). Note the repository already holds GC-0035 for this term from the section 43 pilot; this record is written from the statutory definition rather than from Part 29's use of the phrase, and the two should be reconciled by a reviewer rather than by an agent."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part19A/1%231> ;
    tmk:expertShouldCheck "The overlap with the signed GC-0035. If they are the same concept this record should be retired in favour of the signed one; if the section 43 sense is narrower, both stand and need a relationship between them."@en-AU ;
    tmk:goldRecord "GC-0083" ;
    tmk:labelKey "authorised user" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/authorised-user>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8(1)> ;
    tmk:notLabel "authorised use"@en-AU,
        "predecessor in title"@en-AU,
