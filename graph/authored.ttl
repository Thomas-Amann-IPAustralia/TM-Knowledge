    tmk:spanEnd 228 ;
    tmk:spanStart 49 ;
    tmk:supportingText "If a trade mark contains a name of a person (or group of people) which is well known in relation to the specified goods or services, the provisions of section 43 may be triggered." ;
    tmk:tier 3 .

tmka:GR-0687 a tmk:AuthoredAssertion ;
    rdfs:comment "Carries the corrected reading of the signed GR-0039, which stays in eval/gold/ as signed (correction in authored/corrections.yaml)."@en-AU ;
