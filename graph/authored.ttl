    tmk:spanEnd 242 ;
    tmk:spanStart 0 ;
    tmk:supportingText "If a notice of intention to defend is not filed, the Registrar may take the opposition to have succeeded and refuse to remove the trade mark from the Register, or refuse to cease protection of an international trade mark (regs 9.15, 17A.48Q)." ;
    tmk:tier 2 .

tmka:GR-0176 a tmk:AuthoredAssertion ;
