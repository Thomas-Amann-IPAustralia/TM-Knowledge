tmkc:GC-0097 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Available across the Act wherever a time is set, and the Manual notes the procedure differs by which time is being extended. That variability is why it is one concept with many procedures rather than many concepts."@en-AU ;
    skos:altLabel "extension of the period"@en-AU,
        "extensions of time"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "extension of time"@en-AU ;
