    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part31/4/4/2/2~2> ;
    tmk:spanEnd 256 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Grounds for rejection under section 43 of the Act may need to be considered if, in the context of the trade mark as a whole, the Australian National Flag connotes a quality of the goods or services, and consumers would be likely to be confused as a result." ;
    tmk:tier 3 .

