tmka:GR-0313 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0130 ;
    tmk:assertionPredicate skos:related ;
    tmk:assertionSubject tmkc:GC-0041 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual identifies use and marketing as measures of reputation, supporting a connection between evidence of use and assessing reputation. It does not say that the evidence itself creates reputation."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:expertShouldCheck "Whether identifying use as a measure sufficiently supports a relationship with the distinct concept evidence of use."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0313" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:ce1851662a61a6804b1c5dd26c33639e60a96730fb439501df4ba858b93f46c0" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part34/6/6/2/3> ;
    tmk:spanEnd 1493 ;
    tmk:spanStart 1375 ;
    tmk:supportingText "Both use and marketing are important measures of reputation - see McCormick & Company Inc v McCormick [2000] FCA 1335." ;
    tmk:tier 2 .

tmka:GR-0314 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0117 ;
    tmk:assertionPredicate tmk:allocatesTo ;
    tmk:assertionSubject tmkc:GC-0130 ;
