    tmk:spanEnd 977 ;
    tmk:spanStart 732 ;
    tmk:supportingText "The likelihood of confusion must depend on the reputation of the opponent’s trade mark, but have regard (amongst other factors) to the level of similarity of the goods/services and the degree of similarity of the trade marks, greater or smaller." ;
    tmk:tier 3 .

tmka:GR-0082 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0003 ;
    tmk:assertionPredicate tmk:qualifies ;
