    tmk:spanEnd 1958 ;
    tmk:spanStart 1704 ;
    tmk:supportingText "An applicant may overcome a section 43 ground for rejection in relation to a name by providing the well-known person’s written permission to use their name as a trade mark. Where permission is provided, this should be made clear by way of an endorsement." ;
    tmk:tier 2 .

tmka:GR-0090 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0006 ;
    tmk:assertionPredicate tmk:mayGiveRiseTo ;
    tmk:assertionSubject tmkc:GC-0036 ;
