tmka:GT-0079 tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "A single application covering two or more marks that resemble each other in material particulars. The concept names the set of marks — what is applied for."@en-AU ;
    tmk:conceptGroup "subject_matter" ;
    tmk:confidence 7e-01 ;
    tmk:expertShouldCheck "Whether 'series of trade marks' and 'divisional application' fall on the same side. This pass puts series in subject_matter and divisional in procedural_step, on the reading that a series is a thing applied for and a division is something done to an application. A reviewer who thinks both are applications should move series; one who thinks both are mechanisms should move divisional. They should be decided together."@en-AU ;
