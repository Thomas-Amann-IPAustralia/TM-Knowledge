tmka:GK-0007 a tmk:Correction ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The owner ruled that wine geographical indications are different from other GIs: they have a dedicated statutory scheme, while other GIs are principally protected through certification trade marks (A4). Wine GIs are now GC-0169, which carries this label; GC-0169 is a kind of GC-0018."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:corrects tmkc:GC-0018 ;
    tmk:expertShouldCheck "Whether 'listed EU GI' (Part 29.11) names wine GIs only; if so it belongs on GC-0169 too."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GK-0007" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:ruling "review/rulings/2026-10-08-chat-ontology-review.yaml#A4" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32B/1/1/3> ;
    tmk:withdrawnValue "alt_labels: geographical indication for wine" .

tmka:GK-0008 a tmk:Correction ;
    tmk:addedValue "not_labels: authorised user" ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "GC-0035 is the section 43 factor about who holds a phone number, domain name or call sign the mark refers to. 'Authorised user' is the trade mark's authorised user under section 8 — GC-0083 — and the owner ruled that the owner and the authorised user are separate entities (A4). The label moves to a not-label so recognition stops putting the two together."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:corrects tmkc:GC-0035 ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GK-0008" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:ruling "review/rulings/2026-10-08-chat-ontology-review.yaml#A4" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s8> ;
    tmk:withdrawnValue "alt_labels: authorised user" .

