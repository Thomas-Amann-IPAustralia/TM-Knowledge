    tmk:authoringReasoning "It extends whose use counts, so it feeds the use questions rather than answering one. That is a relevant_factor."@en-AU ;
    tmk:conceptGroup "relevant_factor" ;
    tmk:confidence 7e-01 ;
    tmk:expertShouldCheck "Whether this and the other role concepts should be typed alike."@en-AU ;
