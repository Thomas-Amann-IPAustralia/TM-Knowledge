    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual expressly makes clear satisfaction of this likelihood test necessary before a mark is caught by the provisions. In context, that is a prerequisite to the stated absence of discretion, not an unconditional duty to reject."@en-AU ;
    tmk:confidence 9.3e-01 ;
    tmk:expertShouldCheck "Whether this prerequisite should be modelled against section 43 rather than the mandatory-application concept."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0183" ;
    tmk:isStale false ;
    tmk:modality "must" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:b6690f96b0ebc5181ac9b42c2669b0de831371538a8cc414e94d5e54796ceeff" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/1%231> ;
    tmk:spanEnd 777 ;
    tmk:spanStart 543 ;
    tmk:supportingText "However for a trade mark to be caught by these provisions it is necessary for a decision maker to be clearly satisfied that use of the trade mark for the specified goods and / or services would be likely to deceive or cause confusion." ;
    tmk:tier 3 .

