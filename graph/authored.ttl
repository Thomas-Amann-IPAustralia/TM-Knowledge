tmka:GK-0012 a tmk:Correction ;
    tmk:addedValue "alt_labels: divisional applications",
        "legislative_basis: TMA1995/s45",
        "legislative_basis: TMA1995/s46",
        "not_labels: parent application" ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 45 names both and they are opposites: the parent application is the one a divisional is made from. 'Parent application' as an alternative label made every mention of a parent recognise a divisional; it is a not-label now. Sections 45 and 46 are the divisional's own provisions, from the withdrawn duplicate GC-0110 (ruling A1); the signed record cites only the grounds a divisional is examined against."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:corrects tmkc:GC-0043 ;
    tmk:expertShouldCheck "Whether the grounds (ss 39 to 43) the signed record cites should stay as bases."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GK-0012" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:ruling "review/rulings/2026-10-08-chat-ontology-review.yaml#A1+D2" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s45>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part12/1%231> ;
    tmk:withdrawnValue "alt_labels: parent application" .

tmka:GK-0013 a tmk:Correction ;
    tmk:addedValue "legislative_basis: TMA1995/s201",
        "not_labels: Deputy Registrar",
        "not_labels: delegate" ;
    tmk:authoredBy "claude-code-agent-S026" ;
    tmk:authoredDate "2026-10-08"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Registrar is the statutory office (s 201). A delegate exercises the Registrar's powers by instrument (s 206) and a Deputy Registrar by statute (s 205), but neither is the Registrar: the owner approved the review's reading that the roles are distinct (C1, C2). \"The Registrar's delegate\" moves to the delegate concept (GC-0171); the two offices become not-labels. Section 201 is from the withdrawn duplicate GC-0115 (A1), which cited section 200 (the seal) by mistake."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:corrects tmkc:GC-0046 ;
    tmk:expertShouldCheck "Whether passages that say 'the Registrar' but mean the delegate acting should still recognise the Registrar; they will, which is how the Manual writes."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GK-0013" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:ruling "review/rulings/2026-10-08-chat-ontology-review.yaml#C1+C2+A1" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s201>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s206> ;
    tmk:withdrawnValue "alt_labels: the Registrar's delegate" .

