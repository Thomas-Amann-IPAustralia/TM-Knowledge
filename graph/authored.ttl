    tmk:spanEnd 206 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The Madrid Protocol has no direct provisions for revocation of acceptance. However it is possible to notify the IB of additional provisional refusals based on examination during the 18-month refusal period." ;
    tmk:tier 2 .

tmka:GR-0282 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0121 ;
