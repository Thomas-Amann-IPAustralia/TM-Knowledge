tmkc:GC-0069 a skos:Concept,
        tmk:InstrumentOrRecord,
        tmk:LegalConcept ;
    rdfs:comment "The Act defines 'limitations' in section 6 and uses 'conditions or limitations' as a pair in sections 33(2) and 44(3). The Manual treats them as the price of acceptance under subsection 44(3)."@en-AU ;
    skos:altLabel "conditions and limitations"@en-AU,
        "limitations"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "conditions or limitations"@en-AU ;
    skos:related tmkc:GC-0100 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Act states the power and defines one half of the pair. The concept is held as the pair because that is how both the Act and the Manual use it, and holding 'limitations' alone would leave 'conditions' unrepresented."@en-AU ;
    tmk:confidence 7.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part28/5%231> ;
    tmk:expertShouldCheck "Whether conditions and limitations are one concept or two. The Act defines only limitations, which is evidence for two."@en-AU ;
    tmk:goldRecord "GC-0069" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s33(2)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44(3)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/limitations> ;
    tmk:notLabel "disclaimer"@en-AU,
        "endorsement"@en-AU,
        "other circumstances"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s44>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/limitations> ;
    tmk:typedBy tmka:GT-0069 .

tmkc:GC-0070 a skos:Concept,
        tmk:LegalConcept,
        tmk:LegalTest ;
    rdfs:comment "The Manual is explicit that classification is not the determining factor, which is the single most useful thing in this record: the class number and the similarity question are different things and are routinely confused."@en-AU ;
    skos:altLabel "goods of the same description"@en-AU,
        "similar goods"@en-AU,
        "similar services"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "similarity of goods and services"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 14 defines the term and the Manual states the practice point that classification does not settle it. Both are explicit."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/4%231> ;
    tmk:expertShouldCheck "Whether 'goods of the same description' is a synonym or a narrower concept. Section 14(1)(b) makes it one of two ways goods can be similar, which argues narrower."@en-AU ;
    tmk:goldRecord "GC-0070" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s14>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s14(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s14(2)> ;
    tmk:notLabel "classification of goods and services"@en-AU,
        "closely related goods and services"@en-AU ;
    tmk:origin "authored" ;
    tmk:qualifies tmkc:GC-0061 ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s14>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part26/4%231> ;
    tmk:typedBy tmka:GT-0070 .

tmkc:GC-0084 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Defined by the Register: the person in whose name the mark is registered. That is narrower than ownership at common law, and the Manual's Part 19B treats the registration as personal property held by that person."@en-AU ;
    skos:altLabel "owner of the trade mark"@en-AU,
        "registered proprietor"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "registered owner"@en-AU ;
    skos:related tmkc:GC-0107 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined by the Act in terms; the Manual supplies the property characterisation the definition sits inside."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part19B/1%231> ;
    tmk:expertShouldCheck "Whether 'owner of the trade mark' is safe as an alt_label. The Act uses that phrase in section 8 for a mark that need not be registered, so the alt_label may be too wide."@en-AU ;
    tmk:goldRecord "GC-0084" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s21(1)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/registered-owner> ;
    tmk:notLabel "applicant"@en-AU,
        "authorised user"@en-AU,
        "predecessor in title"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/registered-owner>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part19B/1%231> ;
    tmk:typedBy tmka:GT-0084 .

tmkc:GC-0086 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "Defined narrowly by the Act as an assignment by act of the parties. Transmission is the other half of the pair and covers what happens without such an act — the Manual's Part 43 title carries both."@en-AU ;
    skos:altLabel "assignment of a trade mark"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "assignment"@en-AU ;
    tmk:appliesTo tmkc:GC-0107 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined in terms by section 6. Held apart from transmission because the Act defines them separately and the difference — an act of the parties, or not — is the whole distinction."@en-AU ;
    tmk:confidence 8.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part43/1%231~1> ;
    tmk:expertShouldCheck "Nothing specific; this is one of the cleaner records in the pass."@en-AU ;
    tmk:goldRecord "GC-0086" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s106>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/assignment> ;
    tmk:notLabel "authorised use"@en-AU,
        "change of ownership"@en-AU,
        "transmission"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/assignment> ;
    tmk:typedBy tmka:GT-0086 .

tmkc:GC-0087 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "The section 6 definition is a stub continuing into a list, so this record's evidence comes from the Manual rather than from the definition itself."@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "transmission"@en-AU ;
    skos:related tmkc:GC-0029 ;
    tmk:appliesTo tmkc:GC-0107,
        tmkc:GC-0108 ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Act defines the term but its text is a stub. The Manual's Part 43 treats assignment and transmission together, so the evidence available is weak — and the record says so with a low confidence rather than borrowing certainty from the pair."@en-AU ;
    tmk:confidence 5.5e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part43/1%231~1> ;
    tmk:expertShouldCheck "The Manual passage this rests on defines assignment and transmission together and never separates them, so the record is evidenced for the pair and not for this half of it. Either the section 6 subparagraphs supply the difference or the two should be one concept."@en-AU ;
    tmk:goldRecord "GC-0087" ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/transmission> ;
    tmk:notLabel "assignment"@en-AU,
        "change of ownership"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part43/1%231~1> ;
    tmk:typedBy tmka:GT-0087 .

tmkc:GC-0105 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProceduralStep ;
    rdfs:comment "A court remedy, not a Registrar's one: the amendment or cancellation results from an order of a prescribed court. That is what separates it from every other correction mechanism in the Act."@en-AU ;
    skos:altLabel "rectification"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
