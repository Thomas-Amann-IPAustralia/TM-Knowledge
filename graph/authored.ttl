    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "A period set by the Act or Regulations is lengthened on request. A change in the state of the thing whose period it is."@en-AU ;
    tmk:conceptGroup "procedural_step" ;
