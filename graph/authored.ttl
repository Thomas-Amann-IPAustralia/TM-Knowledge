tmka:GR-0150 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0093 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0036 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual’s conditional acceptance practice requires the goods to accord with the plant variety name or synonym. I infer that the name qualifies the scope of acceptance, rather than independently permitting acceptance."@en-AU ;
    tmk:confidence 7.8e-01 ;
    tmk:expertShouldCheck "Whether the qualifying subject should instead be the goods restriction or Letter of Consent."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0150" ;
    tmk:isStale false ;
    tmk:modality "may" ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:12bba07304bba24fb302b2f30f946b5dac3fee95ae0e2c793283bf92ac872692" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/2/1/2-1-2-c-letter-of-consent> ;
    tmk:spanEnd 457 ;
    tmk:spanStart 0 ;
    tmk:supportingText "The trade mark application may be accepted if the applicant provides a Letter of Consent from the PBR title holder, agreeing to the use and registration of the PBR variety name or synonym as part of a trade mark for the offending goods (see s 11 of the PBR Act). In this circumstance, the owner of the trade mark will need to agree to an endorsement to that effect. The goods will also need to be restricted to accord with the plant variety name or synonym." ;
    tmk:tier 3 .

tmka:GR-0151 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0036 ;
    tmk:assertionPredicate skos:related ;
