    tmk:authoringReasoning "A well-known person's name may give rise to the section 43 ground."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:expertShouldCheck "Whether the edge should be conditional on the name being well known 'in relation to the specified goods or services', as the sentence says."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0686" ;
    tmk:isStale false ;
