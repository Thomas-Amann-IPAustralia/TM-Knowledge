    tmk:spanEnd 259 ;
    tmk:spanStart 0 ;
    tmk:supportingText "No reference is to be made to any additional goods or services in the endorsement that are included in the specification but for which no claim to a priority date has been made as the Australian filing date is the priority date for such goods and/or services." ;
    tmk:tier 2 .

