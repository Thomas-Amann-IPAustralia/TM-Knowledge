    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual recognises that domain-like material can convey a generic-TLD connotation. I infer the relationship to the broader domain-name record from its TLD component, rather than equating acquired trade-origin meaning under section 41 with section 43 connotation."@en-AU ;
    tmk:confidence 8.4e-01 ;
    tmk:expertShouldCheck "Whether generic-TLD material is sufficiently within the internet-domain-name record to support this broader relationship."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0063" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:3264c706f600642da5ed333d95290b16d856bad2a6b6f6170d7761522bf49c0f" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/8/8/1> ;
    tmk:spanEnd 483 ;
    tmk:spanStart 265 ;
    tmk:supportingText "In the case of a generic TLD, the trade mark application needs to be holistically considered, including the relevant specification, when determining whether the material (.SOMETHING) is likely to connote a generic TLD." ;
    tmk:tier 3 .

