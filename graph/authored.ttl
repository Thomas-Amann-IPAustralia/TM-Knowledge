    tmk:supportingText "The grounds for rectification set out in Division 2 of Part 8 of the Act apply to certification trade marks, noting that section 177 applies to certification trade marks instead of section 41." ;
    tmk:tier 3 .

tmka:GR-0277 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0086 ;
