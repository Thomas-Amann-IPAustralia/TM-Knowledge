    tmk:spanEnd 167 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Applications proceeding despite being not to any extent inherently adapted to distinguish require a demonstrated capacity to distinguish for particular goods/services." ;
    tmk:tier 3 .

tmka:GR-0299 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0120 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0061 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual identifies other traders' legitimate desire to use as part of assessing the extent of inherent adaptation, then lists no inherent adaptation as one possible category. Its bearing on that specific category is therefore inferred rather than separately stated."@en-AU ;
    tmk:confidence 8.3e-01 ;
    tmk:expertShouldCheck "Whether a factor in the general assessment sufficiently supports qualifies for the specific no-inherent-adaptation category."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0299" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:5a98371ccfdfb4a4f333e505716c18c9c7b6fb903adb5be22c344fb6a950ad3e" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/3%231~1> ;
    tmk:spanEnd 602 ;
    tmk:spanStart 244 ;
    tmk:supportingText "This determination involves a two-part process: firstly, determining the ordinary signification of the trade mark in the light of the applied for goods and/or services; and secondly, determining the likelihood that other traders might legitimately wish to use the trade mark for that ordinary signification in connection with their similar goods or services." ;
    tmk:tier 3 .

tmka:GR-0300 a tmk:AuthoredAssertion ;
