    tmk:sourceContentHash "sha256:94d2b8f375cd4df08c21d7e4a9625b80416dd3dfdfb83e9d0b880fd8f35e30a5" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part32A/2/4/2/4/1> ;
    tmk:spanEnd 844 ;
    tmk:spanStart 645 ;
    tmk:supportingText "In the context of plants and plant material, the average consumer has an awareness of accepted naming conventions and an expectation of what they will see on labels, packaging and related literature." ;
    tmk:tier 3 .

tmka:GR-0076 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0001 ;
    tmk:assertionPredicate skos:broader ;
    tmk:assertionSubject tmkc:GC-0028 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual describes an implied connection whose content is endorsement or approval. I read implied endorsement as a particular kind of connotation, although the passage does not expressly use that classification."@en-AU ;
    tmk:confidence 8.6e-01 ;
    tmk:expertShouldCheck "Whether implied endorsement should instead be modelled as a consumer belief resulting from the connotation."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0076" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:4a152ff8e285012f7bc44941664602f7d5ebbe7775f61faa73472e1827a6bc60" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/9/9/7> ;
    tmk:spanEnd 435 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Trade marks that consist of, or include wording and/or imagery that connotes a connection with a well- known reference may also give rise to deception and confusion. The inclusion of such material may result in ordinary consumers being deceived and confused on the basis of incorrectly believing that the trade mark indicates an endorsement or approval from the party or parties that own and have control over the well- known material." ;
    tmk:tier 2 .

tmka:GR-0077 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0001 ;
