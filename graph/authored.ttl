    tmk:spanEnd 470 ;
    tmk:spanStart 260 ;
    tmk:supportingText "Any person may effect the renewal (subject to their making their request in an approved form, and upon payment of the correct fee). Renewal is not restricted to the owner of the trade mark (sections 75 and 77)." ;
    tmk:tier 2 .

tmka:GR-0273 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0107 ;
    tmk:assertionPredicate tmk:appliesTo ;
