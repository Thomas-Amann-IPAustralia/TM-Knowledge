    tmk:spanEnd 536 ;
    tmk:spanStart 378 ;
    tmk:supportingText "A trade mark is likely to cause confusion if the ordinary person entertains a reasonable doubt about whether the goods and services come from the same source." ;
    tmk:tier 3 .

tmka:GR-0102 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0008 ;
    tmk:assertionPredicate tmk:qualifies ;
