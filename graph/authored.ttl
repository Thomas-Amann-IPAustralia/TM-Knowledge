    tmk:tier 3 .

tmka:GR-0241 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0073 ;
    tmk:assertionPredicate skos:broader ;
    tmk:assertionSubject tmkc:GC-0078 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual's classification of scent trade marks under the kind of sign “scent” supports treating a scent trade mark as a kind of sign. This is an inference from Manual indexing practice, not a statement of legislative classification."@en-AU ;
    tmk:confidence 9.1e-01 ;
    tmk:expertShouldCheck "Whether indexing under a kind of sign sufficiently supports the broader is_kind_of relationship."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0241" ;
    tmk:isStale false ;
    tmk:kindOfAffirmed "Section 6 includes a scent in \"sign\", and the Manual indexes scent trade marks as \"the kind of sign 'scent'\" (Part 10.3.4.2). A scent trade mark is a trade mark and every trade mark is a sign (s 17); the bare word \"sign\" does not name it."@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:49d9190bd7715d71b25b7fdadb00be8b79be93f13413dd16ec8050a1b556a786" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part10/3/3/4/2> ;
    tmk:spanEnd 183 ;
    tmk:spanStart 0 ;
    tmk:supportingText "Trade marks consisting of or containing a scent will be indexed as the kind of sign “scent” and therefore, all scent trade marks will come up on a search of the “scent” kinds of sign." ;
    tmk:tier 2 .

tmka:GR-0242 a tmk:AuthoredAssertion ;
