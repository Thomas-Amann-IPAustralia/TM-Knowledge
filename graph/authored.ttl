    tmk:sourceContentHash "sha256:c4235ae85720f19a20037d7a4f5a41161ef68438cf8e1ea2d8e36b90b621b1bb" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/5> ;
    tmk:spanEnd 349 ;
    tmk:spanStart 0 ;
    tmk:supportingText "A ground for rejection under section 43 exists where a trade mark to be used in relation to pharmaceuticals or veterinary substances consists of an INN stem, or contains a notified INN stem in a meaningful way, and use of the trade mark in respect of the goods covered by the specification are not restricted to substances indicated by the INN stem." ;
    tmk:tier 3 .

tmka:GR-0419 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0004 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0024 ;
    tmk:authoredBy "gpt-6.1-sol" ;
    tmk:authoredDate "2026-10-07"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "The Manual links the absence of meaningful inclusion to the absence of deception or confusion. This supports meaningful inclusion as a qualification on the confusion assessment, not as a sufficient condition for confusion."@en-AU ;
    tmk:confidence 8.8e-01 ;
    tmk:expertShouldCheck "Whether the negative formulation sufficiently supports a qualifies relationship for meaningful inclusion."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0419" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:66817de6196f7150720015e718aecdc209059307b7d11869b0767ecd18e8e89a" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part29/5/5/6~1> ;
    tmk:spanEnd 373 ;
    tmk:spanStart 192 ;
    tmk:supportingText "Some INN stems consist of simple two or three letter combinations and their presence in a larger word may not be meaningful and as a result would not lead to deception or confusion." ;
    tmk:tier 3 .

tmka:GR-0420 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0002 ;
    tmk:assertionPredicate tmk:qualifies ;
    tmk:assertionSubject tmkc:GC-0025 ;
