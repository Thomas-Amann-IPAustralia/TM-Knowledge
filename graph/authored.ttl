    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "The Manual expressly connects routine expedition with protecting examination against overlooking earlier priority dates. The stated trigger is a convention claim, so the passage does not make priority date itself a direct condition for expedition."@en-AU ;
    tmk:confidence 9.3e-01 ;
    tmk:expertShouldCheck "Whether the policy rationale warrants a more specific predicate than related_to."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0122" ;
