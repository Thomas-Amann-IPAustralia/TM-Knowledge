        "registered owner"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/applicant> ;
    tmk:typedBy tmka:GT-0116 .

tmkc:GC-0115 a skos:Concept,
        tmk:LegalConcept,
        tmk:ProcessRole ;
    rdfs:comment "Almost every duty and discretion in the Act is the Registrar's. Section 205 makes a Deputy Registrar's exercise of a power count as the Registrar's, which is why decisions issued by a Deputy are the Registrar's decisions. GC-0046 already holds this term."@en-AU ;
    skos:altLabel "Registrar"@en-AU,
        "the Registrar"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "Registrar of Trade Marks"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Defined by the Act, and the Manual supplies the delegation rule that makes the role behave the way examiners meet it. Overlaps the signed GC-0046 and says so."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part52/1%231~2> ;
    tmk:expertShouldCheck "The overlap with the signed GC-0046, and whether the section 205 point belongs in this concept or in a separate 'Deputy Registrar' one."@en-AU ;
    tmk:goldRecord "GC-0115" ;
    tmk:hasStatutoryBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s101>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s104>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s175(4)>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s41>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s84A(3)(b)> ;
    tmk:legislativeBasis <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s200>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s205>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/registrar> ;
    tmk:notLabel "Deputy Registrar"@en-AU,
        "delegate"@en-AU,
        "prescribed court"@en-AU ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMA1995/s6/registrar>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part52/1%231~2> ;
    tmk:typedBy tmka:GT-0115 .

tmkc:GC-0072 a skos:Concept,
        tmk:LegalConcept,
        tmk:SubjectMatter ;
    rdfs:comment "The Manual makes the point that matters most here: the definition of trade mark is closed and exhaustive, while the definition of sign is open and inclusive. A sign is a trade mark only when used or intended to be used to distinguish in the course of trade."@en-AU ;
    skos:altLabel "mark"@en-AU ;
    skos:inScheme tmkc:scheme-s43 ;
    skos:prefLabel "trade mark"@en-AU ;
    tmk:authoredBy "claude-opus-5" ;
    tmk:authoredDate "2026-09-09"^^xsd:date ;
    tmk:authoringBasis "corpus_explicit" ;
    tmk:authoringReasoning "Section 17 defines it in terms and the Manual explains the character of the definition. Held apart from 'sign' because the Manual says in one sentence why they are not the same kind of definition."@en-AU ;
    tmk:confidence 9e-01 ;
    tmk:definitionSource <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/1%231>,
        <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part20/3%231> ;
    tmk:expertShouldCheck "Whether 'mark' is really an alt_label. The Manual uses it as the 1955 Act's word and the 1995 Act deliberately replaced it, which may make it historical rather than current."@en-AU ;
    tmk:goldRecord "GC-0072" ;
