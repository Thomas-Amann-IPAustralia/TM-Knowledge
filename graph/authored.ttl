    tmk:authoredDate "2026-10-09"^^xsd:date ;
    tmk:authoringBasis "corpus_inferred" ;
    tmk:authoringReasoning "A mark sufficiently inherently adapted to distinguish is prima facie capable of distinguishing."@en-AU ;
    tmk:confidence 8e-01 ;
    tmk:expertShouldCheck "Whether the sentence states this relationship, read the way the predicate reads."@en-AU ;
    tmk:extractionMethod "agent_authoring" ;
    tmk:goldRecord "GR-0484" ;
    tmk:isStale false ;
    tmk:origin "authored" ;
    tmk:reviewStatus "unreviewed" ;
    tmk:sourceContentHash "sha256:04125b04bcd11cef1c8a0e1be6b4641de03d04d880a5cba65b4256c8bce70413" ;
    tmk:sourcePassage <https://data.ipaustralia.gov.au/tmk/ref/TMM/Part22/14/14/3> ;
    tmk:spanEnd 1672 ;
    tmk:spanStart 1271 ;
    tmk:supportingText "Trade marks consisting of the combination of a word that has some reference to the goods or services, followed by the word SMART or INTELLIGENT, will usually be prima facie capable of distinguishing. For example LIGHT SMART would be inherently adapted to distinguish lighting apparatus or the installation of lighting apparatus and therefore a section 41 ground for rejection would not be appropriate." ;
    tmk:tier 3 .

tmka:GR-0485 a tmk:AuthoredAssertion ;
    tmk:assertionObject tmkc:GC-0059 ;
