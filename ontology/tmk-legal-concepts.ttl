# TM-Knowledge ontology — Legal concepts
#
# The concept classes, and the non-synonym property SKOS lacks.
#
# GENERATED by tm_knowledge.graph.ontology. Do not hand-edit: the base
# IRI is a configuration value (IDENTIFIERS.md, HANDOFF Q7) and editing
# the prefix line here is the find-and-replace that rule forbids.
# Edit src/tm_knowledge/graph/ontology.py and rebuild with tmk-graph.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tmk: <https://data.ipaustralia.gov.au/tmk/ns/> .
@prefix tmka: <https://data.ipaustralia.gov.au/tmk/assertion/> .
@prefix tmkc: <https://data.ipaustralia.gov.au/tmk/concept/> .
@prefix tmkg: <https://data.ipaustralia.gov.au/tmk/graph/> .
@prefix tmkr: <https://data.ipaustralia.gov.au/tmk/ref/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tmk:Exception
    a owl:Class ;
    rdfs:comment "A circumstance that displaces a ground that would otherwise apply. Unpopulated for the same reason."@en ;
    rdfs:label "exception"@en ;
    rdfs:subClassOf tmk:LegalConcept ;
    tmk:unpopulatedByDesign true .

tmk:GroundOfRefusal
    a owl:Class ;
    rdfs:comment "A basis on which an application may be rejected. **No concept in the pilot is classified into this class**, because deciding that a particular concept is a ground rather than a test or a factor is a legal judgement and no approved record carries it (rule 1)."@en ;
    rdfs:label "ground of refusal"@en ;
    rdfs:subClassOf tmk:LegalConcept ;
    tmk:unpopulatedByDesign true .

tmk:LegalConcept
    a owl:Class ;
    rdfs:comment "A concept in the controlled vocabulary that the examination practice turns on. Every member is also a skos:Concept in the pilot scheme."@en ;
    rdfs:label "legal concept"@en ;
    rdfs:subClassOf tmk:LegalMatter .

tmk:LegalTest
    a owl:Class ;
    rdfs:comment "A test a decision maker applies. Unpopulated for the same reason as GroundOfRefusal."@en ;
    rdfs:label "legal test"@en ;
    rdfs:subClassOf tmk:LegalConcept ;
    tmk:unpopulatedByDesign true .

tmk:RelevantFactor
    a owl:Class ;
    rdfs:comment "Something a decision maker weighs without it being decisive. Unpopulated for the same reason."@en ;
    rdfs:label "relevant factor"@en ;
    rdfs:subClassOf tmk:LegalConcept ;
    tmk:unpopulatedByDesign true .

tmk:notLabel
    a owl:DatatypeProperty ;
    rdfs:comment "A term that must **not** be treated as a synonym of this concept, recorded by a reviewer. SKOS has no way to say this and it is the most valuable field in the vocabulary: a synonym list makes recall better, and only a non-synonym list stops the expansion turning 'connotation' into 'deceptively similar'."@en ;
    rdfs:label "not a label for"@en .
