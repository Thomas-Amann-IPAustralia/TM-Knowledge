# TM-Knowledge ontology — Provenance
#
# Reified assertions and the approval fields from ADR-0011.
#
# GENERATED by tm_knowledge.graph.ontology. Do not hand-edit: the base
# IRI is a configuration value (IDENTIFIERS.md, HANDOFF Q7) and editing
# the prefix line here is the find-and-replace that rule forbids.
# Edit src/tm_knowledge/graph/ontology.py and rebuild with tmk-graph.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tmk: <https://data.ipaustralia.gov.au/tmk/ns/> .
@prefix tmka: <https://data.ipaustralia.gov.au/tmk/assertion/> .
@prefix tmkc: <https://data.ipaustralia.gov.au/tmk/concept/> .
@prefix tmkg: <https://data.ipaustralia.gov.au/tmk/graph/> .
@prefix tmkr: <https://data.ipaustralia.gov.au/tmk/ref/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tmk:Assertion
    a owl:Class ;
    rdfs:comment "One approved relationship, reified so that it can carry who approved it, on what passage, at what strength and at what tier. The plain triple says what the graph believes; this says why, and the two live in different named graphs so a query for one need not wade through the other."@en ;
    rdfs:label "assertion"@en ;
    rdfs:subClassOf prov:Entity .

tmk:Mention
    rdfs:subClassOf prov:Entity .

tmk:approvedBy
    a owl:DatatypeProperty ;
    rdfs:comment "Who signed the record. A record with no name here is not approved knowledge, whatever else it carries (ADR-0039)."@en ;
    rdfs:label "approved by"@en .

tmk:approvedDate
    a owl:DatatypeProperty ;
    rdfs:comment "When it was signed."@en ;
    rdfs:label "approved date"@en .

tmk:goldRecord
    a owl:DatatypeProperty ;
    rdfs:comment "The id of the approved record this node was built from, so anything in the graph can be traced back to the row a person signed."@en ;
    rdfs:label "gold record"@en .

tmk:sourceContentHash
    a owl:DatatypeProperty ;
    rdfs:comment "The passage's content hash at the time of approval. When the pin moves and this no longer matches, the approval is stale and the harness says so — a hash is never silently refreshed."@en ;
    rdfs:label "source content hash"@en .

tmk:spanEnd
    a owl:DatatypeProperty ;
    rdfs:comment "Character offset, exclusive, of the end of the supporting span."@en ;
    rdfs:label "span end"@en .

tmk:spanStart
    a owl:DatatypeProperty ;
    rdfs:comment "Character offset of the supporting span within the passage."@en ;
    rdfs:label "span start"@en .

tmk:supportingText
    a owl:DatatypeProperty ;
    rdfs:comment "The sentence the assertion rests on, quoted from the passage."@en ;
    rdfs:label "supporting text"@en .

tmk:tier
    a owl:DatatypeProperty ;
    rdfs:comment "The consequence tier from the gold record: 3 where a wrong reading would change an examination position, 2 where it would not."@en ;
    rdfs:label "tier"@en .

tmk:unpopulatedByDesign
    a owl:DatatypeProperty ;
    rdfs:comment "Marks a class that is declared and deliberately empty because putting anything in it would be a legal judgement no approved record supports. An empty class so marked is a question; an empty class without it is a bug."@en ;
    rdfs:label "unpopulated by design"@en .
