    rdfs:label "qualifies"@en-AU ;
    rdfs:domain tmk:LegalMatter ;
    rdfs:range tmk:LegalMatter ;
    skos:definition "The subject affects how the object is assessed or applied, without deciding it — the way a relevant factor bears on a test."@en-AU ;
    tmk:reading "<factor> qualifies <test or concept>"@en-AU ;
    skos:example "GR-0017: the trade mark as a whole qualifies whether it is likely to deceive or cause confusion."@en-AU ;
    tmk:counterExample "Not because a sentence uses the word 'qualifies' (GR-0520 'qualifies for registration' was that mistake)."@en-AU ;
