tmk:prevailsOver a owl:ObjectProperty ;
    a tmk:AdmittedRelation ;
    rdfs:label "prevails over"@en-AU ;
    rdfs:domain tmk:LegalMatter ;
    rdfs:range tmk:LegalMatter ;
    skos:definition "Where the subject and the object disagree, the subject's view stands."@en-AU ;
    tmk:reading "<subject> prevails over <object>"@en-AU ;
    skos:example "In a classification dispute on a Madrid export application, the International Bureau's opinion stands over the Office of origin's (Part 14.2.2.2.2)."@en-AU ;
    tmk:counterExample "Not for general seniority; only where a source says whose view stands."@en-AU ;
    tmk:admittedBy "owner-2026-10-08" ;
    tmk:predicateAuthority "practice" ;
    tmk:usageCount 0 ;
    tmk:authoredUsageCount 1 ;
    tmk:observedSubjectType tmk:LegalConcept ;
    tmk:observedObjectType tmk:LegalConcept ;
    rdfs:comment "Admitted by the owner's ruling (owner-2026-10-08); no signed record uses it yet. Machine-written usage: 1, unreviewed."@en-AU .

tmk:qualifies a owl:ObjectProperty ;
