# TM-Knowledge ontology — Relations
#
# The fourteen approved predicates and the three modalities.
#
# GENERATED by tm_knowledge.graph.ontology. Do not hand-edit: the base
# IRI is a configuration value (IDENTIFIERS.md, HANDOFF Q7) and editing
# the prefix line here is the find-and-replace that rule forbids.
# Edit src/tm_knowledge/graph/ontology.py and rebuild with tmk-graph.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tmk: <https://data.ipaustralia.gov.au/tmk/ns/> .
@prefix tmka: <https://data.ipaustralia.gov.au/tmk/assertion/> .
@prefix tmkc: <https://data.ipaustralia.gov.au/tmk/concept/> .
@prefix tmkg: <https://data.ipaustralia.gov.au/tmk/graph/> .
@prefix tmkr: <https://data.ipaustralia.gov.au/tmk/ref/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tmk:May
    a tmk:Modality ;
    rdfs:comment "Stated as a possibility — it can happen, not that it must."@en ;
    rdfs:label "may"@en .

tmk:Modality
    a owl:Class ;
    rdfs:comment "How strongly a relationship is stated: must, may or should. Taken from the approved record, never inferred from the grammar — several approved relationships carry a modality that no modal verb in the sentence supports, and the record says so."@en ;
    rdfs:label "modality"@en .

tmk:Must
    a tmk:Modality ;
    rdfs:comment "Stated as an obligation or as the absence of a discretion."@en ;
    rdfs:label "must"@en .

tmk:Should
    a tmk:Modality ;
    rdfs:comment "Stated as expected practice. The weakest of the three, and the one most often mistaken for an obligation when the Manual is read as law."@en ;
    rdfs:label "should"@en .

tmk:allocatesTo
    a owl:ObjectProperty ;
    rdfs:comment "The passage assigns the matter to another provision."@en ;
    rdfs:label "allocates to"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:appliesTo
    a owl:ObjectProperty ;
    rdfs:comment "The provision applies to the matter, of its own force."@en ;
    rdfs:label "applies to"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:citesAuthorityFor
    a owl:ObjectProperty ;
    rdfs:comment "The subject is cited as authority for the object."@en ;
    rdfs:label "cites authority for"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:constrainsExaminerTo
    a owl:ObjectProperty ;
    rdfs:comment "The subject limits what a decision maker may do — including by removing a discretion that would otherwise exist."@en ;
    rdfs:label "constrains examiner to"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:dependsOnExternalSource
    a owl:ObjectProperty ;
    rdfs:comment "Establishing the subject needs something the programme does not hold — a register, a decision text, a fact about the world."@en ;
    rdfs:label "depends on external source"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:doesNotGiveRiseTo
    a owl:ObjectProperty ;
    rdfs:comment "The subject does not lead to the object."@en ;
    rdfs:label "does not give rise to"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:excludesBasis
    a owl:ObjectProperty ;
    rdfs:comment "The object may not be used as a basis for the subject. A negative statement, and one that can sit in genuine tension with requiresElement over the same pair — see the demonstration report."@en ;
    rdfs:label "excludes basis"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:extendsTo
    a owl:ObjectProperty ;
    rdfs:comment "The subject reaches the object as well."@en ;
    rdfs:label "extends to"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:hasModality
    a owl:ObjectProperty ;
    rdfs:comment "The strength the approved record recorded, as a Modality individual."@en ;
    rdfs:label "has modality"@en .

tmk:interprets
    a owl:ObjectProperty ;
    rdfs:comment "The decision or passage construes the object."@en ;
    rdfs:label "interprets"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:isOvercomeBy
    a owl:ObjectProperty ;
    rdfs:comment "The subject is displaced or answered by the object."@en ;
    rdfs:label "is overcome by"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:mayGiveRiseTo
    a owl:ObjectProperty ;
    rdfs:comment "The subject can lead to the object. Possibility, not consequence."@en ;
    rdfs:label "may give rise to"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:qualifies
    a owl:ObjectProperty ;
    rdfs:comment "The subject narrows or conditions the object."@en ;
    rdfs:label "qualifies"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:relatesLegalMatter
    a owl:ObjectProperty ;
    rdfs:comment "The common parent of the fourteen approved predicates, so a query can ask what the graph says about a concept without naming all fourteen. Carries no domain or range: in RDFS those infer rather than check, and the endpoints here are checked in SHACL instead."@en ;
    rdfs:label "relates legal matter"@en .

tmk:requiresElement
    a owl:ObjectProperty ;
    rdfs:comment "The subject is not made out unless the object is present."@en ;
    rdfs:label "requires element"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .

tmk:statesThresholdFor
    a owl:ObjectProperty ;
    rdfs:comment "The subject fixes the level at which the object is met."@en ;
    rdfs:label "states threshold for"@en ;
    rdfs:subPropertyOf tmk:relatesLegalMatter .
