# TM-Knowledge ontology — Authority
#
# What may be cited, and the distinction that must survive into every
# answer: the Act binds, the Manual states practice.
#
# GENERATED by tm_knowledge.graph.ontology. Do not hand-edit: the base
# IRI is a configuration value (IDENTIFIERS.md, HANDOFF Q7) and editing
# the prefix line here is the find-and-replace that rule forbids.
# Edit src/tm_knowledge/graph/ontology.py and rebuild with tmk-graph.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tmk: <https://data.ipaustralia.gov.au/tmk/ns/> .
@prefix tmka: <https://data.ipaustralia.gov.au/tmk/assertion/> .
@prefix tmkc: <https://data.ipaustralia.gov.au/tmk/concept/> .
@prefix tmkg: <https://data.ipaustralia.gov.au/tmk/graph/> .
@prefix tmkr: <https://data.ipaustralia.gov.au/tmk/ref/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tmk:Authority
    a owl:Class ;
    rdfs:comment "Something that can be cited in support of an examination position. Its subclasses are the whole point of this module: they do not carry the same weight and must never be flattened into one another."@en ;
    rdfs:label "authority"@en ;
    rdfs:subClassOf tmk:LegalMatter .

tmk:JudicialDecision
    a owl:Class ;
    rdfs:comment "A decided case. Cited by the Manual and by this graph, but held nowhere in the programme as a document — every case node is a citation whose text nothing has read (HANDOFF Q6, QUIRKS Q-11)."@en ;
    rdfs:label "judicial decision"@en ;
    rdfs:subClassOf tmk:Authority .

tmk:LegalMatter
    a owl:Class ;
    rdfs:comment "Anything an approved relationship can stand between: a provision, a decision, a passage of the Manual, or a concept. Deliberately broad. It exists so the SHACL shapes have something to name, not so a reasoner can conclude anything from it."@en ;
    rdfs:label "legal matter"@en .

tmk:Legislation
    a owl:Class ;
    rdfs:comment "An instrument — the Trade Marks Act 1995 or the Trade Marks Regulations 1995. Binding."@en ;
    rdfs:label "legislation"@en ;
    rdfs:subClassOf tmk:Authority .

tmk:LegislativeProvision
    a owl:Class ;
    owl:disjointWith tmk:ManualInstruction ;
    rdfs:comment "A section, regulation, schedule or item within an instrument. Binding law. Addressed by an upstream provision ref such as TMA1995/s43."@en ;
    rdfs:label "legislative provision"@en ;
    rdfs:subClassOf tmk:Authority .

tmk:ManualInstruction
    a owl:Class ;
    owl:disjointWith tmk:LegislativeProvision ;
    rdfs:comment "A statement of the Registrar's practice, taken from the Examiner's Manual. It states what the Office does; it does not bind the Registrar's discretion and it is not law (CLAUDE.md rule 5). Disjoint from LegislativeProvision, and the disjointness is the single most load-bearing axiom in this ontology."@en ;
    rdfs:label "Manual instruction"@en ;
    rdfs:subClassOf tmk:Authority .
