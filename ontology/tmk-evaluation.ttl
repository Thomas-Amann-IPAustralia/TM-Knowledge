# TM-Knowledge ontology — Evaluation
#
# Questions the system must answer and conclusions it must not draw. In
# the ontology rather than only in eval/ so that a bound can be checked
# against an answer at query time.
#
# GENERATED by tm_knowledge.graph.ontology. Do not hand-edit: the base
# IRI is a configuration value (IDENTIFIERS.md, HANDOFF Q7) and editing
# the prefix line here is the find-and-replace that rule forbids.
# Edit src/tm_knowledge/graph/ontology.py and rebuild with tmk-graph.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tmk: <https://data.ipaustralia.gov.au/tmk/ns/> .
@prefix tmka: <https://data.ipaustralia.gov.au/tmk/assertion/> .
@prefix tmkc: <https://data.ipaustralia.gov.au/tmk/concept/> .
@prefix tmkg: <https://data.ipaustralia.gov.au/tmk/graph/> .
@prefix tmkr: <https://data.ipaustralia.gov.au/tmk/ref/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tmk:Bound
    a owl:Class ;
    rdfs:comment "A conclusion the system must not draw, with the reason and the way it is detected. Held in the graph rather than in a test fixture so that a retrieval answer can be checked against it at query time."@en ;
    rdfs:label "bound"@en .

tmk:Question
    a owl:Class ;
    rdfs:comment "A question the system is expected to answer, from the approved competency and retrieval sets. Present so that a bound has something to attach to: a prohibition floating free of the questions it constrains is a sentence in a document, not a guard."@en ;
    rdfs:label "question"@en .

tmk:askedBy
    a owl:DatatypeProperty ;
    rdfs:comment "Who asks it — an examiner, an applicant, an attorney."@en ;
    rdfs:label "asked by"@en .

tmk:boundKind
    a owl:DatatypeProperty ;
    rdfs:comment "What kind of failure the bound guards against."@en ;
    rdfs:label "bound kind"@en .

tmk:boundsQuestion
    a owl:ObjectProperty ;
    rdfs:comment "A competency or retrieval question this bound applies to."@en ;
    rdfs:label "bounds question"@en .

tmk:category
    a owl:DatatypeProperty ;
    rdfs:comment "The approved question category."@en ;
    rdfs:label "category"@en .

tmk:detectableBy
    a owl:DatatypeProperty ;
    rdfs:comment "How a breach of this bound would be caught — by an automated test, by evaluation, or only by a person reading the output."@en ;
    rdfs:label "detectable by"@en .

tmk:prohibits
    a owl:DatatypeProperty ;
    rdfs:comment "The conclusion this bound forbids."@en ;
    rdfs:label "prohibits"@en .

tmk:questionText
    a owl:DatatypeProperty ;
    rdfs:comment "The question as a person would ask it."@en ;
    rdfs:label "question text"@en .

tmk:requiresAuthorityDistinction
    a owl:DatatypeProperty ;
    rdfs:comment "True where an answer is wrong unless it keeps the Act and the Manual's practice visibly apart (CLAUDE.md rule 5)."@en ;
    rdfs:label "requires authority distinction"@en .

tmk:requiresEvidence
    a owl:ObjectProperty ;
    rdfs:comment "A passage or provision an answer must rest on to be right. The difference between an answer and a plausible sentence."@en ;
    rdfs:label "requires evidence"@en .

tmk:why
    a owl:DatatypeProperty ;
    rdfs:comment "Why the conclusion is wrong, in the reviewer's words."@en ;
    rdfs:label "why"@en .
