@prefix tmk:  <https://data.ipaustralia.gov.au/tmk/ns/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Every assertion has method, span, hash and review status. ADR-0011, and
# CLAUDE.md rule 8: no output goes anywhere unlabelled.

tmk:ApprovedAssertionShape
    a sh:NodeShape ;
    sh:targetClass tmk:ApprovedAssertion ;
    rdfs:label "An approved assertion carries its whole provenance block"@en-AU ;
    sh:property [
        sh:path tmk:goldRecord ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "No route back to the approved record, so no route back to the reviewer who signed it." ;
    ] ;
    sh:property [
        sh:path tmk:sourcePassage ;
        sh:minCount 1 ;
        sh:message "First of the six starting rules: every approved proposition has a source passage." ;
    ] ;
    sh:property [
        sh:path tmk:extractionMethod ;
        sh:minCount 1 ;
        sh:message "Third of the six starting rules: every extracted relationship identifies its extraction method." ;
    ] ;
    sh:property [
        sh:path tmk:reviewStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "approved" "candidate" "rejected" "stale" ) ;
        sh:message "Review status absent or outside the vocabulary. It is never defaulted to approved." ;
    ] ;
    sh:property [
        sh:path tmk:approvedBy ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "A name and a date are the approval artefact (ADR-0039). Without a name this is a candidate sitting in approved space, which is rule 4 inverted." ;
    ] ;
    sh:property [
        sh:path tmk:approvedDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "No approval date, or one that is not a date." ;
    ] ;
    sh:property [
        sh:path tmk:sourceContentHash ;
        sh:pattern "^sha256:[0-9a-f]{64}$" ;
        sh:message "A content hash that is not one. Staleness detection reads this and nothing else." ;
    ] ;
    sh:property [
        sh:path tmk:confidence ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ;
        sh:message "Confidence outside [0,1]. Note this is confidence in the *extraction*; a confidence attached to a legal conclusion is PU-0003." ;
    ] .

tmk:SpanShape
    a sh:NodeShape ;
    sh:targetSubjectsOf tmk:spanStart ;
    rdfs:label "A span is a well-formed interval"@en-AU ;
    sh:property [
        sh:path tmk:spanEnd ;
        sh:minCount 1 ;
        sh:message "A span with a start and no end locates nothing." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Span end is not after its start. The offsets were constructed rather than measured against the snapshot (ADR-0045)." ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://data.ipaustralia.gov.au/tmk/ns/spanStart> ?start ;
                      <https://data.ipaustralia.gov.au/tmk/ns/spanEnd> ?end .
                FILTER (?end <= ?start)
            }
        """ ;
    ] .

# The direct triple and the assertion beside it are one fact recorded twice.
# If either can exist alone, the graph can carry an approved-looking edge that
# nobody signed — which is the whole reason both are emitted (ADR-0058).

tmk:UnreifiedRelationShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this
            WHERE { ?this a <https://data.ipaustralia.gov.au/tmk/ns/ApprovedRelation> }
        """ ;
    ] ;
    rdfs:label "Every approved relation edge has an assertion behind it"@en-AU ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A direct triple uses this approved predicate with no tmk:Assertion recording who approved it and from which passage. An edge nobody signed is sitting in the approved graph." ;
        sh:select """
            SELECT $this ?value
            WHERE {
                ?subject $this ?object .
                BIND (?subject AS ?value)
                FILTER NOT EXISTS {
                    ?assertion <https://data.ipaustralia.gov.au/tmk/ns/assertionSubject> ?subject ;
                               <https://data.ipaustralia.gov.au/tmk/ns/assertionPredicate> $this ;
                               <https://data.ipaustralia.gov.au/tmk/ns/assertionObject> ?object .
                }
            }
        """ ;
    ] .

tmk:StaleAssertionShape
    a sh:NodeShape ;
    sh:targetClass tmk:ApprovedAssertion ;
    rdfs:label "A stale assertion does not stay in the approved graph"@en-AU ;
    sh:property [
        sh:path tmk:isStale ;
        sh:not [ sh:hasValue true ] ;
        sh:severity sh:Warning ;
        sh:message "The passage under this assertion has moved since it was approved. It returns to review rather than being carried forward, and the hash is never silently refreshed (IDENTIFIERS.md §5)." ;
    ] .

# Absence of tmk:isStale is a different finding from staleness, and saying so
# takes a second constraint. An assertion the build could not check — because
# the passage it names is not in the graph at all — is not known to be current;
# it is unknown, and reporting it as stale would be as wrong as reporting it as
# fresh.

tmk:UncheckedStalenessShape
    a sh:NodeShape ;
    sh:targetClass tmk:ApprovedAssertion ;
    rdfs:label "Staleness was actually checked"@en-AU ;
    sh:property [
        sh:path tmk:isStale ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "No staleness verdict on this assertion: the build could not find the passage it names in the graph, so nothing has confirmed the text under it is still there." ;
    ] .

# --- what a machine wrote --------------------------------------------------
#
# ADR-0079 permits an agent to author legal content and prohibits it being
# mistaken for signed content. The first is a rule about people; these three
# shapes are what make the second mechanical. They are the RDF half of the
# authoring envelope: an authored assertion that reaches a reader can say who
# wrote it, when, on what evidential footing and why — or it does not publish.

tmk:AuthoredAssertionShape
    a sh:NodeShape ;
    sh:targetClass tmk:AuthoredAssertion ;
    rdfs:label "An authored assertion says who wrote it, when, and on what"@en-AU ;
    sh:property [
        sh:path tmk:goldRecord ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "No route back to the authored record, so no route back to the judgement or the evidence under it." ;
    ] ;
    sh:property [
        sh:path tmk:origin ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue "authored" ;
        sh:message "An authored assertion whose origin is not \"authored\". The named graph is the boundary and this stamp is what survives a triple being lifted out of it." ;
    ] ;
    sh:property [
        sh:path tmk:reviewStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "unreviewed" "rejected" ) ;
        sh:message "Review status absent, or claiming more than it may. There are three states and only a signature moves a record off unreviewed; approval also moves it to eval/gold/, so an approved assertion in the authored graph is a transcription that did not finish (ADR-0086)." ;
    ] ;
    sh:property [
        sh:path tmk:approvedBy ;
        sh:maxCount 0 ;
        sh:message "A name in approvedBy on an authored assertion. It means a person read this and signed it, and no agent writes it — this is the single failure the whole scheme exists to prevent (ADR-0079 guard 3)." ;
    ] ;
    sh:property [
        sh:path tmk:approvedDate ;
        sh:maxCount 0 ;
        sh:message "An approval date on an assertion nobody approved." ;
    ] ;
    sh:property [
        sh:path tmk:authoredBy ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "No model recorded. A silent model change alters what gets authored and invalidates every baseline measured before it, so the model and its version are stamped on each record (ADR-0087)." ;
    ] ;
    sh:property [
        sh:path tmk:authoredDate ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "No authoring date, or one that is not a date." ;
    ] ;
    sh:property [
        sh:path tmk:authoringBasis ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "corpus_explicit" "corpus_inferred" "general_knowledge" ) ;
        sh:message "No authoring basis, or one outside the three. Silence about where a judgement came from is exactly the laundering rule 1 now prohibits." ;
    ] ;
    sh:property [
        sh:path tmk:authoringReasoning ;
        sh:minCount 1 ;
        sh:message "No reasoning. The field that makes correction cheap, which is the entire premise of ADR-0079 — without it an expert can only agree or start again." ;
    ] ;
    sh:property [
        sh:path tmk:extractionMethod ;
        sh:minCount 1 ;
        sh:message "Third of the six starting rules: every extracted relationship identifies its extraction method. An authored one identifies that it was authored." ;
    ] ;
    sh:property [
        sh:path tmk:confidence ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ;
        sh:message "Confidence outside [0,1]. Confidence in the authoring is legitimate; a confidence attached to a legal conclusion served to an examiner is PU-0003." ;
    ] .

# Evidence, or the admission that there is none. Not a `minCount 1` on
# sourcePassage, because `general_knowledge` is a permitted and honest label and
# forbidding it would only buy a dishonest `corpus_inferred`. What is forbidden
# is claiming the corpus says something and naming no passage.

tmk:AuthoredEvidenceShape
    a sh:NodeShape ;
    sh:targetClass tmk:AuthoredAssertion ;
    rdfs:label "An authored assertion cites the corpus or says it cannot"@en-AU ;
    sh:or (
        [ sh:property [
            sh:path tmk:authoringBasis ;
            sh:hasValue "general_knowledge" ;
            sh:minCount 1 ;
        ] ]
        [ sh:property [
            sh:path tmk:sourcePassage ;
            sh:minCount 1 ;
        ] ]
    ) ;
    sh:message "This assertion says the corpus supports it and names no passage. Either cite the passage, or record the basis as general_knowledge and let a reviewer reach it first — the one thing that may not happen is the claim without the citation (ADR-0079 guard 2)." .

# The cross-check that survives flattening. The named graphs are the separation;
# a validator sees their union, so this is what would catch machine output that
# had been typed as signed knowledge on its way through.

tmk:OriginConsistencyShape
    a sh:NodeShape ;
    sh:targetSubjectsOf tmk:origin ;
    rdfs:label "Nothing is both authored and approved"@en-AU ;
    sh:not [
        sh:and (
            [ sh:property [ sh:path tmk:origin ; sh:hasValue "authored" ; sh:minCount 1 ] ]
            [ sh:class tmk:ApprovedAssertion ]
        )
    ] ;
    sh:message "A node stamped as authored is typed as an approved assertion. If those two mix once, no later audit can unmix them (ADR-0007)." .
