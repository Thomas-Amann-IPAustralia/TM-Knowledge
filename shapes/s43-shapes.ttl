# TM-Knowledge — SHACL shapes for the section 43 pilot
#
# Constraints that report rather than infer. See the module docstring
# in src/tm_knowledge/graph/shapes.py for why these are not OWL.
#
# GENERATED by tm_knowledge.graph.shapes. Rebuild with tmk-graph.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tmk: <https://data.ipaustralia.gov.au/tmk/ns/> .
@prefix tmka: <https://data.ipaustralia.gov.au/tmk/assertion/> .
@prefix tmkc: <https://data.ipaustralia.gov.au/tmk/concept/> .
@prefix tmkg: <https://data.ipaustralia.gov.au/tmk/graph/> .
@prefix tmkr: <https://data.ipaustralia.gov.au/tmk/ref/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/approvedBy>
    sh:message "An assertion with no name against it is not approved knowledge (ADR-0039)."@en ;
    sh:minCount 1 ;
    sh:path tmk:approvedBy ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/approvedDate>
    sh:message "An approval with no date cannot be aged against a snapshot."@en ;
    sh:minCount 1 ;
    sh:path tmk:approvedDate ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/goldRecord>
    sh:message "Every node must name the approved record it was built from."@en ;
    sh:minCount 1 ;
    sh:path tmk:goldRecord ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/hasModality>
    sh:message "No modality recorded. A warning and not a violation: five approved relationships have none because the sentence carries none, and filling that in would be inventing a strength nobody stated."@en ;
    sh:minCount 1 ;
    sh:path tmk:hasModality ;
    sh:severity sh:Warning .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/supportingText>
    sh:message "An assertion with no supporting sentence is an opinion."@en ;
    sh:minCount 1 ;
    sh:path tmk:supportingText ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/wasDerivedFrom>
    sh:message "An assertion with no source passage cannot be checked by a reader."@en ;
    sh:minCount 1 ;
    sh:path prov:wasDerivedFrom ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion>
    a sh:NodeShape ;
    rdfs:comment "What makes a reified relationship approved knowledge rather than a candidate. Every one of these is a field a person filled in."@en ;
    sh:property
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/approvedBy> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/approvedDate> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/goldRecord> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/hasModality> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/supportingText> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Assertion/wasDerivedFrom> ;
    sh:targetClass tmk:Assertion .

<https://data.ipaustralia.gov.au/tmk/ns/shape/AuthorityKept/notManual/in>
    sh:hasValue tmk:ManualInstruction .

<https://data.ipaustralia.gov.au/tmk/ns/shape/AuthorityKept/notManual>
    sh:message "This node is typed as both binding law and stated practice. One of the two is wrong and the distinction must survive into any answer."@en ;
    sh:not <https://data.ipaustralia.gov.au/tmk/ns/shape/AuthorityKept/notManual/in> ;
    sh:path rdf:type ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/AuthorityKept>
    a sh:NodeShape ;
    rdfs:comment "CLAUDE.md rule 5, as a check rather than as a sentence in a document: the Manual states the Registrar's practice and does not bind the Registrar's discretion, so nothing may be both a provision of the Act and an instruction of the Manual. The OWL disjointness says the same, but an OWL reasoner reports it by calling the whole graph inconsistent. This names the node."@en ;
    sh:property <https://data.ipaustralia.gov.au/tmk/ns/shape/AuthorityKept/notManual> ;
    sh:targetClass tmk:LegislativeProvision .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Concept/definition>
    sh:message "A concept with no defining passage rests on nothing."@en ;
    sh:minCount 1 ;
    sh:path skos:definition ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Concept/prefLabel>
    sh:message "A concept with no preferred label cannot be searched for."@en ;
    sh:minCount 1 ;
    sh:path skos:prefLabel ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Concept>
    a sh:NodeShape ;
    sh:property
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Concept/definition> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Concept/prefLabel> ;
    sh:targetClass skos:Concept .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Mention/mentionOf>
    sh:message "A mention with no passage is a claim about nowhere."@en ;
    sh:minCount 1 ;
    sh:path tmk:mentionOf ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Mention/sourceContentHash>
    sh:message "Without the hash the span cannot be told from a stale span, which is the failure that looks exactly like success."@en ;
    sh:minCount 1 ;
    sh:path tmk:sourceContentHash ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Mention/spanEnd>
    sh:datatype xsd:integer ;
    sh:message "A mention with no span cannot be verified against the passage."@en ;
    sh:minCount 1 ;
    sh:path tmk:spanEnd ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Mention/spanStart>
    sh:datatype xsd:integer ;
    sh:message "A mention with no span cannot be verified against the passage."@en ;
    sh:minCount 1 ;
    sh:path tmk:spanStart ;
    sh:severity sh:Violation .

<https://data.ipaustralia.gov.au/tmk/ns/shape/Mention>
    a sh:NodeShape ;
    rdfs:comment "A mention is only useful if a reader can go and look at it. That means a passage, a span and the hash of the passage as it stood when it was approved."@en ;
    sh:property
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Mention/mentionOf> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Mention/sourceContentHash> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Mention/spanEnd> ,
        <https://data.ipaustralia.gov.au/tmk/ns/shape/Mention/spanStart> ;
    sh:targetClass tmk:Mention .
