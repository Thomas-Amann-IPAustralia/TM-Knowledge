@prefix tmk:  <https://data.ipaustralia.gov.au/tmk/ns/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# SKOS well-formedness, plus the one constraint SKOS has no vocabulary for.

tmk:ConceptShape
    a sh:NodeShape ;
    sh:targetClass tmk:LegalConcept ;
    rdfs:label "A concept has exactly one preferred label and belongs to a scheme"@en-AU ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A concept with two preferred labels is two concepts that have not been separated yet." ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:message "A concept outside every scheme cannot be found by anything that walks a scheme." ;
    ] ;
    sh:property [
        sh:path tmk:goldRecord ;
        sh:minCount 1 ;
        sh:message "No route from the concept back to the record and the reviewer who approved it." ;
    ] .

tmk:NoBroaderCycleShape
    a sh:NodeShape ;
    sh:targetClass tmk:LegalConcept ;
    rdfs:label "No cycles in broader/narrower"@en-AU ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This concept is its own ancestor. A cycle in the hierarchy makes every hierarchy walk non-terminating and every broader-than query meaningless." ;
        sh:select """
            SELECT $this
            WHERE {
                $this <http://www.w3.org/2004/02/skos/core#broader>+ $this .
            }
        """ ;
    ] .

# The constraint SKOS cannot express, and the one most worth having.

tmk:NotLabelShape
    a sh:NodeShape ;
    sh:targetClass tmk:LegalConcept ;
    rdfs:label "A not-label is not also a label"@en-AU ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This concept carries the same string as both a label and a not-label, ignoring case. The record says at once that the term means this concept and that it must never be read as this concept, and a retrieval system reading the first will route an examiner to the wrong test. Case is folded because recognition folds it: 'ART' and 'art' are one string to the matcher (review E4)." ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this <https://data.ipaustralia.gov.au/tmk/ns/notLabel> ?value .
                { $this <http://www.w3.org/2004/02/skos/core#prefLabel> ?label }
                UNION
                { $this <http://www.w3.org/2004/02/skos/core#altLabel> ?label }
                FILTER (LCASE(STR(?label)) = LCASE(STR(?value)))
            }
        """ ;
    ] .

tmk:NotLabelCollisionShape
    a sh:NodeShape ;
    sh:targetClass tmk:LegalConcept ;
    rdfs:label "A not-label naming another concept's label is reported, not failed"@en-AU ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This concept's not-label is another concept's label. That is usually correct and is exactly what a not-label is for — 'deceptively similar' belongs to section 44 and must not be read as this concept. Reported so the pairs are visible, never failed." ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this <https://data.ipaustralia.gov.au/tmk/ns/notLabel> ?label .
                ?value <http://www.w3.org/2004/02/skos/core#prefLabel> ?label .
                FILTER (?value != $this)
            }
        """ ;
    ] .

# Review F2 (ADR-0125): the rulebook passed with duplicates and contradictions present,
# because no rule looked for them. These three look. Names are compared by the key the
# graph build states beside every label (tmk:labelKey, tmk:prefLabelKey,
# tmk:notLabelKey): the label folded by `ontology.hygiene.fold` — case, punctuation, a
# leading article and plurals — the same comparison the harness makes.

tmk:SharedPreferredLabelShape
    a sh:NodeShape ;
    sh:targetClass tmk:LegalConcept ;
    rdfs:label "No two concepts share a preferred label"@en-AU ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Another concept has the same preferred label once case, punctuation, a leading article and plurals are folded. Two records under one name are one idea held twice, or two ideas recognition cannot tell apart (review A1, A5)." ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this <https://data.ipaustralia.gov.au/tmk/ns/prefLabelKey> ?key .
                ?value <https://data.ipaustralia.gov.au/tmk/ns/prefLabelKey> ?key .
                FILTER (?value != $this)
            }
        """ ;
    ] .

tmk:SharedLabelShape
    a sh:NodeShape ;
    sh:targetClass tmk:LegalConcept ;
    rdfs:label "A name two concepts answer to is reported, not failed"@en-AU ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Another concept answers to one of this concept's names — preferred or alternative — once case, punctuation, a leading article and plurals are folded. Sometimes the records already separate a homonym; recognition cannot, on that name. A warning for a person to look at (review A5)." ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this <https://data.ipaustralia.gov.au/tmk/ns/labelKey> ?key .
                ?value <https://data.ipaustralia.gov.au/tmk/ns/labelKey> ?key .
                FILTER (?value != $this)
            }
        """ ;
    ] .

tmk:KindOfBesideNotLabelShape
    a sh:NodeShape ;
    sh:targetClass tmk:AuthoredAssertion ;
    rdfs:label "A machine-written 'kind of' beside a 'not the same as' carries its reason"@en-AU ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This machine-written assertion says one concept is a kind of another, and one of the two lists the other's name as not the same concept. That can be right — a narrower idea is never the same idea as its broader one, and the expert's own GC-0017 says so of geographical indications — but it is the shape a wrong hierarchy takes, so it publishes only with a written reason (tmk:kindOfAffirmed, from authored/kind-of-affirmed.yaml; review D4)." ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this <https://data.ipaustralia.gov.au/tmk/ns/assertionPredicate> <http://www.w3.org/2004/02/skos/core#broader> ;
                      <https://data.ipaustralia.gov.au/tmk/ns/assertionSubject> ?narrower ;
                      <https://data.ipaustralia.gov.au/tmk/ns/assertionObject> ?broader .
                FILTER NOT EXISTS { $this <https://data.ipaustralia.gov.au/tmk/ns/kindOfAffirmed> ?why }
                {
                    ?narrower <https://data.ipaustralia.gov.au/tmk/ns/notLabelKey> ?key .
                    ?broader <https://data.ipaustralia.gov.au/tmk/ns/labelKey> ?key .
                    BIND (?broader AS ?value)
                }
                UNION
                {
                    ?broader <https://data.ipaustralia.gov.au/tmk/ns/notLabelKey> ?key .
                    ?narrower <https://data.ipaustralia.gov.au/tmk/ns/labelKey> ?key .
                    BIND (?narrower AS ?value)
                }
            }
        """ ;
    ] .
