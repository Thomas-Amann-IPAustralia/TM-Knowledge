{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.ipaustralia.gov.au/tmk/schema/open-questions.json",
  "title": "The queue of decisions waiting on a person",
  "description": "Read by tm_knowledge.dashboard.questions and rendered as the dashboard's decision form. Every field here exists to make a question answerable without reading the repo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "themes", "questions"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "blurb"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 3 },
          "blurb": { "type": "string", "minLength": 10 }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "theme", "status", "needs", "urgency", "title", "plain", "why_you", "if_unanswered", "raised"],
        "properties": {
          "id": { "type": "string", "pattern": "^OQ-\\d{4}$" },
          "theme": { "type": "string" },
          "status": { "enum": ["open", "parked", "answered"] },
          "needs": {
            "description": "Who can settle it. `owner` reaches the form; `expert` and `organisation` are shown as context and are not asked.",
            "enum": ["owner", "expert", "organisation"]
          },
          "urgency": { "enum": ["high", "medium", "low"] },
          "title": { "type": "string", "minLength": 10, "maxLength": 120 },
          "plain": {
            "description": "What is going on, in language that assumes no engineering. Two to five sentences.",
            "type": "string",
            "minLength": 60
          },
          "why_you": { "type": "string", "minLength": 20 },
          "if_unanswered": { "type": "string", "minLength": 20 },
          "raised": { "type": "string", "pattern": "^S\\d{3}$" },
          "tracked_as": { "type": "array", "items": { "type": "string" } },
          "background": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": { "type": "string" },
                "href": { "type": "string" }
              }
            }
          },
          "answer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["choice", "multi", "text", "long_text"] },
              "prompt": { "type": "string" },
              "placeholder": { "type": "string" },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "label"],
                  "properties": {
                    "value": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "label": { "type": "string" },
                    "help": { "type": "string" }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "enum": ["choice", "multi"] } } },
                "then": { "required": ["options"] }
              }
            ]
          },
          "notes_prompt": { "type": "string" },
          "answered": {
            "description": "Where the answer is recorded, for a question settled outside the dashboard form — typed into the issue by hand, or decided somewhere the form never saw. A question with `status: answered` and no entry in a ruling file must carry this: without it the site shows it as answered and offers no trace of an answer, which reads as an open question that has lost its control.",
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "how", "record"],
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "how": {
                "description": "One sentence on how the answer arrived, in the reader's terms.",
                "type": "string",
                "minLength": 10
              },
              "record": {
                "description": "Repository-relative path to the file holding the answer itself.",
                "type": "string",
                "minLength": 3
              },
              "applied": {
                "description": "False while the answer is recorded but not yet acted on.",
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "description": "A question put to the owner must carry an answer control; a parked one must not pretend to be answerable here.",
            "if": {
              "properties": { "status": { "const": "open" }, "needs": { "const": "owner" } },
              "required": ["status", "needs"]
            },
            "then": { "required": ["answer"] }
          }
        ]
      }
    }
  }
}
