# question: CQ-0009
# answers: What has to be established before a standalone geographical reference in a trade mark is treated as likely to cause confusion?
# limits: Returns the elements the Manual states as required, with the sentence stating each. It does not weigh them, and it does not say whether they are made out on any set of facts — that is the decision maker's evaluative judgement and stating it is PU-0001. Note GR-0008's own note: `requiresElement` reads plausibly and, on that record, says the wrong thing.

PREFIX tmk:  <https://data.ipaustralia.gov.au/tmk/ns/>
PREFIX tmkg: <https://data.ipaustralia.gov.au/tmk/graph/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?record ?subjectLabel ?predicate ?objectLabel ?modality ?sourceRef
WHERE {
  GRAPH tmkg:approved {
    ?assertion a tmk:ApprovedAssertion ;
               tmk:goldRecord ?record ;
               tmk:assertionPredicate ?predicate ;
               tmk:assertionSubject ?subject ;
               tmk:assertionObject ?object ;
               tmk:sourcePassage ?passage .
    OPTIONAL { ?assertion tmk:modality ?modality }
    ?subject skos:prefLabel ?subjectLabel .
    OPTIONAL { ?object skos:prefLabel ?objectLabel }
    VALUES ?predicate { tmk:requiresElement tmk:extendsTo tmk:excludesBasis tmk:qualifies }
    FILTER (CONTAINS(LCASE(?subjectLabel), "geograph") || CONTAINS(LCASE(?subjectLabel), "connotation"))
  }
  GRAPH tmkg:source { ?passage tmk:upstreamRef ?sourceRef }
}
ORDER BY ?record
