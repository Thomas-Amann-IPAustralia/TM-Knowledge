# question: CQ-0024
# answers: Is that a requirement, or is it how we usually do it?
# limits: One row per relationship still serving, from both graphs (`standing`: "reviewed" for a signed record, "unreviewed" for a machine-written one, never merged), with `authority` saying whose words the supporting passage is: "practice" for the Manual, "law" for the Act or the Regulations. A "must" in the Manual is the Registrar's practice, not a requirement of the Act, and the `authority` column is what keeps that visible; the `modality` is the reading recorded on the record, never inferred from the sentence's grammar, and a blank stays blank (guide §5.4). It does not say whether the Act requires the same thing: a practice row whose subject has a legislative basis is the place to look, and this query does not follow it.

PREFIX tmk:  <https://data.ipaustralia.gov.au/tmk/ns/>
PREFIX tmkg: <https://data.ipaustralia.gov.au/tmk/graph/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?standing ?authority ?modality ?record ?subjectLabel ?predicate ?objectLabel ?sourceRef
WHERE {
  {
    GRAPH tmkg:approved {
      ?assertion a tmk:ApprovedAssertion ; tmk:sourcePassage ?passage .
      # A corrected signed record is history; its replacement serves (ADR-0122).
      FILTER NOT EXISTS { ?assertion tmk:isCorrected true }
    }
    BIND ("reviewed" AS ?standing)
  } UNION {
    GRAPH tmkg:authored { ?assertion a tmk:AuthoredAssertion ; tmk:sourcePassage ?passage }
    BIND ("unreviewed" AS ?standing)
  }
  GRAPH ?g {
    ?assertion tmk:goldRecord ?record ; tmk:assertionPredicate ?predicate ;
               tmk:assertionSubject ?subject ; tmk:assertionObject ?object .
    OPTIONAL { ?assertion tmk:modality ?m }
  }
  OPTIONAL { GRAPH ?sg { ?subject skos:prefLabel ?subjectLabel } }
  OPTIONAL { GRAPH ?og { ?object skos:prefLabel ?objectLabel } }
  BIND (COALESCE(?m, "«not supplied — a gap, not a default»") AS ?modality)
  GRAPH tmkg:source {
    ?passage tmk:upstreamRef ?sourceRef .
    OPTIONAL { ?passage a tmk:ManualPassage . BIND ("practice" AS ?manual) }
    OPTIONAL { ?passage a tmk:LegislativeProvision . BIND ("law" AS ?law) }
  }
  BIND (COALESCE(?manual, ?law, "«not stated»") AS ?authority)
}
ORDER BY ?standing ?authority ?modality ?record
