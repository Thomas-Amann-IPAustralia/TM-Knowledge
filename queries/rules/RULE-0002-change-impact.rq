# rule: RULE-0002
# derives: tmk:impactedBy — every approved record that would have to be re-read if a given Manual passage changed, because the record was read out of that passage or names it as a definition source.
# basis: CQ-0017 and CQ-0019, the two impact-category competency questions. The edges it walks are the ones already in the approved graph; the rule materialises the closure so an impact answer is a lookup rather than a traversal written afresh each time.
# approved-by: PENDING — a candidate. Everything it produces carries tmk:reviewStatus "candidate" and tmk:requiresHumanReview true.
# fires-test: tests/unit/test_rules.py::test_rule_0002_fires_for_a_passage_with_dependants
# near-miss-test: tests/unit/test_rules.py::test_rule_0002_does_not_fire_for_an_unreferenced_passage
# limits: Impact by *recorded dependency*, and nothing else. A passage that discusses the same subject without being cited by a record is invisible to it, which is the known shape of the gap (Q-28): a term's definition is usually not in a passage that cites anything, so the material a scope rule finds and the material a topic actually spans are not the same set. Reading a nil result as "nothing is affected" is the error this limits line exists to prevent.

PREFIX tmk:  <https://data.ipaustralia.gov.au/tmk/ns/>
PREFIX tmkg: <https://data.ipaustralia.gov.au/tmk/graph/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
  ?inference a tmk:InferredAssertion ;
             tmk:assertionSubject ?dependant ;
             tmk:assertionPredicate tmk:impactedBy ;
             tmk:assertionObject ?passage ;
             tmk:producedByRule <https://data.ipaustralia.gov.au/tmk/prop/RULE-0002> ;
             tmk:derivedFrom ?dependant ;
             tmk:derivedFrom ?passage ;
             tmk:inferenceKind "impact" ;
             tmk:reviewStatus "candidate" ;
             tmk:requiresHumanReview true ;
             tmk:extractionMethod "construct_rule" .
  ?dependant tmk:impactedBy ?passage .
}
WHERE {
  GRAPH tmkg:source { ?passage a tmk:Chunk ; tmk:upstreamRef ?ref }
  GRAPH tmkg:approved {
    { ?dependant tmk:sourcePassage ?passage ; tmk:goldRecord ?record }
    UNION
    { ?dependant tmk:definitionSource ?passage ; tmk:goldRecord ?record }
  }
  BIND (IRI(CONCAT("https://data.ipaustralia.gov.au/tmk/assertion/inf-RULE-0002-",
                   ?record, "-", REPLACE(?ref, "#", "%23"))) AS ?inference)
}
